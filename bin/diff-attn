#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Differential Attention (Diff-Transformer) & Noise Cancellation Engine.

A mathematically rigorous, production-grade implementation of Differential Attention
(as introduced in 'Differential Transformer', Microsoft Research, Oct 2024).

Key Innovations & Capabilities:
- Dual-Softmax Differential formulation: A_diff = softmax(Q1 K1^T / sqrt(d_k)) - lambda * softmax(Q2 K2^T / sqrt(d_k))
- Noise Cancellation: Eliminates attention noise over long contexts by subtracting correlated background activation.
- Contrastive Filtering: Prevents attention sink drift and drastically boosts Needle-In-A-Haystack retrieval.
- Dynamic / Learnable Lambda balance parameter with parameterization bounds.
- Full Autoregressive KV-Cache: Incremental decoding with dual-key state caching (K1, K2, V).
- Standard Multi-Head Attention baseline for rigorous comparative benchmarking.
- CLI subcommands: verify, bench, needle, inspect.
"""

from __future__ import annotations

import argparse
import dataclasses
from dataclasses import dataclass, field
import math
import os
import sys
import time
from typing import Dict, List, Optional, Tuple, Union

import numpy as np

USE_COLOR = sys.stdout.isatty() or os.getenv('FORCE_COLOR', '0') == '1'

def c(color_code: str, text: str) -> str:
    return f"\033[{color_code}m{text}\033[0m" if USE_COLOR else text

def bold(text: str) -> str: return c('1', text)
def dim(text: str) -> str: return c('2', text)
def cyan(text: str) -> str: return c('36', text)
def green(text: str) -> str: return c('32', text)
def yellow(text: str) -> str: return c('33', text)
def red(text: str) -> str: return c('31', text)
def magenta(text: str) -> str: return c('35', text)
def blue(text: str) -> str: return c('34', text)


# =====================================================================
# Core Mathematical Primitives
# =====================================================================

def softmax(x: np.ndarray, axis: int = -1) -> np.ndarray:
    """Numerically stable softmax along specified axis."""
    max_val = np.max(x, axis=axis, keepdims=True)
    exp_x = np.exp(x - max_val)
    sum_exp = np.sum(exp_x, axis=axis, keepdims=True)
    return exp_x / np.maximum(sum_exp, 1e-12)


def rms_norm(x: np.ndarray, weight: np.ndarray, eps: float = 1e-6) -> np.ndarray:
    """Root Mean Square Layer Normalization (RMSNorm)."""
    variance = np.mean(x ** 2, axis=-1, keepdims=True)
    return (x / np.sqrt(variance + eps)) * weight


def precompute_rope_freqs(dim: int, max_seq_len: int, theta: float = 10000.0) -> Tuple[np.ndarray, np.ndarray]:
    """Precomputes cos and sin frequency tables for Rotary Position Embedding (RoPE)."""
    if dim % 2 != 0:
        raise ValueError(f"RoPE dimension must be even, got {dim}")
    half = dim // 2
    freqs = 1.0 / (theta ** (np.arange(0, half, dtype=np.float64) / half))
    t = np.arange(max_seq_len, dtype=np.float64)
    freqs = np.outer(t, freqs)
    return np.cos(freqs), np.sin(freqs)


def apply_rope(x: np.ndarray, cos: np.ndarray, sin: np.ndarray, pos: int) -> np.ndarray:
    """Applies RoPE rotation to the trailing dimension at a single position."""
    half = x.shape[-1] // 2
    c_p = cos[pos]
    s_p = sin[pos]
    x1 = x[..., :half]
    x2 = x[..., half:]
    return np.concatenate([x1 * c_p - x2 * s_p, x1 * s_p + x2 * c_p], axis=-1)


def apply_rope_sequence(x: np.ndarray, cos: np.ndarray, sin: np.ndarray, start_pos: int = 0) -> np.ndarray:
    """Applies RoPE rotation across sequence dimension (B, S, H, D) or (B, H, S, D)."""
    S = x.shape[1] if x.ndim == 4 and x.shape[1] > x.shape[2] else x.shape[2]
    half = x.shape[-1] // 2
    c_slice = cos[start_pos : start_pos + S]
    s_slice = sin[start_pos : start_pos + S]

    if x.ndim == 4 and x.shape[1] == S:  # (B, S, H, D)
        c_slice = c_slice[:, None, :]
        s_slice = s_slice[:, None, :]
    elif x.ndim == 4 and x.shape[2] == S:  # (B, H, S, D)
        c_slice = c_slice[None, None, :, :]
        s_slice = s_slice[None, None, :, :]

    x1 = x[..., :half]
    x2 = x[..., half:]
    return np.concatenate([x1 * c_slice - x2 * s_slice, x1 * s_slice + x2 * c_slice], axis=-1)


# =====================================================================
# Configuration Dataclass
# =====================================================================

@dataclass
class DiffAttnConfig:
    dim: int = 512                   # Model hidden dimension (d_model)
    n_heads: int = 8                 # Number of attention heads
    lambda_init: float = 0.8         # Initial / baseline balance factor lambda
    max_seq_len: int = 2048          # Maximum sequence context length
    eps: float = 1e-6                # RMSNorm epsilon
    rope_theta: float = 10000.0      # Base RoPE frequency
    use_rope: bool = True            # Apply rotary positional embeddings
    learnable_lambda: bool = True    # Use parameterized re-scaled lambda per head

    @property
    def head_dim(self) -> int:
        """Total head dimension d = d_model / n_heads."""
        return self.dim // self.n_heads

    @property
    def half_head_dim(self) -> int:
        """Sub-vector dimension d_k = d / 2 for Q1, Q2, K1, K2."""
        return self.head_dim // 2

    def __post_init__(self):
        if self.dim % self.n_heads != 0:
            raise ValueError(f"dim ({self.dim}) must be divisible by n_heads ({self.n_heads})")
        if self.head_dim % 2 != 0:
            raise ValueError(f"head_dim ({self.head_dim}) must be even for Q1/Q2 split")


# =====================================================================
# Autoregressive Differential KV-Cache
# =====================================================================

class DifferentialKVCache:
    """Autoregressive KV Cache maintaining historical dual keys (K1, K2) and values (V)."""

    def __init__(self, config: DiffAttnConfig, batch_size: int = 1):
        self.config = config
        self.batch_size = batch_size
        self.k1_cache: Optional[np.ndarray] = None
        self.k2_cache: Optional[np.ndarray] = None
        self.v_cache: Optional[np.ndarray] = None
        self.cur_len = 0

    def update(self, k1: np.ndarray, k2: np.ndarray, v: np.ndarray) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
        """Appends new token K1, K2, V of shape (B, 1, H, d_k) and (B, 1, H, d_v)."""
        if self.k1_cache is None:
            self.k1_cache = k1
            self.k2_cache = k2
            self.v_cache = v
        else:
            self.k1_cache = np.concatenate([self.k1_cache, k1], axis=1)
            self.k2_cache = np.concatenate([self.k2_cache, k2], axis=1)
            self.v_cache = np.concatenate([self.v_cache, v], axis=1)
        self.cur_len = self.k1_cache.shape[1]
        return self.k1_cache, self.k2_cache, self.v_cache

    def reset(self) -> None:
        self.k1_cache = None
        self.k2_cache = None
        self.v_cache = None
        self.cur_len = 0


# =====================================================================
# Differential Attention Module
# =====================================================================

class DifferentialAttention:
    """Production Differential Attention implementation with dual Softmax and noise cancellation."""

    def __init__(self, config: DiffAttnConfig, seed: int = 42):
        self.config = config
        self.rng = np.random.RandomState(seed)

        d = config.dim
        h = config.n_heads
        dk = config.half_head_dim
        dv = config.head_dim

        # Linear Projections
        # W_q: projects hidden dimension d to 2 * h * dk = d (for Q1 and Q2)
        # W_k: projects hidden dimension d to 2 * h * dk = d (for K1 and K2)
        # W_v: projects hidden dimension d to h * dv = d (for V)
        # W_o: projects output h * dv to d
        scale_init = 1.0 / math.sqrt(d)
        self.W_q = self.rng.randn(d, d) * scale_init
        self.W_k = self.rng.randn(d, d) * scale_init
        self.W_v = self.rng.randn(d, d) * scale_init
        self.W_o = self.rng.randn(d, d) * scale_init

        # Learnable Lambda parameterization vectors per head:
        # lambda = exp(lambda_q1 . lambda_k1) - exp(lambda_q2 . lambda_k2) + lambda_init
        self.lambda_q1 = self.rng.randn(h, dk) * 0.01
        self.lambda_k1 = self.rng.randn(h, dk) * 0.01
        self.lambda_q2 = self.rng.randn(h, dk) * 0.01
        self.lambda_k2 = self.rng.randn(h, dk) * 0.01

        # Sub-layer RMSNorm weight
        self.norm_weight = np.ones(dv)

        # Precompute RoPE tables if enabled
        if config.use_rope:
            self.cos_rope, self.sin_rope = precompute_rope_freqs(dk, config.max_seq_len, config.rope_theta)
        else:
            self.cos_rope, self.sin_rope = None, None

    def compute_lambda(self) -> np.ndarray:
        """Computes per-head lambda balance factors in [0, 1)."""
        if not self.config.learnable_lambda:
            return np.full((self.config.n_heads,), self.config.lambda_init, dtype=np.float64)
        
        # lambda_h = exp(sum(l_q1 * l_k1)) - exp(sum(l_q2 * l_k2)) + lambda_init
        dot1 = np.sum(self.lambda_q1 * self.lambda_k1, axis=-1)
        dot2 = np.sum(self.lambda_q2 * self.lambda_k2, axis=-1)
        lam = np.exp(dot1) - np.exp(dot2) + self.config.lambda_init
        # Constrain within stable numerical range [0.01, 0.99]
        return np.clip(lam, 0.01, 0.99)

    def forward(
        self,
        x: np.ndarray,
        causal: bool = True,
        return_maps: bool = False
    ) -> Union[np.ndarray, Tuple[np.ndarray, Dict[str, np.ndarray]]]:
        """Full sequence forward pass over input x of shape (B, S, D)."""
        B, S, D = x.shape
        H = self.config.n_heads
        dk = self.config.half_head_dim
        dv = self.config.head_dim

        # Projections
        Q = np.dot(x, self.W_q)  # (B, S, D)
        K = np.dot(x, self.W_k)  # (B, S, D)
        V = np.dot(x, self.W_v)  # (B, S, D)

        # Reshape into heads and split into dual components
        # Q: (B, S, H, 2 * dk) -> Q1, Q2 each (B, S, H, dk)
        Q_reshaped = Q.reshape(B, S, H, 2, dk)
        Q1 = Q_reshaped[:, :, :, 0, :]
        Q2 = Q_reshaped[:, :, :, 1, :]

        K_reshaped = K.reshape(B, S, H, 2, dk)
        K1 = K_reshaped[:, :, :, 0, :]
        K2 = K_reshaped[:, :, :, 1, :]

        # V: (B, S, H, dv)
        V = V.reshape(B, S, H, dv)

        # Apply RoPE to Q1, Q2, K1, K2
        if self.config.use_rope and self.cos_rope is not None:
            Q1 = apply_rope_sequence(Q1, self.cos_rope, self.sin_rope, 0)
            Q2 = apply_rope_sequence(Q2, self.cos_rope, self.sin_rope, 0)
            K1 = apply_rope_sequence(K1, self.cos_rope, self.sin_rope, 0)
            K2 = apply_rope_sequence(K2, self.cos_rope, self.sin_rope, 0)

        # Transpose for multi-head attention: (B, H, S, dk)
        Q1 = Q1.transpose(0, 2, 1, 3)
        Q2 = Q2.transpose(0, 2, 1, 3)
        K1 = K1.transpose(0, 2, 1, 3)
        K2 = K2.transpose(0, 2, 1, 3)
        V = V.transpose(0, 2, 1, 3)    # (B, H, S, dv)

        # Compute scaled dot-product attention scores
        scale = 1.0 / math.sqrt(dk)
        scores1 = np.matmul(Q1, K1.transpose(0, 1, 3, 2)) * scale  # (B, H, S, S)
        scores2 = np.matmul(Q2, K2.transpose(0, 1, 3, 2)) * scale  # (B, H, S, S)

        if causal and S > 1:
            mask = np.triu(np.full((S, S), -1e9), k=1)
            scores1 = scores1 + mask
            scores2 = scores2 + mask

        # Dual Softmax attention maps
        A1 = softmax(scores1, axis=-1)  # (B, H, S, S)
        A2 = softmax(scores2, axis=-1)  # (B, H, S, S)

        # Retrieve lambda balance factor per head: shape (H,)
        lambdas = self.compute_lambda()
        lam_broadcast = lambdas[None, :, None, None]  # (1, H, 1, 1)

        # Differential Attention matrix
        A_diff = A1 - lam_broadcast * A2  # (B, H, S, S)

        # Head aggregation with Values
        O_heads = np.matmul(A_diff, V)    # (B, H, S, dv)

        # Transpose back: (B, S, H, dv)
        O_heads = O_heads.transpose(0, 2, 1, 3)

        # Per-head RMSNorm scaling
        # Sub-layer norm: normalize head outputs and rescale with (1 - lambda_init)
        O_normed = rms_norm(O_heads, self.norm_weight, self.config.eps)
        O_normed = O_normed * (1.0 - self.config.lambda_init)

        # Flatten heads to hidden dimension: (B, S, D)
        O_flat = O_normed.reshape(B, S, D)

        # Output projection
        out = np.dot(O_flat, self.W_o)

        if return_maps:
            return out, {"A1": A1, "A2": A2, "A_diff": A_diff, "lambdas": lambdas}
        return out

    def step_forward(
        self,
        x_step: np.ndarray,
        kv_cache: DifferentialKVCache,
        pos: int
    ) -> np.ndarray:
        """Autoregressive single-token incremental decoding step with KV-cache."""
        B, S_cur, D = x_step.shape
        assert S_cur == 1, "x_step must have sequence length 1 for incremental decoding"
        H = self.config.n_heads
        dk = self.config.half_head_dim
        dv = self.config.head_dim

        # Project single token
        Q = np.dot(x_step, self.W_q)
        K = np.dot(x_step, self.W_k)
        V = np.dot(x_step, self.W_v)

        # Reshape
        Q_reshaped = Q.reshape(B, 1, H, 2, dk)
        Q1 = Q_reshaped[:, :, :, 0, :]
        Q2 = Q_reshaped[:, :, :, 1, :]

        K_reshaped = K.reshape(B, 1, H, 2, dk)
        K1 = K_reshaped[:, :, :, 0, :]
        K2 = K_reshaped[:, :, :, 1, :]
        V = V.reshape(B, 1, H, dv)

        # Apply RoPE at current position
        if self.config.use_rope and self.cos_rope is not None:
            Q1 = apply_rope(Q1, self.cos_rope, self.sin_rope, pos)
            Q2 = apply_rope(Q2, self.cos_rope, self.sin_rope, pos)
            K1 = apply_rope(K1, self.cos_rope, self.sin_rope, pos)
            K2 = apply_rope(K2, self.cos_rope, self.sin_rope, pos)

        # Update KV-Cache: cached arrays have shape (B, S_total, H, dk/dv)
        K1_all, K2_all, V_all = kv_cache.update(K1, K2, V)
        S_total = K1_all.shape[1]

        # Transpose: Q: (B, H, 1, dk), K_all: (B, H, S_total, dk), V_all: (B, H, S_total, dv)
        Q1_t = Q1.transpose(0, 2, 1, 3)
        Q2_t = Q2.transpose(0, 2, 1, 3)
        K1_all_t = K1_all.transpose(0, 2, 1, 3)
        K2_all_t = K2_all.transpose(0, 2, 1, 3)
        V_all_t = V_all.transpose(0, 2, 1, 3)

        # Scaled attention scores
        scale = 1.0 / math.sqrt(dk)
        scores1 = np.matmul(Q1_t, K1_all_t.transpose(0, 1, 3, 2)) * scale  # (B, H, 1, S_total)
        scores2 = np.matmul(Q2_t, K2_all_t.transpose(0, 1, 3, 2)) * scale  # (B, H, 1, S_total)

        # Softmax
        A1 = softmax(scores1, axis=-1)
        A2 = softmax(scores2, axis=-1)

        lambdas = self.compute_lambda()
        lam_broadcast = lambdas[None, :, None, None]

        A_diff = A1 - lam_broadcast * A2

        O_heads = np.matmul(A_diff, V_all_t)  # (B, H, 1, dv)
        O_heads = O_heads.transpose(0, 2, 1, 3)

        O_normed = rms_norm(O_heads, self.norm_weight, self.config.eps)
        O_normed = O_normed * (1.0 - self.config.lambda_init)

        O_flat = O_normed.reshape(B, 1, D)
        return np.dot(O_flat, self.W_o)


# =====================================================================
# Standard Multi-Head Attention Baseline
# =====================================================================

class StandardAttentionBaseline:
    """Standard Softmax Multi-Head Attention baseline for rigorous comparative study."""

    def __init__(self, config: DiffAttnConfig, seed: int = 42):
        self.config = config
        self.rng = np.random.RandomState(seed)
        d = config.dim
        h = config.n_heads
        dv = config.head_dim

        scale_init = 1.0 / math.sqrt(d)
        self.W_q = self.rng.randn(d, d) * scale_init
        self.W_k = self.rng.randn(d, d) * scale_init
        self.W_v = self.rng.randn(d, d) * scale_init
        self.W_o = self.rng.randn(d, d) * scale_init

        if config.use_rope:
            self.cos_rope, self.sin_rope = precompute_rope_freqs(dv, config.max_seq_len, config.rope_theta)
        else:
            self.cos_rope, self.sin_rope = None, None

    def forward(
        self,
        x: np.ndarray,
        causal: bool = True,
        return_maps: bool = False
    ) -> Union[np.ndarray, Tuple[np.ndarray, np.ndarray]]:
        B, S, D = x.shape
        H = self.config.n_heads
        dv = self.config.head_dim

        Q = np.dot(x, self.W_q).reshape(B, S, H, dv)
        K = np.dot(x, self.W_k).reshape(B, S, H, dv)
        V = np.dot(x, self.W_v).reshape(B, S, H, dv)

        if self.config.use_rope and self.cos_rope is not None:
            Q = apply_rope_sequence(Q, self.cos_rope, self.sin_rope, 0)
            K = apply_rope_sequence(K, self.cos_rope, self.sin_rope, 0)

        Q = Q.transpose(0, 2, 1, 3)
        K = K.transpose(0, 2, 1, 3)
        V = V.transpose(0, 2, 1, 3)

        scale = 1.0 / math.sqrt(dv)
        scores = np.matmul(Q, K.transpose(0, 1, 3, 2)) * scale

        if causal and S > 1:
            mask = np.triu(np.full((S, S), -1e9), k=1)
            scores = scores + mask

        A = softmax(scores, axis=-1)
        out_heads = np.matmul(A, V).transpose(0, 2, 1, 3).reshape(B, S, D)
        out = np.dot(out_heads, self.W_o)

        if return_maps:
            return out, A
        return out


# =====================================================================
# CLI Subcommand Implementations
# =====================================================================

def cmd_verify(args: argparse.Namespace) -> None:
    print(bold("\n🔍 [Differential Attention Mathematical Verification & Invariant Proofs]"))
    config = DiffAttnConfig(dim=256, n_heads=4, lambda_init=0.8, max_seq_len=256)
    diff_engine = DifferentialAttention(config, seed=1337)

    print(f"  • Configuration: dim={config.dim}, heads={config.n_heads}, head_dim={config.head_dim}, lambda_init={config.lambda_init}")
    passed = 0
    total = 5

    # Test 1: Noise Cancellation Invariant
    print("\n  [1/5] Verifying Background Noise Cancellation Property...")
    # Construct input with correlated background noise across key vectors
    B, S, D = 1, 32, config.dim
    x = np.random.RandomState(42).randn(B, S, D)
    _, maps = diff_engine.forward(x, causal=False, return_maps=True)
    A1 = maps["A1"]
    A2 = maps["A2"]
    A_diff = maps["A_diff"]
    lambdas = maps["lambdas"]

    # Invariant: Sum of row weights in A_diff must equal 1 - lambda_h
    row_sums = np.sum(A_diff, axis=-1)  # (B, H, S)
    expected_sums = 1.0 - lambdas[None, :, None]  # (1, H, 1)
    max_sum_err = np.max(np.abs(row_sums - expected_sums))
    if max_sum_err < 1e-7:
        print(green(f"    ✓ Differential sum invariant verified: sum(A_diff) == 1 - lambda (max error: {max_sum_err:.2e})"))
        passed += 1
    else:
        print(red(f"    ✗ Sum invariant failed: error {max_sum_err:.2e}"))

    # Test 2: Dual Softmax Probability Validity
    print("\n  [2/5] Verifying A1 and A2 are strictly valid probability distributions...")
    a1_valid = np.all(A1 >= 0) and np.allclose(np.sum(A1, axis=-1), 1.0, atol=1e-6)
    a2_valid = np.all(A2 >= 0) and np.allclose(np.sum(A2, axis=-1), 1.0, atol=1e-6)
    if a1_valid and a2_valid:
        print(green("    ✓ Both A1 and A2 are strictly non-negative and sum to 1.0 per query token."))
        passed += 1
    else:
        print(red("    ✗ Probability normalization check failed."))

    # Test 3: Incremental KV-Cache Equivalence with Full Sequence Forward
    print("\n  [3/5] Verifying Full Causal Forward vs Incremental KV-Cache Step Equivalence...")
    seq_len = 8
    x_seq = np.random.RandomState(7).randn(1, seq_len, config.dim)
    # Full sequence forward
    out_full = diff_engine.forward(x_seq, causal=True)

    # Incremental forward step-by-step with KV Cache
    cache = DifferentialKVCache(config, batch_size=1)
    out_steps = []
    for t in range(seq_len):
        xt = x_seq[:, t:t+1, :]
        ot = diff_engine.step_forward(xt, cache, pos=t)
        out_steps.append(ot)
    out_incremental = np.concatenate(out_steps, axis=1)

    kv_max_err = np.max(np.abs(out_full - out_incremental))
    if kv_max_err < 1e-6:
        print(green(f"    ✓ Numerical equivalence confirmed between full causal forward and KV cache (max error: {kv_max_err:.2e})"))
        passed += 1
    else:
        print(red(f"    ✗ KV-cache discrepancy detected: max error = {kv_max_err:.2e}"))

    # Test 4: Learnable Lambda Boundedness & Dynamics
    print("\n  [4/5] Verifying Learnable Lambda Gradient/Range Boundedness...")
    lams = diff_engine.compute_lambda()
    in_bounds = np.all((lams >= 0.01) & (lams <= 0.99))
    print(f"    • Lambda values across heads: {[f'{v:.4f}' for v in lams]}")
    if in_bounds:
        print(green("    ✓ All head balance factors strictly bounded within [0.01, 0.99]."))
        passed += 1
    else:
        print(red("    ✗ Lambda boundary violation."))

    # Test 5: Common-Mode Noise Rejection & Differential Amplification (CMRR Invariant)
    print("\n  [5/5] Verifying Common-Mode Noise Rejection (CMRR Invariant)...")
    # When keys contain common-mode ambient background noise, S1_noise ~ S2_noise
    # Differential attention algebraically cancels common-mode distraction by factor (1 - lambda)
    lam_mean = float(np.mean(diff_engine.compute_lambda()))
    expected_suppression = 1.0 - lam_mean

    # Create input with uniform common-mode background noise
    cm_scores = np.ones((1, config.n_heads, 1, 16)) * 2.5
    a1_cm = softmax(cm_scores, axis=-1)
    a2_cm = softmax(cm_scores, axis=-1)
    a_diff_cm = a1_cm - diff_engine.compute_lambda()[None, :, None, None] * a2_cm

    cm_total = float(np.mean(np.sum(a_diff_cm, axis=-1)))
    cmrr_gain = 1.0 / max(cm_total, 1e-9)

    print(f"    • Standard Attention Common-Mode Response:     1.000 (100% noise accumulation)")
    print(f"    • Differential Attention Common-Mode Response: {cm_total:.4f} (Noise attenuated to {cm_total*100:.1f}%)")
    print(f"    • Common-Mode Rejection Gain:                  {cmrr_gain:.2f}x background noise cancellation")

    if abs(cm_total - expected_suppression) < 1e-6 and cmrr_gain >= 3.0:
        print(green(f"    ✓ Common-Mode Rejection verified: background noise attenuated by {100*(1-cm_total):.1f}%!"))
        passed += 1
    else:
        print(red("    ✗ Common-Mode Rejection verification failed."))

    print(bold("\n============================================================"))
    if passed == total:
        print(green(f"✅ ALL {total}/{total} MATHEMATICAL INVARIANTS PERFECTLY VERIFIED!"))
    else:
        print(red(f"❌ VERIFICATION FAILED ({passed}/{total} passed)"))
        sys.exit(1)


def cmd_bench(args: argparse.Namespace) -> None:
    print(bold("\n⚡ [Differential Attention vs Standard Softmax MHA Benchmark]"))
    seq_lens = [256, 512, 1024, 2048]
    hidden_dim = args.dim or 512
    heads = args.heads or 8

    print(f"  Configuration: Model Dim={hidden_dim}, Heads={heads}, Head Dim={hidden_dim // heads}")
    print(bold("+" + "-" * 78 + "+"))
    print(bold(f"| {'Context':<9} | {'MHA Latency':<13} | {'Diff Latency':<14} | {'Diff Throughput':<17} | {'Overhead':<12} |"))
    print(bold("+" + "-" * 78 + "+"))

    for sl in seq_lens:
        cfg = DiffAttnConfig(dim=hidden_dim, n_heads=heads, max_seq_len=sl)
        diff_attn = DifferentialAttention(cfg, seed=42)
        base_attn = StandardAttentionBaseline(cfg, seed=42)

        x = np.random.randn(1, sl, hidden_dim).astype(np.float64)

        # Warmup
        _ = base_attn.forward(x[:, :64, :])
        _ = diff_attn.forward(x[:, :64, :])

        # MHA Benchmark
        iters = 3 if sl > 1024 else 5
        t0 = time.perf_counter()
        for _ in range(iters):
            _ = base_attn.forward(x)
        mha_ms = ((time.perf_counter() - t0) / iters) * 1000.0

        # Diff Attention Benchmark
        t0 = time.perf_counter()
        for _ in range(iters):
            _ = diff_attn.forward(x)
        diff_ms = ((time.perf_counter() - t0) / iters) * 1000.0

        throughput = (sl / (diff_ms / 1000.0))
        overhead = ((diff_ms - mha_ms) / mha_ms) * 100.0
        sign = "+" if overhead >= 0 else ""

        print(f"| {sl:<9} | {mha_ms:>10.2f} ms | {diff_ms:>11.2f} ms | {throughput:>12.0f} tok/s | {sign}{overhead:>10.1f}% |")

    print(bold("+" + "-" * 78 + "+"))
    print(dim("  Note: Differential Attention runs dual matrix multiplications (Q1K1 and Q2K2) on half-dimension "
              "vectors (d/2), yielding near parity in compute complexity with standard attention while cancelling noise."))


def cmd_needle(args: argparse.Namespace) -> None:
    print(bold("\n🪡 [Needle-In-A-Haystack (NIAH) Noise Cancellation Experiment]"))
    ctx_len = args.context or 64
    needle_pos = args.pos if args.pos is not None else 18
    if needle_pos >= ctx_len:
        needle_pos = ctx_len // 2

    print(f"  • Context Length: {ctx_len} tokens")
    print(f"  • Injected Needle Position: Index {needle_pos}")

    cfg = DiffAttnConfig(dim=256, n_heads=4, lambda_init=0.85, max_seq_len=ctx_len)
    diff_engine = DifferentialAttention(cfg, seed=42)
    base_engine = StandardAttentionBaseline(cfg, seed=42)

    # Generate noisy haystack context embeddings with high ambient variance
    rng = np.random.RandomState(1337)
    x = rng.randn(1, ctx_len, cfg.dim) * 0.5

    # Inject distinct key signal at needle_pos
    needle_vector = rng.randn(cfg.dim) * 3.0
    x[0, needle_pos, :] = needle_vector

    # Query at final token specifically queries the needle signature
    x[0, ctx_len - 1, :] = needle_vector + rng.randn(cfg.dim) * 0.1

    # Execute forward pass
    _, diff_maps = diff_engine.forward(x, causal=True, return_maps=True)
    _, base_map = base_engine.forward(x, causal=True, return_maps=True)

    # Query at last token attending to all previous tokens
    # Average attention across heads
    diff_attn_row = np.mean(diff_maps["A_diff"][0, :, ctx_len - 1, :], axis=0)
    base_attn_row = np.mean(base_map[0, :, ctx_len - 1, :], axis=0)

    # Normalize diff_attn_row for positive display
    diff_disp = np.maximum(diff_attn_row, 0.0)
    if np.sum(diff_disp) > 0:
        diff_disp = diff_disp / np.sum(diff_disp)

    print("\n  --- Standard Softmax Attention Map (Last Token -> All Tokens) ---")
    render_ascii_bar_chart(base_attn_row, needle_pos, label="MHA Attention")

    print("\n  --- Differential Attention Map (Noise Canceled) ---")
    render_ascii_bar_chart(diff_disp, needle_pos, label="Diff Attention")

    needle_mha_pct = base_attn_row[needle_pos] * 100.0
    needle_diff_pct = diff_disp[needle_pos] * 100.0
    
    # Noise mass (sum of all other positions except needle and self)
    noise_indices = [i for i in range(ctx_len - 1) if i != needle_pos]
    noise_mha_pct = np.sum(base_attn_row[noise_indices]) * 100.0
    noise_diff_pct = np.sum(diff_disp[noise_indices]) * 100.0

    print(bold("\n  Retrieval Metrics Comparison:"))
    print(f"  • Standard MHA:       Needle Mass = {needle_mha_pct:>5.1f}%, Background Noise Mass = {noise_mha_pct:>5.1f}%")
    print(f"  • Diff Attention:     Needle Mass = {cyan(f'{needle_diff_pct:>5.1f}%')}, Background Noise Mass = {green(f'{noise_diff_pct:>5.1f}%')}")
    gain = needle_diff_pct / max(needle_mha_pct, 1e-3)
    print(bold(green(f"  ★ Differential Attention delivers a {gain:.2f}x focus amplification on the target needle!\n")))


def render_ascii_bar_chart(weights: np.ndarray, needle_idx: int, label: str, max_width: int = 40) -> None:
    n = len(weights)
    max_w = max(np.max(weights), 1e-6)
    step = max(1, n // 24)  # sample down to max 24 display rows
    
    for idx in range(0, n, step):
        w = weights[idx]
        bar_len = int((w / max_w) * max_width)
        bar = "█" * bar_len
        is_needle = (abs(idx - needle_idx) < step and needle_idx >= idx and needle_idx < idx + step)
        
        if is_needle:
            tok_str = bold(yellow(f"Tok {idx:2d} [NEEDLE]"))
            bar_str = bold(cyan(bar))
            pct_str = bold(yellow(f"{w*100:5.1f}%"))
        else:
            tok_str = dim(f"Tok {idx:2d}         ")
            bar_str = dim(bar) if bar else " "
            pct_str = dim(f"{w*100:5.1f}%")
            
        print(f"  {tok_str} | {bar_str:<{max_width}} | {pct_str}")


def cmd_inspect(args: argparse.Namespace) -> None:
    print(bold("\n🔬 [Differential Attention Layer Architecture Inspection]"))
    cfg = DiffAttnConfig(dim=256, n_heads=4, lambda_init=0.8, max_seq_len=64)
    diff_engine = DifferentialAttention(cfg, seed=123)

    x = np.random.randn(1, 8, cfg.dim)
    _, maps = diff_engine.forward(x, causal=True, return_maps=True)

    A1 = maps["A1"][0, 0]        # Head 0, shape (8, 8)
    A2 = maps["A2"][0, 0]        # Head 0, shape (8, 8)
    A_diff = maps["A_diff"][0, 0]
    lambdas = maps["lambdas"]

    print(f"  • Learned Lambda across 4 Heads: {[round(float(v), 4) for v in lambdas]}")
    print(bold("\n  --- Head 0: Primary Attention Map A1 (Softmax Q1 K1^T) ---"))
    print_matrix(A1)

    print(bold(f"\n  --- Head 0: Noise Attention Map A2 (Softmax Q2 K2^T) ---"))
    print_matrix(A2)

    print(bold(f"\n  --- Head 0: Differential Attention Map A_diff = A1 - {lambdas[0]:.2f} * A2 ---"))
    print_matrix(A_diff, highlight_negative=True)


def print_matrix(mat: np.ndarray, highlight_negative: bool = False) -> None:
    rows, cols = mat.shape
    header = "        " + " ".join([f"Col {c}" for c in range(cols)])
    print(dim(header))
    for r in range(rows):
        row_strs = []
        for c in range(cols):
            val = mat[r, c]
            if highlight_negative and val < -1e-4:
                row_strs.append(red(f"{val:>5.2f}"))
            elif val > 0.15:
                row_strs.append(green(f"{val:>5.2f}"))
            elif abs(val) < 1e-4:
                row_strs.append(dim(f"{val:>5.2f}"))
            else:
                row_strs.append(f"{val:>5.2f}")
        print(f"  Row {r}: " + " ".join(row_strs))


# =====================================================================
# CLI Entry Point
# =====================================================================

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="diff-attn",
        description="Differential Attention (Diff-Transformer) & Noise Cancellation Engine",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Sub-command to execute")

    # verify
    p_verify = subparsers.add_parser("verify", help="Verify mathematical invariants and dual-softmax properties")

    # bench
    p_bench = subparsers.add_parser("bench", help="Benchmark Differential Attention against standard Softmax MHA")
    p_bench.add_argument("--dim", type=int, default=512, help="Model hidden dimension (default: 512)")
    p_bench.add_argument("--heads", type=int, default=8, help="Number of attention heads (default: 8)")

    # needle
    p_needle = subparsers.add_parser("needle", help="Simulate Needle-In-A-Haystack noise cancellation retrieval")
    p_needle.add_argument("--context", type=int, default=48, help="Context sequence length (default: 48)")
    p_needle.add_argument("--pos", type=int, default=14, help="Needle index position")

    # inspect
    p_inspect = subparsers.add_parser("inspect", help="Inspect internal dual attention maps and difference tensor")

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    if not args.subcommand:
        parser.print_help()
        sys.exit(0)

    if args.subcommand == "verify":
        cmd_verify(args)
    elif args.subcommand == "bench":
        cmd_bench(args)
    elif args.subcommand == "needle":
        cmd_needle(args)
    elif args.subcommand == "inspect":
        cmd_inspect(args)
    else:
        parser.print_help()


if __name__ == '__main__':
    main()
