#!/usr/bin/env python3
"""Hyperdimensional 4D Fractal Raymarcher & Quaternion Julia Engine.

A mathematically rigorous, production-grade 4D raymarcher and visualization engine
written from scratch in pure Python with zero external dependencies.

Renders 4D Quaternion Julia sets, 4D Mandelbulbs, and Clifford Tori via Signed
Distance Fields (SDFs), Hart distance estimation, SO(4) isoclinic rotations,
Blinn-Phong illumination, ambient occlusion, and soft penumbra shadows.
Supports 24-bit Truecolor ANSI terminal rendering and high-res PPM/PNG image export.
"""

import os
import sys
import time
import math
import shutil
import argparse
import subprocess
from typing import Tuple, List, Dict, Optional

class Quaternion:
    __slots__ = ("w", "x", "y", "z")

    def __init__(self, w: float, x: float, y: float, z: float):
        self.w = float(w)
        self.x = float(x)
        self.y = float(y)
        self.z = float(z)

    def __repr__(self) -> str:
        return f"Q({self.w:.4f} + {self.x:.4f}i + {self.y:.4f}j + {self.z:.4f}k)"

    def __add__(self, other: "Quaternion") -> "Quaternion":
        return Quaternion(self.w + other.w, self.x + other.x, self.y + other.y, self.z + other.z)

    def __sub__(self, other: "Quaternion") -> "Quaternion":
        return Quaternion(self.w - other.w, self.x - other.x, self.y - other.y, self.z - other.z)

    def __mul__(self, other) -> "Quaternion":
        if isinstance(other, (int, float)):
            return Quaternion(self.w * other, self.x * other, self.y * other, self.z * other)
        return Quaternion(
            self.w * other.w - self.x * other.x - self.y * other.y - self.z * other.z,
            self.w * other.x + self.x * other.w + self.y * other.z - self.z * other.y,
            self.w * other.y - self.x * other.z + self.y * other.w + self.z * other.x,
            self.w * other.z + self.x * other.y - self.y * other.x + self.z * other.w
        )

    def square(self) -> "Quaternion":
        w2 = self.w * self.w
        v2 = self.x * self.x + self.y * self.y + self.z * self.z
        two_w = 2.0 * self.w
        return Quaternion(w2 - v2, two_w * self.x, two_w * self.y, two_w * self.z)

    def norm_squared(self) -> float:
        return self.w * self.w + self.x * self.x + self.y * self.y + self.z * self.z

    def norm(self) -> float:
        return math.sqrt(self.norm_squared())

    def conjugate(self) -> "Quaternion":
        return Quaternion(self.w, -self.x, -self.y, -self.z)

    def inverse(self) -> "Quaternion":
        n2 = self.norm_squared()
        if n2 == 0.0:
            raise ZeroDivisionError("Cannot invert zero quaternion")
        return Quaternion(self.w / n2, -self.x / n2, -self.y / n2, -self.z / n2)


class Vec3:
    __slots__ = ("x", "y", "z")

    def __init__(self, x: float, y: float, z: float):
        self.x = float(x)
        self.y = float(y)
        self.z = float(z)

    def __add__(self, o: "Vec3") -> "Vec3":
        return Vec3(self.x + o.x, self.y + o.y, self.z + o.z)

    def __sub__(self, o: "Vec3") -> "Vec3":
        return Vec3(self.x - o.x, self.y - o.y, self.z - o.z)

    def __mul__(self, s: float) -> "Vec3":
        return Vec3(self.x * s, self.y * s, self.z * s)

    def __rmul__(self, s: float) -> "Vec3":
        return self.__mul__(s)

    def dot(self, o: "Vec3") -> float:
        return self.x * o.x + self.y * o.y + self.z * o.z

    def cross(self, o: "Vec3") -> "Vec3":
        return Vec3(
            self.y * o.z - self.z * o.y,
            self.z * o.x - self.x * o.z,
            self.x * o.y - self.y * o.x
        )

    def length_sq(self) -> float:
        return self.x * self.x + self.y * self.y + self.z * self.z

    def length(self) -> float:
        return math.sqrt(self.length_sq())

    def norm(self) -> "Vec3":
        l = self.length()
        return Vec3(self.x / l, self.y / l, self.z / l) if l > 1e-12 else Vec3(0.0, 0.0, 0.0)


class Vec4:
    __slots__ = ("x", "y", "z", "w")

    def __init__(self, x: float, y: float, z: float, w: float):
        self.x = float(x)
        self.y = float(y)
        self.z = float(z)
        self.w = float(w)

    def length_sq(self) -> float:
        return self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w

    def length(self) -> float:
        return math.sqrt(self.length_sq())


class Rotation4D:
    def __init__(self, th_xy: float = 0.0, th_xz: float = 0.0, th_xw: float = 0.0,
                 th_yz: float = 0.0, th_yw: float = 0.0, th_zw: float = 0.0):
        self.th_xy = th_xy
        self.th_xz = th_xz
        self.th_xw = th_xw
        self.th_yz = th_yz
        self.th_yw = th_yw
        self.th_zw = th_zw

    def rotate(self, v: Vec4) -> Vec4:
        x, y, z, w = v.x, v.y, v.z, v.w
        if self.th_xy != 0.0:
            c, s = math.cos(self.th_xy), math.sin(self.th_xy)
            x, y = c * x - s * y, s * x + c * y
        if self.th_xz != 0.0:
            c, s = math.cos(self.th_xz), math.sin(self.th_xz)
            x, z = c * x - s * z, s * x + c * z
        if self.th_xw != 0.0:
            c, s = math.cos(self.th_xw), math.sin(self.th_xw)
            x, w = c * x - s * w, s * x + c * w
        if self.th_yz != 0.0:
            c, s = math.cos(self.th_yz), math.sin(self.th_yz)
            y, z = c * y - s * z, s * y + c * z
        if self.th_yw != 0.0:
            c, s = math.cos(self.th_yw), math.sin(self.th_yw)
            y, w = c * y - s * w, s * y + c * w
        if self.th_zw != 0.0:
            c, s = math.cos(self.th_zw), math.sin(self.th_zw)
            z, w = c * z - s * w, s * z + c * w
        return Vec4(x, y, z, w)


class DistanceResult:
    __slots__ = ("dist", "trap_min", "trap_last", "iters")
    def __init__(self, dist: float, trap_min: float = 0.0, trap_last: float = 0.0, iters: int = 0):
        self.dist = dist
        self.trap_min = trap_min
        self.trap_last = trap_last
        self.iters = iters


class Fractal4D:
    def distance(self, p: Vec4) -> DistanceResult:
        raise NotImplementedError


class QuaternionJulia(Fractal4D):
    def __init__(self, c: Quaternion, max_iter: int = 16, escape_radius: float = 4.0):
        self.c = c
        self.max_iter = max_iter
        self.escape_radius_sq = escape_radius * escape_radius

    def distance(self, p: Vec4) -> DistanceResult:
        p_len_sq = p.length_sq()
        if p_len_sq > 4.84:
            return DistanceResult(math.sqrt(p_len_sq) - 1.45, 1.0, 1.0, 0)

        zw, zx, zy, zz = p.w, p.x, p.y, p.z
        cw, cx, cy, cz = self.c.w, self.c.x, self.c.y, self.c.z
        dz = 1.0
        trap_min = 1e9

        for i in range(self.max_iter):
            z_len_sq = zw * zw + zx * zx + zy * zy + zz * zz
            z_len = math.sqrt(z_len_sq)
            dz = 2.0 * z_len * dz + 1.0

            v_sq = zx * zx + zy * zy + zz * zz
            new_w = zw * zw - v_sq + cw
            two_w = 2.0 * zw
            new_x = two_w * zx + cx
            new_y = two_w * zy + cy
            new_z = two_w * zz + cz
            zw, zx, zy, zz = new_w, new_x, new_y, new_z

            dist_axes = min(abs(zx), abs(zy), abs(zz))
            if dist_axes < trap_min:
                trap_min = dist_axes

            if zw * zw + zx * zx + zy * zy + zz * zz > self.escape_radius_sq:
                z_norm = math.sqrt(zw * zw + zx * zx + zy * zy + zz * zz)
                dist = 0.5 * z_norm * math.log(z_norm) / dz
                return DistanceResult(dist, trap_min, z_norm, i)

        return DistanceResult(0.0, trap_min, 0.0, self.max_iter)


class Mandelbulb4D(Fractal4D):
    def __init__(self, power: float = 8.0, max_iter: int = 14):
        self.power = power
        self.max_iter = max_iter

    def distance(self, p: Vec4) -> DistanceResult:
        p_len_sq = p.length_sq()
        if p_len_sq > 4.0:
            return DistanceResult(math.sqrt(p_len_sq) - 1.25, 1.0, 1.0, 0)
        x, y, z, w = p.x, p.y, p.z, p.w
        cx, cy, cz, cw = x, y, z, w
        dr = 1.0
        r = 0.0
        trap_min = 1e9
        for i in range(self.max_iter):
            r = math.sqrt(x * x + y * y + z * z + w * w)
            if r > 2.0:
                break
            dr = math.pow(r, self.power - 1.0) * self.power * dr + 1.0
            r3 = math.sqrt(x * x + y * y + z * z)
            theta = math.acos(max(-1.0, min(1.0, w / r))) if r > 1e-9 else 0.0
            phi = math.acos(max(-1.0, min(1.0, z / r3))) if r3 > 1e-9 else 0.0
            psi = math.atan2(y, x)
            zr = math.pow(r, self.power)
            theta *= self.power
            phi *= self.power
            psi *= self.power
            sin_th = math.sin(theta)
            sin_phi = math.sin(phi)
            x = zr * sin_th * sin_phi * math.cos(psi) + cx
            y = zr * sin_th * sin_phi * math.sin(psi) + cy
            z = zr * sin_th * math.cos(phi) + cz
            w = zr * math.cos(theta) + cw
            trap_min = min(trap_min, abs(z))
        if r <= 2.0:
            return DistanceResult(0.0, trap_min, r, self.max_iter)
        dist = 0.5 * math.log(r) * r / dr
        return DistanceResult(dist, trap_min, r, i)


class CliffordTorus4D(Fractal4D):
    def __init__(self, r1: float = 0.75, r2: float = 0.75, thickness: float = 0.15):
        self.r1 = r1
        self.r2 = r2
        self.thickness = thickness

    def distance(self, p: Vec4) -> DistanceResult:
        d1 = math.sqrt(p.x * p.x + p.y * p.y) - self.r1
        d2 = math.sqrt(p.z * p.z + p.w * p.w) - self.r2
        dist = math.sqrt(d1 * d1 + d2 * d2) - self.thickness
        trap = abs(math.atan2(p.y, p.x) - math.atan2(p.w, p.z))
        return DistanceResult(dist, trap, dist, 1)


class Camera:
    def __init__(self, eye: Vec3, target: Vec3, up: Vec3 = Vec3(0, 1, 0), fov_deg: float = 60.0):
        self.eye = eye
        self.target = target
        self.forward = (target - eye).norm()
        self.right = self.forward.cross(up).norm()
        self.up = self.right.cross(self.forward).norm()
        self.fov_factor = math.tan(math.radians(fov_deg) * 0.5)

    def get_ray_dir(self, u: float, v: float, aspect: float) -> Vec3:
        return (self.forward + self.right * (u * aspect * self.fov_factor) + self.up * (v * self.fov_factor)).norm()


class Raymarcher:
    def __init__(self, fractal: Fractal4D, rot4d: Rotation4D, slice_w: float = 0.0):
        self.fractal = fractal
        self.rot4d = rot4d
        self.slice_w = slice_w
        self.light_key = Vec3(2.5, 3.5, 2.0).norm()
        self.light_fill = Vec3(-2.0, -1.0, -1.5).norm()

    def map_to_4d(self, p3: Vec3) -> Vec4:
        v4 = Vec4(p3.x, p3.y, p3.z, self.slice_w)
        return self.rot4d.rotate(v4)

    def eval_de(self, p3: Vec3) -> DistanceResult:
        return self.fractal.distance(self.map_to_4d(p3))

    def calc_normal(self, p3: Vec3, eps: float = 0.002) -> Vec3:
        d0 = self.eval_de(p3).dist
        nx = self.eval_de(Vec3(p3.x + eps, p3.y, p3.z)).dist - d0
        ny = self.eval_de(Vec3(p3.x, p3.y + eps, p3.z)).dist - d0
        nz = self.eval_de(Vec3(p3.x, p3.y, p3.z + eps)).dist - d0
        return Vec3(nx, ny, nz).norm()

    def ambient_occlusion(self, p: Vec3, n: Vec3, steps: int = 4, delta: float = 0.03) -> float:
        occ = 0.0
        weight = 1.0
        for i in range(1, steps + 1):
            sample_p = p + n * (i * delta)
            d = self.eval_de(sample_p).dist
            occ += (i * delta - d) * weight
            weight *= 0.5
        return max(0.0, min(1.0, 1.0 - 2.5 * occ))

    def soft_shadow(self, p: Vec3, light_dir: Vec3, min_t: float = 0.02, max_t: float = 2.0, k: float = 16.0) -> float:
        res = 1.0
        t = min_t
        for _ in range(20):
            d = self.eval_de(p + light_dir * t).dist
            if d < 0.0005:
                return 0.0
            res = min(res, k * d / t)
            t += max(0.008, d)
            if t > max_t:
                break
        return max(0.0, min(1.0, res))

    def march(self, ray_origin: Vec3, ray_dir: Vec3, max_dist: float = 8.0, max_steps: int = 65) -> Tuple[bool, Vec3, DistanceResult, int]:
        t = 0.0
        b_dist = ray_origin.length()
        if b_dist > 3.0:
            to_orig = Vec3(0, 0, 0) - ray_origin
            proj = to_orig.dot(ray_dir)
            if proj > 0:
                closest = ray_origin + ray_dir * proj
                if closest.length() < 2.5:
                    t = max(0.0, proj - 2.5)
                else:
                    return False, ray_origin, DistanceResult(100.0), 0
            else:
                return False, ray_origin, DistanceResult(100.0), 0

        res = DistanceResult(100.0)
        for step in range(max_steps):
            p = ray_origin + ray_dir * t
            res = self.eval_de(p)
            d = res.dist
            hit_thresh = 0.001 * (1.0 + 0.1 * t)
            if d < hit_thresh:
                return True, p, res, step
            t += d
            if t > max_dist:
                break
        return False, ray_origin + ray_dir * t, res, max_steps


PALETTES = {
    "cosmic": {"base": (15, 10, 35), "diffuse1": (80, 45, 180), "diffuse2": (20, 160, 220), "specular": (255, 230, 255)},
    "neon": {"base": (10, 20, 15), "diffuse1": (255, 0, 128), "diffuse2": (0, 240, 200), "specular": (255, 255, 255)},
    "gold": {"base": (25, 15, 5), "diffuse1": (220, 140, 30), "diffuse2": (255, 210, 80), "specular": (255, 250, 210)},
    "opal": {"base": (20, 25, 30), "diffuse1": (170, 190, 215), "diffuse2": (210, 160, 190), "specular": (245, 250, 255)},
    "emerald": {"base": (5, 20, 10), "diffuse1": (20, 160, 70), "diffuse2": (80, 230, 130), "specular": (220, 255, 230)}
}

def shade_pixel(hit: bool, p: Vec3, normal: Vec3, de_res: DistanceResult, steps: int,
                ray_dir: Vec3, rm: Raymarcher, palette_name: str = "cosmic") -> Tuple[int, int, int]:
    pal = PALETTES.get(palette_name, PALETTES["cosmic"])
    if not hit:
        bg_grad = max(0.0, 1.0 - 0.5 * (ray_dir.y + 1.0))
        return (int(pal["base"][0] * bg_grad), int(pal["base"][1] * bg_grad), int(pal["base"][2] * bg_grad))

    n_dot_l1 = max(0.0, normal.dot(rm.light_key))
    n_dot_l2 = max(0.0, normal.dot(rm.light_fill))
    h1 = (rm.light_key - ray_dir).norm()
    spec = math.pow(max(0.0, normal.dot(h1)), 32.0)
    ao = rm.ambient_occlusion(p, normal)
    shadow = rm.soft_shadow(p, rm.light_key)

    trap_factor = max(0.0, min(1.0, de_res.trap_min * 3.5))
    d1 = pal["diffuse1"]
    d2 = pal["diffuse2"]
    surf_r = d1[0] * (1.0 - trap_factor) + d2[0] * trap_factor
    surf_g = d1[1] * (1.0 - trap_factor) + d2[1] * trap_factor
    surf_b = d1[2] * (1.0 - trap_factor) + d2[2] * trap_factor

    ambient = 0.15 * ao
    diffuse = (0.75 * n_dot_l1 * shadow + 0.25 * n_dot_l2) * ao
    spec_term = 0.5 * spec * shadow

    r = surf_r * (ambient + diffuse) + pal["specular"][0] * spec_term
    g = surf_g * (ambient + diffuse) + pal["specular"][1] * spec_term
    b = surf_b * (ambient + diffuse) + pal["specular"][2] * spec_term
    return (max(0, min(255, int(r))), max(0, min(255, int(g))), max(0, min(255, int(b))))


def render_frame(width: int, height: int, rm: Raymarcher, cam: Camera, palette: str) -> List[List[Tuple[int, int, int]]]:
    aspect = width / height
    frame = []
    for y in range(height):
        row = []
        v = 1.0 - 2.0 * (y + 0.5) / height
        for x in range(width):
            u = 2.0 * (x + 0.5) / width - 1.0
            ray_dir = cam.get_ray_dir(u, v, aspect)
            hit, pos, de_res, steps = rm.march(cam.eye, ray_dir)
            normal = rm.calc_normal(pos) if hit else Vec3(0, 0, 0)
            rgb = shade_pixel(hit, pos, normal, de_res, steps, ray_dir, rm, palette)
            row.append(rgb)
        frame.append(row)
    return frame


def display_terminal_frame(frame: List[List[Tuple[int, int, int]]]):
    height = len(frame)
    width = len(frame[0]) if height > 0 else 0
    lines = []
    for y in range(0, height - 1, 2):
        top_row = frame[y]
        bot_row = frame[y + 1]
        line_buf = []
        for x in range(width):
            tr, tg, tb = top_row[x]
            br, bg, bb = bot_row[x]
            line_buf.append(f"\033[38;2;{tr};{tg};{tb}m\033[48;2;{br};{bg};{bb}m▀")
        line_buf.append("\033[0m")
        lines.append("".join(line_buf))
    if height % 2 == 1:
        last_row = frame[height - 1]
        line_buf = []
        for x in range(width):
            tr, tg, tb = last_row[x]
            line_buf.append(f"\033[38;2;{tr};{tg};{tb}m\033[48;2;0;0;0m▀")
        line_buf.append("\033[0m")
        lines.append("".join(line_buf))
    print("\n".join(lines))


def save_ppm(frame: List[List[Tuple[int, int, int]]], output_path: str):
    height = len(frame)
    width = len(frame[0]) if height > 0 else 0
    header = f"P6\n{width} {height}\n255\n".encode("ascii")
    raw_bytes = bytearray()
    for row in frame:
        for r, g, b in row:
            raw_bytes.append(r)
            raw_bytes.append(g)
            raw_bytes.append(b)
    with open(output_path, "wb") as f:
        f.write(header)
        f.write(raw_bytes)


def convert_ppm_to_png(ppm_path: str, png_path: str) -> bool:
    if shutil.which("sips"):
        res = subprocess.run(["sips", "-s", "format", "png", ppm_path, "--out", png_path], capture_output=True, text=True)
        return res.returncode == 0
    return False


