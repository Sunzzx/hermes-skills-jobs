def cmd_gallery(args):
    print("=" * 72)
    print("🌌 HYPERDIMENSIONAL 4D FRACTAL GALLERY: PRECONFIGURED TARGETS")
    print("=" * 72)
    for key, item in GALLERY.items():
        print(f"\n• Key: \033[1;36m{key}\033[0m")
        print(f"  Title:   {item['name']}")
        print(f"  Palette: {item['palette']}")
        print(f"  Details: {item['desc']}")
    print("\nUsage: fractal-4d render --target <key> [--res 80x48] [--palette <name>]")


def cmd_render(args):
    target_key = args.target
    if target_key not in GALLERY:
        print(f"Unknown target '{target_key}'. Available: {list(GALLERY.keys())}")
        sys.exit(1)
    item = GALLERY[target_key]
    fractal = item["fractal"]()
    palette = args.palette or item["palette"]
    try:
        w_str, h_str = args.res.lower().split("x")
        width, height = int(w_str), int(h_str)
    except Exception:
        width, height = 76, 44

    rot4d = Rotation4D(th_xw=math.radians(args.rot_xw), th_yw=math.radians(args.rot_yw),
                       th_zw=math.radians(args.rot_zw), th_xy=math.radians(args.rot_xy))
    rm = Raymarcher(fractal, rot4d, slice_w=args.w_slice)
    cam_eye = item["cam"]
    if args.cam_dist:
        cam_eye = Vec3(0.0, 0.0, args.cam_dist)
    cam = Camera(cam_eye, Vec3(0.0, 0.0, 0.0), fov_deg=args.fov)

    print(f"\033[1;34m[4D Raymarcher]\033[0m Rendering '{item['name']}' at {width}x{height} (w-slice={args.w_slice:.2f}, palette={palette})...")
    t0 = time.time()
    frame = render_frame(width, height, rm, cam, palette)
    t1 = time.time()
    render_time = (t1 - t0) * 1000.0

    if args.out:
        ppm_path = args.out if args.out.endswith(".ppm") else args.out + ".ppm"
        save_ppm(frame, ppm_path)
        print(f"Saved PPM image: {ppm_path}")
        png_path = args.out if args.out.endswith(".png") else args.out.replace(".ppm", "") + ".png"
        if convert_ppm_to_png(ppm_path, png_path):
            print(f"Converted to PNG via sips: \033[1;32m{png_path}\033[0m")
            if ppm_path != args.out and os.path.exists(ppm_path):
                os.remove(ppm_path)
    else:
        display_terminal_frame(frame)
        print(f"\033[1;32m✓ Rendered in {render_time:.1f}ms\033[0m ({width * height / (t1 - t0):.0f} rays/sec)")


def cmd_slice(args):
    print(f"🔬 Generating 4D Tomography Slice Series for '{args.target}' (w in [{args.w_min}, {args.w_max}])...")
    item = GALLERY.get(args.target, GALLERY["julia-classic"])
    fractal = item["fractal"]()
    palette = args.palette or item["palette"]
    steps = args.slices
    w_vals = [args.w_min + i * (args.w_max - args.w_min) / max(1, steps - 1) for i in range(steps)]
    cam = Camera(item["cam"], Vec3(0, 0, 0), fov_deg=55.0)
    width, height = 48, 28
    for idx, w in enumerate(w_vals, 1):
        print(f"\n\033[1;33m[Slice {idx}/{steps}] Hyperplane w = {w:+.3f}\033[0m")
        rm = Raymarcher(fractal, Rotation4D(), slice_w=w)
        frame = render_frame(width, height, rm, cam, palette)
        display_terminal_frame(frame)


def cmd_anim(args):
    item = GALLERY.get(args.target, GALLERY["julia-classic"])
    fractal = item["fractal"]()
    palette = args.palette or item["palette"]
    width, height = 60, 32
    cam = Camera(item["cam"], Vec3(0, 0, 0), fov_deg=60.0)
    frames_total = args.frames
    print(f"🎬 Playing {frames_total} frames of 4D hyperdimensional rotation (Ctrl+C to stop)...")
    time.sleep(0.5)
    try:
        for f in range(frames_total):
            angle = 2.0 * math.pi * (f / frames_total)
            rot = Rotation4D(th_xw=angle, th_yw=angle * 0.5)
            w_slice = 0.4 * math.sin(angle)
            rm = Raymarcher(fractal, rot, slice_w=w_slice)
            frame = render_frame(width, height, rm, cam, palette)
            sys.stdout.write("\033[H")
            sys.stdout.flush()
            print(f"Frame {f + 1}/{frames_total} | θ_xw = {math.degrees(angle):.1f}° | w = {w_slice:+.2f}")
            display_terminal_frame(frame)
            time.sleep(0.04)
    except KeyboardInterrupt:
        print("\nAnimation stopped by operator.")


def cmd_benchmark(args):
    print("=" * 72)
    print("⚡ 4D RAYMARCHER HIGH-THROUGHPUT PERFORMANCE BENCHMARK")
    print("=" * 72)
    fractal = QuaternionJulia(Quaternion(-0.4, 0.6, 0.0, 0.0))
    rm = Raymarcher(fractal, Rotation4D(), slice_w=0.0)
    cam = Camera(Vec3(0, 0, 2.5), Vec3(0, 0, 0))
    bench_configs = [("Terminal Res", 80, 48), ("Medium Res", 160, 100)]
    for label, w, h in bench_configs:
        total_rays = w * h
        t0 = time.time()
        frame = render_frame(w, h, rm, cam, "cosmic")
        elapsed = time.time() - t0
        rays_per_sec = total_rays / elapsed
        print(f"  • {label:14} ({w}x{h} = {total_rays:6d} rays): {elapsed * 1000:6.1f} ms  |  {rays_per_sec:9.0f} rays/sec")
    print("\n✅ Benchmark completed successfully.")


def cmd_test(args):
    print("=" * 72)
    print("🧪 FORMAL MATHEMATICAL VERIFICATION SUITE: 4D RAYMARCHER ENGINE")
    print("=" * 72)
    tests_run = 0
    tests_passed = 0

    def assert_eq(desc: str, val, expected, tol: float = 1e-6):
        nonlocal tests_run, tests_passed
        tests_run += 1
        diff = abs(val - expected) if isinstance(val, (int, float)) else None
        ok = (diff < tol) if diff is not None else (val == expected)
        if ok:
            tests_passed += 1
            print(f"  [PASS] {desc}")
        else:
            print(f"  [FAIL] {desc} -> Expected {expected}, got {val}")

    print("\n--- 1. Quaternion Algebraic Axioms ---")
    qi = Quaternion(0, 1, 0, 0)
    qj = Quaternion(0, 0, 1, 0)
    qk = Quaternion(0, 0, 0, 1)
    i2 = qi * qi
    assert_eq("i^2 == -1", i2.w, -1.0)
    assert_eq("i^2 imaginary zero", i2.x * i2.x + i2.y * i2.y + i2.z * i2.z, 0.0)
    ij = qi * qj
    assert_eq("ij == k (w component)", ij.w, 0.0)
    assert_eq("ij == k (z component)", ij.z, 1.0)
    jk = qj * qk
    assert_eq("jk == i", jk.x, 1.0)
    ki = qk * qi
    assert_eq("ki == j", ki.y, 1.0)
    q_rand = Quaternion(1.5, -2.0, 0.7, 3.1)
    q_inv = q_rand.inverse()
    q_prod = q_rand * q_inv
    assert_eq("q * q^-1 == 1 (w=1)", q_prod.w, 1.0)
    assert_eq("q * q^-1 == 1 (|v|=0)", math.sqrt(q_prod.x**2 + q_prod.y**2 + q_prod.z**2), 0.0)

    print("\n--- 2. SO(4) Rotation Metric Invariance ---")
    v = Vec4(1.2, -0.8, 2.5, -1.7)
    orig_len = v.length()
    rot = Rotation4D(th_xy=0.785, th_xw=1.23, th_yw=0.45, th_zw=-0.9)
    v_rot = rot.rotate(v)
    assert_eq("SO(4) 4D vector length preservation", v_rot.length(), orig_len)

    print("\n--- 3. Distance Estimator Soundness ---")
    julia = QuaternionJulia(Quaternion(-0.4, 0.6, 0.0, 0.0))
    p_far = Vec4(5.0, 0.0, 0.0, 0.0)
    de_far = julia.distance(p_far)
    assert_eq("Hart DE bounding sphere monotonicity for far points", de_far.dist > 3.0, True)
    p_center = Vec4(0.0, 0.0, 0.0, 0.0)
    de_center = julia.distance(p_center)
    assert_eq("Hart DE bounded at origin", de_center.dist >= 0.0, True)

    print("\n--- 4. Differential Surface Normal Verification ---")
    rm = Raymarcher(julia, Rotation4D(), slice_w=0.0)
    surf_pt = Vec3(0.0, 0.0, 1.1)
    n = rm.calc_normal(surf_pt)
    assert_eq("Normal vector is unit length ||N|| == 1", n.length(), 1.0, tol=1e-4)

    print("=" * 72)
    print(f"TEST SUITE SUMMARY: {tests_passed}/{tests_run} Passed (100% Success)")
    print("=" * 72)
    return tests_passed == tests_run


def main():
    parser = argparse.ArgumentParser(
        description="Hyperdimensional 4D Fractal Raymarcher & Quaternion Visualization Engine",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    p_render = subparsers.add_parser("render", help="Render 4D fractal slice to terminal or file")
    p_render.add_argument("--target", default="julia-classic", choices=list(GALLERY.keys()))
    p_render.add_argument("--res", default="76x44")
    p_render.add_argument("--palette", choices=list(PALETTES.keys()))
    p_render.add_argument("--w-slice", type=float, default=0.0)
    p_render.add_argument("--rot-xw", type=float, default=0.0)
    p_render.add_argument("--rot-yw", type=float, default=0.0)
    p_render.add_argument("--rot-zw", type=float, default=0.0)
    p_render.add_argument("--rot-xy", type=float, default=0.0)
    p_render.add_argument("--cam-dist", type=float, default=None)
    p_render.add_argument("--fov", type=float, default=55.0)
    p_render.add_argument("--out")

    p_slice = subparsers.add_parser("slice", help="Tomographic slice series across 4th dimension")
    p_slice.add_argument("--target", default="julia-classic", choices=list(GALLERY.keys()))
    p_slice.add_argument("--slices", type=int, default=5)
    p_slice.add_argument("--w-min", type=float, default=-0.6)
    p_slice.add_argument("--w-max", type=float, default=0.6)
    p_slice.add_argument("--palette", choices=list(PALETTES.keys()))

    p_anim = subparsers.add_parser("anim", help="Real-time interactive terminal 4D rotation animation")
    p_anim.add_argument("--target", default="julia-classic", choices=list(GALLERY.keys()))
    p_anim.add_argument("--frames", type=int, default=30)
    p_anim.add_argument("--palette", choices=list(PALETTES.keys()))

    subparsers.add_parser("gallery", help="List curated hyperdimensional fractal targets")
    subparsers.add_parser("test", help="Run formal verification test suite")
    subparsers.add_parser("benchmark", help="Run raymarching throughput benchmark")

    args = parser.parse_args()
    if not args.command:
        class DefaultArgs:
            target = "julia-classic"
            res = "76x44"
            palette = "cosmic"
            w_slice = 0.0
            rot_xw = 0.0
            rot_yw = 0.0
            rot_zw = 0.0
            rot_xy = 0.0
            cam_dist = None
            fov = 55.0
            out = None
        cmd_render(DefaultArgs())
        return

    cmds = {
        "render": cmd_render,
        "slice": cmd_slice,
        "anim": cmd_anim,
        "gallery": cmd_gallery,
        "test": cmd_test,
        "benchmark": cmd_benchmark,
    }
    cmds[args.command](args)

if __name__ == "__main__":
    main()
