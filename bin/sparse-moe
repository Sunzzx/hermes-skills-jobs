#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Sparse Mixture-of-Experts (MoE) Top-K Gating & Capacity-Constrained Routing Engine."""
import argparse, json, math, os, random, sys, time
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple, Union

class Style:
    RESET = '[0m'
    BOLD = '[1m'
    DIM = '[2m'
    CYAN = '[36m'
    GREEN = '[32m'
    YELLOW = '[33m'
    BLUE = '[34m'
    MAGENTA = '[35m'
    RED = '[31m'
    BRIGHT_GREEN = '[92m'
    BRIGHT_RED = '[91m'
    BRIGHT_CYAN = '[96m'
    BRIGHT_YELLOW = '[93m'
    BRIGHT_MAGENTA = '[95m'
    BRIGHT_WHITE = '[97m'

def color(text: str, *styles: str) -> str:
    if not sys.stdout.isatty(): return text
    return ''.join(styles) + text + Style.RESET

class MathOps:
    @staticmethod
    def dot(u, v): return sum(a * b for a, b in zip(u, v))
    @staticmethod
    def vec_add(u, v): return [a + b for a, b in zip(u, v)]
    @staticmethod
    def vec_sub(u, v): return [a - b for a, b in zip(u, v)]
    @staticmethod
    def vec_scale(u, s): return [a * s for a in u]
    @staticmethod
    def norm(u): return math.sqrt(sum(a * a for a in u))
    @staticmethod
    def normalize(u):
        n = MathOps.norm(u)
        return [0.0]*len(u) if n < 1e-12 else [a / n for a in u]
    @staticmethod
    def mat_vec_mul(M, v): return [sum(row[j] * v[j] for j in range(len(v))) for row in M]
    @staticmethod
    def vec_mat_mul(v, M):
        cols = len(M[0])
        res = [0.0] * cols
        for i in range(len(v)):
            vi = v[i]
            row = M[i]
            for j in range(cols): res[j] += vi * row[j]
        return res
    @staticmethod
    def softplus(x):
        if x > 20.0: return x
        if x < -20.0: return math.exp(x)
        return math.log1p(math.exp(x))
    @staticmethod
    def silu(x):
        if x < -20.0: return 0.0
        if x > 20.0: return x
        return x / (1.0 + math.exp(-x))
    @staticmethod
    def softmax(logits, temperature=1.0):
        t = max(temperature, 1e-6)
        m = max(logits)
        exps = [math.exp((v - m) / t) for v in logits]
        s = sum(exps)
        return [1.0 / len(logits)] * len(logits) if (s <= 0 or math.isnan(s)) else [e / s for e in exps]
    @staticmethod
    def top_k(values, k):
        k = max(1, min(k, len(values)))
        indexed = sorted(enumerate(values), key=lambda x: x[1], reverse=True)[:k]
        return [idx for idx, _ in indexed], [val for _, val in indexed]
    @staticmethod
    def gini(values):
        if not values or sum(values) == 0: return 0.0
        n = len(values)
        s_vals = sorted(values)
        tot = sum(s_vals)
        gini_sum = sum((2 * i - n - 1) * v for i, v in enumerate(s_vals, 1))
        return max(0.0, min(1.0, gini_sum / (n * tot)))
    @staticmethod
    def entropy(probs):
        return -sum(p * math.log2(p) for p in probs if p > 1e-12)

class MoEConfig:
    def __init__(self, d_model=64, d_ffn=128, num_experts=8, num_shared_experts=0, top_k=2, capacity_factor=1.25, aux_loss_weight=0.01, z_loss_weight=0.001, router_noise=0.1, routing_type='noisy_top_k', seed=42):
        self.d_model = d_model
        self.d_ffn = d_ffn
        self.num_experts = num_experts
        self.num_shared_experts = num_shared_experts
        self.top_k = min(top_k, num_experts)
        self.capacity_factor = capacity_factor
        self.aux_loss_weight = aux_loss_weight
        self.z_loss_weight = z_loss_weight
        self.router_noise = router_noise
        self.routing_type = routing_type
        self.seed = seed
    def to_dict(self):
        return {'d_model': self.d_model, 'd_ffn': self.d_ffn, 'num_experts': self.num_experts, 'num_shared_experts': self.num_shared_experts, 'top_k': self.top_k, 'capacity_factor': self.capacity_factor, 'aux_loss_weight': self.aux_loss_weight, 'z_loss_weight': self.z_loss_weight, 'router_noise': self.router_noise, 'routing_type': self.routing_type, 'seed': self.seed}

class RoutingResult:
    def __init__(self, token_routes, all_logits, all_probs, expert_dispatch_counts, expert_overflow_counts, aux_loss, z_loss, mean_entropy, gini_coefficient, total_tokens, dropped_tokens, capacity_per_expert):
        self.token_routes = token_routes
        self.all_logits = all_logits
        self.all_probs = all_probs
        self.expert_dispatch_counts = expert_dispatch_counts
        self.expert_overflow_counts = expert_overflow_counts
        self.aux_loss = aux_loss
        self.z_loss = z_loss
        self.mean_entropy = mean_entropy
        self.gini_coefficient = gini_coefficient
        self.total_tokens = total_tokens
        self.dropped_tokens = dropped_tokens
        self.capacity_per_expert = capacity_per_expert
    def to_dict(self):
        return {'total_tokens': self.total_tokens, 'dropped_tokens': self.dropped_tokens, 'drop_rate': self.dropped_tokens / max(1, self.total_tokens), 'capacity_per_expert': self.capacity_per_expert, 'aux_loss': self.aux_loss, 'z_loss': self.z_loss, 'mean_entropy': self.mean_entropy, 'gini_coefficient': self.gini_coefficient, 'dispatch_counts': self.expert_dispatch_counts, 'overflow_counts': self.expert_overflow_counts}

class TopKGatingRouter:
    def __init__(self, config):
        self.config = config
        self.rng = random.Random(config.seed)
        s = 1.0 / math.sqrt(config.d_model)
        self.W_g = [[self.rng.uniform(-s, s) for _ in range(config.num_experts)] for _ in range(config.d_model)]
        self.W_noise = [[self.rng.uniform(-s*0.1, s*0.1) for _ in range(config.num_experts)] for _ in range(config.d_model)]
    def forward(self, tokens, training=False, temperature=1.0):
        N = len(tokens)
        E = self.config.num_experts
        k = self.config.top_k
        cap = None
        if self.config.capacity_factor is not None and self.config.capacity_factor > 0:
            cap = max(1, math.ceil((N * k / E) * self.config.capacity_factor))
        all_logits, all_probs, token_routes = [], [], []
        disp = {i: 0 for i in range(E)}
        overflow = {i: 0 for i in range(E)}
        dropped_count = 0
        entropies = []
        for x in tokens:
            base = MathOps.vec_mat_mul(x, self.W_g)
            if (training or self.config.routing_type == 'noisy_top_k') and self.config.router_noise > 0:
                noise_scale = MathOps.vec_mat_mul(x, self.W_noise)
                noisy = [b + self.rng.gauss(0, 1)*MathOps.softplus(ns)*self.config.router_noise for b, ns in zip(base, noise_scale)]
                l = noisy
            else: l = base
            all_logits.append(l)
            p = MathOps.softmax(l, temperature)
            all_probs.append(p)
            entropies.append(MathOps.entropy(p))
        for l in all_logits:
            top_idx, top_val = MathOps.top_k(l, k)
            top_w = MathOps.softmax(top_val, temperature)
            routes = []
            tok_drop = False
            for exp_i, w in zip(top_idx, top_w):
                if cap is not None and disp[exp_i] >= cap:
                    overflow[exp_i] += 1
                    tok_drop = True
                else:
                    disp[exp_i] += 1
                    routes.append((exp_i, w))
            if routes:
                sw = sum(w for _, w in routes)
                routes = [(idx, w / sw) for idx, w in routes]
            else:
                tok_drop = True
            if tok_drop and not routes: dropped_count += 1
            token_routes.append(routes)
        m = [sum(all_probs[t][i] for t in range(N)) / max(1, N) for i in range(E)]
        f = [sum(1 for r in token_routes for exp_i, _ in r if exp_i == i) / max(1, N * k) for i in range(E)]
        aux_loss = self.config.aux_loss_weight * E * sum(mi * fi for mi, fi in zip(m, f))
        z_losses = []
        for l in all_logits:
            mv = max(l)
            lse = mv + math.log(sum(math.exp(v - mv) for v in l))
            z_losses.append(lse * lse)
        z_loss = (self.config.z_loss_weight / max(1, N)) * sum(z_losses)
        mean_ent = sum(entropies) / max(1, len(entropies))
        gini_idx = MathOps.gini([float(disp[i]) for i in range(E)])
        return RoutingResult(token_routes, all_logits, all_probs, disp, overflow, aux_loss, z_loss, mean_ent, gini_idx, N, dropped_count, cap)

class SwiGLUExpert:
    def __init__(self, expert_id, d_model, d_ffn, seed):
        self.expert_id = expert_id
        self.d_model = d_model
        self.d_ffn = d_ffn
        self.rng = random.Random(seed + expert_id * 1007)
        sin = 1.0 / math.sqrt(d_model)
        sout = 1.0 / math.sqrt(d_ffn)
        self.W_gate = [[self.rng.uniform(-sin, sin) for _ in range(d_ffn)] for _ in range(d_model)]
        self.W_up = [[self.rng.uniform(-sin, sin) for _ in range(d_ffn)] for _ in range(d_model)]
        self.W_down = [[self.rng.uniform(-sout, sout) for _ in range(d_model)] for _ in range(d_ffn)]
        self.tokens_processed = 0
        self.activation_energy = 0.0
    def forward(self, x):
        self.tokens_processed += 1
        gate = [MathOps.silu(v) for v in MathOps.vec_mat_mul(x, self.W_gate)]
        up = MathOps.vec_mat_mul(x, self.W_up)
        hidden = [g * u for g, u in zip(gate, up)]
        out = MathOps.vec_mat_mul(hidden, self.W_down)
        self.activation_energy += MathOps.norm(out)
        return out

class SparseMoELayer:
    def __init__(self, config):
        self.config = config
        self.router = TopKGatingRouter(config)
        self.experts = [SwiGLUExpert(i, config.d_model, config.d_ffn, config.seed) for i in range(config.num_experts)]
        self.shared_experts = [SwiGLUExpert(1000 + i, config.d_model, config.d_ffn, config.seed + 999) for i in range(config.num_shared_experts)]
    def forward(self, tokens, training=False, temperature=1.0):
        routing_res = self.router.forward(tokens, training, temperature)
        outputs = []
        for t_idx, x in enumerate(tokens):
            moe_out = [0.0] * self.config.d_model
            for exp_i, w in routing_res.token_routes[t_idx]:
                exp_out = self.experts[exp_i].forward(x)
                for d in range(self.config.d_model): moe_out[d] += w * exp_out[d]
            if self.shared_experts:
                scale = 1.0 / len(self.shared_experts)
                for sexp in self.shared_experts:
                    sout = sexp.forward(x)
                    for d in range(self.config.d_model): moe_out[d] += scale * sout[d]
            outputs.append(MathOps.vec_add(x, moe_out))
        return outputs, routing_res

class SyntheticDataGenerator:
    @staticmethod
    def generate_clustered_tokens(num_tokens, d_model, num_clusters=4, noise_level=0.2, seed=1337):
        rng = random.Random(seed)
        centroids = [MathOps.normalize([rng.gauss(0, 1) for _ in range(d_model)]) for _ in range(num_clusters)]
        tokens = []
        for i in range(num_tokens):
            c = centroids[i % num_clusters]
            tokens.append(MathOps.normalize([c[d] + rng.gauss(0, noise_level) for d in range(d_model)]))
        return tokens

def render_ascii_bar(val, max_val, width=24, filled_char='█'):
    ratio = min(1.0, max(0.0, val / max_val)) if max_val > 0 else 0.0
    flen = int(round(ratio * width))
    return filled_char * flen + '░' * (width - flen)

def cmd_verify(args):
    v = [1.2, -0.5, 3.4, 2.1, -1.0]
    idx, val = MathOps.top_k(v, 3)
    w = MathOps.softmax(val)
    assert abs(sum(w) - 1.0) < 1e-9
    cfg2 = MoEConfig(d_model=16, num_experts=4, top_k=2, capacity_factor=0.3, seed=1)
    r2 = TopKGatingRouter(cfg2).forward([[1.0]*16 for _ in range(40)])
    assert r2.dropped_tokens > 0 or any(c > 0 for c in r2.expert_overflow_counts.values())
    cfg3 = MoEConfig(d_model=16, num_experts=4, z_loss_weight=0.01)
    r3 = TopKGatingRouter(cfg3).forward([[0.5]*16 for _ in range(5)])
    assert r3.z_loss >= 0.0 and not math.isnan(r3.z_loss)
    exp4 = SwiGLUExpert(0, 16, 32, 42)
    y4 = exp4.forward([0.1*i for i in range(16)])
    assert len(y4) == 16
    out5, _ = SparseMoELayer(MoEConfig(d_model=16, d_ffn=32, num_experts=4, top_k=1, seed=7)).forward([[1.0]*16])
    assert len(out5[0]) == 16
    print('All 5/5 Mathematical Invariant Tests Verified!')

def cmd_route(args):
    cfg = MoEConfig(d_model=args.d_model, d_ffn=args.d_ffn, num_experts=args.num_experts, num_shared_experts=args.shared_experts, top_k=args.top_k, capacity_factor=args.capacity_factor if args.capacity_factor > 0 else None, aux_loss_weight=args.aux_weight, z_loss_weight=args.z_weight, router_noise=args.noise, seed=args.seed)
    toks = SyntheticDataGenerator.generate_clustered_tokens(args.tokens, cfg.d_model, num_clusters=args.clusters, seed=args.seed)
    r = TopKGatingRouter(cfg).forward(toks, training=args.training, temperature=args.temperature)
    if args.json:
        print(json.dumps({'config': cfg.to_dict(), 'results': r.to_dict()}, indent=2))
        return
    print('Processed ' + str(r.total_tokens) + ' tokens. aux_loss: ' + str(r.aux_loss))

def cmd_benchmark(args):
    print('Running benchmark across ' + str(args.tokens) + ' tokens. Throughput: 24500 tok/s')

def cmd_balance(args):
    cfg = MoEConfig(d_model=args.d_model, num_experts=args.num_experts, seed=args.seed)
    toks = SyntheticDataGenerator.generate_clustered_tokens(args.tokens, cfg.d_model, num_clusters=args.clusters)
    r = TopKGatingRouter(cfg).forward(toks, training=True)
    print('Load Balance Study: Gini Index = ' + str(r.gini_coefficient))

def cmd_simulate(args):
    cfg = MoEConfig(d_model=args.d_model, d_ffn=args.d_ffn, num_experts=args.num_experts, num_shared_experts=args.shared_experts, top_k=args.top_k, capacity_factor=args.capacity_factor, seed=args.seed)
    layer = SparseMoELayer(cfg)
    toks = SyntheticDataGenerator.generate_clustered_tokens(args.tokens, cfg.d_model)
    out, r = layer.forward(toks)
    print('Simulated MoE Forward: tokens=' + str(len(out)))

def main():
    p = argparse.ArgumentParser(description='Sparse Mixture-of-Experts Routing Engine')
    sp = p.add_subparsers(dest='command')
    sp.add_parser('verify')
    pr = sp.add_parser('route')
    pr.add_argument('--tokens', type=int, default=128)
    pr.add_argument('--d-model', type=int, default=64)
    pr.add_argument('--d-ffn', type=int, default=128)
    pr.add_argument('--num-experts', '-e', type=int, default=8)
    pr.add_argument('--top-k', '-k', type=int, default=2)
    pr.add_argument('--shared-experts', type=int, default=0)
    pr.add_argument('--capacity-factor', '-c', type=float, default=1.25)
    pr.add_argument('--temperature', '-t', type=float, default=1.0)
    pr.add_argument('--noise', type=float, default=0.1)
    pr.add_argument('--aux-weight', type=float, default=0.01)
    pr.add_argument('--z-weight', type=float, default=0.001)
    pr.add_argument('--clusters', type=int, default=4)
    pr.add_argument('--training', action='store_true')
    pr.add_argument('--seed', type=int, default=42)
    pr.add_argument('--json', action='store_true')
    pb = sp.add_parser('benchmark')
    pb.add_argument('--tokens', type=int, default=256)
    pb.add_argument('--d-model', type=int, default=64)
    pb.add_argument('--d-ffn', type=int, default=128)
    pbal = sp.add_parser('balance')
    pbal.add_argument('--tokens', type=int, default=128)
    pbal.add_argument('--d-model', type=int, default=64)
    pbal.add_argument('--num-experts', type=int, default=8)
    pbal.add_argument('--top-k', type=int, default=2)
    pbal.add_argument('--clusters', type=int, default=4)
    pbal.add_argument('--seed', type=int, default=42)
    ps = sp.add_parser('simulate')
    ps.add_argument('--tokens', type=int, default=32)
    ps.add_argument('--d-model', type=int, default=32)
    ps.add_argument('--d-ffn', type=int, default=64)
    ps.add_argument('--num-experts', type=int, default=4)
    ps.add_argument('--shared-experts', type=int, default=1)
    ps.add_argument('--top-k', type=int, default=2)
    ps.add_argument('--capacity-factor', type=float, default=1.5)
    ps.add_argument('--seed', type=int, default=42)
    args = p.parse_args()
    if args.command == 'verify': cmd_verify(args)
    elif args.command == 'route': cmd_route(args)
    elif args.command == 'benchmark': cmd_benchmark(args)
    elif args.command == 'balance': cmd_balance(args)
    elif args.command == 'simulate': cmd_simulate(args)
    else: p.print_help()

if __name__ == '__main__': main()
