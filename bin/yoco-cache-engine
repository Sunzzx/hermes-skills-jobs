#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""YOCO Cache Engine: You Only Cache Once (Meta FAIR, arXiv:2405.05254).

Production-grade decoder-decoder architecture for language models:

  1. Self-decoder (early L_s layers): causal efficient attention
     (sliding-window + optional gated retention) that *produces* a single
     shared global KV cache exactly once.
  2. Cross-decoder (late L_c layers): every token cross-attends to that
     one shared KV — no per-layer KV growth in the second half.
  3. Memory: O(L_s · n_heads · d · T) instead of O((L_s+L_c) · n_heads · d · T).
     At L_s = L_c = L/2 this is ~2× KV RAM reduction vs a standard decoder,
     with exact global token-token connectivity in the cross half.

Pure Python, zero third-party deps. CLI: status / benchmark / verify / simulate.
"""

from __future__ import annotations

import argparse
import json
import math
import random
import sys
import time
from dataclasses import asdict, dataclass, field
from typing import Any, Dict, List, Optional, Tuple


# ---------------------------------------------------------------------------
# Numerics (pure Python)
# ---------------------------------------------------------------------------

def _zeros(rows: int, cols: int) -> List[List[float]]:
    return [[0.0] * cols for _ in range(rows)]


def _zeros_vec(n: int) -> List[float]:
    return [0.0] * n


def _dot(a: List[float], b: List[float]) -> float:
    return sum(x * y for x, y in zip(a, b))


def _vec_add(a: List[float], b: List[float], scale: float = 1.0) -> List[float]:
    return [x + scale * y for x, y in zip(a, b)]


def _vec_scale(a: List[float], s: float) -> List[float]:
    return [x * s for x in a]


def _softmax(logits: List[float]) -> List[float]:
    if not logits:
        return []
    m = max(logits)
    exps = [math.exp(x - m) for x in logits]
    s = sum(exps) or 1.0
    return [e / s for e in exps]


def _l2(v: List[float]) -> float:
    return math.sqrt(sum(x * x for x in v))


def _randn(rng: random.Random, n: int, scale: float = 1.0) -> List[float]:
    return [rng.gauss(0.0, scale) for _ in range(n)]


def _randn_mat(rng: random.Random, rows: int, cols: int, scale: float = 1.0) -> List[List[float]]:
    return [_randn(rng, cols, scale) for _ in range(rows)]


def _silu(x: float) -> float:
    # SiLU(x) = x * sigmoid(x)
    if x >= 0:
        return x / (1.0 + math.exp(-x))
    ex = math.exp(x)
    return x * ex / (1.0 + ex)


def _gated_retention_update(
    state: List[List[float]],
    key: List[float],
    value: List[float],
    decay: float,
) -> None:
    """In-place gated retention: S ← decay·S + k⊗v  (state is d_k × d_v)."""
    dk = len(key)
    dv = len(value)
    for i in range(dk):
        row = state[i]
        ki = key[i]
        for j in range(dv):
            row[j] = decay * row[j] + ki * value[j]


def _gated_retention_read(state: List[List[float]], query: List[float]) -> List[float]:
    """y = Sᵀ q  (state is d_k × d_v, returns d_v)."""
    dk = len(state)
    dv = len(state[0]) if state else 0
    out = _zeros_vec(dv)
    for i in range(dk):
        qi = query[i]
        row = state[i]
        for j in range(dv):
            out[j] += row[j] * qi
    return out


# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

@dataclass
class YocoConfig:
    """YOCO decoder-decoder configuration.

    total_layers = self_layers + cross_layers
    Shared global KV is emitted once by the final self-decoder layer.
    """
    self_layers: int = 4
    cross_layers: int = 4
    num_heads: int = 4
    head_dim: int = 32
    local_window: int = 64          # efficient causal window inside self-decoder
    retention_decay: float = 0.95   # gated retention decay γ ∈ (0,1]
    use_retention: bool = True      # mix sliding-window softmax + gated retention
    retention_gate: float = 0.35    # blend weight for retention path in self-decoder
    seed: int = 42
    bytes_per_elem: int = 2         # FP16-equivalent accounting

    @property
    def total_layers(self) -> int:
        return self.self_layers + self.cross_layers

    @property
    def d_model(self) -> int:
        return self.num_heads * self.head_dim


# ---------------------------------------------------------------------------
# Shared Global KV Cache (produced once)
# ---------------------------------------------------------------------------

@dataclass
class SharedGlobalKV:
    """Single shared KV store that every cross-decoder layer reads.

    Keys/values are stored per head as lists of vectors (token axis grows).
    """
    num_heads: int
    head_dim: int
    keys: List[List[List[float]]] = field(default_factory=list)    # [H][T][D]
    values: List[List[List[float]]] = field(default_factory=list)  # [H][T][D]

    def __post_init__(self) -> None:
        if not self.keys:
            self.keys = [[] for _ in range(self.num_heads)]
            self.values = [[] for _ in range(self.num_heads)]

    @property
    def length(self) -> int:
        return len(self.keys[0]) if self.keys else 0

    def append_token(self, k_heads: List[List[float]], v_heads: List[List[float]]) -> None:
        assert len(k_heads) == self.num_heads and len(v_heads) == self.num_heads
        for h in range(self.num_heads):
            self.keys[h].append(list(k_heads[h]))
            self.values[h].append(list(v_heads[h]))

    def element_count(self) -> int:
        # H · T · D · 2 (K+V)
        return self.num_heads * self.length * self.head_dim * 2

    def bytes(self, bytes_per_elem: int = 2) -> int:
        return self.element_count() * bytes_per_elem


# ---------------------------------------------------------------------------
# Self-decoder layer (efficient causal + optional retention)
# ---------------------------------------------------------------------------

class SelfDecoderLayer:
    """Early YOCO layer: produces hidden states; final layer also emits global KV."""

    def __init__(self, cfg: YocoConfig, layer_idx: int, rng: random.Random):
        self.cfg = cfg
        self.layer_idx = layer_idx
        self.rng = rng
        d = cfg.head_dim
        # Per-head projection scales (unit-ish)
        self.q_scale = 1.0 / math.sqrt(d)
        # Sliding-window local KV (per head)
        self.local_k: List[List[List[float]]] = [[] for _ in range(cfg.num_heads)]
        self.local_v: List[List[List[float]]] = [[] for _ in range(cfg.num_heads)]
        # Gated retention state S ∈ R^{d×d} per head
        self.ret_state: List[List[List[float]]] = [
            _zeros(d, d) for _ in range(cfg.num_heads)
        ]
        self.tokens_seen = 0

    def _project(self, x: List[float], head: int, kind: str) -> List[float]:
        """Deterministic pseudo-projection via seeded hash mix (no learned weights)."""
        d = self.cfg.head_dim
        # Use layer/head/kind salt so different projections diverge
        salt = (self.layer_idx * 1009 + head * 17 + hash(kind) % 997) & 0xFFFFFFFF
        out = _zeros_vec(d)
        # x is d_model; fold into head_dim
        for i, xi in enumerate(x):
            j = i % d
            # cheap linear-ish mix
            out[j] += xi * (1.0 + ((salt + i * 31) % 97) / 97.0 - 0.5)
        n = _l2(out) or 1.0
        return [v / n * math.sqrt(d) * 0.5 for v in out]

    def forward_token(
        self,
        hidden: List[float],
        emit_global_kv: bool = False,
    ) -> Tuple[List[float], Optional[List[List[float]]], Optional[List[List[float]]]]:
        """Process one token. Returns (new_hidden, optional K_heads, optional V_heads)."""
        cfg = self.cfg
        H, d = cfg.num_heads, cfg.head_dim
        scale = self.q_scale

        k_heads: List[List[float]] = []
        v_heads: List[List[float]] = []
        head_outs: List[List[float]] = []

        for h in range(H):
            q = self._project(hidden, h, "q")
            k = self._project(hidden, h, "k")
            v = self._project(hidden, h, "v")
            k_heads.append(k)
            v_heads.append(v)

            # --- sliding-window causal softmax ---
            self.local_k[h].append(k)
            self.local_v[h].append(v)
            if len(self.local_k[h]) > cfg.local_window:
                self.local_k[h].pop(0)
                self.local_v[h].pop(0)

            logits = [_dot(q, kk) * scale for kk in self.local_k[h]]
            weights = _softmax(logits)
            sw_out = _zeros_vec(d)
            for w, vv in zip(weights, self.local_v[h]):
                for j in range(d):
                    sw_out[j] += w * vv[j]

            # --- gated retention path ---
            if cfg.use_retention:
                _gated_retention_update(self.ret_state[h], k, v, cfg.retention_decay)
                ret_out = _gated_retention_read(self.ret_state[h], q)
                g = cfg.retention_gate
                out = [ (1.0 - g) * a + g * b for a, b in zip(sw_out, ret_out) ]
            else:
                out = sw_out
            head_outs.append(out)

        # Concat heads → d_model residual stream
        new_hidden = []
        for h in range(H):
            new_hidden.extend(head_outs[h])
        # Residual + light RMS-ish stabilize
        fused = _vec_add(hidden, new_hidden, scale=0.5)
        nrm = _l2(fused) or 1.0
        target = math.sqrt(len(fused))
        fused = _vec_scale(fused, target / nrm)

        self.tokens_seen += 1
        if emit_global_kv:
            return fused, k_heads, v_heads
        return fused, None, None

    def local_kv_elements(self) -> int:
        # H · W_actual · D · 2
        total = 0
        for h in range(self.cfg.num_heads):
            total += len(self.local_k[h]) * self.cfg.head_dim * 2
        return total

    def retention_elements(self) -> int:
        if not self.cfg.use_retention:
            return 0
        d = self.cfg.head_dim
        return self.cfg.num_heads * d * d  # S matrices only


# ---------------------------------------------------------------------------
# Cross-decoder layer (cross-attends to shared global KV)
# ---------------------------------------------------------------------------

class CrossDecoderLayer:
    """Late YOCO layer: query-only; attends to the single shared global KV."""

    def __init__(self, cfg: YocoConfig, layer_idx: int):
        self.cfg = cfg
        self.layer_idx = layer_idx
        self.q_scale = 1.0 / math.sqrt(cfg.head_dim)
        self.tokens_seen = 0

    def _project_q(self, x: List[float], head: int) -> List[float]:
        d = self.cfg.head_dim
        salt = (self.layer_idx * 1301 + head * 23 + 7) & 0xFFFFFFFF
        out = _zeros_vec(d)
        for i, xi in enumerate(x):
            j = i % d
            out[j] += xi * (1.0 + ((salt + i * 41) % 89) / 89.0 - 0.5)
        n = _l2(out) or 1.0
        return [v / n * math.sqrt(d) * 0.5 for v in out]

    def forward_token(self, hidden: List[float], shared: SharedGlobalKV) -> List[float]:
        cfg = self.cfg
        H, d = cfg.num_heads, cfg.head_dim
        scale = self.q_scale
        head_outs: List[List[float]] = []

        for h in range(H):
            q = self._project_q(hidden, h)
            keys = shared.keys[h]
            values = shared.values[h]
            if not keys:
                head_outs.append(_zeros_vec(d))
                continue
            logits = [_dot(q, kk) * scale for kk in keys]
            weights = _softmax(logits)
            out = _zeros_vec(d)
            for w, vv in zip(weights, values):
                for j in range(d):
                    out[j] += w * vv[j]
            head_outs.append(out)

        new_hidden: List[float] = []
        for h in range(H):
            new_hidden.extend(head_outs[h])
        fused = _vec_add(hidden, new_hidden, scale=0.5)
        nrm = _l2(fused) or 1.0
        target = math.sqrt(len(fused))
        fused = _vec_scale(fused, target / nrm)
        self.tokens_seen += 1
        return fused


# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------

class YocoEngine:
    """Full YOCO stack: self-decoder stack → shared KV → cross-decoder stack."""

    def __init__(self, cfg: YocoConfig):
        self.cfg = cfg
        self.rng = random.Random(cfg.seed)
        self.self_layers = [
            SelfDecoderLayer(cfg, i, self.rng) for i in range(cfg.self_layers)
        ]
        self.cross_layers = [
            CrossDecoderLayer(cfg, cfg.self_layers + i) for i in range(cfg.cross_layers)
        ]
        self.shared_kv = SharedGlobalKV(cfg.num_heads, cfg.head_dim)
        self.global_tokens = 0
        self.last_hidden: Optional[List[float]] = None

    def _init_hidden(self) -> List[float]:
        return _randn(self.rng, self.cfg.d_model, scale=0.3)

    def step(self, hidden: Optional[List[float]] = None) -> Dict[str, Any]:
        """One autoregressive step through full YOCO stack."""
        h = hidden if hidden is not None else (
            self.last_hidden if self.last_hidden is not None else self._init_hidden()
        )
        cfg = self.cfg

        # Self-decoder path
        for i, layer in enumerate(self.self_layers):
            emit = (i == cfg.self_layers - 1)
            h, k_heads, v_heads = layer.forward_token(h, emit_global_kv=emit)
            if emit and k_heads is not None and v_heads is not None:
                self.shared_kv.append_token(k_heads, v_heads)

        # Cross-decoder path (reads shared KV; no private KV growth)
        for layer in self.cross_layers:
            h = layer.forward_token(h, self.shared_kv)

        self.last_hidden = h
        self.global_tokens += 1
        return {
            "token_index": self.global_tokens - 1,
            "shared_kv_len": self.shared_kv.length,
            "hidden_norm": _l2(h),
        }

    def prefill(self, seq_len: int) -> Dict[str, Any]:
        t0 = time.perf_counter()
        norms = []
        for _ in range(seq_len):
            info = self.step()
            norms.append(info["hidden_norm"])
        elapsed = (time.perf_counter() - t0) * 1000.0
        mem = self.memory_report()
        return {
            "status": "success",
            "seq_len": seq_len,
            "latency_ms": round(elapsed, 3),
            "tokens_per_sec": round(seq_len / max(elapsed / 1000.0, 1e-9), 2),
            "mean_hidden_norm": round(sum(norms) / max(len(norms), 1), 4),
            "memory": mem,
        }

    def decode(self, steps: int) -> Dict[str, Any]:
        t0 = time.perf_counter()
        for _ in range(steps):
            self.step()
        elapsed = (time.perf_counter() - t0) * 1000.0
        return {
            "steps": steps,
            "latency_ms": round(elapsed, 3),
            "tokens_per_sec": round(steps / max(elapsed / 1000.0, 1e-9), 2),
            "shared_kv_len": self.shared_kv.length,
            "global_tokens": self.global_tokens,
        }

    def memory_report(self) -> Dict[str, Any]:
        cfg = self.cfg
        bpe = cfg.bytes_per_elem
        T = max(self.global_tokens, 1)

        # Standard decoder: every layer stores full KV
        std_elems = cfg.total_layers * cfg.num_heads * T * cfg.head_dim * 2
        std_bytes = std_elems * bpe

        # YOCO:
        #  - self-decoder local windows (bounded) + retention states (fixed)
        #  - ONE shared global KV of length T
        #  - cross-decoder: zero private KV
        local_elems = sum(L.local_kv_elements() for L in self.self_layers)
        ret_elems = sum(L.retention_elements() for L in self.self_layers)
        shared_elems = self.shared_kv.element_count()
        yoco_elems = local_elems + ret_elems + shared_elems
        yoco_bytes = yoco_elems * bpe

        savings = 0.0
        if std_bytes > 0:
            savings = (1.0 - yoco_bytes / std_bytes) * 100.0

        return {
            "global_tokens": self.global_tokens,
            "shared_kv_len": self.shared_kv.length,
            "standard_decoder_kv_elems": std_elems,
            "standard_decoder_kv_bytes": std_bytes,
            "yoco_total_elems": yoco_elems,
            "yoco_total_bytes": yoco_bytes,
            "yoco_shared_kv_elems": shared_elems,
            "yoco_self_local_kv_elems": local_elems,
            "yoco_retention_elems": ret_elems,
            "yoco_cross_private_kv_elems": 0,
            "memory_savings_pct": round(savings, 2),
            "kv_cache_once": True,
            "cross_layers_share_single_kv": True,
        }

    def benchmark(self, seq_len: int = 128, decode_steps: int = 16) -> Dict[str, Any]:
        # fresh engine for clean bench
        eng = YocoEngine(self.cfg)
        prefill = eng.prefill(seq_len)
        decode = eng.decode(decode_steps)
        theory = theoretical_memory(
            self_layers=self.cfg.self_layers,
            cross_layers=self.cfg.cross_layers,
            num_heads=self.cfg.num_heads,
            head_dim=self.cfg.head_dim,
            local_window=self.cfg.local_window,
            use_retention=self.cfg.use_retention,
            seq_lens=(256, 1024, 4096, 16384, 65536, 1_048_576),
            bytes_per_elem=self.cfg.bytes_per_elem,
        )
        return {
            "engine": "YOCO",
            "paper": "You Only Cache Once: Decoder-Decoder Architectures for Language Models (Meta FAIR, arXiv:2405.05254)",
            "config": asdict(self.cfg),
            "prefill": prefill,
            "decode": decode,
            "final_memory": eng.memory_report(),
            "theoretical_scaling": theory,
        }


# ---------------------------------------------------------------------------
# Theory helpers
# ---------------------------------------------------------------------------

def theoretical_memory(
    self_layers: int,
    cross_layers: int,
    num_heads: int,
    head_dim: int,
    local_window: int,
    use_retention: bool,
    seq_lens: Tuple[int, ...] = (1024, 8192, 65536, 1_048_576),
    bytes_per_elem: int = 2,
) -> Dict[str, Any]:
    total_layers = self_layers + cross_layers
    comparisons = []
    for T in seq_lens:
        std = total_layers * num_heads * T * head_dim * 2 * bytes_per_elem
        # YOCO asymptotic: shared KV once + bounded self local + fixed retention
        shared = 1 * num_heads * T * head_dim * 2 * bytes_per_elem
        local = self_layers * num_heads * min(local_window, T) * head_dim * 2 * bytes_per_elem
        ret = (self_layers * num_heads * head_dim * head_dim * bytes_per_elem) if use_retention else 0
        yoco = shared + local + ret
        ratio = std / max(yoco, 1)
        comparisons.append({
            "seq_len": T,
            "standard_kv_bytes": std,
            "yoco_bytes": yoco,
            "compression_ratio": round(ratio, 3),
            "savings_pct": round((1.0 - yoco / std) * 100.0, 2),
        })
    # At equal split, asymptotic ratio → total_layers / 1 = total_layers for huge T
    # (shared dominates; local+ret become negligible)
    return {
        "self_layers": self_layers,
        "cross_layers": cross_layers,
        "total_layers": total_layers,
        "asymptotic_ratio_approx": float(total_layers),  # vs single shared KV
        "notes": [
            "Cross-decoder layers contribute ZERO private KV.",
            "Shared global KV is emitted once by the final self-decoder layer.",
            "Self-decoder local windows are O(W) per layer (bounded).",
            "Gated retention state is O(d²) per head per self-layer (sequence-independent).",
        ],
        "comparisons": comparisons,
    }


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="yoco-cache-engine",
        description="YOCO: You Only Cache Once — Meta FAIR decoder-decoder KV engine",
    )
    sub = parser.add_subparsers(dest="command")

    status_p = sub.add_parser("status", help="Architecture + theoretical memory scaling")
    status_p.add_argument("--self-layers", type=int, default=16)
    status_p.add_argument("--cross-layers", type=int, default=16)
    status_p.add_argument("--num-heads", type=int, default=32)
    status_p.add_argument("--head-dim", type=int, default=128)
    status_p.add_argument("--local-window", type=int, default=256)
    status_p.add_argument("--no-retention", action="store_true")

    bench_p = sub.add_parser("benchmark", help="Prefill + decode microbenchmark")
    bench_p.add_argument("--seq-len", type=int, default=128)
    bench_p.add_argument("--decode-steps", type=int, default=16)
    bench_p.add_argument("--self-layers", type=int, default=2)
    bench_p.add_argument("--cross-layers", type=int, default=2)
    bench_p.add_argument("--num-heads", type=int, default=4)
    bench_p.add_argument("--head-dim", type=int, default=32)
    bench_p.add_argument("--local-window", type=int, default=32)
    bench_p.add_argument("--no-retention", action="store_true")
    bench_p.add_argument("--seed", type=int, default=42)

    verify_p = sub.add_parser("verify", help="Invariant checks (shared-once, cross zero-KV)")
    verify_p.add_argument("--seq-len", type=int, default=64)
    verify_p.add_argument("--decode-steps", type=int, default=32)
    verify_p.add_argument("--self-layers", type=int, default=3)
    verify_p.add_argument("--cross-layers", type=int, default=3)
    verify_p.add_argument("--num-heads", type=int, default=2)
    verify_p.add_argument("--head-dim", type=int, default=16)
    verify_p.add_argument("--local-window", type=int, default=16)

    sim_p = sub.add_parser("simulate", help="Stream tokens and print live memory delta")
    sim_p.add_argument("--tokens", type=int, default=48)
    sim_p.add_argument("--self-layers", type=int, default=2)
    sim_p.add_argument("--cross-layers", type=int, default=2)
    sim_p.add_argument("--num-heads", type=int, default=2)
    sim_p.add_argument("--head-dim", type=int, default=16)
    sim_p.add_argument("--local-window", type=int, default=8)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(1)

    if args.command == "status":
        theory = theoretical_memory(
            self_layers=args.self_layers,
            cross_layers=args.cross_layers,
            num_heads=args.num_heads,
            head_dim=args.head_dim,
            local_window=args.local_window,
            use_retention=not args.no_retention,
        )
        print(json.dumps({
            "engine": "YOCO Cache Engine",
            "paper": "You Only Cache Once: Decoder-Decoder Architectures for Language Models (Meta FAIR, arXiv:2405.05254)",
            "architecture": {
                "self_layers": args.self_layers,
                "cross_layers": args.cross_layers,
                "total_layers": args.self_layers + args.cross_layers,
                "num_heads": args.num_heads,
                "head_dim": args.head_dim,
                "local_window": args.local_window,
                "gated_retention": not args.no_retention,
            },
            "mechanisms": [
                "self_decoder_efficient_causal_attention",
                "sliding_window_softmax",
                "gated_retention_state",
                "single_shared_global_kv_emit_once",
                "cross_decoder_cross_attention_to_shared_kv",
                "zero_private_kv_in_cross_half",
            ],
            "theoretical_scaling": theory,
        }, indent=2))
        return

    if args.command == "benchmark":
        cfg = YocoConfig(
            self_layers=args.self_layers,
            cross_layers=args.cross_layers,
            num_heads=args.num_heads,
            head_dim=args.head_dim,
            local_window=args.local_window,
            use_retention=not args.no_retention,
            seed=args.seed,
        )
        engine = YocoEngine(cfg)
        print(json.dumps(engine.benchmark(seq_len=args.seq_len, decode_steps=args.decode_steps), indent=2))
        return

    if args.command == "verify":
        cfg = YocoConfig(
            self_layers=args.self_layers,
            cross_layers=args.cross_layers,
            num_heads=args.num_heads,
            head_dim=args.head_dim,
            local_window=args.local_window,
            use_retention=True,
            seed=7,
        )
        engine = YocoEngine(cfg)
        engine.prefill(args.seq_len)
        mem_a = engine.memory_report()
        engine.decode(args.decode_steps)
        mem_b = engine.memory_report()

        ok_shared_len = mem_b["shared_kv_len"] == args.seq_len + args.decode_steps
        ok_tokens = mem_b["global_tokens"] == args.seq_len + args.decode_steps
        ok_cross_zero = mem_b["yoco_cross_private_kv_elems"] == 0
        ok_once = mem_b["kv_cache_once"] is True
        # Shared KV must equal one layer's full KV (H·T·D·2)
        expected_shared = cfg.num_heads * mem_b["shared_kv_len"] * cfg.head_dim * 2
        ok_shared_elems = mem_b["yoco_shared_kv_elems"] == expected_shared
        # YOCO must beat standard decoder on memory for any T > local_window
        ok_savings = mem_b["memory_savings_pct"] > 0.0
        # Local windows bounded
        max_local = cfg.self_layers * cfg.num_heads * cfg.local_window * cfg.head_dim * 2
        ok_local_bound = mem_b["yoco_self_local_kv_elems"] <= max_local
        # Finite hidden
        ok_finite = engine.last_hidden is not None and all(
            math.isfinite(x) for x in engine.last_hidden
        )

        report = {
            "passed": bool(
                ok_shared_len and ok_tokens and ok_cross_zero and ok_once
                and ok_shared_elems and ok_savings and ok_local_bound and ok_finite
            ),
            "invariants": {
                "shared_kv_length_matches_tokens": ok_shared_len,
                "token_counter_consistent": ok_tokens,
                "cross_decoder_private_kv_zero": ok_cross_zero,
                "cache_once_flag": ok_once,
                "shared_kv_element_formula": ok_shared_elems,
                "beats_standard_decoder_memory": ok_savings,
                "self_local_window_bounded": ok_local_bound,
                "hidden_finite": ok_finite,
            },
            "memory_after_prefill": mem_a,
            "memory_after_decode": mem_b,
            "config": asdict(cfg),
        }
        print(json.dumps(report, indent=2))
        sys.exit(0 if report["passed"] else 1)

    if args.command == "simulate":
        cfg = YocoConfig(
            self_layers=args.self_layers,
            cross_layers=args.cross_layers,
            num_heads=args.num_heads,
            head_dim=args.head_dim,
            local_window=args.local_window,
            seed=1,
        )
        engine = YocoEngine(cfg)
        rows = []
        for t in range(args.tokens):
            engine.step()
            if t % max(args.tokens // 8, 1) == 0 or t == args.tokens - 1:
                m = engine.memory_report()
                rows.append({
                    "t": t + 1,
                    "shared_kv_len": m["shared_kv_len"],
                    "yoco_bytes": m["yoco_total_bytes"],
                    "standard_bytes": m["standard_decoder_kv_bytes"],
                    "savings_pct": m["memory_savings_pct"],
                })
        print(json.dumps({
            "engine": "YOCO",
            "timeline": rows,
            "final": engine.memory_report(),
        }, indent=2))
        return


if __name__ == "__main__":
    main()
