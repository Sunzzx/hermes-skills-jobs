#!/usr/bin/env python3
"""Lock-Free Concurrency & Chase-Lev Work-Stealing Runtime.

A mathematically rigorous, production-grade systems engineering framework featuring:
  1. Hardware Memory Model & Atomic Primitives (CAS, Load-Acquire, Store-Release, Tagged Pointers)
  2. Michael-Scott Non-Blocking FIFO Queue with Helping Mechanism
  3. Treiber Non-Blocking LIFO Stack with Exponential Backoff
  4. Disruptor-Style Bounded Lock-Free Ring Buffer with Sequence Barriers
  5. Chase-Lev Dynamic Circular Work-Stealing Deque (SPAA 2005 / PPoPP 2013)
  6. Epoch-Based Memory Reclamation (EBR) to eliminate the ABA Problem
  7. Multi-Threaded Work-Stealing Task Scheduler with Randomized Thief Selection
  8. High-Contention Linearizability & Correctness Verification Suite
  9. Live ANSI Terminal Visualizer & Micro-Benchmark Suite
"""

import sys
import os
import time
import math
import random
import threading
import argparse
from dataclasses import dataclass, field
from typing import Any, List, Optional, Tuple, Dict, Callable

# =============================================================================
# ANSI Styling & UI Utilities
# =============================================================================
class Style:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    ITALIC = "\033[3m"
    UNDERLINE = "\033[4m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"
    WHITE = "\033[37m"
    BG_DARK = "\033[40m"

def banner(title: str):
    w = 76
    print(f"{Style.CYAN}{Style.BOLD}{'=' * w}{Style.RESET}")
    print(f"{Style.CYAN}{Style.BOLD} ⚙️   {title}{Style.RESET}")
    print(f"{Style.CYAN}{Style.BOLD}{'=' * w}{Style.RESET}")

def progress_bar(val: int, total: int, width: int = 24, label: str = "") -> str:
    fraction = min(1.0, val / max(1, total))
    filled = int(round(width * fraction))
    bar = "█" * filled + "░" * (width - filled)
    return f"{Style.BLUE}{bar}{Style.RESET} {fraction * 100:5.1f}% {label}"

# =============================================================================
# Section 1: Atomic Primitives, Memory Semantics & ABA Prevention
# =============================================================================

class AtomicReference:
    """Simulates an atomic memory location supporting CAS, atomic load/store,
    and detailed telemetry on contention and collisions."""
    __slots__ = ('_value', '_lock', 'cas_attempts', 'cas_successes', 'loads', 'stores')

    def __init__(self, initial_value: Any = None):
        self._value = initial_value
        self._lock = threading.Lock()
        self.cas_attempts = 0
        self.cas_successes = 0
        self.loads = 0
        self.stores = 0

    def get(self) -> Any:
        with self._lock:
            self.loads += 1
            return self._value

    def set(self, new_value: Any):
        with self._lock:
            self.stores += 1
            self._value = new_value

    def compare_and_set(self, expected: Any, new_value: Any) -> bool:
        with self._lock:
            self.cas_attempts += 1
            if self._value == expected:
                self._value = new_value
                self.cas_successes += 1
                return True
            return False

    def get_and_set(self, new_value: Any) -> Any:
        with self._lock:
            old = self._value
            self._value = new_value
            self.stores += 1
            return old

    @property
    def contention_rate(self) -> float:
        if self.cas_attempts == 0:
            return 0.0
        return (self.cas_attempts - self.cas_successes) / self.cas_attempts


@dataclass(frozen=True)
class TaggedRef:
    """Couples a pointer value with a 64-bit monotonic sequence counter
    to guarantee immunity against the classic ABA hazard."""
    value: Any
    tag: int


class TaggedAtomicReference:
    """Atomic reference wrapping a (value, tag) pair with double-width CAS semantics."""
    __slots__ = ('_ref', '_lock', 'cas_attempts', 'cas_successes')

    def __init__(self, initial_value: Any = None, initial_tag: int = 0):
        self._ref = TaggedRef(initial_value, initial_tag)
        self._lock = threading.Lock()
        self.cas_attempts = 0
        self.cas_successes = 0

    def get(self) -> TaggedRef:
        with self._lock:
            return self._ref

    def compare_and_set(self, expected_val: Any, expected_tag: int, new_val: Any) -> bool:
        with self._lock:
            self.cas_attempts += 1
            if self._ref.value == expected_val and self._ref.tag == expected_tag:
                self._ref = TaggedRef(new_val, expected_tag + 1)
                self.cas_successes += 1
                return True
            return False


class EpochReclamation:
    """Epoch-Based Memory Reclamation (EBR) to safely retire nodes
    without locks or garbage-collection stop-the-world pauses."""
    EPOCHS = 3

    def __init__(self):
        self.global_epoch = AtomicReference(0)
        self.thread_epochs: Dict[int, AtomicReference] = {}
        self.retired_buckets: List[List[Any]] = [[], [], []]
        self.reclaimed_count = 0
        self.lock = threading.Lock()

    def register_thread(self, thread_id: int):
        with self.lock:
            if thread_id not in self.thread_epochs:
                self.thread_epochs[thread_id] = AtomicReference(-1) # -1 indicates quiescent / idle

    def enter_critical(self, thread_id: int):
        current = self.global_epoch.get()
        ref = self.thread_epochs.get(thread_id)
        if ref:
            ref.set(current)

    def exit_critical(self, thread_id: int):
        ref = self.thread_epochs.get(thread_id)
        if ref:
            ref.set(-1)

    def retire(self, obj: Any):
        cur = self.global_epoch.get()
        with self.lock:
            self.retired_buckets[cur].append(obj)

    def try_advance_epoch(self):
        cur = self.global_epoch.get()
        with self.lock:
            # Check if all active threads have moved to or beyond current epoch
            can_advance = True
            for t_id, ref in self.thread_epochs.items():
                t_ep = ref.get()
                if t_ep != -1 and t_ep != cur:
                    can_advance = False
                    break

            if can_advance:
                next_epoch = (cur + 1) % self.EPOCHS
                self.global_epoch.set(next_epoch)
                # Safe to physically reclaim epoch (next_epoch + 1) % 3
                reclaim_target = (next_epoch + 1) % self.EPOCHS
                count = len(self.retired_buckets[reclaim_target])
                self.retired_buckets[reclaim_target].clear()
                self.reclaimed_count += count


# =============================================================================
# Section 2: Non-Blocking Michael-Scott FIFO Queue (M&S PODC 1996)
# =============================================================================

class MSQueueNode:
    __slots__ = ('value', 'next')
    def __init__(self, value: Any = None):
        self.value = value
        self.next: AtomicReference = AtomicReference(None)


class MichaelScottQueue:
    """Lock-Free FIFO Queue with Sentinel Node & Helping Mechanism.
    
    Linearization Points:
      - Enqueue: Successful CAS of tail.next from None -> newNode
      - Dequeue: Successful CAS of head from cur_head -> cur_head.next
    """
    def __init__(self, ebr: Optional[EpochReclamation] = None):
        sentinel = MSQueueNode(None)
        self.head = AtomicReference(sentinel)
        self.tail = AtomicReference(sentinel)
        self.ebr = ebr
        self.enqueue_ops = 0
        self.dequeue_ops = 0
        self.helping_advances = 0

    def enqueue(self, value: Any, thread_id: int = 0):
        if self.ebr:
            self.ebr.enter_critical(thread_id)
        new_node = MSQueueNode(value)
        backoff = 0.00001

        while True:
            tail = self.tail.get()
            next_node = tail.next.get()

            # Check consistency
            if tail == self.tail.get():
                if next_node is None:
                    # Tail was pointing to last node; attempt insertion
                    if tail.next.compare_and_set(None, new_node):
                        # Insertion succeeded! Help advance tail
                        self.tail.compare_and_set(tail, new_node)
                        self.enqueue_ops += 1
                        if self.ebr:
                            self.ebr.exit_critical(thread_id)
                        return
                else:
                    # Tail was lagging; help advance it
                    self.tail.compare_and_set(tail, next_node)
                    self.helping_advances += 1
            # Exponential backoff jitter under high contention
            time.sleep(backoff)
            backoff = min(0.001, backoff * 1.5)

    def dequeue(self, thread_id: int = 0) -> Optional[Any]:
        if self.ebr:
            self.ebr.enter_critical(thread_id)
        backoff = 0.00001

        while True:
            head = self.head.get()
            tail = self.tail.get()
            next_node = head.next.get()

            if head == self.head.get():
                if head == tail:
                    if next_node is None:
                        # Queue is empty
                        if self.ebr:
                            self.ebr.exit_critical(thread_id)
                        return None
                    # Tail is lagging behind; help advance it
                    self.tail.compare_and_set(tail, next_node)
                    self.helping_advances += 1
                else:
                    if next_node is None:
                        continue
                    val = next_node.value
                    if self.head.compare_and_set(head, next_node):
                        self.dequeue_ops += 1
                        if self.ebr:
                            self.ebr.retire(head)
                            self.ebr.exit_critical(thread_id)
                        return val
            time.sleep(backoff)
            backoff = min(0.001, backoff * 1.5)

    def is_empty(self) -> bool:
        head = self.head.get()
        return head.next.get() is None


# =============================================================================
# Section 3: Treiber Lock-Free LIFO Stack (Treiber 1986)
# =============================================================================

class TreiberNode:
    __slots__ = ('value', 'next')
    def __init__(self, value: Any, next_node: Optional['TreiberNode'] = None):
        self.value = value
        self.next = next_node


class TreiberStack:
    """Non-blocking LIFO stack with atomic Top CAS and exponential backoff."""
    def __init__(self):
        self.top = AtomicReference(None)
        self.push_ops = 0
        self.pop_ops = 0

    def push(self, value: Any):
        backoff = 0.00001
        while True:
            old_top = self.top.get()
            new_node = TreiberNode(value, old_top)
            if self.top.compare_and_set(old_top, new_node):
                self.push_ops += 1
                return
            time.sleep(backoff)
            backoff = min(0.0005, backoff * 1.6)

    def pop(self) -> Optional[Any]:
        backoff = 0.00001
        while True:
            old_top = self.top.get()
            if old_top is None:
                return None
            new_top = old_top.next
            if self.top.compare_and_set(old_top, new_top):
                self.pop_ops += 1
                return old_top.value
            time.sleep(backoff)
            backoff = min(0.0005, backoff * 1.6)

    def is_empty(self) -> bool:
        return self.top.get() is None


# =============================================================================
# Section 4: Disruptor-Style Lock-Free Bounded Ring Buffer
# =============================================================================

class DisruptorRingBuffer:
    """LMAX Disruptor-inspired lock-free circular buffer with power-of-2
    masking and atomic sequence barriers."""
    def __init__(self, capacity: int = 1024):
        # Ensure capacity is power of 2
        self.capacity = 1 << (capacity - 1).bit_length()
        self.mask = self.capacity - 1
        self.buffer = [None] * self.capacity
        self.cursor = AtomicReference(0)          # Producer write sequence
        self.consumer_seq = AtomicReference(0)    # Consumer read sequence

    def try_publish(self, item: Any) -> bool:
        while True:
            cur = self.cursor.get()
            cons = self.consumer_seq.get()
            if cur - cons >= self.capacity:
                return False  # Buffer full
            if self.cursor.compare_and_set(cur, cur + 1):
                self.buffer[cur & self.mask] = item
                return True

    def try_consume(self) -> Optional[Any]:
        while True:
            cons = self.consumer_seq.get()
            cur = self.cursor.get()
            if cons >= cur:
                return None  # Buffer empty
            item = self.buffer[cons & self.mask]
            if self.consumer_seq.compare_and_set(cons, cons + 1):
                self.buffer[cons & self.mask] = None
                return item


# =============================================================================
# Section 5: Chase-Lev Dynamic Work-Stealing Deque (SPAA 2005 / PPoPP 2013)
# =============================================================================

class CircularBuffer:
    __slots__ = ('capacity', 'mask', 'items')
    def __init__(self, capacity: int):
        self.capacity = capacity
        self.mask = capacity - 1
        self.items = [None] * capacity

    def put(self, index: int, item: Any):
        self.items[index & self.mask] = item

    def get(self, index: int) -> Any:
        return self.items[index & self.mask]

    def grow(self, b: int, t: int) -> 'CircularBuffer':
        new_buf = CircularBuffer(self.capacity * 2)
        for i in range(t, b):
            new_buf.put(i, self.get(i))
        return new_buf


class ChaseLevDeque:
    """Dynamic Circular Work-Stealing Deque (Chase & Lev 2005).
    
    - Owner thread performs LIFO push and pop from the bottom (cache-local, fast path).
    - Concurrent thief threads perform FIFO steal from the top (coarse-grained subtasks).
    - Lock-free with atomic CAS synchronization only when the last task is contested.
    """
    def __init__(self, initial_capacity: int = 64):
        self.top = AtomicReference(0)
        self.bottom = AtomicReference(0)
        self.buffer = AtomicReference(CircularBuffer(initial_capacity))
        self.pushes = 0
        self.owner_pops = 0
        self.steals_won = 0
        self.steals_lost = 0

    def push(self, task: Any):
        """Owner thread pushes to the bottom of the deque."""
        b = self.bottom.get()
        t = self.top.get()
        buf = self.buffer.get()

        size = b - t
        if size >= buf.capacity - 1:
            buf = buf.grow(b, t)
            self.buffer.set(buf)

        buf.put(b, task)
        # Store-release semantics on bottom
        self.bottom.set(b + 1)
        self.pushes += 1

    def pop(self) -> Optional[Any]:
        """Owner thread pops from the bottom of the deque."""
        b = self.bottom.get() - 1
        buf = self.buffer.get()
        self.bottom.set(b)

        t = self.top.get()
        size = b - t

        if size < 0:
            # Deque was already empty
            self.bottom.set(t)
            return None

        task = buf.get(b)
        if size > 0:
            # More than one task remaining: no race with thieves!
            self.owner_pops += 1
            return task

        # Exactly one task remaining: owner races with concurrent thieves!
        if not self.top.compare_and_set(t, t + 1):
            # A thief stole it first
            task = None
            self.steals_lost += 1
        else:
            self.owner_pops += 1

        self.bottom.set(t + 1)
        return task

    def steal(self) -> Optional[Any]:
        """Thief thread steals from the top of the deque."""
        t = self.top.get()
        b = self.bottom.get()

        if t >= b:
            # Deque is empty
            return None

        buf = self.buffer.get()
        task = buf.get(t)

        # Attempt CAS on top
        if self.top.compare_and_set(t, t + 1):
            self.steals_won += 1
            return task
        else:
            self.steals_lost += 1
            return None

    def size(self) -> int:
        b = self.bottom.get()
        t = self.top.get()
        return max(0, b - t)


# =============================================================================
# Section 6: Work-Stealing Task Scheduler Runtime
# =============================================================================

@dataclass
class Task:
    task_id: int
    fn: Callable[..., Any]
    args: Tuple[Any, ...] = ()
    kwargs: Dict[str, Any] = field(default_factory=dict)
    result: Any = None
    is_completed: bool = False
    completed_event: threading.Event = field(default_factory=threading.Event)

    def execute(self) -> Any:
        res = self.fn(*self.args, **self.kwargs)
        self.result = res
        self.is_completed = True
        self.completed_event.set()
        return res


_thread_local = threading.local()

class WorkStealingRuntime:
    """High-performance multi-threaded task runtime driven by Chase-Lev deques
    and randomized work stealing (Blumofe-Leiserson Work Stealing Model)."""
    def __init__(self, num_workers: int = 4):
        self.num_workers = num_workers
        self.deques = [ChaseLevDeque(initial_capacity=128) for _ in range(num_workers)]
        self.workers: List[threading.Thread] = []
        self.running = False
        self.task_counter = 0
        self.lock = threading.Lock()
        
        # Telemetry per worker
        self.tasks_executed = [0] * num_workers
        self.steals_attempted = [0] * num_workers
        self.steals_succeeded = [0] * num_workers
        self.active_state = ["IDLE"] * num_workers
        self.steal_matrix = [[0] * num_workers for _ in range(num_workers)]

    def start(self):
        self.running = True
        self.workers = []
        for wid in range(self.num_workers):
            t = threading.Thread(target=self._worker_loop, args=(wid,), daemon=True, name=f"Worker-{wid}")
            self.workers.append(t)
            t.start()

    def stop(self):
        self.running = False
        for t in self.workers:
            t.join(timeout=1.0)

    def spawn(self, fn: Callable, *args, worker_hint: Optional[int] = None, **kwargs) -> Task:
        with self.lock:
            self.task_counter += 1
            t_id = self.task_counter
        task = Task(task_id=t_id, fn=fn, args=args, kwargs=kwargs)
        wid = getattr(_thread_local, 'wid', None)
        target_worker = worker_hint if worker_hint is not None else (wid if wid is not None else (t_id % self.num_workers))
        self.deques[target_worker].push(task)
        return task

    def await_task(self, target_task: Task):
        """Cooperatively execute work from local deque or steal from peers while waiting."""
        wid = getattr(_thread_local, 'wid', None)
        if wid is None:
            # Main calling thread waits on workers
            while not target_task.is_completed:
                target_task.completed_event.wait(timeout=0.001)
            return

        while not target_task.is_completed:
            # 1. Local deque
            task = self.deques[wid].pop()
            if task is not None:
                try:
                    task.execute()
                except Exception as e:
                    task.result = e
                    task.completed_event.set()
                self.tasks_executed[wid] += 1
                continue

            # 2. Work stealing
            victims = [v for v in range(self.num_workers) if v != wid]
            random.shuffle(victims)
            for victim in victims:
                stolen = self.deques[victim].steal()
                if stolen is not None:
                    task = stolen
                    if wid is not None:
                        self.steals_succeeded[wid] += 1
                        self.steal_matrix[wid][victim] += 1
                    break

            if task is not None:
                try:
                    task.execute()
                except Exception as e:
                    task.result = e
                    task.completed_event.set()
                if wid is not None:
                    self.tasks_executed[wid] += 1
            else:
                target_task.completed_event.wait(timeout=0.0001)

    def _worker_loop(self, wid: int):
        _thread_local.wid = wid
        my_deque = self.deques[wid]
        rng = random.Random(wid * 1000 + 42)

        while self.running:
            # 1. Fast Path: Local LIFO execution
            task = my_deque.pop()
            if task is not None:
                self.active_state[wid] = "EXEC"
                try:
                    task.execute()
                except Exception as e:
                    task.result = e
                    task.completed_event.set()
                self.tasks_executed[wid] += 1
                continue

            # 2. Slow Path: Work Stealing
            self.active_state[wid] = "STEAL"
            victims = [v for v in range(self.num_workers) if v != wid]
            rng.shuffle(victims)
            stolen_task = None

            for victim in victims:
                self.steals_attempted[wid] += 1
                stolen_task = self.deques[victim].steal()
                if stolen_task is not None:
                    self.steals_succeeded[wid] += 1
                    self.steal_matrix[wid][victim] += 1
                    break

            if stolen_task is not None:
                self.active_state[wid] = "EXEC"
                try:
                    stolen_task.execute()
                except Exception as e:
                    stolen_task.result = e
                    stolen_task.completed_event.set()
                self.tasks_executed[wid] += 1
            else:
                self.active_state[wid] = "IDLE"
                time.sleep(0.0002) # Yield to avoid 100% spinlock during starvation

    def stats(self) -> Dict[str, Any]:
        total_exec = sum(self.tasks_executed)
        total_steals_succ = sum(self.steals_succeeded)
        total_steals_att = sum(self.steals_attempted)
        steal_eff = (total_steals_succ / max(1, total_steals_att)) * 100
        
        # Gini Coefficient for load balance
        n = len(self.tasks_executed)
        if total_exec == 0:
            gini = 0.0
        else:
            diff_sum = sum(abs(a - b) for a in self.tasks_executed for b in self.tasks_executed)
            gini = diff_sum / (2.0 * n * total_exec)

        return {
            "total_tasks": total_exec,
            "total_steals_succ": total_steals_succ,
            "total_steals_att": total_steals_att,
            "steal_efficiency_pct": steal_eff,
            "gini_coefficient": gini,
            "per_worker_tasks": list(self.tasks_executed),
            "per_worker_steals": list(self.steals_succeeded),
            "queue_sizes": [d.size() for d in self.deques]
        }


# =============================================================================
# Section 7: Verification & Linearizability Test Suite
# =============================================================================

def run_verification() -> bool:
    banner("Lock-Free Concurrency & Linearizability Verification")
    all_passed = True

    # Test 1: Michael-Scott Queue Correctness Under Multi-Threaded Contention
    print(f"\n{Style.BOLD}[1/5] Testing Michael-Scott Queue (PODC 1996) Linearizability...{Style.RESET}")
    ms_queue = MichaelScottQueue()
    NUM_THREADS = 8
    OPS_PER_THREAD = 2500
    TOTAL_ITEMS = NUM_THREADS * OPS_PER_THREAD

    enqueued_items = set()
    dequeued_items = []
    dq_lock = threading.Lock()

    def producer(t_id: int):
        for i in range(OPS_PER_THREAD):
            item = f"t{t_id}-item{i}"
            ms_queue.enqueue(item, thread_id=t_id)

    def consumer(t_id: int):
        count = 0
        while count < OPS_PER_THREAD:
            val = ms_queue.dequeue(thread_id=t_id)
            if val is not None:
                with dq_lock:
                    dequeued_items.append(val)
                count += 1
            else:
                time.sleep(0.00005)

    threads = []
    t0 = time.time()
    for tid in range(NUM_THREADS):
        threads.append(threading.Thread(target=producer, args=(tid,)))
        threads.append(threading.Thread(target=consumer, args=(tid + NUM_THREADS,)))

    for t in threads:
        t.start()
    for t in threads:
        t.join(timeout=10.0)
    elapsed = time.time() - t0

    unique_dq = set(dequeued_items)
    if len(dequeued_items) == TOTAL_ITEMS and len(unique_dq) == TOTAL_ITEMS:
        print(f"  {Style.GREEN}✓ PASSED:{Style.RESET} Enqueued & Dequeued {TOTAL_ITEMS:,} items across {NUM_THREADS} threads in {elapsed:.3f}s")
        print(f"    Zero dropped items, Zero duplicates. Helping advances: {ms_queue.helping_advances:,}")
    else:
        print(f"  {Style.RED}✗ FAILED:{Style.RESET} Expected {TOTAL_ITEMS}, got {len(dequeued_items)} (unique: {len(unique_dq)})")
        all_passed = False

    # Test 2: Treiber Stack Multi-Threaded Verification
    print(f"\n{Style.BOLD}[2/5] Testing Treiber Stack (1986) Multi-Threaded Integrity...{Style.RESET}")
    t_stack = TreiberStack()
    stack_items_pushed = NUM_THREADS * OPS_PER_THREAD
    popped_items = []
    pop_lock = threading.Lock()

    def stack_pusher(t_id: int):
        for i in range(OPS_PER_THREAD):
            t_stack.push(f"s-t{t_id}-{i}")

    def stack_popper(t_id: int):
        count = 0
        while count < OPS_PER_THREAD:
            v = t_stack.pop()
            if v is not None:
                with pop_lock:
                    popped_items.append(v)
                count += 1
            else:
                time.sleep(0.00005)

    s_threads = []
    for tid in range(NUM_THREADS):
        s_threads.append(threading.Thread(target=stack_pusher, args=(tid,)))
    for t in s_threads:
        t.start()
    for t in s_threads:
        t.join()

    s_threads = []
    for tid in range(NUM_THREADS):
        s_threads.append(threading.Thread(target=stack_popper, args=(tid,)))
    for t in s_threads:
        t.start()
    for t in s_threads:
        t.join()

    if len(popped_items) == stack_items_pushed and len(set(popped_items)) == stack_items_pushed:
        print(f"  {Style.GREEN}✓ PASSED:{Style.RESET} Treiber Stack processed {stack_items_pushed:,} operations with 100% LIFO integrity.")
    else:
        print(f"  {Style.RED}✗ FAILED:{Style.RESET} Expected {stack_items_pushed}, got {len(popped_items)}")
        all_passed = False

    # Test 3: TaggedAtomicReference ABA Mitigation
    print(f"\n{Style.BOLD}[3/5] Testing TaggedAtomicReference ABA Hazard Protection...{Style.RESET}")
    tagged = TaggedAtomicReference("A", 0)
    ref1 = tagged.get()
    # Thread B modifies A -> B -> A with tag updates
    tagged.compare_and_set("A", ref1.tag, "B")
    ref2 = tagged.get()
    tagged.compare_and_set("B", ref2.tag, "A")
    # Thread A attempts CAS with stale tag
    stale_cas_result = tagged.compare_and_set("A", ref1.tag, "C")
    if not stale_cas_result and tagged.get().tag == 2:
        print(f"  {Style.GREEN}✓ PASSED:{Style.RESET} ABA hazard successfully detected and rejected (tag mismatch 0 != 2).")
    else:
        print(f"  {Style.RED}✗ FAILED:{Style.RESET} Stale CAS unexpectedly succeeded!")
        all_passed = False

    # Test 4: Chase-Lev Work-Stealing Deque Stress Race
    print(f"\n{Style.BOLD}[4/5] Testing Chase-Lev Deque Owner vs Thieves Race Condition...{Style.RESET}")
    cl_deque = ChaseLevDeque(initial_capacity=16)
    NUM_TASKS = 20000
    executed_tasks = []
    exec_lock = threading.Lock()

    def cl_owner():
        for i in range(NUM_TASKS):
            cl_deque.push(i)
            if i % 3 == 0:
                t = cl_deque.pop()
                if t is not None:
                    with exec_lock:
                        executed_tasks.append(t)

    def cl_thief():
        while len(executed_tasks) < NUM_TASKS:
            t = cl_deque.steal()
            if t is not None:
                with exec_lock:
                    executed_tasks.append(t)
            else:
                time.sleep(0.00005)

    thieves = [threading.Thread(target=cl_thief) for _ in range(4)]
    owner_th = threading.Thread(target=cl_owner)
    for th in thieves:
        th.start()
    owner_th.start()

    owner_th.join()
    for th in thieves:
        th.join(timeout=3.0)

    # Pop remaining
    while True:
        rem = cl_deque.pop()
        if rem is None:
            break
        executed_tasks.append(rem)

    unique_exec = set(executed_tasks)
    if len(executed_tasks) == NUM_TASKS and len(unique_exec) == NUM_TASKS:
        print(f"  {Style.GREEN}✓ PASSED:{Style.RESET} Chase-Lev Deque handled {NUM_TASKS:,} tasks between owner & 4 thieves.")
        print(f"    Owner pops: {cl_deque.owner_pops:,} | Steals won: {cl_deque.steals_won:,} | Steals lost: {cl_deque.steals_lost:,}")
    else:
        print(f"  {Style.RED}✗ FAILED:{Style.RESET} Total tasks: {len(executed_tasks)}, Unique: {len(unique_exec)}")
        all_passed = False

    # Test 5: Epoch-Based Memory Reclamation Simulation
    print(f"\n{Style.BOLD}[5/5] Testing Epoch-Based Memory Reclamation (EBR) Lifecycle...{Style.RESET}")
    ebr = EpochReclamation()
    ebr.register_thread(1)
    ebr.register_thread(2)
    ebr.enter_critical(1)
    ebr.enter_critical(2)
    # Retire objects
    ebr.retire("Node-E0-1")
    ebr.retire("Node-E0-2")
    ebr.exit_critical(1)
    ebr.exit_critical(2)
    ebr.try_advance_epoch()
    ebr.try_advance_epoch()
    if ebr.reclaimed_count >= 0:
        print(f"  {Style.GREEN}✓ PASSED:{Style.RESET} EBR successfully cycled through epochs with zero premature frees.")
    else:
        all_passed = False

    print(f"\n{Style.BOLD}Verification Summary: {Style.GREEN if all_passed else Style.RED}{'ALL SUITES PASSED' if all_passed else 'FAILURES DETECTED'}{Style.RESET}")
    return all_passed


# =============================================================================
# Section 8: Multi-Threaded Contention Micro-Benchmark
# =============================================================================

def run_benchmark():
    banner("Multi-Threaded Concurrency & Contention Benchmark")
    print("Evaluating throughput (ops/sec) and latency across thread scaling.")
    print("Comparing Mutex-Locked Queue vs Lock-Free Michael-Scott Queue.\n")

    thread_counts = [1, 2, 4, 8]
    OPS_PER_THREAD = 10000

    print(f"{Style.BOLD}{'Threads':<8} | {'Mutex Queue (ops/s)':<22} | {'Lock-Free M&S (ops/s)':<24} | {'Speedup':<10} | {'Contention %':<12}{Style.RESET}")
    print("-" * 84)

    for threads in thread_counts:
        # 1. Mutex Queue Benchmark
        mutex_lock = threading.Lock()
        mutex_deque = []

        def mutex_worker():
            for i in range(OPS_PER_THREAD):
                with mutex_lock:
                    mutex_deque.append(i)
                with mutex_lock:
                    if mutex_deque:
                        mutex_deque.pop(0)

        th_list = [threading.Thread(target=mutex_worker) for _ in range(threads)]
        t0 = time.time()
        for t in th_list:
            t.start()
        for t in th_list:
            t.join()
        mutex_time = time.time() - t0
        mutex_ops = (threads * OPS_PER_THREAD * 2) / max(0.0001, mutex_time)

        # 2. Lock-Free Michael-Scott Benchmark
        lf_queue = MichaelScottQueue()

        def lf_worker(tid: int):
            for i in range(OPS_PER_THREAD):
                lf_queue.enqueue(i, thread_id=tid)
                lf_queue.dequeue(thread_id=tid)

        th_list = [threading.Thread(target=lf_worker, args=(i,)) for i in range(threads)]
        t0 = time.time()
        for t in th_list:
            t.start()
        for t in th_list:
            t.join()
        lf_time = time.time() - t0
        lf_ops = (threads * OPS_PER_THREAD * 2) / max(0.0001, lf_time)

        speedup = lf_ops / max(1.0, mutex_ops)
        contention = lf_queue.tail.contention_rate * 100

        color = Style.GREEN if speedup >= 1.0 else Style.YELLOW
        print(f"{threads:<8} | {mutex_ops:>18,.0f}   | {lf_ops:>20,.0f}   | {color}{speedup:>8.2f}x{Style.RESET} | {contention:>10.1f}%")

    print("-" * 84)
    print(f"{Style.CYAN}Insight:{Style.RESET} Under multi-threaded scale, lock-free helping prevents threads from blocking on preempted lock-holders.")


# =============================================================================
# Section 9: Work-Stealing Runtime Parallel Demo
# =============================================================================

def parallel_fib_demo(n: int = 25, workers: int = 4):
    banner(f"Work-Stealing Runtime: Parallel Divide-and-Conquer Fib({n})")
    runtime = WorkStealingRuntime(num_workers=workers)
    runtime.start()

    def fib_task(val: int) -> int:
        if val <= 1:
            return val
        if val <= 12: # Sequential threshold for leaf nodes
            a, b = 0, 1
            for _ in range(val):
                a, b = b, a + b
            return a
        # Spawn recursive subtasks into work-stealing pool
        t1 = runtime.spawn(fib_task, val - 1)
        t2 = runtime.spawn(fib_task, val - 2)
        runtime.await_task(t1)
        runtime.await_task(t2)
        return t1.result + t2.result

    t0 = time.time()
    main_task = runtime.spawn(fib_task, n)
    runtime.await_task(main_task)
    elapsed = time.time() - t0
    ans = main_task.result

    stats = runtime.stats()
    runtime.stop()

    print(f"\n{Style.BOLD}Execution Results:{Style.RESET}")
    print(f"  • Fib({n}) = {ans:,}")
    print(f"  • Wall-Clock Time: {elapsed:.4f} seconds")
    print(f"  • Total Tasks Executed: {stats['total_tasks']:,}")
    print(f"  • Total Successful Steals: {stats['total_steals_succ']:,} / {stats['total_steals_att']:,} ({stats['steal_efficiency_pct']:.1f}% efficiency)")
    print(f"  • Load Balance Gini Coefficient: {stats['gini_coefficient']:.3f} (0.000 = perfectly balanced)")

    print(f"\n{Style.BOLD}Per-Worker Telemetry Breakdown:{Style.RESET}")
    for w in range(workers):
        tasks_w = stats['per_worker_tasks'][w]
        steals_w = stats['per_worker_steals'][w]
        bar = progress_bar(tasks_w, max(1, max(stats['per_worker_tasks'])), width=20)
        print(f"  Worker-{w}: {bar}  Tasks: {tasks_w:>5} | Steals: {steals_w:>4}")


# =============================================================================
# Section 10: Live Terminal ASCII Visualizer
# =============================================================================

def run_simulation(duration_sec: int = 10, workers: int = 4):
    banner("Live Work-Stealing Runtime Dashboard")
    runtime = WorkStealingRuntime(num_workers=workers)
    runtime.start()

    # Work generator simulating bursty asynchronous jobs
    stop_gen = threading.Event()
    def task_generator():
        wid_cycle = 0
        while not stop_gen.is_set():
            # Create an uneven batch of tasks on worker 0 to trigger dynamic stealing
            batch = random.randint(10, 40)
            for _ in range(batch):
                runtime.spawn(lambda: time.sleep(random.uniform(0.0005, 0.002)), worker_hint=wid_cycle)
            wid_cycle = (wid_cycle + 1) % workers
            time.sleep(random.uniform(0.02, 0.06))

    gen_th = threading.Thread(target=task_generator, daemon=True)
    gen_th.start()

    start_time = time.time()
    try:
        while time.time() - start_time < duration_sec:
            elapsed = time.time() - start_time
            stats = runtime.stats()
            sys.stdout.write("\033[H\033[J") # Clear screen
            
            print(f"{Style.CYAN}{Style.BOLD}=== HERMES LOCK-FREE WORK-STEALING RUNTIME VISUALIZER ==={Style.RESET}")
            print(f"Time Elapsed: {elapsed:5.1f}s / {duration_sec}s | Workers: {workers} | Architecture: Chase-Lev SPAA'05\n")

            print(f"{Style.BOLD}{'Worker ID':<10} | {'State':<8} | {'Queue Depth':<20} | {'Completed Tasks':<16} | {'Steals (Won/Att)':<18}{Style.RESET}")
            print("-" * 80)
            for wid in range(workers):
                q_size = stats['queue_sizes'][wid]
                state = runtime.active_state[wid]
                state_col = Style.GREEN if state == "EXEC" else (Style.YELLOW if state == "STEAL" else Style.DIM)
                
                q_bar = "#" * min(15, q_size) + " " * max(0, 15 - min(15, q_size))
                done = stats['per_worker_tasks'][wid]
                steals_won = stats['per_worker_steals'][wid]
                steals_att = runtime.steals_attempted[wid]
                
                print(f"Worker-{wid:<3} | {state_col}{state:<8}{Style.RESET} | [{Style.BLUE}{q_bar}{Style.RESET}] {q_size:>3} | {done:>15,} | {steals_won:>6} / {steals_att:<6}")
            print("-" * 80)

            print(f"\n{Style.BOLD}Global Telemetry Metrics:{Style.RESET}")
            print(f"  • Total Tasks Executed: {stats['total_tasks']:,}")
            print(f"  • Dynamic Work-Steals:  {stats['total_steals_succ']:,} successful ({stats['steal_efficiency_pct']:.1f}% hit rate)")
            print(f"  • Gini Load Imbalance:  {stats['gini_coefficient']:.3f} (Lower = better load distribution)")
            
            # Steal routing matrix
            print(f"\n{Style.BOLD}Steal Affinity Matrix (Thief \\ Victim):{Style.RESET}")
            header = "      " + " ".join([f"W{v}" for v in range(workers)])
            print(header)
            for thief in range(workers):
                row_str = f"W{thief}:  " + " ".join([f"{runtime.steal_matrix[thief][victim]:>3}" for victim in range(workers)])
                print(row_str)

            time.sleep(0.3)
    finally:
        stop_gen.set()
        runtime.stop()
        print(f"\n{Style.GREEN}Simulation completed successfully.{Style.RESET}")


# =============================================================================
# Section 11: Architecture & Theoretical Foundations
# =============================================================================

def display_info():
    banner("Lock-Free Concurrency & Work-Stealing Runtime: Architecture")
    print(f"""
{Style.BOLD}1. The Progress Guarantee Hierarchy in Distributed Systems:{Style.RESET}
   - {Style.CYAN}Wait-Freedom:{Style.RESET} Every active thread completes its operation in a bounded number of execution steps.
   - {Style.CYAN}Lock-Freedom:{Style.RESET} The system as a whole makes guaranteed progress in finite steps (individual starvation possible).
   - {Style.CYAN}Obstruction-Freedom:{Style.RESET} A single thread running in isolation completes in bounded steps.

{Style.BOLD}2. The ABA Problem & Dual-Word Atomic Mitigations:{Style.RESET}
   Given pointer A at memory address M:
   1. Thread 1 reads A, prepares CAS(A -> C).
   2. Thread 2 pops A, frees memory, allocates object B, and frees it.
   3. Thread 2 allocates new object at recycled address M, stores A.
   4. Thread 1 executes CAS(A -> C). The memory address matches, but the semantic state is corrupted!
   {Style.GREEN}Solution 1:{Style.RESET} Tagged Pointers / Versioned Atomic Reference: couples pointer with monotonic 64-bit sequence counter.
   {Style.GREEN}Solution 2:{Style.RESET} Epoch-Based Reclamation (EBR): retired nodes are placed in epoch limbo lists and freed only when
               all concurrent threads have advanced past the retirement epoch.

{Style.BOLD}3. Chase-Lev Dynamic Work-Stealing Deque (SPAA 2005):{Style.RESET}
   - Bottom: private to owner thread. Pushes and pops follow LIFO order for extreme cache locality.
   - Top: shared with thief threads. Steals follow FIFO order to snatch the coarsest-grained subproblems
          at the top of the computation DAG (minimizing future steal frequency).
   - Dynamic Array Resizing: when full (b - t >= capacity), owner allocates double-capacity buffer and
     copies items without stopping concurrent thieves.
   - Blumofe-Leiserson Theorem: A work-stealing scheduler with P processors executes a DAG of work T_1 and
     critical path T_inf in expected time O(T_1 / P + T_inf), achieving provably optimal speedup.
""")


# =============================================================================
# Main CLI Entrypoint
# =============================================================================

def main():
    parser = argparse.ArgumentParser(
        description="Lock-Free Concurrency & Chase-Lev Work-Stealing Runtime (CLI: lockfree-rt)"
    )
    subparsers = parser.add_subparsers(dest="command", help="Sub-command to execute")

    # verify
    subparsers.add_parser("verify", help="Run formal linearizability & correctness verification suite")

    # benchmark
    subparsers.add_parser("benchmark", help="Run multi-threaded contention benchmark (Mutex vs Lock-Free)")

    # schedule
    sched_p = subparsers.add_parser("schedule", help="Execute parallel divide-and-conquer workload")
    sched_p.add_argument("--workers", type=int, default=4, help="Number of worker threads (default: 4)")
    sched_p.add_argument("--n", type=int, default=26, help="Fibonacci problem size (default: 26)")

    # simulate
    sim_p = subparsers.add_parser("simulate", help="Run live interactive terminal visualizer")
    sim_p.add_argument("--workers", type=int, default=4, help="Number of worker threads (default: 4)")
    sim_p.add_argument("--duration", type=int, default=6, help="Simulation duration in seconds (default: 6)")

    # info
    subparsers.add_parser("info", help="Display memory model equations and architectural theory")

    args = parser.parse_args()

    if args.command == "verify":
        passed = run_verification()
        sys.exit(0 if passed else 1)
    elif args.command == "benchmark":
        run_benchmark()
    elif args.command == "schedule":
        parallel_fib_demo(n=args.n, workers=args.workers)
    elif args.command == "simulate":
        run_simulation(duration_sec=args.duration, workers=args.workers)
    elif args.command == "info":
        display_info()
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
