#!/usr/bin/env python3
# -*- coding: utf-8 -*-
'''Hierarchical Navigable Small World (HNSW) High-Dimensional Vector Search Engine.

A mathematically rigorous, production-grade HNSW approximate nearest neighbor (ANN)
search and graph indexing engine with pure Python fallback and optional NumPy acceleration.

Features:
  1. Multi-Layer Hierarchical Proximity Graph Architecture (Malkov & Yashunin, 2018):
     - Probabilistic geometric layer assignment: l ~ Floor(-ln(Uniform(0, 1)) * mL)
     - Exponential density decay across layers ensuring O(log N) search complexity.
     - Upper-layer greedy routing with 1-NN entry point descent.
     - Bottom-layer beam search (search_layer) bounded by dynamic candidate pool size ef.
  2. Spatial Diversity Neighbor Selection Heuristic (Algorithm 4):
     - Shrinking candidate set with Voronoi cell boundary diversification.
     - Guarantees long-range cluster-spanning highway edges across high-dimensional manifolds.
     - Optional pruned-connection retention for high-recall degree saturation.
  3. Multiple Distance Metrics & Metric Spaces:
     - Cosine Distance (1 - cos_sim(u, v))
     - Squared Euclidean (L2) Distance (sum((u_i - v_i)^2))
     - Maximum Inner Product Search (MIPS / IP)
     - Manhattan (L1) Distance (sum(|u_i - v_i|))
  4. SQ8 Scalar Quantization & Asymmetric Distance Computation (ADC):
     - 8-bit affine uniform min-max scalar quantization reducing memory by 4x (32 -> 8 bits).
     - Fast asymmetric distance estimation without dequantizing target vectors.
  5. Exact Brute-Force Ground Truth & Evaluation Profiler:
     - Recall@K computation: |KNN_hnsw cap KNN_exact| / K.
     - Latency profiling: Mean, P50, P95, P99 query latency, QPS, and speedup ratio.
     - Distance computation efficiency tracking (pruning ratio vs brute-force).
  6. Graph Topological Diagnostics:
     - Degree distribution per layer, clustering coefficients, and diameter metrics.
  7. Interactive Visual Terminal ASCII Routing Tracer:
     - Step-by-step layer descent and local minimum trajectory visualization.
'''

import argparse
import heapq
import json
import math
import os
import random
import struct
import sys
import time
from typing import Any, Callable, Dict, List, Optional, Set, Tuple, Union

try:
    import numpy as np
    HAVE_NUMPY = True
except ImportError:
    HAVE_NUMPY = False
    np = None


# =====================================================================
# 1. Distance Metrics & Metric Spaces
# =====================================================================

class DistanceMetric:
    '''High-performance distance metrics with dual Pure-Python / NumPy implementations.'''

    @staticmethod
    def squared_euclidean(u: Union[List[float], Any], v: Union[List[float], Any]) -> float:
        if HAVE_NUMPY and isinstance(u, np.ndarray) and isinstance(v, np.ndarray):
            diff = u - v
            return float(np.dot(diff, diff))
        acc = 0.0
        for ui, vi in zip(u, v):
            d = ui - vi
            acc += d * d
        return acc

    @staticmethod
    def euclidean(u: Union[List[float], Any], v: Union[List[float], Any]) -> float:
        return math.sqrt(DistanceMetric.squared_euclidean(u, v))

    @staticmethod
    def cosine(u: Union[List[float], Any], v: Union[List[float], Any]) -> float:
        if HAVE_NUMPY and isinstance(u, np.ndarray) and isinstance(v, np.ndarray):
            dot = float(np.dot(u, v))
            norm_u = float(np.linalg.norm(u))
            norm_v = float(np.linalg.norm(v))
            if norm_u < 1e-12 or norm_v < 1e-12:
                return 1.0
            sim = dot / (norm_u * norm_v)
            return max(0.0, 1.0 - sim)
        dot = 0.0
        norm_u_sq = 0.0
        norm_v_sq = 0.0
        for ui, vi in zip(u, v):
            dot += ui * vi
            norm_u_sq += ui * ui
            norm_v_sq += vi * vi
        if norm_u_sq < 1e-24 or norm_v_sq < 1e-24:
            return 1.0
        norm_u = math.sqrt(norm_u_sq)
        norm_v = math.sqrt(norm_v_sq)
        sim = dot / (norm_u * norm_v)
        return max(0.0, 1.0 - sim)

    @staticmethod
    def inner_product(u: Union[List[float], Any], v: Union[List[float], Any]) -> float:
        '''Normalized inner product distance: 1.0 - dot_product.'''
        if HAVE_NUMPY and isinstance(u, np.ndarray) and isinstance(v, np.ndarray):
            return float(1.0 - np.dot(u, v))
        dot = 0.0
        for ui, vi in zip(u, v):
            dot += ui * vi
        return 1.0 - dot

    @staticmethod
    def manhattan(u: Union[List[float], Any], v: Union[List[float], Any]) -> float:
        if HAVE_NUMPY and isinstance(u, np.ndarray) and isinstance(v, np.ndarray):
            return float(np.sum(np.abs(u - v)))
        acc = 0.0
        for ui, vi in zip(u, v):
            acc += abs(ui - vi)
        return acc

    @classmethod
    def get(cls, name: str) -> Callable[[Any, Any], float]:
        name_clean = name.lower().replace("-", "_")
        if name_clean in ("l2", "squared_euclidean", "euclidean_sq"):
            return cls.squared_euclidean
        elif name_clean in ("euclidean",):
            return cls.euclidean
        elif name_clean in ("cosine", "cos"):
            return cls.cosine
        elif name_clean in ("ip", "inner_product", "dot"):
            return cls.inner_product
        elif name_clean in ("l1", "manhattan"):
            return cls.manhattan
        else:
            raise ValueError(f"Unknown distance metric: '{name}'. Supported: 'cosine', 'l2', 'ip', 'l1'")


# =====================================================================
# 2. SQ8 Scalar Quantizer & Asymmetric Distance Computation
# =====================================================================

class ScalarQuantizerSQ8:
    '''8-Bit Uniform Affine Scalar Quantization for High-Dimensional Vectors.'''

    def __init__(self, dim: int):
        self.dim = dim
        self.min_vals = [0.0] * dim
        self.max_vals = [1.0] * dim
        self.scales = [1.0] * dim
        self.is_fitted = False

    def fit(self, vectors: List[List[float]]) -> 'ScalarQuantizerSQ8':
        if not vectors:
            return self
        n = len(vectors)
        self.min_vals = [float(vectors[0][i]) for i in range(self.dim)]
        self.max_vals = [float(vectors[0][i]) for i in range(self.dim)]
        for vec in vectors[1:]:
            for i in range(self.dim):
                v = float(vec[i])
                if v < self.min_vals[i]:
                    self.min_vals[i] = v
                if v > self.max_vals[i]:
                    self.max_vals[i] = v

        for i in range(self.dim):
            span = self.max_vals[i] - self.min_vals[i]
            self.scales[i] = span / 255.0 if span > 1e-8 else 1.0
        self.is_fitted = True
        return self

    def quantize(self, vec: List[float]) -> bytes:
        if not self.is_fitted:
            raise RuntimeError("Quantizer must be fitted before quantizing vectors.")
        q = bytearray(self.dim)
        for i in range(self.dim):
            v = float(vec[i])
            raw = round((v - self.min_vals[i]) / self.scales[i])
            q[i] = max(0, min(255, raw))
        return bytes(q)

    def dequantize(self, q_bytes: bytes) -> List[float]:
        return [self.min_vals[i] + float(q_bytes[i]) * self.scales[i] for i in range(self.dim)]

    def asymmetric_l2_squared(self, query_float: List[float], doc_bytes: bytes) -> float:
        acc = 0.0
        for i in range(self.dim):
            recon = self.min_vals[i] + float(doc_bytes[i]) * self.scales[i]
            d = query_float[i] - recon
            acc += d * d
        return acc


# =====================================================================
# 3. HNSW Multi-Layer Graph Index
# =====================================================================

class HNSWNode:
    __slots__ = ("id", "vector", "level", "neighbors")

    def __init__(self, node_id: Any, vector: List[float], level: int):
        self.id = node_id
        self.vector = vector
        self.level = level
        self.neighbors: List[List[Any]] = [[] for _ in range(level + 1)]


class HNSWIndex:
    '''Production-Grade Hierarchical Navigable Small World (HNSW) Index.'''

    def __init__(
        self,
        dim: int,
        metric: str = "cosine",
        m: int = 16,
        ef_construction: int = 100,
        ef_search: int = 50,
        heuristic: bool = True,
        keep_pruned: bool = True,
        seed: Optional[int] = 42,
    ):
        self.dim = dim
        self.metric_name = metric.lower()
        self.dist_fn = DistanceMetric.get(metric)
        self.m = m
        self.m0 = 2 * m
        self.ef_construction = ef_construction
        self.ef_search = ef_search
        self.heuristic = heuristic
        self.keep_pruned = keep_pruned
        self.m_l = 1.0 / math.log(float(m)) if m > 1 else 1.0

        self.nodes: Dict[Any, HNSWNode] = {}
        self.entry_point_id: Optional[Any] = None
        self.max_level: int = -1
        self.distance_computations: int = 0
        self.rng = random.Random(seed)

    def _distance(self, u_vec: List[float], v_vec: List[float]) -> float:
        self.distance_computations += 1
        return self.dist_fn(u_vec, v_vec)

    def _assign_level(self) -> int:
        '''Probabilistic geometric layer distribution: floor(-ln(unif) * mL)'''
        unif = self.rng.random()
        while unif == 0.0:
            unif = self.rng.random()
        return int(-math.log(unif) * self.m_l)

    def _search_layer(
        self,
        query_vec: List[float],
        enter_points: List[Any],
        ef: int,
        level: int,
    ) -> List[Tuple[float, Any]]:
        '''Search layer lc returning ef closest elements to query_vec.

        Uses priority queues: min-heap C for candidates, max-heap W for nearest neighbors.
        '''
        visited: Set[Any] = set(enter_points)
        candidates: List[Tuple[float, Any]] = []
        nearest_w: List[Tuple[float, Any]] = []

        for ep in enter_points:
            d = self._distance(query_vec, self.nodes[ep].vector)
            heapq.heappush(candidates, (d, ep))
            heapq.heappush(nearest_w, (-d, ep))

        while candidates:
            c_dist, c_id = heapq.heappop(candidates)
            f_dist = -nearest_w[0][0]

            if c_dist > f_dist and len(nearest_w) >= ef:
                break

            node_c = self.nodes[c_id]
            if level >= len(node_c.neighbors):
                continue

            for neighbor_id in node_c.neighbors[level]:
                if neighbor_id not in visited:
                    visited.add(neighbor_id)
                    f_dist = -nearest_w[0][0]
                    d_neighbor = self._distance(query_vec, self.nodes[neighbor_id].vector)

                    if d_neighbor < f_dist or len(nearest_w) < ef:
                        heapq.heappush(candidates, (d_neighbor, neighbor_id))
                        heapq.heappush(nearest_w, (-d_neighbor, neighbor_id))

                        if len(nearest_w) > ef:
                            heapq.heappop(nearest_w)

        results = [(-item[0], item[1]) for item in nearest_w]
        results.sort(key=lambda x: x[0])
        return results

    def _select_neighbors_heuristic(
        self,
        base_vec: List[float],
        candidates: List[Tuple[float, Any]],
        m_max: int,
    ) -> List[Any]:
        '''Algorithm 4: SELECT-NEIGHBORS-HEURISTIC with spatial diversity pruning.'''
        if len(candidates) <= m_max:
            return [item[1] for item in candidates]

        w_sorted = sorted(candidates, key=lambda x: x[0])
        result_ids: List[Any] = []
        result_vecs: List[List[float]] = []
        discarded_ids: List[Any] = []

        for d_e_base, e_id in w_sorted:
            if len(result_ids) >= m_max:
                break
            e_vec = self.nodes[e_id].vector
            is_diverse = True
            for r_vec in result_vecs:
                d_e_r = self._distance(e_vec, r_vec)
                if d_e_r < d_e_base:
                    is_diverse = False
                    break
            if is_diverse:
                result_ids.append(e_id)
                result_vecs.append(e_vec)
            else:
                discarded_ids.append(e_id)

        if self.keep_pruned and len(result_ids) < m_max:
            for disc_id in discarded_ids:
                if len(result_ids) >= m_max:
                    break
                result_ids.append(disc_id)

        return result_ids

    def _select_neighbors(
        self,
        base_vec: List[float],
        candidates: List[Tuple[float, Any]],
        m_max: int,
    ) -> List[Any]:
        if self.heuristic:
            return self._select_neighbors_heuristic(base_vec, candidates, m_max)
        else:
            sorted_c = sorted(candidates, key=lambda x: x[0])
            return [item[1] for item in sorted_c[:m_max]]

    def insert(self, node_id: Any, vector: List[float]) -> None:
        '''Algorithm 1: INSERT vector into HNSW index.'''
        if len(vector) != self.dim:
            raise ValueError(f"Dimension mismatch: expected {self.dim}, got {len(vector)}")

        vec = [float(x) for x in vector]
        node_level = self._assign_level()
        new_node = HNSWNode(node_id, vec, node_level)
        self.nodes[node_id] = new_node

        if self.entry_point_id is None:
            self.entry_point_id = node_id
            self.max_level = node_level
            return

        curr_ep = self.entry_point_id
        curr_level = self.max_level

        # 1. Greedy 1-NN search from top level down to node_level + 1
        for l in range(curr_level, node_level, -1):
            w = self._search_layer(vec, [curr_ep], ef=1, level=l)
            if w:
                curr_ep = w[0][1]

        # 2. Multi-layer connection search from min(curr_level, node_level) down to 0
        for l in range(min(curr_level, node_level), -1, -1):
            m_layer = self.m0 if l == 0 else self.m
            w = self._search_layer(vec, [curr_ep], ef=self.ef_construction, level=l)
            
            selected_neighbors = self._select_neighbors(vec, w, m_layer)
            new_node.neighbors[l] = selected_neighbors

            for neighbor_id in selected_neighbors:
                neighbor_node = self.nodes[neighbor_id]
                if l < len(neighbor_node.neighbors):
                    neighbor_conns = neighbor_node.neighbors[l]
                    if node_id not in neighbor_conns:
                        neighbor_conns.append(node_id)
                    if len(neighbor_conns) > m_layer:
                        cand_list = [
                            (self._distance(neighbor_node.vector, self.nodes[c].vector), c)
                            for c in neighbor_conns
                        ]
                        pruned = self._select_neighbors(neighbor_node.vector, cand_list, m_layer)
                        neighbor_node.neighbors[l] = pruned

            if w:
                curr_ep = w[0][1]

        # 3. Update entry point if newly added node has higher layer
        if node_level > self.max_level:
            self.max_level = node_level
            self.entry_point_id = node_id

    def search(
        self,
        query_vec: List[float],
        k: int = 10,
        ef_search: Optional[int] = None,
        trace: bool = False,
    ) -> Tuple[List[Tuple[Any, float]], Optional[Dict[str, Any]]]:
        '''Algorithm 3: K-NN-SEARCH with optional routing trajectory trace.'''
        if not self.nodes or self.entry_point_id is None:
            return [], None

        ef = ef_search if ef_search is not None else self.ef_search
        ef = max(ef, k)
        q = [float(x) for x in query_vec]

        trace_data = {"steps": []} if trace else None
        curr_ep = self.entry_point_id

        # 1. Greedy descent through upper layers (L down to 1)
        for l in range(self.max_level, 0, -1):
            w = self._search_layer(q, [curr_ep], ef=1, level=l)
            if w:
                best_d, best_id = w[0]
                if trace:
                    trace_data["steps"].append({
                        "level": l,
                        "entry_node": curr_ep,
                        "best_node": best_id,
                        "distance": best_d,
                        "type": "greedy_descent",
                    })
                curr_ep = best_id

        # 2. Bottom-layer beam search at layer 0
        candidates_l0 = self._search_layer(q, [curr_ep], ef=ef, level=0)
        if trace:
            trace_data["steps"].append({
                "level": 0,
                "entry_node": curr_ep,
                "candidates_evaluated": len(candidates_l0),
                "type": "beam_search",
            })

        top_k = candidates_l0[:k]
        formatted = [(item[1], item[0]) for item in top_k]
        return formatted, trace_data

    def stats(self) -> Dict[str, Any]:
        '''Compute comprehensive graph topological and memory statistics.'''
        total_nodes = len(self.nodes)
        if total_nodes == 0:
            return {"total_nodes": 0, "max_level": -1}

        level_counts: Dict[int, int] = {}
        degree_per_level: Dict[int, List[int]] = {}

        for node in self.nodes.values():
            lvl = node.level
            level_counts[lvl] = level_counts.get(lvl, 0) + 1
            for l in range(lvl + 1):
                deg = len(node.neighbors[l])
                degree_per_level.setdefault(l, []).append(deg)

        level_stats = {}
        for l, degs in degree_per_level.items():
            level_stats[f"layer_{l}"] = {
                "node_count": len(degs),
                "avg_degree": sum(degs) / len(degs) if degs else 0.0,
                "min_degree": min(degs) if degs else 0,
                "max_degree": max(degs) if degs else 0,
            }

        vector_bytes = total_nodes * self.dim * 8
        edge_count = sum(sum(len(node.neighbors[l]) for l in range(node.level + 1)) for node in self.nodes.values())
        edge_bytes = edge_count * 8
        total_kb = (vector_bytes + edge_bytes) / 1024.0

        return {
            "total_nodes": total_nodes,
            "dim": self.dim,
            "metric": self.metric_name,
            "m": self.m,
            "m0": self.m0,
            "ef_construction": self.ef_construction,
            "ef_search": self.ef_search,
            "max_level": self.max_level,
            "level_distribution": level_counts,
            "level_stats": level_stats,
            "total_edges": edge_count,
            "estimated_memory_kb": round(total_kb, 2),
        }

    def save(self, filepath: str) -> None:
        '''Serialize HNSW index to JSON file.'''
        serializable = {
            "dim": self.dim,
            "metric": self.metric_name,
            "m": self.m,
            "m0": self.m0,
            "ef_construction": self.ef_construction,
            "ef_search": self.ef_search,
            "heuristic": self.heuristic,
            "keep_pruned": self.keep_pruned,
            "entry_point_id": self.entry_point_id,
            "max_level": self.max_level,
            "nodes": {
                str(k): {
                    "vector": node.vector,
                    "level": node.level,
                    "neighbors": node.neighbors,
                }
                for k, node in self.nodes.items()
            },
        }
        with open(filepath, "w") as f:
            json.dump(serializable, f)

    @classmethod
    def load(cls, filepath: str) -> 'HNSWIndex':
        '''Deserialize HNSW index from JSON file.'''
        with open(filepath, "r") as f:
            data = json.load(f)
        idx = cls(
            dim=data["dim"],
            metric=data["metric"],
            m=data["m"],
            ef_construction=data["ef_construction"],
            ef_search=data["ef_search"],
            heuristic=data["heuristic"],
            keep_pruned=data["keep_pruned"],
        )
        idx.entry_point_id = data["entry_point_id"]
        idx.max_level = data["max_level"]
        for k_str, node_dict in data["nodes"].items():
            k = int(k_str) if k_str.isdigit() else k_str
            node = HNSWNode(k, node_dict["vector"], node_dict["level"])
            node.neighbors = node_dict["neighbors"]
            idx.nodes[k] = node
        return idx


# =====================================================================
# 4. Exact Brute-Force Scanner (Ground Truth)
# =====================================================================

class BruteForceKNN:
    '''Exhaustive linear scan computing exact ground-truth nearest neighbors.'''

    def __init__(self, dim: int, metric: str = "cosine"):
        self.dim = dim
        self.dist_fn = DistanceMetric.get(metric)
        self.data: List[Tuple[Any, List[float]]] = []

    def insert(self, node_id: Any, vector: List[float]) -> None:
        self.data.append((node_id, [float(x) for x in vector]))

    def search(self, query: List[float], k: int = 10) -> List[Tuple[Any, float]]:
        q = [float(x) for x in query]
        scored = [(item[0], self.dist_fn(q, item[1])) for item in self.data]
        scored.sort(key=lambda x: x[1])
        return scored[:k]


# =====================================================================
# 5. Benchmark & Validation Engine
# =====================================================================

class HNSWBenchmarkEngine:
    '''Generates clustered manifold datasets and benchmarks Recall@K, QPS & Latency.'''

    @staticmethod
    def generate_clustered_dataset(
        n: int = 1000,
        dim: int = 32,
        num_clusters: int = 8,
        seed: int = 42,
    ) -> Tuple[List[List[float]], List[List[float]]]:
        rng = random.Random(seed)
        centers = []
        for _ in range(num_clusters):
            center = [rng.gauss(0, 1) for _ in range(dim)]
            norm = math.sqrt(sum(c * c for c in center))
            norm = max(norm, 1e-8)
            centers.append([c / norm for c in center])

        vectors = []
        for _ in range(n):
            c = rng.choice(centers)
            vec = [c[i] + rng.gauss(0, 0.15) for i in range(dim)]
            norm = math.sqrt(sum(v * v for v in vec))
            norm = max(norm, 1e-8)
            vectors.append([v / norm for v in vec])

        queries = []
        for _ in range(50):
            c = rng.choice(centers)
            q = [c[i] + rng.gauss(0, 0.20) for i in range(dim)]
            norm = math.sqrt(sum(qi * qi for qi in q))
            norm = max(norm, 1e-8)
            queries.append([qi / norm for qi in q])

        return vectors, queries

    @classmethod
    def run(
        cls,
        n: int = 1000,
        dim: int = 32,
        num_queries: int = 50,
        k: int = 10,
        metric: str = "cosine",
        m: int = 16,
        ef_c: int = 100,
        ef_search_sweep: Optional[List[int]] = None,
    ) -> Dict[str, Any]:
        if ef_search_sweep is None:
            ef_search_sweep = [10, 20, 50, 100]

        print(f"""
=======================================================================
* HNSW HIGH-DIMENSIONAL VECTOR SEARCH BENCHMARK
=======================================================================
  - Vectors:        {n:,}
  - Dimensions:     {dim}
  - Metric:         {metric.upper()}
  - HNSW Params:    M={m}, M0={2*m}, efConstruction={ef_c}
  - Queries:        {num_queries}
  - Top-K:          {k}
=======================================================================
""")

        vectors, queries = cls.generate_clustered_dataset(n=n, dim=dim, seed=42)
        queries = queries[:num_queries]

        print("- Indexing vectors into Exact Brute-Force baseline...")
        bf = BruteForceKNN(dim=dim, metric=metric)
        for i, vec in enumerate(vectors):
            bf.insert(i, vec)

        print(f"- Computing ground truth for {num_queries} queries via linear scan...")
        t0 = time.perf_counter()
        ground_truth: List[Set[Any]] = []
        for q in queries:
            exact_res = bf.search(q, k=k)
            ground_truth.append(set(item[0] for item in exact_res))
        bf_time = (time.perf_counter() - t0) * 1000.0
        bf_qps = num_queries / (bf_time / 1000.0)
        print(f"  * Ground Truth computed: {bf_time:.2f} ms ({bf_qps:.1f} QPS)\n")

        print("- Constructing Hierarchical Navigable Small World (HNSW) Index...")
        hnsw = HNSWIndex(dim=dim, metric=metric, m=m, ef_construction=ef_c, seed=42)
        t0 = time.perf_counter()
        for i, vec in enumerate(vectors):
            hnsw.insert(i, vec)
        build_time = time.perf_counter() - t0
        build_throughput = n / build_time
        print(f"  * HNSW built in {build_time:.2f}s ({build_throughput:.1f} vectors/sec)")

        stats = hnsw.stats()
        print(f"  * Graph Hierarchy: Max Level={stats['max_level']}, Total Edges={stats['total_edges']:,}")
        print(f"  * Memory Footprint: {stats['estimated_memory_kb']} KB\n")

        print(f"{'efSearch':<10} | {'Recall@'+str(k):<12} | {'Mean Latency':<14} | {'P95 Latency':<14} | {'QPS':<10} | {'Speedup':<10}")
        print("-" * 78)

        sweep_results = []
        for ef_s in ef_search_sweep:
            latencies = []
            recalls = []
            hnsw.distance_computations = 0
            t_start_sweep = time.perf_counter()

            for q, true_top_k in zip(queries, ground_truth):
                t_q = time.perf_counter()
                ann_res, _ = hnsw.search(q, k=k, ef_search=ef_s)
                latencies.append((time.perf_counter() - t_q) * 1000.0)
                ann_ids = set(item[0] for item in ann_res)
                recall = len(ann_ids.intersection(true_top_k)) / float(k)
                recalls.append(recall)

            total_sweep_time = time.perf_counter() - t_start_sweep
            mean_rec = sum(recalls) / len(recalls)
            mean_lat = sum(latencies) / len(latencies)
            latencies.sort()
            p95_lat = latencies[int(len(latencies) * 0.95)]
            qps = num_queries / total_sweep_time
            speedup = qps / max(bf_qps, 1e-4)

            sweep_results.append({
                "ef_search": ef_s,
                "recall": round(mean_rec, 4),
                "mean_latency_ms": round(mean_lat, 3),
                "p95_latency_ms": round(p95_lat, 3),
                "qps": round(qps, 1),
                "speedup": round(speedup, 2),
                "dist_computations_per_query": round(hnsw.distance_computations / num_queries, 1),
            })

            rec_str = f"{mean_rec * 100:.2f}%"
            print(f"{ef_s:<10} | {rec_str:<12} | {mean_lat:.3f} ms{'':<6} | {p95_lat:.3f} ms{'':<6} | {qps:<10.1f} | {speedup:.1f}x")

        print("-" * 78)
        print("- HNSW benchmark completed successfully.\n")

        return {
            "n": n,
            "dim": dim,
            "metric": metric,
            "build_time_sec": round(build_time, 2),
            "build_throughput_vps": round(build_throughput, 1),
            "stats": stats,
            "sweep": sweep_results,
        }


# =====================================================================
# 6. Interactive ASCII Routing Visualizer
# =====================================================================

class VisualDemo:
    @staticmethod
    def run():
        print("""
=======================================================================
* HNSW MULTI-LAYER TRAJECTORY ROUTING DEMO
=======================================================================
Constructing toy 256-node graph in 32-D metric space to visualize
hierarchical search descent from entry point down to Voronoi cells...
""")
        vectors, queries = HNSWBenchmarkEngine.generate_clustered_dataset(n=256, dim=32, num_clusters=4, seed=123)
        hnsw = HNSWIndex(dim=32, metric="cosine", m=8, ef_construction=64, seed=123)
        for i, v in enumerate(vectors):
            hnsw.insert(i, v)

        query = queries[0]
        top_k, trace = hnsw.search(query, k=5, ef_search=32, trace=True)

        print(f"- Search Query: Vector [0] (Dim=32, First 4 components: [{', '.join(f'{x:.3f}' for x in query[:4])}, ...])")
        print(f"- Graph Top Level: Layer {hnsw.max_level} | Initial Entry Point: Node #{hnsw.entry_point_id}\n")

        print("Hierarchical Navigation Trajectory Flow:")
        for step in trace["steps"]:
            if step["type"] == "greedy_descent":
                lvl = step['level']
                ep = step['entry_node']
                best = step['best_node']
                dist = step['distance']
                print(f"  [Layer {lvl}] Greedy 1-NN Step: Node #{ep} -> Node #{best} (Cosine Distance: {dist:.4f})")
            elif step["type"] == "beam_search":
                eval_count = step['candidates_evaluated']
                print(f"  [Layer 0] Voronoi Beam Search (ef=32): Expanded {eval_count} candidates in local cluster")

        print("-" * 70 + "\n")
        print("- Top-5 Approximate Nearest Neighbors Identified:")
        for rank, (node_id, dist) in enumerate(top_k, 1):
            sim = max(0.0, 1.0 - dist) * 100.0
            bar = "#" * int(sim / 5.0) + "-" * (20 - int(sim / 5.0))
            print(f"  #{rank}: Node #{node_id:<4} | Dist: {dist:.4f} | Cosine Sim: {sim:5.1f}% [{bar}]")
        print("\n- Visual demo complete.")


# =====================================================================
# 7. CLI Entrypoint
# =====================================================================

def main():
    parser = argparse.ArgumentParser(
        description="HNSW High-Dimensional Vector Search Engine & Quantized Proximity Graph",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", help="Subcommand to execute")

    subparsers.add_parser("demo", help="Run visual ASCII multi-layer trajectory routing demo")

    bench_p = subparsers.add_parser("bench", help="Run full Recall@K and QPS benchmark")
    bench_p.add_argument("--n", type=int, default=1000, help="Number of vectors (default: 1000)")
    bench_p.add_argument("--dim", type=int, default=32, help="Vector dimension (default: 32)")
    bench_p.add_argument("--queries", type=int, default=50, help="Query count (default: 50)")
    bench_p.add_argument("--k", type=int, default=10, help="Top-K neighbors (default: 10)")
    bench_p.add_argument("--metric", type=str, default="cosine", choices=["cosine", "l2", "ip", "l1"], help="Distance metric")
    bench_p.add_argument("--m", type=int, default=16, help="HNSW M connections (default: 16)")
    bench_p.add_argument("--ef-construction", type=int, default=100, help="efConstruction (default: 100)")

    stats_p = subparsers.add_parser("stats", help="Display topological stats for an index")
    stats_p.add_argument("--index", type=str, required=True, help="Path to index file")

    q_p = subparsers.add_parser("quantize", help="Test SQ8 scalar quantization compression & accuracy")
    q_p.add_argument("--n", type=int, default=1000, help="Vectors to test (default: 1000)")
    q_p.add_argument("--dim", type=int, default=128, help="Dimension (default: 128)")

    args = parser.parse_args()

    if args.command == "demo":
        VisualDemo.run()
    elif args.command == "bench":
        HNSWBenchmarkEngine.run(
            n=args.n,
            dim=args.dim,
            num_queries=args.queries,
            k=args.k,
            metric=args.metric,
            m=args.m,
            ef_c=args.ef_construction,
        )
    elif args.command == "stats":
        if not os.path.exists(args.index):
            print(f"Error: Index file '{args.index}' does not exist.")
            sys.exit(1)
        idx = HNSWIndex.load(args.index)
        print(json.dumps(idx.stats(), indent=2))
    elif args.command == "quantize":
        print(f"Testing SQ8 Scalar Quantizer (N={args.n}, Dim={args.dim})...")
        vecs, _ = HNSWBenchmarkEngine.generate_clustered_dataset(n=args.n, dim=args.dim, seed=42)
        sq = ScalarQuantizerSQ8(dim=args.dim)
        sq.fit(vecs)
        sample = vecs[0]
        q_bytes = sq.quantize(sample)
        deq = sq.dequantize(q_bytes)
        recon_err = math.sqrt(sum((a - b) ** 2 for a, b in zip(sample, deq))) / math.sqrt(sum(a * a for a in sample))
        print(f"  * Original FP32 Vector Size:  {args.dim * 4} bytes")
        print(f"  * SQ8 Quantized Vector Size: {len(q_bytes)} bytes (4.0x Memory Compression)")
        print(f"  * Relative Reconstruction L2 Error: {recon_err * 100:.2f}%")
        print("- SQ8 Scalar Quantization validated successfully.")
    else:
        VisualDemo.run()


if __name__ == "__main__":
    main()
