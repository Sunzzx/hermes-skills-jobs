#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""hotstuff-chained-bft: HotStuff Chained BFT Consensus Engine.

Production-grade pure-Python reference for HotStuff (Yin, Malkhi, Reiter,
Gueta, Abraham — PODC 2019 / arXiv:1803.05069):

  • Chained HotStuff with generic Quorum Certificates (QCs)
  • Three-phase pipeline folded into a single Propose/Vote round
  • 3-chain commit rule: commit b when QC(b) ← QC(b') ← QC(b'') form a chain
  • Linear O(n) authenticated message complexity via leader aggregation
  • Pacemaker: view-change / next-view with highest-QC timeout recovery
  • Safety: no two honest replicas commit conflicting blocks at same height
  • Liveness under GST with responsive leader rotation (view = height)
  • Fault models: crash, mute, Byzantine double-propose / fork attempts
  • Linearizable KV state machine on committed blocks
  • PBFT comparison ledger (O(n²) three-phase vs HotStuff O(n) pipeline)
  • CLI: selftest | simulate | compare | chaos | bench | theory | explain | status

Pure Python 3 stdlib only (no NumPy).

References:
  - Yin et al., HotStuff: BFT Consensus with Linearity and Responsiveness, PODC 2019
  - Castro & Liskov, Practical Byzantine Fault Tolerance, OSDI 1999
  - Chan, Pass, Shi, PaLa / Streamlet simplified chained BFT
  - Buterin et al., Casper FFG (2-chain finality cousin)
  - Tendermint (Kwon/Buchman) prevote/precommit round-based BFT
"""

from __future__ import annotations

import argparse
import hashlib
import json
import random
import sys
import time
from collections import defaultdict, deque
from dataclasses import dataclass
from enum import Enum, auto
from typing import Any, Dict, Iterable, List, Optional, Sequence, Set, Tuple


ENGINE_NAME = "hotstuff-chained-bft"
ENGINE_VERSION = "1.0.0"
PAPER = "Yin et al., HotStuff: BFT Consensus with Linearity and Responsiveness, PODC 2019"


def max_faults(n: int) -> int:
    """Maximum Byzantine faults for n = 3f+1."""
    return max(0, (n - 1) // 3)


def quorum_size(n: int) -> int:
    """Quorum size 2f+1 for n = 3f+1."""
    f = max_faults(n)
    return 2 * f + 1


def digest(obj: Any) -> str:
    """Stable SHA-256 hex digest of a JSON-canonical object."""
    raw = json.dumps(obj, sort_keys=True, separators=(",", ":"), default=str)
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:16]


def block_id(view: int, height: int, parent: str, cmd_digest: str) -> str:
    return digest({"v": view, "h": height, "p": parent, "c": cmd_digest})


@dataclass(frozen=True)
class Command:
    client: int
    seq: int
    op: Dict[str, Any]

    def d(self) -> str:
        return digest({"client": self.client, "seq": self.seq, "op": self.op})


@dataclass
class QC:
    """Quorum Certificate over a block (aggregated 2f+1 votes)."""

    view: int
    height: int
    block_hash: str
    voters: Tuple[int, ...] = ()

    def to_dict(self) -> Dict[str, Any]:
        return {
            "view": self.view,
            "height": self.height,
            "block_hash": self.block_hash,
            "voters": list(self.voters),
            "size": len(self.voters),
        }

    @property
    def size(self) -> int:
        return len(self.voters)


@dataclass
class Block:
    view: int
    height: int
    parent_id: str
    cmd: Optional[Command]
    justify: Optional[QC] = None
    block_hash: str = ""

    def __post_init__(self) -> None:
        cd = self.cmd.d() if self.cmd else "NOP"
        self.block_hash = block_id(self.view, self.height, self.parent_id, cd)

    def to_dict(self) -> Dict[str, Any]:
        return {
            "view": self.view,
            "height": self.height,
            "parent_id": self.parent_id,
            "cmd": None
            if self.cmd is None
            else {"client": self.cmd.client, "seq": self.cmd.seq, "op": self.cmd.op},
            "justify": None if self.justify is None else self.justify.to_dict(),
            "block_hash": self.block_hash,
        }


GENESIS_HASH = "GENESISGENESIS00"
GENESIS = Block(view=0, height=0, parent_id="", cmd=None, justify=None)
GENESIS.block_hash = GENESIS_HASH


@dataclass
class Vote:
    replica: int
    view: int
    height: int
    block_hash: str

    def to_dict(self) -> Dict[str, Any]:
        return {
            "replica": self.replica,
            "view": self.view,
            "height": self.height,
            "block_hash": self.block_hash,
        }


class MsgType(Enum):
    PROPOSE = auto()
    VOTE = auto()
    NEW_VIEW = auto()


@dataclass
class Message:
    mtype: MsgType
    sender: int
    view: int
    payload: Any
    ts: float = 0.0


class KVStateMachine:
    """Linearizable multi-op KV used as HotStuff app state."""

    def __init__(self) -> None:
        self.store: Dict[str, Any] = {}
        self.last_height: int = 0
        self.history: List[Tuple[int, str, Any]] = []

    def apply(self, height: int, op: Dict[str, Any]) -> Any:
        kind = op.get("op", "NOP")
        key = op.get("key", "")
        val = op.get("val")
        result: Any = None
        if kind == "SET":
            self.store[key] = val
            result = val
        elif kind == "GET":
            result = self.store.get(key)
        elif kind == "INCR":
            cur = int(self.store.get(key, 0) or 0)
            cur += int(val if val is not None else 1)
            self.store[key] = cur
            result = cur
        elif kind == "CAS":
            expected = op.get("expected")
            if self.store.get(key) == expected:
                self.store[key] = val
                result = True
            else:
                result = False
        elif kind == "APPEND":
            cur = str(self.store.get(key, "") or "")
            cur = cur + str(val if val is not None else "")
            self.store[key] = cur
            result = cur
        else:
            result = None
        self.last_height = height
        self.history.append((height, kind, result))
        return result

    def snapshot(self) -> Dict[str, Any]:
        return dict(self.store)


class ReplicaRole(Enum):
    HONEST = auto()
    CRASHED = auto()
    MUTE = auto()
    BYZANTINE = auto()


class HotStuffReplica:
    """Single HotStuff replica with locked QC and 3-chain commit tracking."""

    def __init__(self, rid: int, n: int, role: ReplicaRole = ReplicaRole.HONEST) -> None:
        self.id = rid
        self.n = n
        self.f = max_faults(n)
        self.q = quorum_size(n)
        self.role = role

        self.view = 1
        self.height = 0
        self.prepare_qc: QC = QC(
            view=0, height=0, block_hash=GENESIS_HASH, voters=tuple(range(self.q))
        )
        self.locked_qc: QC = self.prepare_qc
        self.commit_qc: Optional[QC] = None

        self.blocks: Dict[str, Block] = {GENESIS_HASH: GENESIS}
        self.qc_by_hash: Dict[str, QC] = {GENESIS_HASH: self.prepare_qc}
        self.committed_hashes: List[str] = [GENESIS_HASH]
        self.committed_heights: Set[int] = {0}
        self.sm = KVStateMachine()

        self.vote_pool: Dict[str, Dict[int, Vote]] = defaultdict(dict)
        self.client_results: Dict[Tuple[int, int], Any] = {}

        self.byz_forks: int = 0
        self.votes_cast: int = 0
        self.proposals_made: int = 0

    def leader_of(self, view: int) -> int:
        return view % self.n

    def is_leader(self, view: Optional[int] = None) -> bool:
        v = self.view if view is None else view
        return self.leader_of(v) == self.id and self.role != ReplicaRole.CRASHED

    def alive(self) -> bool:
        return self.role not in (ReplicaRole.CRASHED, ReplicaRole.MUTE)

    def can_vote(self) -> bool:
        return self.role in (ReplicaRole.HONEST, ReplicaRole.BYZANTINE)

    def extends(self, block: Block, qc: QC) -> bool:
        """True if block's ancestor chain includes qc.block_hash."""
        if qc.block_hash == GENESIS_HASH:
            return True
        cur = block.parent_id
        seen: Set[str] = set()
        while cur and cur not in seen:
            if cur == qc.block_hash:
                return True
            seen.add(cur)
            b = self.blocks.get(cur)
            if b is None:
                break
            cur = b.parent_id
        return block.block_hash == qc.block_hash

    def safe_node(self, block: Block) -> bool:
        """HotStuff safety: vote if extends locked_qc OR justify.view > locked.view."""
        if self.role == ReplicaRole.BYZANTINE:
            return True
        locked = self.locked_qc
        justify = block.justify
        if justify is None:
            return block.parent_id == GENESIS_HASH and locked.height == 0
        if justify.view > locked.view:
            return True
        return self.extends(block, locked)

    def on_propose(self, block: Block) -> Optional[Vote]:
        if not self.can_vote() or self.role == ReplicaRole.CRASHED:
            return None
        if block.view < self.view:
            return None
        if block.view > self.view:
            self.view = block.view

        self.blocks[block.block_hash] = block
        if block.justify is not None:
            self.qc_by_hash[block.justify.block_hash] = block.justify
            self._update_qcs(block.justify)
            self._try_commit_from(block)

        if not self.safe_node(block):
            return None

        self.height = max(self.height, block.height)
        self.votes_cast += 1
        return Vote(
            replica=self.id,
            view=block.view,
            height=block.height,
            block_hash=block.block_hash,
        )

    def _update_qcs(self, qc: QC) -> None:
        if qc.view > self.prepare_qc.view or (
            qc.view == self.prepare_qc.view and qc.height > self.prepare_qc.height
        ):
            self.prepare_qc = qc
            self.locked_qc = qc

    def _ancestor_chain(self, block_hash: str, max_len: int = 8) -> List[Block]:
        chain: List[Block] = []
        cur = block_hash
        seen: Set[str] = set()
        while cur and cur not in seen and len(chain) < max_len:
            seen.add(cur)
            b = self.blocks.get(cur)
            if b is None:
                break
            chain.append(b)
            cur = b.parent_id
        return chain

    def _try_commit_from(self, block: Block) -> None:
        """3-chain commit: commit b0 when b0←b1←b2 with consecutive views + nested QCs."""
        chain = self._ancestor_chain(block.block_hash, max_len=5)
        if len(chain) < 3:
            return
        b2, b1, b0 = chain[0], chain[1], chain[2]
        if not (b0.view + 1 == b1.view and b1.view + 1 == b2.view):
            return
        if not (b1.justify and b1.justify.block_hash == b0.block_hash):
            return
        if not (b2.justify and b2.justify.block_hash == b1.block_hash):
            return
        self._commit_block(b0)

    def _commit_block(self, block: Block) -> None:
        chain = self._ancestor_chain(block.block_hash, max_len=64)
        for b in reversed(chain):
            if b.height > block.height:
                continue
            if b.block_hash == GENESIS_HASH:
                continue
            if b.height in self.committed_heights:
                continue
            self.committed_heights.add(b.height)
            self.committed_hashes.append(b.block_hash)
            if b.cmd is not None:
                res = self.sm.apply(b.height, b.cmd.op)
                self.client_results[(b.cmd.client, b.cmd.seq)] = res
            self.commit_qc = QC(
                view=b.view,
                height=b.height,
                block_hash=b.block_hash,
                voters=tuple(range(self.q)),
            )

    def collect_vote(self, vote: Vote) -> Optional[QC]:
        if self.role == ReplicaRole.CRASHED:
            return None
        key = vote.block_hash
        self.vote_pool[key][vote.replica] = vote
        if len(self.vote_pool[key]) >= self.q:
            voters = tuple(sorted(self.vote_pool[key].keys()))
            qc = QC(
                view=vote.view,
                height=vote.height,
                block_hash=vote.block_hash,
                voters=voters,
            )
            self.qc_by_hash[vote.block_hash] = qc
            self._update_qcs(qc)
            blk = self.blocks.get(vote.block_hash)
            if blk is not None:
                self._try_commit_from(blk)
            return qc
        return None

    def make_proposal(
        self, view: int, cmd: Optional[Command], high_qc: Optional[QC] = None
    ) -> Optional[Block]:
        if not self.is_leader(view) or self.role == ReplicaRole.CRASHED:
            return None
        justify = high_qc or self.prepare_qc
        parent = justify.block_hash
        height = justify.height + 1
        if self.role == ReplicaRole.BYZANTINE and self.byz_forks < 2 and height > 1:
            parent = GENESIS_HASH
            height = 1
            self.byz_forks += 1
        block = Block(view=view, height=height, parent_id=parent, cmd=cmd, justify=justify)
        self.blocks[block.block_hash] = block
        self.proposals_made += 1
        self.view = max(self.view, view)
        self.height = max(self.height, height)
        return block

    def on_new_view(self, qc: QC) -> None:
        if qc.view >= self.prepare_qc.view:
            self._update_qcs(qc)

    def committed_store(self) -> Dict[str, Any]:
        return self.sm.snapshot()


class HotStuffCluster:
    """Discrete-event HotStuff cluster simulator."""

    def __init__(
        self,
        n: int = 4,
        seed: int = 42,
        drop_prob: float = 0.0,
        byzantine_ids: Optional[Sequence[int]] = None,
        crash_ids: Optional[Sequence[int]] = None,
    ) -> None:
        if n < 4:
            raise ValueError("HotStuff requires n >= 4 (n = 3f+1)")
        self.n = n
        self.f = max_faults(n)
        self.q = quorum_size(n)
        self.rng = random.Random(seed)
        self.drop_prob = drop_prob
        self.time = 0.0
        self.msg_count = 0
        self.dropped = 0
        self.inbox: deque = deque()
        self.client_seq = 0
        self.submitted: List[Command] = []
        self.global_view = 1
        self.high_qc: QC = QC(
            view=0, height=0, block_hash=GENESIS_HASH, voters=tuple(range(self.q))
        )
        self.latest_qc: Optional[QC] = None

        byz = set(byzantine_ids or [])
        crash = set(crash_ids or [])
        self.replicas: Dict[int, HotStuffReplica] = {}
        for i in range(n):
            if i in crash:
                role = ReplicaRole.CRASHED
            elif i in byz:
                role = ReplicaRole.BYZANTINE
            else:
                role = ReplicaRole.HONEST
            self.replicas[i] = HotStuffReplica(i, n, role=role)

    def honest_ids(self) -> List[int]:
        return [i for i, r in self.replicas.items() if r.role == ReplicaRole.HONEST]

    def leader(self, view: Optional[int] = None) -> int:
        v = self.global_view if view is None else view
        return v % self.n

    def _send(self, msg: Message, dests: Iterable[int]) -> None:
        for d in dests:
            if self.drop_prob > 0 and self.rng.random() < self.drop_prob:
                self.dropped += 1
                continue
            self.msg_count += 1
            self.inbox.append((d, msg))

    def _deliver_one(self) -> bool:
        if not self.inbox:
            return False
        dest, msg = self.inbox.popleft()
        self.time += 0.001
        r = self.replicas.get(dest)
        if r is None or r.role == ReplicaRole.CRASHED:
            return True
        if msg.mtype == MsgType.PROPOSE:
            block: Block = msg.payload
            vote = r.on_propose(block)
            if vote is not None and r.alive():
                leader = r.leader_of(block.view)
                self._send(
                    Message(MsgType.VOTE, r.id, block.view, vote, self.time),
                    [leader],
                )
        elif msg.mtype == MsgType.VOTE:
            vote = msg.payload
            if r.is_leader(vote.view) or r.id == self.leader(vote.view):
                qc = r.collect_vote(vote)
                if qc is not None:
                    self.latest_qc = qc
                    if qc.view > self.high_qc.view or (
                        qc.view == self.high_qc.view and qc.height >= self.high_qc.height
                    ):
                        self.high_qc = qc
                    for other in self.replicas.values():
                        if other.id == r.id:
                            continue
                        other.qc_by_hash[qc.block_hash] = qc
                        other._update_qcs(qc)
                        blk = other.blocks.get(qc.block_hash) or r.blocks.get(qc.block_hash)
                        if blk is not None:
                            other.blocks[blk.block_hash] = blk
                            other._try_commit_from(blk)
        elif msg.mtype == MsgType.NEW_VIEW:
            qc = msg.payload
            r.on_new_view(qc)
            if qc.view > self.high_qc.view or (
                qc.view == self.high_qc.view and qc.height >= self.high_qc.height
            ):
                self.high_qc = qc
        return True

    def drain(self, max_steps: int = 10_000) -> int:
        total = 0
        while self.inbox and total < max_steps:
            if not self._deliver_one():
                break
            total += 1
        return total

    def propose_once(self, op: Optional[Dict[str, Any]] = None, client: int = 0) -> Optional[Block]:
        view = self.global_view
        leader_id = self.leader(view)
        leader = self.replicas[leader_id]

        cmd = None
        if op is not None:
            self.client_seq += 1
            cmd = Command(client=client, seq=self.client_seq, op=op)
            self.submitted.append(cmd)

        for r in self.replicas.values():
            if r.alive() and r.role != ReplicaRole.CRASHED:
                self._send(
                    Message(MsgType.NEW_VIEW, r.id, view, r.prepare_qc, self.time),
                    [leader_id],
                )
        self.drain()

        block = leader.make_proposal(view, cmd, high_qc=self.high_qc)
        if block is None:
            self.global_view += 1
            return None

        self._send(
            Message(MsgType.PROPOSE, leader_id, view, block, self.time),
            list(range(self.n)),
        )
        self.drain()

        if self.latest_qc and self.latest_qc.block_hash == block.block_hash:
            self.high_qc = self.latest_qc
            for r in self.replicas.values():
                if block.block_hash not in r.blocks:
                    r.blocks[block.block_hash] = block
                r.qc_by_hash[self.latest_qc.block_hash] = self.latest_qc
                r._update_qcs(self.latest_qc)
                r._try_commit_from(block)

        self.global_view += 1
        return block

    def run_ops(self, ops: Sequence[Dict[str, Any]], client: int = 0) -> List[Optional[Block]]:
        blocks = []
        for op in ops:
            b = self.propose_once(op, client=client)
            blocks.append(b)
        for _ in range(3):
            self.propose_once(None, client=client)
        return blocks

    def check_agreement(self) -> Tuple[bool, str]:
        honest = self.honest_ids()
        if not honest:
            return False, "no honest replicas"
        chains = [self.replicas[i].committed_hashes for i in honest]
        m = min(len(c) for c in chains)
        if m == 0:
            return False, "empty chains"
        for idx in range(m):
            hashes = {c[idx] for c in chains}
            if len(hashes) != 1:
                return False, f"conflict at prefix index {idx}: {hashes}"
        height_map: Dict[int, Set[str]] = defaultdict(set)
        for i in honest:
            r = self.replicas[i]
            for hsh in r.committed_hashes:
                b = r.blocks.get(hsh)
                if b:
                    height_map[b.height].add(hsh)
        for h, s in height_map.items():
            if len(s) > 1:
                return False, f"conflicting commits at height {h}: {s}"
        return True, f"prefix_len={m}"

    def check_validity(self) -> Tuple[bool, str]:
        submitted_digests = {c.d() for c in self.submitted}
        for i in self.honest_ids():
            r = self.replicas[i]
            for hsh in r.committed_hashes:
                b = r.blocks.get(hsh)
                if b is None or b.cmd is None:
                    continue
                if b.cmd.d() not in submitted_digests:
                    return False, f"unsubmitted cmd committed on replica {i}"
        return True, "ok"

    def committed_ops_count(self) -> int:
        honest = self.honest_ids()
        if not honest:
            return 0
        counts = []
        for i in honest:
            r = self.replicas[i]
            n_cmd = sum(
                1
                for h in r.committed_hashes
                if h != GENESIS_HASH and r.blocks.get(h) and r.blocks[h].cmd is not None
            )
            counts.append(n_cmd)
        return min(counts) if counts else 0

    def stores_agree(self) -> bool:
        honest = self.honest_ids()
        snaps = [json.dumps(self.replicas[i].committed_store(), sort_keys=True) for i in honest]
        return len(set(snaps)) <= 1


def run_happy_path(n: int = 4, n_ops: int = 10, seed: int = 42) -> Dict[str, Any]:
    c = HotStuffCluster(n=n, seed=seed)
    ops = [{"op": "SET", "key": "x", "val": i} for i in range(n_ops)]
    ops.append({"op": "INCR", "key": "ctr", "val": 1})
    c.run_ops(ops)
    ok_a, msg_a = c.check_agreement()
    ok_v, msg_v = c.check_validity()
    stores = {str(i): c.replicas[i].committed_store() for i in c.honest_ids()}
    return {
        "scenario": "happy",
        "n": n,
        "f": c.f,
        "ops": n_ops + 1,
        "committed_ops": c.committed_ops_count(),
        "agreement": ok_a,
        "agreement_msg": msg_a,
        "validity": ok_v,
        "validity_msg": msg_v,
        "stores_agree": c.stores_agree(),
        "messages": c.msg_count,
        "dropped": c.dropped,
        "views": c.global_view,
        "high_qc": c.high_qc.to_dict(),
        "stores": stores,
    }


def run_leader_crash(n: int = 4, seed: int = 7) -> Dict[str, Any]:
    c = HotStuffCluster(n=n, seed=seed)
    c.run_ops([{"op": "SET", "key": "a", "val": 1}, {"op": "SET", "key": "a", "val": 2}])
    crash_id = c.leader(c.global_view)
    c.replicas[crash_id].role = ReplicaRole.CRASHED
    for i in range(8):
        c.propose_once({"op": "SET", "key": "b", "val": i})
    for _ in range(4):
        c.propose_once(None)
    ok_a, msg_a = c.check_agreement()
    return {
        "scenario": "leader_crash",
        "n": n,
        "crashed": crash_id,
        "committed_ops": c.committed_ops_count(),
        "agreement": ok_a,
        "agreement_msg": msg_a,
        "stores_agree": c.stores_agree(),
        "honest_b": [c.replicas[i].sm.store.get("b") for i in c.honest_ids()],
        "messages": c.msg_count,
        "views": c.global_view,
    }


def run_byzantine_fork(n: int = 4, seed: int = 11) -> Dict[str, Any]:
    byz = [0]
    c = HotStuffCluster(n=n, seed=seed, byzantine_ids=byz)
    ops = [{"op": "SET", "key": "k", "val": i} for i in range(12)]
    c.run_ops(ops)
    ok_a, msg_a = c.check_agreement()
    ok_v, msg_v = c.check_validity()
    return {
        "scenario": "byzantine_fork",
        "n": n,
        "byzantine": byz,
        "committed_ops": c.committed_ops_count(),
        "agreement": ok_a,
        "agreement_msg": msg_a,
        "validity": ok_v,
        "stores_agree": c.stores_agree(),
        "byz_forks_attempted": c.replicas[0].byz_forks,
        "messages": c.msg_count,
        "honest_k": [c.replicas[i].sm.store.get("k") for i in c.honest_ids()],
    }


def run_lossy(n: int = 4, drop: float = 0.1, seed: int = 13) -> Dict[str, Any]:
    c = HotStuffCluster(n=n, seed=seed, drop_prob=drop)
    ops = [{"op": "INCR", "key": "z", "val": 1} for _ in range(15)]
    c.run_ops(ops)
    for _ in range(6):
        c.propose_once(None)
    ok_a, msg_a = c.check_agreement()
    return {
        "scenario": "lossy",
        "n": n,
        "drop": drop,
        "committed_ops": c.committed_ops_count(),
        "agreement": ok_a,
        "agreement_msg": msg_a,
        "stores_agree": c.stores_agree(),
        "dropped": c.dropped,
        "messages": c.msg_count,
        "honest_z": [c.replicas[i].sm.store.get("z") for i in c.honest_ids()],
    }


def run_chaos(n: int = 4, drop: float = 0.05, seed: int = 99) -> Dict[str, Any]:
    byz = [n - 1]
    c = HotStuffCluster(n=n, seed=seed, drop_prob=drop, byzantine_ids=byz)
    c.run_ops([{"op": "SET", "key": "c", "val": 0}])
    crash_id = 1 if n > 2 else 0
    if crash_id in byz:
        crash_id = 0
    c.replicas[crash_id].role = ReplicaRole.CRASHED
    for i in range(10):
        c.propose_once({"op": "INCR", "key": "c", "val": 1})
    for _ in range(5):
        c.propose_once(None)
    ok_a, msg_a = c.check_agreement()
    return {
        "scenario": "chaos",
        "n": n,
        "byzantine": byz,
        "crashed": crash_id,
        "drop": drop,
        "committed_ops": c.committed_ops_count(),
        "agreement": ok_a,
        "agreement_msg": msg_a,
        "stores_agree": c.stores_agree(),
        "dropped": c.dropped,
        "messages": c.msg_count,
        "honest_c": [c.replicas[i].sm.store.get("c") for i in c.honest_ids()],
    }


def run_bench(n: int = 4, ops: int = 40, seed: int = 3) -> Dict[str, Any]:
    c = HotStuffCluster(n=n, seed=seed)
    t0 = time.perf_counter()
    for i in range(ops):
        c.propose_once({"op": "SET", "key": "bench", "val": i})
    for _ in range(3):
        c.propose_once(None)
    elapsed = time.perf_counter() - t0
    ok_a, _ = c.check_agreement()
    committed = c.committed_ops_count()
    return {
        "scenario": "bench",
        "n": n,
        "ops": ops,
        "committed_ops": committed,
        "agreement": ok_a,
        "stores_agree": c.stores_agree(),
        "messages": c.msg_count,
        "elapsed_ms": round(elapsed * 1000, 3),
        "ops_per_sec": round(ops / elapsed, 2) if elapsed > 0 else None,
        "msgs_per_op": round(c.msg_count / max(ops, 1), 2),
    }


def theory_ledger(n: int = 4, batch: int = 1) -> Dict[str, Any]:
    f = max_faults(n)
    q = quorum_size(n)
    hs_msgs = 3 * n
    pbft_msgs = 2 * n * n + n
    return {
        "paper": PAPER,
        "n": n,
        "f": f,
        "quorum_2f1": q,
        "n_equals_3f1": n == 3 * f + 1,
        "hotstuff_msgs_per_block": hs_msgs,
        "pbft_msgs_per_op": pbft_msgs,
        "linearity_ratio_pbft_over_hs": round(pbft_msgs / hs_msgs, 2),
        "commit_rule": "3-chain (commit b0 when b0←b1←b2 with consecutive views + nested QCs)",
        "safety": "locked QC + safe-node: extend locked OR higher-view justify",
        "liveness": "pacemaker advances view; honest leader after GST drives progress",
        "batch": batch,
        "authenticated_complexity": "O(n) with threshold / multi-sig aggregation at leader",
        "view_leader": "leader(view) = view mod n",
        "responsiveness": "commits at network speed after GST (no fixed Δ in happy path)",
    }


def compare_pbft(n: int = 4) -> Dict[str, Any]:
    t = theory_ledger(n)
    return {
        "n": n,
        "f": t["f"],
        "hotstuff": {
            "msgs_per_block": t["hotstuff_msgs_per_block"],
            "phases_to_commit": 3,
            "pipelined": True,
            "complexity": "O(n)",
        },
        "pbft": {
            "msgs_per_op": t["pbft_msgs_per_op"],
            "phases_to_commit": 3,
            "pipelined": False,
            "complexity": "O(n²)",
        },
        "msg_savings_factor": t["linearity_ratio_pbft_over_hs"],
        "note": "HotStuff pipelines phases across views; PBFT runs all three phases per request in one view.",
    }


def selftest(verbose: bool = True) -> int:
    checks: List[Tuple[str, bool, str]] = []

    def chk(name: str, cond: bool, detail: str = "") -> None:
        checks.append((name, bool(cond), detail))

    chk("max_faults_4", max_faults(4) == 1)
    chk("max_faults_7", max_faults(7) == 2)
    chk("quorum_4", quorum_size(4) == 3)
    chk("quorum_7", quorum_size(7) == 5)
    chk("n_3f1_4", 4 == 3 * max_faults(4) + 1)
    chk("n_3f1_7", 7 == 3 * max_faults(7) + 1)

    chk("digest_stable", digest({"a": 1}) == digest({"a": 1}))
    chk("digest_diff", digest({"a": 1}) != digest({"a": 2}))

    sm = KVStateMachine()
    sm.apply(1, {"op": "SET", "key": "a", "val": 5})
    chk("kv_set", sm.store["a"] == 5)
    chk("kv_incr", sm.apply(2, {"op": "INCR", "key": "a", "val": 3}) == 8)
    chk("kv_cas_ok", sm.apply(3, {"op": "CAS", "key": "a", "expected": 8, "val": 0}) is True)
    chk("kv_cas_fail", sm.apply(4, {"op": "CAS", "key": "a", "expected": 8, "val": 1}) is False)

    chk("genesis_hash", GENESIS.block_hash == GENESIS_HASH)
    b = Block(view=1, height=1, parent_id=GENESIS_HASH, cmd=Command(0, 1, {"op": "NOP"}), justify=None)
    chk("block_hash_len", len(b.block_hash) == 16)

    happy = run_happy_path(n=4, n_ops=8, seed=21)
    chk("happy_agreement", happy["agreement"] is True, happy.get("agreement_msg", ""))
    chk("happy_validity", happy["validity"] is True)
    chk("happy_stores", happy["stores_agree"] is True)
    chk("happy_committed", happy["committed_ops"] >= 5, str(happy["committed_ops"]))

    happy7 = run_happy_path(n=7, n_ops=5, seed=22)
    chk("happy7_agreement", happy7["agreement"] is True)
    chk("happy7_f", happy7["f"] == 2)

    crash = run_leader_crash(n=4, seed=23)
    chk("crash_agreement", crash["agreement"] is True, crash.get("agreement_msg", ""))
    chk("crash_progress", crash["committed_ops"] >= 2, str(crash["committed_ops"]))

    byz = run_byzantine_fork(n=4, seed=24)
    chk("byz_agreement", byz["agreement"] is True, byz.get("agreement_msg", ""))
    chk("byz_stores", byz["stores_agree"] is True)
    chk("byz_validity", byz["validity"] is True)

    lossy = run_lossy(n=4, drop=0.08, seed=25)
    chk("lossy_agreement", lossy["agreement"] is True, lossy.get("agreement_msg", ""))
    chk("lossy_progress", lossy["committed_ops"] >= 3, str(lossy["committed_ops"]))

    chaos = run_chaos(n=4, drop=0.05, seed=26)
    chk("chaos_agreement", chaos["agreement"] is True, chaos.get("agreement_msg", ""))

    th = theory_ledger(4)
    chk("theory_linear", th["hotstuff_msgs_per_block"] == 12)
    chk("theory_pbft_higher", th["pbft_msgs_per_op"] > th["hotstuff_msgs_per_block"])
    chk("theory_ratio", th["linearity_ratio_pbft_over_hs"] >= 2.0)

    r = HotStuffReplica(0, 4)
    parent_qc = QC(view=1, height=1, block_hash="parenthash0000001", voters=(0, 1, 2))
    pb = Block(view=1, height=1, parent_id=GENESIS_HASH, cmd=None, justify=None)
    pb.block_hash = "parenthash0000001"
    r.blocks["parenthash0000001"] = pb
    r.locked_qc = QC(view=1, height=1, block_hash="parenthash0000001", voters=(0, 1, 2))
    good = Block(view=2, height=2, parent_id="parenthash0000001", cmd=None, justify=parent_qc)
    r.blocks[good.block_hash] = good
    chk("safe_extends_locked", r.safe_node(good) is True)
    high_j = QC(view=5, height=1, block_hash=GENESIS_HASH, voters=(0, 1, 2))
    unlocked = Block(view=6, height=2, parent_id=GENESIS_HASH, cmd=None, justify=high_j)
    chk("safe_higher_view", r.safe_node(unlocked) is True)

    bench = run_bench(n=4, ops=12, seed=3)
    chk("bench_agreement", bench["agreement"] is True)
    chk("bench_msgs_linearish", bench["msgs_per_op"] < 50, str(bench["msgs_per_op"]))

    cmp_ = compare_pbft(7)
    chk("compare_hs_o_n", cmp_["hotstuff"]["complexity"] == "O(n)")
    chk("compare_pbft_o_n2", cmp_["pbft"]["complexity"] == "O(n²)")

    failed = [(n_, d) for n_, ok, d in checks if not ok]
    if verbose:
        for name, ok, detail in checks:
            mark = "OK" if ok else "FAIL"
            extra = f" — {detail}" if detail and not ok else ""
            print(f"  [{mark}] {name}{extra}")
        print(f"\nSelftest: {len(checks) - len(failed)}/{len(checks)} passed")
    if failed:
        if verbose:
            print("FAILED:", ", ".join(f[0] for f in failed))
        return 1
    if verbose:
        print("HotStuff chained BFT engine validated.")
    return 0


def cmd_simulate(args: argparse.Namespace) -> int:
    scen = args.scenario
    if scen == "happy":
        out = run_happy_path(n=args.n, n_ops=args.ops, seed=args.seed)
    elif scen == "leader_crash":
        out = run_leader_crash(n=args.n, seed=args.seed)
    elif scen == "byzantine_fork":
        out = run_byzantine_fork(n=args.n, seed=args.seed)
    elif scen == "lossy":
        out = run_lossy(n=args.n, drop=args.drop, seed=args.seed)
    else:
        print(json.dumps({"error": f"unknown scenario {scen}"}))
        return 2
    print(json.dumps(out, indent=2))
    return 0 if out.get("agreement") else 1


def cmd_chaos(args: argparse.Namespace) -> int:
    out = run_chaos(n=args.n, drop=args.drop, seed=args.seed)
    print(json.dumps(out, indent=2))
    return 0 if out.get("agreement") else 1


def cmd_bench(args: argparse.Namespace) -> int:
    out = run_bench(n=args.n, ops=args.ops, seed=args.seed)
    print(json.dumps(out, indent=2))
    return 0 if out.get("agreement") else 1


def cmd_theory(args: argparse.Namespace) -> int:
    print(json.dumps(theory_ledger(n=args.n, batch=args.batch), indent=2))
    return 0


def cmd_compare(args: argparse.Namespace) -> int:
    print(json.dumps(compare_pbft(n=args.n), indent=2))
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    th = theory_ledger(n=args.n)
    out = {
        "engine": ENGINE_NAME,
        "version": ENGINE_VERSION,
        "paper": PAPER,
        "n": args.n,
        "f": th["f"],
        "quorum": th["quorum_2f1"],
        "hotstuff_msgs_per_block": th["hotstuff_msgs_per_block"],
        "pbft_msgs_per_op": th["pbft_msgs_per_op"],
        "commit_rule": th["commit_rule"],
    }
    print(json.dumps(out, indent=2))
    return 0


def cmd_explain(_: argparse.Namespace) -> int:
    text = """
HotStuff (Yin et al., PODC 2019) is a leader-based BFT protocol with *linear*
authenticated message complexity and a pipelined three-phase commit rule.

Setup: n = 3f+1 replicas, quorum size 2f+1. Leader for view v is (v mod n).

Chained HotStuff collapses Prepare / Pre-Commit / Commit into one generic
phase. Each view the leader:

  1. Collects NEW-VIEW messages carrying the highest QC from replicas (O(n)).
  2. Proposes block b that *extends* highQC.block, embedding highQC as justify.
  3. Replicas vote if safe-node(b) holds; votes return to the leader (O(n)).
  4. Leader aggregates 2f+1 votes into QC(b). The *next* proposal carries QC(b).

3-chain commit rule
-------------------
A block b0 is committed when there exist b1, b2 such that:
  - b1.parent = b0 and b2.parent = b1
  - b0.view + 1 = b1.view and b1.view + 1 = b2.view   (consecutive views)
  - b1.justify = QC(b0) and b2.justify = QC(b1)

Safety (locked QC)
------------------
Replica locks on the highest QC it voted for. safe-node(b) holds iff:
  b extends lockedQC.block  OR  b.justify.view > lockedQC.view.
Two honest quorums always intersect in >=1 honest replica -> no conflicting
commits at the same height.

Why linear (vs PBFT O(n^2))?
--------------------------
PBFT broadcasts PREPARE and COMMIT all-to-all. HotStuff funnels votes through
the leader, who produces a single QC (threshold signature / multi-sig in real
deployments). Happy-path cost ≈ 3n messages per block.

Liveness
--------
A pacemaker advances views on timeout. After GST, the first honest leader
drives uninterrupted 3-chain progress at network speed (responsiveness).

This engine is an educational / invariant-checking simulator. Production needs
real threshold signatures, persistent WAL, and authenticated channels.
""".strip()
    print(text)
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=ENGINE_NAME,
        description="HotStuff Chained BFT Consensus Engine (PODC 2019)",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("selftest", help="Run deterministic invariant CI gate")
    s.add_argument("-q", "--quiet", action="store_true")
    s.set_defaults(func=lambda a: selftest(verbose=not a.quiet))

    s = sub.add_parser("simulate", help="Run a named protocol scenario")
    s.add_argument(
        "--scenario",
        default="happy",
        choices=["happy", "leader_crash", "byzantine_fork", "lossy"],
    )
    s.add_argument("--n", type=int, default=4)
    s.add_argument("--ops", type=int, default=12)
    s.add_argument("--drop", type=float, default=0.1)
    s.add_argument("--seed", type=int, default=42)
    s.set_defaults(func=cmd_simulate)

    s = sub.add_parser("chaos", help="Byzantine + crash + loss combined stress")
    s.add_argument("--n", type=int, default=4)
    s.add_argument("--drop", type=float, default=0.05)
    s.add_argument("--seed", type=int, default=99)
    s.set_defaults(func=cmd_chaos)

    s = sub.add_parser("bench", help="Throughput microbench on honest cluster")
    s.add_argument("--n", type=int, default=4)
    s.add_argument("--ops", type=int, default=40)
    s.add_argument("--seed", type=int, default=7)
    s.set_defaults(func=cmd_bench)

    s = sub.add_parser("theory", help="Message-complexity and quorum ledger")
    s.add_argument("--n", type=int, default=4)
    s.add_argument("--batch", type=int, default=1)
    s.set_defaults(func=cmd_theory)

    s = sub.add_parser("compare", help="HotStuff vs PBFT complexity comparison")
    s.add_argument("--n", type=int, default=4)
    s.set_defaults(func=cmd_compare)

    s = sub.add_parser("status", help="Engine metadata + theory snapshot")
    s.add_argument("--n", type=int, default=4)
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("explain", help="Human protocol walkthrough")
    s.set_defaults(func=cmd_explain)
    return p


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv:
        argv = ["selftest"]
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args) or 0)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
