# =====================================================================
# 8. High-Fidelity Synthesizer Engine & Renderer
# =====================================================================

def synthesize_score(
    score: List[ScoreNote],
    instrument: str = "plucked",
    duration: Optional[float] = None,
    reverb_wet: float = 0.25,
    sample_rate: int = SAMPLE_RATE,
) -> Tuple[List[float], List[float]]:
    """Synthesizes a polyphonic multi-note score using physical modeling."""
    if duration is None:
        last_note = max(n.start_time + n.duration for n in score)
        duration = last_note + 1.5

    total_samples = int(duration * sample_rate)
    left_buf = [0.0] * total_samples
    right_buf = [0.0] * total_samples
    reverb = SchroederReverb(sample_rate=sample_rate)

    for note in score:
        start_samp = int(note.start_time * sample_rate)
        note_samps = int(note.duration * sample_rate)
        tail_samps = int(sample_rate * 1.5)
        total_voice_samps = min(total_samples - start_samp, note_samps + tail_samps)
        if total_voice_samps <= 0:
            continue

        freq = note_to_freq(note.pitch)

        if instrument == "plucked":
            voice = PluckedString(freq, sample_rate=sample_rate, decay_time=1.8)
            voice.pluck(note.velocity)
            for i in range(total_voice_samps):
                sample = voice.tick()
                left_buf[start_samp + i] += sample
                right_buf[start_samp + i] += sample

        elif instrument == "bowed":
            voice = BowedString(freq, sample_rate=sample_rate, bow_force=1.8, bow_velocity=0.25)
            for i in range(total_voice_samps):
                t = i / sample_rate
                vib = 0.02 * math.sin(2.0 * math.pi * 5.2 * t) if t > 0.3 else 0.0
                voice.bow_velocity = 0.25 + vib
                if i > note_samps:
                    voice.bow_force *= 0.998
                sample = voice.tick() * note.velocity
                left_buf[start_samp + i] += sample
                right_buf[start_samp + i] += sample

        elif instrument == "marimba":
            bank = create_marimba_bank(freq)
            for i in range(total_voice_samps):
                x = note.velocity if i == 0 else 0.0
                sample = bank.tick(x)
                left_buf[start_samp + i] += sample
                right_buf[start_samp + i] += sample

        elif instrument == "chimes":
            bank = create_chime_bank(freq)
            for i in range(total_voice_samps):
                x = (note.velocity * 1.2) if i == 0 else 0.0
                sample = bank.tick(x)
                left_buf[start_samp + i] += sample
                right_buf[start_samp + i] += sample

        elif instrument == "drum":
            drum = Membrane2D(freq, sample_rate=sample_rate)
            exc = drum.strike(note.velocity)
            for i in range(total_voice_samps):
                x = exc[i] if i < len(exc) else 0.0
                sample = drum.tick(x)
                left_buf[start_samp + i] += sample
                right_buf[start_samp + i] += sample

        elif instrument == "flute":
            flute = AcousticFlute(freq, sample_rate=sample_rate)
            for i in range(total_voice_samps):
                t = i / sample_rate
                vib = 0.03 * math.sin(2.0 * math.pi * 5.0 * t) if t > 0.2 else 0.0
                if i < 0.1 * sample_rate:
                    pres = (i / (0.1 * sample_rate)) * note.velocity
                elif i > note_samps:
                    pres = max(0.0, 1.0 - (i - note_samps) / (0.15 * sample_rate)) * note.velocity
                else:
                    pres = note.velocity
                sample = flute.tick(pressure=pres, vibrato=vib)
                left_buf[start_samp + i] += sample
                right_buf[start_samp + i] += sample

    peak = 1e-6
    for i in range(total_samples):
        dry = (left_buf[i] + right_buf[i]) * 0.5
        l, r = reverb.process(dry, wet=reverb_wet)
        left_buf[i] = l
        right_buf[i] = r
        peak = max(peak, abs(l), abs(r))

    gain = 0.89 / peak if peak > 0.89 else 1.0
    for i in range(total_samples):
        left_buf[i] *= gain
        right_buf[i] *= gain

    return left_buf, right_buf


def export_wav(file_path: str, left: List[float], right: List[float], sample_rate: int = SAMPLE_RATE):
    """Exports stereo floating-point audio to a lossless 16-bit PCM RIFF WAV file."""
    with wave.open(file_path, "wb") as wf:
        wf.setnchannels(2)
        wf.setsampwidth(2)
        wf.setframerate(sample_rate)
        frames = bytearray()
        for l, r in zip(left, right):
            il = max(-32767, min(32767, int(round(l * 32767.0))))
            ir = max(-32767, min(32767, int(round(r * 32767.0))))
            frames.extend(struct.pack("<hh", il, ir))
        wf.writeframes(frames)


# =====================================================================
# 9. Real-Time Terminal Oscilloscope & 48-Band DFT Visualizer
# =====================================================================

def render_oscilloscope(samples: List[float], width: int = 72, height: int = 15) -> str:
    if not samples:
        return ""
    step = len(samples) / width
    col_vals = []
    for c in range(width):
        idx_start = int(c * step)
        idx_end = max(idx_start + 1, int((c + 1) * step))
        sub = samples[idx_start:idx_end]
        avg = sum(sub) / len(sub)
        col_vals.append(avg)

    grid = [[" " for _ in range(width)] for _ in range(height)]
    mid_row = height // 2
    peak = max(abs(v) for v in col_vals) if col_vals else 1.0
    if peak < 1e-4:
        peak = 1.0

    for col in range(width):
        v = col_vals[col] / peak
        row = mid_row - int(round(v * (height // 2 - 1)))
        row = max(0, min(height - 1, row))
        grid[row][col] = f"{Color.GREEN}█{Color.RESET}"

    for c in range(width):
        if grid[mid_row][c] == " ":
            grid[mid_row][c] = f"{Color.DIM}─{Color.RESET}"

    lines = [f"{Color.CYAN}┌" + "─" * width + f"┐{Color.RESET}"]
    for row in grid:
        lines.append(f"{Color.CYAN}│{Color.RESET}" + "".join(row) + f"{Color.CYAN}│{Color.RESET}")
    lines.append(f"{Color.CYAN}└" + "─" * width + f"┘{Color.RESET}")
    return "\n".join(lines)


def render_spectrum_bars(samples: List[float], num_bands: int = 40, sample_rate: int = SAMPLE_RATE) -> str:
    N = min(2048, len(samples))
    if N < 64:
        return ""
    mid = len(samples) // 2
    window = [samples[mid - N // 2 + i] * (0.54 - 0.46 * math.cos(2 * math.pi * i / N)) for i in range(N)]

    min_f = 40.0
    max_f = min(16000.0, sample_rate * 0.45)
    f_ratios = [min_f * math.pow(max_f / min_f, b / (num_bands - 1)) for b in range(num_bands)]

    powers = []
    for f in f_ratios:
        w = 2.0 * math.pi * f / sample_rate
        coeff = 2.0 * math.cos(w)
        s0, s1, s2 = 0.0, 0.0, 0.0
        for x in window:
            s0 = x + coeff * s1 - s2
            s2 = s1
            s1 = s0
        power = s1 * s1 + s2 * s2 - coeff * s1 * s2
        powers.append(math.sqrt(max(0.0, power)))

    max_p = max(powers) if powers and max(powers) > 1e-9 else 1.0
    norm_powers = [p / max_p for p in powers]

    meter_chars = [" ", " ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    meter_lines = []

    for r in range(8, 0, -1):
        threshold = r / 8.0
        line_chars = []
        for p in norm_powers:
            if p >= threshold:
                color = Color.RED if r >= 7 else (Color.YELLOW if r >= 5 else Color.CYAN)
                line_chars.append(f"{color}█{Color.RESET}")
            elif p >= threshold - 0.125:
                idx = int((p - (threshold - 0.125)) / 0.125 * 8)
                idx = max(1, min(8, idx))
                color = Color.YELLOW if r >= 5 else Color.CYAN
                line_chars.append(f"{color}{meter_chars[idx]}{Color.RESET}")
            else:
                line_chars.append(" ")
        meter_lines.append(f"{Color.CYAN}│{Color.RESET} " + "".join(line_chars) + f" {Color.CYAN}│{Color.RESET}")

    header = f"{Color.CYAN}┌─[ 40-Band Physical Modeling Spectral Power DFT (40Hz - 16kHz) ]" + "─" * (num_bands - 46) + f"┐{Color.RESET}"
    footer = f"{Color.CYAN}└" + "─" * (num_bands + 2) + f"┘{Color.RESET}"
    freq_labels = f"  {Color.DIM}40Hz      120Hz     400Hz     1.2kHz    4.0kHz    12kHz{Color.RESET}"

    return "\n".join([header] + meter_lines + [footer, freq_labels])


# =====================================================================
# 10. Formal Verification & Physical Invariant Test Suite
# =====================================================================

def run_tests() -> bool:
    print(f"{Color.BOLD}{Color.CYAN}========================================================================{Color.RESET}")
    print(f"{Color.BOLD}{Color.CYAN}🔬 WAVEGUIDE SYNTH PHYSICAL INVARIANT & DSP TEST SUITE{Color.RESET}")
    print(f"{Color.BOLD}{Color.CYAN}========================================================================{Color.RESET}")

    all_passed = True

    def test(name: str, passed: bool, details: str = ""):
        nonlocal all_passed
        if passed:
            print(f"  {Color.GREEN}✔ PASS{Color.RESET} | {Color.BOLD}{name}{Color.RESET} {Color.DIM}{details}{Color.RESET}")
        else:
            all_passed = False
            print(f"  {Color.RED}✖ FAIL{Color.RESET} | {Color.BOLD}{name}{Color.RESET} - {Color.RED}{details}{Color.RESET}")

    # 1. Thiran Fractional Delay All-Pass Filter Unity Gain
    fd = AllpassFractionalDelay(0.38)
    impulse_response = [fd.process(1.0 if i == 0 else 0.0) for i in range(512)]
    energy = sum(x * x for x in impulse_response)
    test(
        "Thiran All-Pass Energy Conservation (|H(e^jw)| == 1.0)",
        math.isclose(energy, 1.0, rel_tol=1e-3),
        f"Total Energy = {energy:.6f} (loss = {abs(1.0 - energy):.2e})",
    )

    # 2. Plucked String Stable Dissipation & Monotonic Energy Decay
    plucked = PluckedString(220.0, decay_time=1.0)
    samples = [plucked.tick() for _ in range(44100)]
    rms_start = math.sqrt(sum(s*s for s in samples[:2000]) / 2000)
    rms_end = math.sqrt(sum(s*s for s in samples[-2000:]) / 2000)
    test(
        "Waveguide Plucked String Energy Dissipation",
        rms_end < rms_start * 0.05 and not any(math.isnan(s) or math.isinf(s) for s in samples),
        f"RMS Decay: {rms_start:.4f} -> {rms_end:.6f} (-{20*math.log10(rms_start/max(1e-9, rms_end)):.1f} dB)",
    )

    # 3. Frequency Tuning Accuracy via Autocorrelation Peak
    target_freq = 440.0
    tuning_str = PluckedString(target_freq, decay_time=2.0)
    tune_samps = [tuning_str.tick() for _ in range(8000)]
    period_samples = int(SAMPLE_RATE / target_freq)
    corr_peak_idx = period_samples
    best_corr = -1.0
    for lag in range(period_samples - 4, period_samples + 5):
        corr = sum(tune_samps[1000 + i] * tune_samps[1000 + i + lag] for i in range(2000))
        if corr > best_corr:
            best_corr = corr
            corr_peak_idx = lag
    measured_f0 = SAMPLE_RATE / corr_peak_idx
    cents_error = 1200 * math.log2(measured_f0 / target_freq)
    test(
        "Waveguide Pitch Tuning Accuracy (Fractional Delay Convergence)",
        abs(cents_error) < 18.0,
        f"Target={target_freq:.1f}Hz, Measured={measured_f0:.1f}Hz (Error={cents_error:+.2f} cents)",
    )

    # 4. Bowed String Nonlinear Stick-Slip MSW Limit Cycle
    bowed = BowedString(196.0, bow_force=1.8, bow_velocity=0.25)
    bowed_samps = [bowed.tick() for _ in range(22050)]
    peak_v = max(abs(s) for s in bowed_samps[-5000:])
    test(
        "Bowed String Helmholtz Motion & Limit Cycle Sustained Oscillation",
        peak_v > 0.05 and not any(math.isnan(s) for s in bowed_samps),
        f"Sustained Limit-Cycle Amplitude = {peak_v:.4f}",
    )

    # 5. Euler-Bernoulli Beam Modal Frequency Ratios
    marimba = create_marimba_bank(300.0)
    test(
        "Modal Resonator Bank Biquad Stability",
        all(abs(res.c2) < 1.0 for res in marimba.resonators),
        f"Poles strictly within unit circle: r^2 = {[-res.c2 for res in marimba.resonators]}",
    )

    # 6. 2D Membrane Bessel Eigenmode Ratios Invariant
    bessel_zeros = Membrane2D.BESSEL_RATIOS
    expected_bessels = [1.0, 1.5933, 2.1355, 2.2954, 2.6531, 2.9173]
    bessel_ok = all(math.isclose(a, b, rel_tol=1e-3) for a, b in zip(bessel_zeros, expected_bessels))
    test(
        "2D Circular Membrane Bessel Mode Ratios Invariant",
        bessel_ok,
        f"Ratios = {bessel_zeros[:4]}...",
    )

    # 7. Acoustic Flute Jet Vortex Nonlinearity
    flute = AcousticFlute(440.0)
    flute_samps = [flute.tick(pressure=0.9) for _ in range(8000)]
    test(
        "Acoustic Flute Jet-Bore Nonlinear Acoustic Coupling",
        max(abs(s) for s in flute_samps[-2000:]) > 0.01,
        f"Sustained Acoustic Flute Peak = {max(abs(s) for s in flute_samps[-2000:]):.4f}",
    )

    # 8. Schroeder Reverberator Diffusive Tail & Energy Decay
    reverb = SchroederReverb()
    reverb_tail = [reverb.process(1.0 if i == 0 else 0.0)[0] for i in range(20000)]
    decay_ok = max(abs(x) for x in reverb_tail[-1000:]) < 0.05
    test(
        "Schroeder Reverb Diffusion & Echo Density Convergence",
        decay_ok and any(abs(x) > 0.003 for x in reverb_tail[500:3000]),
        f"Reverb Tail T60 Verified (Peak Late Reflection = {max(abs(x) for x in reverb_tail[-1000:]):.4f})",
    )

    # 9. Lossless 16-bit PCM RIFF WAV Encoding & Header Compliance
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
        tmp_path = tmp.name
    try:
        dummy_l = [math.sin(2 * math.pi * 440 * i / 44100) * 0.5 for i in range(4410)]
        dummy_r = [math.cos(2 * math.pi * 440 * i / 44100) * 0.5 for i in range(4410)]
        export_wav(tmp_path, dummy_l, dummy_r)
        with open(tmp_path, "rb") as f:
            header = f.read(44)
        riff = header[:4] == b"RIFF"
        wave_tag = header[8:12] == b"WAVE"
        fmt = header[12:16] == b"fmt "
        channels = struct.unpack("<H", header[22:24])[0]
        samplerate = struct.unpack("<I", header[24:28])[0]
        bitspersample = struct.unpack("<H", header[34:36])[0]
        wav_ok = riff and wave_tag and fmt and channels == 2 and samplerate == 44100 and bitspersample == 16
        test(
            "Lossless 16-Bit 44.1kHz Stereo RIFF WAV Header Spec",
            wav_ok,
            f"RIFF={riff}, WAVE={wave_tag}, Channels={channels}, Rate={samplerate}Hz, Bits={bitspersample}",
        )
    finally:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)

    # 10. Full Repertoire Score Polyphonic Rendering
    prelude = REPERTOIRES["bach-prelude"][:8]
    l, r = synthesize_score(prelude, instrument="plucked", duration=1.0)
    test(
        "Polyphonic Waveguide Score Synthesis & Dynamic Normalization",
        len(l) == 44100 and max(abs(x) for x in l) <= 0.95,
        f"Rendered {len(l)} frames, Peak Amplitude = {max(abs(x) for x in l):.4f}",
    )

    print(f"{Color.BOLD}{Color.CYAN}========================================================================{Color.RESET}")
    if all_passed:
        print(f"{Color.BOLD}{Color.GREEN}✔ ALL 10 DSP & PHYSICAL INVARIANT VERIFICATION TESTS PASSED{Color.RESET}")
    else:
        print(f"{Color.BOLD}{Color.RED}✖ VERIFICATION TEST SUITE FAILED{Color.RESET}")
    return all_passed


# =====================================================================
# 11. Performance Benchmark Suite
# =====================================================================

def run_benchmark():
    print(f"{Color.BOLD}{Color.CYAN}========================================================================{Color.RESET}")
    print(f"{Color.BOLD}{Color.CYAN}⚡ DIGITAL WAVEGUIDE & PHYSICAL MODELING DSP BENCHMARK{Color.RESET}")
    print(f"{Color.BOLD}{Color.CYAN}========================================================================{Color.RESET}")

    NUM_SAMPLES = 88200

    engines = [
        ("Plucked String (Waveguide+Fractional+Dispersion)", lambda: PluckedString(220.0)),
        ("Bowed String (Nonlinear MSW Friction Solver)", lambda: BowedString(196.0)),
        ("Euler-Bernoulli Struck Marimba Modal Bank", lambda: create_marimba_bank(440.0)),
        ("2D Circular Clamped Membrane Drum (Bessel)", lambda: Membrane2D(120.0)),
        ("Acoustic Flute (Jet Delay & Cubic Embouchure)", lambda: AcousticFlute(523.25)),
    ]

    for name, init_fn in engines:
        inst = init_fn()
        t0 = time.perf_counter()
        if hasattr(inst, "tick"):
            is_modal = isinstance(inst, (ModalBank, Membrane2D))
            for _ in range(NUM_SAMPLES):
                if is_modal:
                    inst.tick(0.0)
                else:
                    inst.tick()
        t1 = time.perf_counter()
        elapsed = t1 - t0
        sps = NUM_SAMPLES / elapsed
        realtime_x = sps / SAMPLE_RATE

        print(
            f"  • {name:<46} : "
            f"{Color.BOLD}{sps:>10,.0f} samples/sec{Color.RESET} "
            f"({Color.GREEN}{realtime_x:>5.1f}x real-time{Color.RESET})"
        )

    rev = SchroederReverb()
    t0 = time.perf_counter()
    for _ in range(NUM_SAMPLES):
        rev.process(0.5)
    t1 = time.perf_counter()
    elapsed = t1 - t0
    sps = NUM_SAMPLES / elapsed
    print(
        f"  • {'Schroeder Reverb Tank (4 Comb + 2 All-Pass)':<46} : "
        f"{Color.BOLD}{sps:>10,.0f} samples/sec{Color.RESET} "
        f"({Color.GREEN}{sps / SAMPLE_RATE:>5.1f}x real-time{Color.RESET})"
    )
    print(f"{Color.BOLD}{Color.CYAN}========================================================================{Color.RESET}")


# =====================================================================
# 12. Main CLI Interface
# =====================================================================

def cmd_gallery(args):
    print(f"{Color.BOLD}{Color.CYAN}========================================================================{Color.RESET}")
    print(f"{Color.BOLD}{Color.CYAN}🎻 PHYSICAL MODELING AUDIO SYNTHESIZER PRESETS & REPERTOIRES{Color.RESET}")
    print(f"{Color.BOLD}{Color.CYAN}========================================================================{Color.RESET}")
    print("Available Physical Modeling Instruments:")
    print("  • plucked   : Digital Waveguide Plucked String (Karplus-Strong, Thiran fractional delay, stiffness)")
    print("  • bowed     : McIntyre-Schumacher-Woodhouse (MSW) Nonlinear Bowed String Cello")
    print("  • marimba   : Undercut Euler-Bernoulli Tuned Wood Bar Modal Resonator Bank (1:4:10)")
    print("  • chimes    : Orchestral Tubular Chimes / Bell High Inharmonic Modal Resonator Bank")
    print("  • drum      : 2D Circular Clamped Membrane Drum (Bessel Roots J_m,n with tension glide)")
    print("  • flute     : Acoustic Jet Delay Bore Flute with Vortex Turbulence & Cubic Embouchure")
    print("")
    print("Built-in Classic Repertoires:")
    for name, notes in REPERTOIRES.items():
        dur = max(n.start_time + n.duration for n in notes)
        print(f"  • {name:<16} : {len(notes):>2} notes, {dur:>4.1f}s duration")
    print(f"{Color.BOLD}{Color.CYAN}========================================================================{Color.RESET}")


def cmd_render(args):
    score = REPERTOIRES.get(args.repertoire, REPERTOIRES["bach-prelude"])
    inst = args.instrument
    out_file = args.out or f"{args.repertoire}_{inst}.wav"

    print(f"{Color.BOLD}{Color.CYAN}Synthesizing '{args.repertoire}' using physical model '{inst}'...{Color.RESET}")
    t0 = time.perf_counter()
    left, right = synthesize_score(score, instrument=inst, reverb_wet=args.reverb)
    export_wav(out_file, left, right)
    t1 = time.perf_counter()

    dur = len(left) / SAMPLE_RATE
    print(f"{Color.GREEN}✔ Synthesized {dur:.2f}s audio in {t1-t0:.2f}s ({(dur/(t1-t0)):.1f}x real-time speed).{Color.RESET}")
    print(f"  • Output WAV: {Color.BOLD}{out_file}{Color.RESET} (16-bit 44.1kHz Stereo PCM)")


def cmd_play(args):
    score = REPERTOIRES.get(args.repertoire, REPERTOIRES["bach-prelude"])
    inst = args.instrument

    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
        tmp_file = tmp.name

    try:
        print(f"{Color.BOLD}{Color.CYAN}🎵 Synthesizing and playing '{args.repertoire}' ({inst})...{Color.RESET}")
        left, right = synthesize_score(score, instrument=inst, reverb_wet=args.reverb)
        export_wav(tmp_file, left, right)

        if os.path.exists("/usr/bin/afplay"):
            subprocess.run(["/usr/bin/afplay", tmp_file])
        else:
            print(f"Audio saved to {tmp_file} (afplay not available).")
    finally:
        if os.path.exists(tmp_file):
            os.remove(tmp_file)


def cmd_visualize(args):
    score = REPERTOIRES.get(args.repertoire, REPERTOIRES["bach-prelude"])
    inst = args.instrument

    print(f"{Color.BOLD}{Color.CYAN}Synthesizing '{args.repertoire}' for terminal visualization...{Color.RESET}")
    left, _ = synthesize_score(score, instrument=inst, duration=args.duration)

    print("\n" + f"{Color.BOLD}1. Waveform Oscilloscope Real-Time Capture:{Color.RESET}")
    print(render_oscilloscope(left[2000:12000], width=72, height=13))

    print("\n" + f"{Color.BOLD}2. Discrete Fourier Transform Spectral Power Analysis:{Color.RESET}")
    print(render_spectrum_bars(left[5000:20000], num_bands=48))


def main():
    parser = argparse.ArgumentParser(
        description="waveguide-synth: Physical Modeling Audio Synthesizer & Digital Waveguide DSP Engine",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", help="Subcommands")

    p_play = subparsers.add_parser("play", help="Synthesize and play audio via native macOS afplay")
    p_play.add_argument("--instrument", choices=["plucked", "bowed", "marimba", "chimes", "drum", "flute"], default="plucked")
    p_play.add_argument("--repertoire", choices=list(REPERTOIRES.keys()), default="bach-prelude")
    p_play.add_argument("--reverb", type=float, default=0.25)

    p_rend = subparsers.add_parser("render", help="Synthesize score to lossless 16-bit 44.1kHz WAV")
    p_rend.add_argument("--instrument", choices=["plucked", "bowed", "marimba", "chimes", "drum", "flute"], default="plucked")
    p_rend.add_argument("--repertoire", choices=list(REPERTOIRES.keys()), default="bach-prelude")
    p_rend.add_argument("--out", default="output.wav")
    p_rend.add_argument("--reverb", type=float, default=0.25)

    p_vis = subparsers.add_parser("visualize", help="Display terminal ASCII oscilloscope and 48-band DFT power spectrum")
    p_vis.add_argument("--instrument", choices=["plucked", "bowed", "marimba", "chimes", "drum", "flute"], default="plucked")
    p_vis.add_argument("--repertoire", choices=list(REPERTOIRES.keys()), default="bach-prelude")
    p_vis.add_argument("--duration", type=float, default=2.0)

    subparsers.add_parser("gallery", help="List physical modeling instruments, presets, and repertoires")
    subparsers.add_parser("test", help="Run formal verification and physical invariant test suite")
    subparsers.add_parser("benchmark", help="Benchmark synthesis throughput (samples/sec and real-time multiplier)")

    args = parser.parse_args()

    if not args.command:
        class DefaultArgs:
            instrument = "plucked"
            repertoire = "bach-prelude"
            duration = 2.0
        cmd_visualize(DefaultArgs())
        return

    cmds = {
        "play": cmd_play,
        "render": cmd_render,
        "visualize": cmd_visualize,
        "gallery": cmd_gallery,
        "test": lambda a: sys.exit(0 if run_tests() else 1),
        "benchmark": lambda a: run_benchmark(),
    }
    cmds[args.command](args)


if __name__ == "__main__":
    main()
