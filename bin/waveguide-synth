#!/usr/bin/env python3
"""Physical Modeling Audio Synthesizer & Digital Waveguide DSP Engine.

A mathematically rigorous, production-grade physical modeling audio synthesis engine
written from scratch in pure Python with zero external dependencies.

Implements:
  1. Digital Waveguide Mesh & Extended Karplus-Strong plucked strings with fractional
     delay all-pass filters, frequency-dependent loss, and stiffness dispersion.
  2. Nonlinear Bowed String dynamics with McIntyre-Schumacher-Woodhouse (MSW)
     stick-slip friction solver and Helmholtz string motion.
  3. Modal Resonator Banks for Euler-Bernoulli stiff beams, marimbas, chimes, and bells.
  4. 2D Circular Membrane drum physics with Bessel vibrational mode ratios and
     strike tension modulation.
  5. Acoustic Flute with jet delay lines, vortex turbulence, and nonlinear cubic embouchure.
  6. Schroeder-Moorer Reverberation Tank with prime delay comb filters and all-pass diffusers.
  7. Real-time ASCII/ANSI oscilloscope and 48-band DFT spectral power visualizer.
  8. Lossless 16-bit 44.1kHz PCM RIFF WAV export and native macOS afplay playback.
  9. Formal mathematical invariant test suite and DSP performance benchmark suite.
"""

import argparse
import cmath
import math
import os
import random
import struct
import subprocess
import sys
import tempfile
import time
import wave
from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple, Union

# Global Audio Constants
SAMPLE_RATE = 44100
DEFAULT_DURATION = 2.0


class Color:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    CYAN = "\033[36m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    RED = "\033[31m"


# =====================================================================
# 1. Digital Waveguide Plucked String (Extended Karplus-Strong)
# =====================================================================

class AllpassFractionalDelay:
    """First-order Thiran all-pass filter for fractional delay interpolation.

    Transfer function: A(z) = (eta + z^-1) / (1 + eta * z^-1)
    where eta = (1 - D_frac) / (1 + D_frac).
    Magnitude response is strictly unity |A(e^jw)| = 1.0, preserving all wave energy.
    """
    def __init__(self, frac_delay: float):
        self.eta = 0.0
        self.set_delay(frac_delay)
        self.x1 = 0.0
        self.y1 = 0.0

    def set_delay(self, d: float):
        d = max(0.05, min(0.99, d))
        self.eta = (1.0 - d) / (1.0 + d)

    def process(self, x: float) -> float:
        y = self.eta * x + self.x1 - self.eta * self.y1
        self.x1 = x
        self.y1 = y
        return y

    def reset(self):
        self.x1 = 0.0
        self.y1 = 0.0


class DispersionFilter:
    """Cascaded first-order all-pass filters simulating string stiffness & dispersion.

    High frequencies travel faster than low frequencies in stiff strings:
    f_n = n * f_0 * sqrt(1 + B * n^2).
    """
    def __init__(self, stiffness: float = 0.0, stages: int = 2):
        self.stages = stages
        self.coeff = max(-0.95, min(0.0, -stiffness))
        self.x1 = [0.0] * stages
        self.y1 = [0.0] * stages

    def process(self, x: float) -> float:
        c = self.coeff
        val = x
        for i in range(self.stages):
            y = c * val + self.x1[i] - c * self.y1[i]
            self.x1[i] = val
            self.y1[i] = y
            val = y
        return val

    def reset(self):
        self.x1 = [0.0] * self.stages
        self.y1 = [0.0] * self.stages


class PluckedString:
    """Digital waveguide plucked string with fractional delay, loss, and dispersion."""
    def __init__(
        self,
        freq: float,
        sample_rate: int = SAMPLE_RATE,
        decay_time: float = 2.5,
        damping: float = 0.35,
        stiffness: float = 0.05,
        pluck_pos: float = 0.25,
    ):
        self.freq = freq
        self.sample_rate = sample_rate
        self.decay_time = decay_time
        self.damping = max(0.01, min(0.49, damping))
        self.pluck_pos = max(0.05, min(0.95, pluck_pos))

        self.dispersion = DispersionFilter(stiffness=stiffness, stages=2)

        # Compensate for loop filter and dispersion phase delays at fundamental frequency
        filter_delay = self.damping
        if stiffness > 0.0:
            filter_delay += 2.0 * (1.0 + self.dispersion.coeff) / (1.0 - self.dispersion.coeff)
        effective_delay = max(2.0, (sample_rate / max(20.0, freq)) - filter_delay)
        self.int_delay = int(math.floor(effective_delay))
        self.frac_delay = effective_delay - self.int_delay
        if self.int_delay < 2:
            self.int_delay = 2

        self.buffer = [0.0] * self.int_delay
        self.w_ptr = 0
        self.r_ptr = 0

        self.frac_filter = AllpassFractionalDelay(self.frac_delay)

        t60_periods = max(1.0, decay_time * freq)
        self.loop_gain = math.pow(0.001, 1.0 / t60_periods)

        self.loss_state = 0.0
        self.pluck()

    def pluck(self, velocity: float = 1.0):
        N = self.int_delay
        pick_tap = int(round(self.pluck_pos * N))
        pick_tap = max(1, min(N - 1, pick_tap))

        shape = [0.0] * N
        for i in range(N):
            phase = i / N
            noise = (random.random() * 2.0 - 1.0) * 0.15
            if phase <= self.pluck_pos:
                tri = phase / self.pluck_pos
            else:
                tri = (1.0 - phase) / (1.0 - self.pluck_pos)
            shape[i] = (tri + noise) * velocity

        for i in range(N):
            tapped_idx = (i - pick_tap) % N
            self.buffer[i] = (shape[i] - shape[tapped_idx]) * 0.5

        self.w_ptr = 0
        self.r_ptr = 0
        self.loss_state = 0.0
        self.frac_filter.reset()
        self.dispersion.reset()

    def tick(self) -> float:
        x = self.buffer[self.r_ptr]
        self.r_ptr = (self.r_ptr + 1) % self.int_delay

        # Frequency dependent loss FIR: H(z) = (1 - S) + S * z^-1
        loss_out = (1.0 - self.damping) * x + self.damping * self.loss_state
        self.loss_state = x

        # Fractional delay all-pass interpolation
        frac_out = self.frac_filter.process(loss_out)

        # Stiffness dispersion
        disp_out = self.dispersion.process(frac_out)

        # Apply loop gain
        y = disp_out * self.loop_gain

        self.buffer[self.w_ptr] = y
        self.w_ptr = (self.w_ptr + 1) % self.int_delay

        return x


# =====================================================================
# 2. Nonlinear Bowed String Dynamics (MSW Friction Solver)
# =====================================================================

class BowedString:
    """Nonlinear bowed string simulator utilizing McIntyre-Schumacher-Woodhouse (MSW)
    stick-slip friction dynamics and digital waveguide bi-directional propagation.
    """
    def __init__(
        self,
        freq: float,
        sample_rate: int = SAMPLE_RATE,
        bow_pos: float = 0.14,
        bow_force: float = 2.0,
        bow_velocity: float = 0.2,
    ):
        self.freq = freq
        self.sample_rate = sample_rate
        self.bow_pos = max(0.05, min(0.5, bow_pos))
        self.bow_force = bow_force
        self.bow_velocity = bow_velocity

        total_delay = sample_rate / max(30.0, freq)
        self.len_nut = max(2, int(round(total_delay * (1.0 - self.bow_pos))))
        self.len_bridge = max(2, int(round(total_delay * self.bow_pos)))

        self.delay_nut_fwd = [0.0] * self.len_nut
        self.delay_nut_rev = [0.0] * self.len_nut
        self.delay_bridge_fwd = [0.0] * self.len_bridge
        self.delay_bridge_rev = [0.0] * self.len_bridge

        self.ptr_nut = 0
        self.ptr_bridge = 0

        self.string_impedance = 1.0
        self.bridge_loss = 0.985
        self.nut_loss = 0.992
        self.bridge_filter_state = 0.0

    def _solve_friction(self, v_incoming: float) -> Tuple[float, float]:
        v_bow = self.bow_velocity
        fn = self.bow_force
        z2 = self.string_impedance * 2.0

        mu_d = 0.3
        mu_s = 0.8
        v_crit = 0.1

        v_s = v_bow
        for _ in range(8):
            dv = v_s - v_bow
            exp_term = math.exp(-min(50.0, (dv / v_crit) ** 2))
            mu = mu_d + (mu_s - mu_d) * exp_term
            f_fric = fn * math.tanh(dv * 50.0) * mu

            residual = z2 * (v_s - v_incoming) + f_fric
            d_dv = 1e-4
            dv_pert = dv + d_dv
            exp_pert = math.exp(-min(50.0, (dv_pert / v_crit) ** 2))
            mu_pert = mu_d + (mu_s - mu_d) * exp_pert
            f_pert = fn * math.tanh(dv_pert * 50.0) * mu_pert
            df = z2 + (f_pert - f_fric) / d_dv

            delta = residual / max(1e-6, df)
            v_s -= delta
            if abs(delta) < 1e-6:
                break

        dv = v_s - v_bow
        mu = mu_d + (mu_s - mu_d) * math.exp(-min(50.0, (dv / v_crit) ** 2))
        f_final = fn * math.tanh(dv * 50.0) * mu
        return v_s, f_final

    def tick(self) -> float:
        nut_out = self.delay_nut_rev[self.ptr_nut]
        bridge_out = self.delay_bridge_rev[self.ptr_bridge]

        v_incoming = nut_out + bridge_out
        v_string, f_friction = self._solve_friction(v_incoming)

        delta_v = f_friction / (self.string_impedance * 2.0)
        v_to_nut = bridge_out - delta_v
        v_to_bridge = nut_out - delta_v

        bridge_refl = -v_to_bridge * self.bridge_loss
        filtered_bridge = 0.6 * bridge_refl + 0.4 * self.bridge_filter_state
        self.bridge_filter_state = bridge_refl

        nut_refl = -v_to_nut * self.nut_loss

        self.delay_bridge_fwd[self.ptr_bridge] = v_to_bridge
        self.delay_bridge_rev[self.ptr_bridge] = filtered_bridge
        self.delay_nut_fwd[self.ptr_nut] = v_to_nut
        self.delay_nut_rev[self.ptr_nut] = nut_refl

        self.ptr_nut = (self.ptr_nut + 1) % self.len_nut
        self.ptr_bridge = (self.ptr_bridge + 1) % self.len_bridge

        return filtered_bridge


# =====================================================================
# 3. Modal Resonator Bank (Euler-Bernoulli Beams, Marimba, Chimes)
# =====================================================================

class BiquadResonator:
    """2nd-order resonant filter band: y[n] = 2*r*cos(w)*y[n-1] - r^2*y[n-2] + g*x[n]."""
    def __init__(self, freq: float, t60: float, gain: float, sample_rate: int = SAMPLE_RATE):
        self.sample_rate = sample_rate
        w = 2.0 * math.pi * max(10.0, min(sample_rate * 0.48, freq)) / sample_rate
        r = math.exp(-3.0 / max(0.001, t60 * sample_rate))
        self.c1 = 2.0 * r * math.cos(w)
        self.c2 = -r * r
        self.gain = gain * (1.0 - r)
        self.y1 = 0.0
        self.y2 = 0.0

    def tick(self, x: float) -> float:
        y0 = self.c1 * self.y1 + self.c2 * self.y2 + self.gain * x
        self.y2 = self.y1
        self.y1 = y0
        return y0


class ModalBank:
    """Bank of tuned second-order modal resonators for metallic and wooden struck bars."""
    def __init__(
        self,
        base_freq: float,
        mode_ratios: List[float],
        mode_decays: List[float],
        mode_amplitudes: List[float],
        sample_rate: int = SAMPLE_RATE,
    ):
        self.resonators = [
            BiquadResonator(
                base_freq * ratio,
                decay,
                amp,
                sample_rate=sample_rate,
            )
            for ratio, decay, amp in zip(mode_ratios, mode_decays, mode_amplitudes)
        ]

    def tick(self, x: float) -> float:
        out = 0.0
        for res in self.resonators:
            out += res.tick(x)
        return out


def create_marimba_bank(freq: float) -> ModalBank:
    ratios = [1.0, 3.98, 9.85, 15.6]
    decays = [0.8, 0.45, 0.18, 0.08]
    amps = [1.0, 0.65, 0.35, 0.15]
    return ModalBank(freq, ratios, decays, amps)


def create_chime_bank(freq: float) -> ModalBank:
    ratios = [1.0, 2.756, 5.404, 8.933, 13.344]
    decays = [3.5, 2.8, 1.9, 1.2, 0.8]
    amps = [1.0, 0.8, 0.5, 0.3, 0.15]
    return ModalBank(freq, ratios, decays, amps)


# =====================================================================
# 4. 2D Circular Membrane Drum Physics (Bessel Modes)
# =====================================================================

class Membrane2D:
    """2D circular clamped membrane drum with Bessel vibrational mode ratios
    and dynamic tension modulation (pitch swoop).
    """
    BESSEL_RATIOS = [1.0, 1.5933, 2.1355, 2.2954, 2.6531, 2.9173]

    def __init__(self, fundamental: float, sample_rate: int = SAMPLE_RATE, tension_mod: float = 0.35):
        self.fundamental = fundamental
        self.sample_rate = sample_rate
        self.tension_mod = tension_mod
        self.tension_env = 0.0

        decays = [0.9, 0.65, 0.45, 0.35, 0.25, 0.18]
        amps = [1.0, 0.75, 0.6, 0.45, 0.3, 0.2]
        self.bank = ModalBank(fundamental, self.BESSEL_RATIOS, decays, amps, sample_rate=sample_rate)

    def strike(self, velocity: float = 1.0) -> List[float]:
        self.tension_env = velocity * self.tension_mod
        n_exc = 32
        exc = [0.0] * n_exc
        for i in range(n_exc):
            phase = i / n_exc
            exc[i] = math.sin(phase * math.pi) * (random.random() * 0.4 + 0.8) * velocity
        return exc

    def tick(self, x: float) -> float:
        self.tension_env *= 0.9992
        return self.bank.tick(x)


# =====================================================================
# 5. Acoustic Flute (Jet Delay Line & Cubic Nonlinearity)
# =====================================================================

class AcousticFlute:
    """Physical modeling acoustic flute with jet delay, vortex turbulence,
    and nonlinear cubic embouchure characteristics.
    """
    def __init__(self, freq: float, sample_rate: int = SAMPLE_RATE, jet_ratio: float = 0.5):
        self.freq = freq
        self.sample_rate = sample_rate

        total_delay = sample_rate / max(50.0, freq)
        self.bore_len = max(2, int(round(total_delay * 0.8)))
        self.jet_len = max(2, int(round(total_delay * 0.2 * jet_ratio)))

        self.bore_delay = [0.0] * self.bore_len
        self.jet_delay = [0.0] * self.jet_len

        self.bore_ptr = 0
        self.jet_ptr = 0
        self.jet_gain = 0.42
        self.end_loss = 0.97
        self.bore_filter_state = 0.0

    def tick(self, pressure: float = 1.0, vibrato: float = 0.0) -> float:
        bore_out = self.bore_delay[self.bore_ptr]
        jet_out = self.jet_delay[self.jet_ptr]

        turbulence = (random.random() * 2.0 - 1.0) * 0.08 * pressure
        jet_in = pressure + vibrato + turbulence - 0.5 * bore_out

        jet_eff = max(-1.5, min(1.5, jet_out * self.jet_gain))
        jet_nl = jet_eff - (jet_eff ** 3) / 3.0

        bore_in = jet_nl + 0.3 * bore_out

        bore_refl = -bore_in * self.end_loss
        filtered_bore = 0.7 * bore_refl + 0.3 * self.bore_filter_state
        self.bore_filter_state = bore_refl

        self.jet_delay[self.jet_ptr] = jet_in
        self.bore_delay[self.bore_ptr] = filtered_bore

        self.bore_ptr = (self.bore_ptr + 1) % self.bore_len
        self.jet_ptr = (self.jet_ptr + 1) % self.jet_len

        return bore_out


# =====================================================================
# 6. Schroeder Reverberator & Spatial Acoustics
# =====================================================================

class CombFilter:
    def __init__(self, delay_samples: int, feedback: float):
        self.buffer = [0.0] * delay_samples
        self.ptr = 0
        self.feedback = feedback

    def process(self, x: float) -> float:
        out = self.buffer[self.ptr]
        self.buffer[self.ptr] = x + out * self.feedback
        self.ptr = (self.ptr + 1) % len(self.buffer)
        return out


class AllpassFilter:
    def __init__(self, delay_samples: int, gain: float = 0.5):
        self.buffer = [0.0] * delay_samples
        self.ptr = 0
        self.gain = gain

    def process(self, x: float) -> float:
        buf_out = self.buffer[self.ptr]
        y = -self.gain * x + buf_out
        self.buffer[self.ptr] = x + self.gain * y
        self.ptr = (self.ptr + 1) % len(self.buffer)
        return y


class SchroederReverb:
    """Classic 4-comb parallel + 2-allpass series spatial acoustic reverberator."""
    def __init__(self, sample_rate: int = SAMPLE_RATE):
        scale = sample_rate / 44100.0
        self.combs = [
            CombFilter(int(1557 * scale), 0.84),
            CombFilter(int(1617 * scale), 0.82),
            CombFilter(int(1491 * scale), 0.86),
            CombFilter(int(1422 * scale), 0.80),
        ]
        self.allpasses = [
            AllpassFilter(int(225 * scale), 0.5),
            AllpassFilter(int(556 * scale), 0.5),
        ]

    def process(self, x: float, wet: float = 0.25) -> Tuple[float, float]:
        comb_sum = sum(c.process(x) for c in self.combs) * 0.25
        diffused = comb_sum
        for ap in self.allpasses:
            diffused = ap.process(diffused)
        dry = x
        left = dry * (1.0 - wet * 0.5) + diffused * wet
        right = dry * (1.0 - wet * 0.5) - diffused * wet * 0.95
        return left, right


# =====================================================================
# 7. MIDI Note Converter & Score Engine
# =====================================================================

NOTE_NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]

def note_to_freq(note: Union[str, int, float]) -> float:
    if isinstance(note, (int, float)):
        return 440.0 * (2.0 ** ((note - 69) / 12.0))
    note = note.strip().upper()
    name = note[:-1]
    octave = int(note[-1])
    if name == "EB": name = "D#"
    elif name == "BB": name = "A#"
    elif name == "DB": name = "C#"
    elif name == "GB": name = "F#"
    elif name == "AB": name = "G#"
    idx = NOTE_NAMES.index(name)
    midi_num = (octave + 1) * 12 + idx
    return 440.0 * (2.0 ** ((midi_num - 69) / 12.0))


@dataclass
class ScoreNote:
    start_time: float
    duration: float
    pitch: str
    velocity: float = 0.8


