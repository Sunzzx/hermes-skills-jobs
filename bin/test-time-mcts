#!/usr/bin/env python3
"""Test-Time Compute MCTS & Process Reward Model (PRM) Reasoning Engine.

A mathematically rigorous, zero-dependency Test-Time Search implementation
featuring Monte Carlo Tree Search with step-level Process Reward Models (PRMs),
PUCT exploration, self-correction backtracking, beam search comparison, and
rich ANSI search tree visualization.
"""

import argparse
import copy
import enum
import json
import math
import random
import re
import sys
import time
from dataclasses import dataclass, field
from typing import Any, Dict, List, Optional, Set, Tuple, Union

# ANSI formatting
RESET = "\033[0m"
BOLD = "\033[1m"
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
RED = "\033[31m"
DIM = "\033[2m"
WHITE = "\033[37m"

DEFAULT_C_PUCT = 1.414
DEFAULT_DISCOUNT = 0.95
DEFAULT_PRM_THRESHOLD = 0.40
DEFAULT_MAX_DEPTH = 10
DEFAULT_SIMULATIONS = 200


# =====================================================================
# 1. CORE DATA STRUCTURES & TREE NODE
# =====================================================================

class MCTSNode:
    """A node in the Monte Carlo Search Tree representing a reasoning state."""

    def __init__(
        self,
        state: Any,
        parent: Optional['MCTSNode'] = None,
        action: Optional[str] = None,
        prior: float = 1.0,
        depth: int = 0,
    ):
        self.state = state
        self.parent = parent
        self.action = action
        self.prior = prior
        self.depth = depth
        self.children: Dict[str, 'MCTSNode'] = {}
        self.visit_count: int = 0
        self.total_value: float = 0.0
        self.mean_value: float = 0.0
        self.prm_score: float = 1.0  # Step-level Process Reward
        self.is_terminal: bool = False
        self.is_solved: bool = False
        self.pruned: bool = False

    @property
    def is_expanded(self) -> bool:
        return len(self.children) > 0

    def puct_score(self, total_parent_visits: int, c_puct: float = DEFAULT_C_PUCT) -> float:
        """Calculate Polynomial Upper Confidence Trees (PUCT) score.
        
        PUCT(s, a) = Q(s, a) + c_puct * P(s, a) * sqrt(sum_b N(s, b)) / (1 + N(s, a))
        """
        if self.pruned:
            return -1e9
        u = c_puct * self.prior * math.sqrt(max(1, total_parent_visits)) / (1.0 + self.visit_count)
        return self.mean_value + u

    def update(self, value: float) -> None:
        """Update node statistics on backpropagation."""
        self.visit_count += 1
        self.total_value += value
        self.mean_value = self.total_value / self.visit_count


# =====================================================================
# 2. REASONING DOMAINS & ENVIRONMENTS
# =====================================================================

class StepEvaluation:
    def __init__(self, is_valid: bool, prm_score: float, justification: str):
        self.is_valid = is_valid
        self.prm_score = prm_score
        self.justification = justification


class ProblemDomain:
    """Abstract base class for a multi-step reasoning domain."""
    
    def initial_state(self) -> Any:
        raise NotImplementedError

    def get_actions(self, state: Any) -> List[Tuple[str, Any, float]]:
        """Returns list of (action_str, next_state, prior_prob)."""
        raise NotImplementedError

    def evaluate_step(self, prev_state: Any, action_str: str, next_state: Any) -> StepEvaluation:
        """Process Reward Model (PRM) scoring of an individual step."""
        raise NotImplementedError

    def is_terminal(self, state: Any) -> Tuple[bool, bool, float]:
        """Returns (is_terminal, is_solved, outcome_reward)."""
        raise NotImplementedError


# --- Domain 1: Game of 24 (Countdown Arithmetic Search) ---

class Game24Domain(ProblemDomain):
    """Arithmetic reasoning search: combine numbers using +, -, *, / to make 24."""

    def __init__(self, numbers: List[int], target: float = 24.0):
        self.target = target
        # State is tuple of (value, history_expr_str)
        self.init_numbers = [(float(x), str(x)) for x in numbers]

    def initial_state(self) -> Any:
        return tuple(sorted(self.init_numbers, key=lambda x: (x[0], x[1])))

    def get_actions(self, state: Any) -> List[Tuple[str, Any, float]]:
        n = len(state)
        if n < 2:
            return []
        
        actions = []
        ops = [
            ('+', lambda a, b: a + b, 'add'),
            ('-', lambda a, b: a - b, 'sub'),
            ('*', lambda a, b: a * b, 'mul'),
            ('/', lambda a, b: a / b if abs(b) > 1e-9 else None, 'div'),
        ]

        seen_signatures = set()
        for i in range(n):
            for j in range(n):
                if i == j:
                    continue
                val_a, expr_a = state[i]
                val_b, expr_b = state[j]
                
                for op_sym, op_func, op_name in ops:
                    # Commutative reduction
                    if op_sym in ('+', '*') and i > j:
                        continue
                    res = op_func(val_a, val_b)
                    if res is None:
                        continue
                    
                    new_expr = f"({expr_a} {op_sym} {expr_b})"
                    # Build next numbers tuple
                    remaining = [state[k] for k in range(n) if k != i and k != j]
                    next_state = tuple(sorted(remaining + [(res, new_expr)], key=lambda x: (x[0], x[1])))
                    
                    act_str = f"{val_a:g} {op_sym} {val_b:g} = {res:g}"
                    sig = (round(res, 4), tuple(sorted(x[0] for x in remaining)))
                    if sig in seen_signatures:
                        continue
                    seen_signatures.add(sig)

                    # Heuristic prior based on integer cleanliness & distance to 24
                    prior = 1.0
                    if abs(res - round(res)) < 1e-6:
                        prior += 0.5
                    if res == self.target and len(next_state) == 1:
                        prior += 5.0
                    elif abs(res) > 200:
                        prior *= 0.2
                    
                    actions.append((act_str, next_state, prior))

        # Normalize priors
        total_prior = sum(a[2] for a in actions) if actions else 1.0
        return [(a[0], a[1], a[2] / total_prior) for a in actions]

    def evaluate_step(self, prev_state: Any, action_str: str, next_state: Any) -> StepEvaluation:
        """Process Reward Model for Arithmetic Search."""
        vals = [x[0] for x in next_state]
        # Check if numbers blow up or collapse
        for v in vals:
            if abs(v) > 500:
                return StepEvaluation(False, 0.05, "Extreme divergence: number exceeds 500")
        
        # Check non-integer fractional garbage (division producing messy decimals)
        fractional_penalty = 0.0
        for v in vals:
            diff = abs(v - round(v))
            if diff > 1e-5:
                # Non-integer intermediate
                fractional_penalty += 0.15

        # Check reachability to 24
        if len(vals) == 1:
            if abs(vals[0] - self.target) < 1e-5:
                return StepEvaluation(True, 1.0, "Exact target reached")
            else:
                return StepEvaluation(False, 0.0, f"Terminal failure: {vals[0]} != {self.target}")

        # Score based on factors of 24 or proximity
        score = 0.70 - fractional_penalty
        for v in vals:
            if v > 0 and abs(v - round(v)) < 1e-5:
                iv = int(round(v))
                if iv in (1, 2, 3, 4, 6, 8, 12, 24):
                    score += 0.10
        score = max(0.1, min(1.0, score))
        return StepEvaluation(True, score, f"Arithmetic plausibility score: {score:.2f}")

    def is_terminal(self, state: Any) -> Tuple[bool, bool, float]:
        if len(state) == 1:
            is_solved = abs(state[0][0] - self.target) < 1e-5
            return True, is_solved, 1.0 if is_solved else 0.0
        return False, False, 0.0


# --- Domain 2: Olympiad Step-by-Step Modular Arithmetic ---

class OlympiadModularDomain(ProblemDomain):
    """Solves: Find minimal x > 0 such that x = 2 mod 3, x = 3 mod 5, x = 2 mod 7 (CRT)."""

    def __init__(self):
        self.congruences = [(2, 3), (3, 5), (2, 7)]
        self.correct_path = [
            "Step 1: Modulus M = 3 * 5 * 7 = 105",
            "Step 2: Sub-moduli M1 = 35, M2 = 21, M3 = 15",
            "Step 3: Inverses y1 = 2 (mod 3), y2 = 1 (mod 5), y3 = 1 (mod 7)",
            "Step 4: Sum x0 = 2*35*2 + 3*21*1 + 2*15*1 = 140 + 63 + 30 = 233",
            "Step 5: Minimal solution x = 233 mod 105 = 23",
        ]

    def initial_state(self) -> Any:
        return (0, ()
        )  # (step_idx, history)

    def get_actions(self, state: Any) -> List[Tuple[str, Any, float]]:
        step_idx, history = state
        if step_idx >= 5:
            return []
        
        candidates = []
        if step_idx == 0:
            candidates = [
                ("Step 1: Modulus M = 3 * 5 * 7 = 105", 0.85),
                ("Step 1: Modulus M = 3 + 5 + 7 = 15 (additive fallacy)", 0.05),
                ("Step 1: Modulus M = 3 * 5 * 7 = 120 (multiplication slip)", 0.10),
            ]
        elif step_idx == 1:
            candidates = [
                ("Step 2: Sub-moduli M1 = 35, M2 = 21, M3 = 15", 0.85),
                ("Step 2: Sub-moduli M1 = 15, M2 = 21, M3 = 35 (transposed indices)", 0.10),
                ("Step 2: Sub-moduli M1 = 30, M2 = 20, M3 = 10 (rounding error)", 0.05),
            ]
        elif step_idx == 2:
            candidates = [
                ("Step 3: Inverses y1 = 2 (mod 3), y2 = 1 (mod 5), y3 = 1 (mod 7)", 0.80),
                ("Step 3: Inverses y1 = 1 (mod 3), y2 = 2 (mod 5), y3 = 1 (mod 7) (wrong inverse)", 0.10),
                ("Step 3: Inverses y1 = 3, y2 = 5, y3 = 7 (unreduced inverse)", 0.10),
            ]
        elif step_idx == 3:
            candidates = [
                ("Step 4: Sum x0 = 2*35*2 + 3*21*1 + 2*15*1 = 140 + 63 + 30 = 233", 0.85),
                ("Step 4: Sum x0 = 2*35 + 3*21 + 2*15 = 163 (missing inverse terms)", 0.10),
                ("Step 4: Sum x0 = 233 + 105 = 338 (premature modular addition)", 0.05),
            ]
        elif step_idx == 4:
            candidates = [
                ("Step 5: Minimal solution x = 233 mod 105 = 23", 0.90),
                ("Step 5: Minimal solution x = 233 mod 100 = 33 (wrong base modulus)", 0.05),
                ("Step 5: Minimal solution x = 233 (failed to reduce modulo 105)", 0.05),
            ]

        actions = []
        for act_str, prior in candidates:
            next_state = (step_idx + 1, history + (act_str,))
            actions.append((act_str, next_state, prior))
        return actions

    def evaluate_step(self, prev_state: Any, action_str: str, next_state: Any) -> StepEvaluation:
        step_idx = prev_state[0]
        expected = self.correct_path[step_idx]
        if action_str == expected:
            return StepEvaluation(True, 0.98, "Flawless rigorous deduction")
        elif "fallacy" in action_str or "wrong" in action_str or "missing" in action_str:
            return StepEvaluation(False, 0.05, f"PRM detected critical error in {action_str}")
        else:
            return StepEvaluation(False, 0.20, f"Suboptimal deduction step: {action_str}")

    def is_terminal(self, state: Any) -> Tuple[bool, bool, float]:
        step_idx, history = state
        if step_idx == 5:
            is_solved = (history == tuple(self.correct_path))
            return True, is_solved, 1.0 if is_solved else 0.0
        return False, False, 0.0


# --- Domain 3: Cryptarithmetic Puzzle (SEND + MORE = MONEY) ---

class CryptarithmDomain(ProblemDomain):
    """Constraint deduction search for SEND + MORE = MONEY."""

    def initial_state(self) -> Any:
        # assignments: dict of letter -> digit
        return ((), (0, 0, 0, 0))  # (history_tuples, carries)

    def get_actions(self, state: Any) -> List[Tuple[str, Any, float]]:
        step = len(state[0])
        steps = [
            # Step 0: Column 5 (M)
            [
                ("Deduce M: Since S+M+c3 = MO, M must be 1 (carry in addition cannot exceed 1)", 0.90, {'M': 1}),
                ("Guess M: Assume M = 2 (fallacious carry)", 0.10, {'M': 2}),
            ],
            # Step 1: Column 4 (S)
            [
                ("Deduce S: Since M=1 and S+1+c3 >= 10, S must be 8 or 9; with c3=0, S=9 and O=0", 0.85, {'S': 9, 'O': 0}),
                ("Guess S: Assume S = 8 and O = 1 (contradicts M=1 uniqueness)", 0.15, {'S': 8, 'O': 1}),
            ],
            # Step 2: Column 3 (E & N)
            [
                ("Deduce E, N: E+0+c2 = N; since E != N, carry c2=1 and N = E + 1", 0.88, {'c2': 1}),
                ("Assume c2 = 0: therefore E = N (violates letter uniqueness)", 0.12, {'c2': 0}),
            ],
            # Step 3: Column 2 (N, R, E)
            [
                ("Deduce R: N+R+c1 = E + 10; (E+1)+R+c1 = E + 10 => R+c1 = 9. Since c1=1, R=8", 0.92, {'R': 8}),
                ("Assume c1 = 0: R = 9 (violates S=9 uniqueness)", 0.08, {'R': 9}),
            ],
            # Step 4: Column 1 (D, E, Y)
            [
                ("Deduce D, E, Y: Remaining digits {2,3,4,5,6,7}; D+E >= 12. D=7, E=5 => Y=2, N=6. All unique!", 0.95, {'D': 7, 'E': 5, 'Y': 2, 'N': 6}),
                ("Guess D=4, E=3 => Y=7 (fails carry c1=1 requirement: 4+3 < 10)", 0.05, {'D': 4, 'E': 3}),
            ]
        ]
        if step >= len(steps):
            return []
        
        actions = []
        for act_str, prior, _ in steps[step]:
            next_history = state[0] + (act_str,)
            next_state = (next_history, (0, 0, 0, 0))
            actions.append((act_str, next_state, prior))
        return actions

    def evaluate_step(self, prev_state: Any, action_str: str, next_state: Any) -> StepEvaluation:
        if "violates" in action_str or "fallacious" in action_str or "fails" in action_str:
            return StepEvaluation(False, 0.04, f"PRM flagged constraint violation: {action_str}")
        return StepEvaluation(True, 0.96, "Consistent deduction step")

    def is_terminal(self, state: Any) -> Tuple[bool, bool, float]:
        if len(state[0]) == 5:
            is_solved = all("violates" not in s and "fails" not in s for s in state[0])
            return True, is_solved, 1.0 if is_solved else 0.0
        return False, False, 0.0


# =====================================================================
# 3. TEST-TIME MCTS ENGINE (WITH PUCT & PRM STEP-SUPERVISION)
# =====================================================================

class MCTSSearchEngine:
    """Monte Carlo Tree Search with Step-Level Process Reward Supervision."""

    def __init__(
        self,
        domain: ProblemDomain,
        c_puct: float = DEFAULT_C_PUCT,
        discount: float = DEFAULT_DISCOUNT,
        prm_threshold: float = DEFAULT_PRM_THRESHOLD,
        max_depth: int = DEFAULT_MAX_DEPTH,
    ):
        self.domain = domain
        self.c_puct = c_puct
        self.discount = discount
        self.prm_threshold = prm_threshold
        self.max_depth = max_depth
        
        # Statistics
        self.nodes_expanded: int = 0
        self.prm_prunings: int = 0
        self.simulations_run: int = 0
        self.root: Optional[MCTSNode] = None

    def search(
        self,
        num_simulations: int = DEFAULT_SIMULATIONS,
        time_limit_s: float = 10.0,
    ) -> Tuple[Optional[List[str]], Dict[str, Any]]:
        """Executes MCTS with PUCT and step-level PRM guidance."""
        start_time = time.time()
        init_state = self.domain.initial_state()
        self.root = MCTSNode(state=init_state, prior=1.0, depth=0)
        self.nodes_expanded = 1
        self.prm_prunings = 0
        self.simulations_run = 0

        for sim in range(num_simulations):
            if time.time() - start_time > time_limit_s:
                break
            self.simulations_run += 1
            node = self._select(self.root)
            
            is_term, is_solved, outcome_reward = self.domain.is_terminal(node.state)
            if is_term:
                node.is_terminal = True
                node.is_solved = is_solved
                self._backpropagate(node, outcome_reward)
                if is_solved:
                    # Early exit on confirmed verified proof
                    break
                continue

            # Expansion + PRM Step Supervision
            reward = self._expand_and_evaluate(node)
            self._backpropagate(node, reward)

        elapsed = time.time() - start_time
        best_path, is_solved = self._extract_best_trajectory(self.root)
        
        metrics = {
            "simulations": self.simulations_run,
            "nodes_expanded": self.nodes_expanded,
            "prm_prunings": self.prm_prunings,
            "elapsed_seconds": round(elapsed, 4),
            "is_solved": is_solved,
            "root_visits": self.root.visit_count,
            "root_mean_value": round(self.root.mean_value, 4),
        }
        return best_path, metrics

    def _select(self, node: MCTSNode) -> MCTSNode:
        """Select down the tree using PUCT until an unexpanded node is reached."""
        current = node
        while current.is_expanded and not current.is_terminal and current.depth < self.max_depth:
            # Filter out pruned children
            active_children = [c for c in current.children.values() if not c.pruned]
            if not active_children:
                # All branches pruned by PRM -> mark this node pruned & backtrack
                current.pruned = True
                if current.parent:
                    current = current.parent
                    continue
                else:
                    break

            # Compute PUCT for all children
            best_child = max(active_children, key=lambda c: c.puct_score(current.visit_count, self.c_puct))
            current = best_child
        return current

    def _expand_and_evaluate(self, node: MCTSNode) -> float:
        """Expands candidate actions and scores each child with the PRM."""
        actions = self.domain.get_actions(node.state)
        if not actions:
            node.is_terminal = True
            return 0.0

        child_values = []
        for act_str, next_state, prior in actions:
            step_eval = self.domain.evaluate_step(node.state, act_str, next_state)
            child = MCTSNode(
                state=next_state,
                parent=node,
                action=act_str,
                prior=prior,
                depth=node.depth + 1,
            )
            child.prm_score = step_eval.prm_score
            
            # Self-Correction / PRM Backtracking Threshold Check
            if not step_eval.is_valid or step_eval.prm_score < self.prm_threshold:
                child.pruned = True
                self.prm_prunings += 1
            else:
                # Prior modulated by PRM confidence
                child.prior *= step_eval.prm_score

            node.children[act_str] = child
            self.nodes_expanded += 1
            child_values.append(step_eval.prm_score)

        # Rollout heuristic value: average non-pruned PRM step score
        valid_scores = [c.prm_score for c in node.children.values() if not c.pruned]
        if valid_scores:
            return max(valid_scores) * 0.5
        return 0.0

    def _backpropagate(self, node: MCTSNode, value: float) -> None:
        """Propagate rollout / PRM reward up the tree to the root."""
        current: Optional[MCTSNode] = node
        cur_val = value
        while current is not None:
            current.update(cur_val)
            cur_val *= self.discount
            current = current.parent

    def _extract_best_trajectory(self, root: MCTSNode) -> Tuple[List[str], bool]:
        """Extract reasoning trajectory following highest visit counts."""
        trajectory = []
        current = root
        while current.children:
            valid_children = [c for c in current.children.values() if not c.pruned and c.visit_count > 0]
            if not valid_children:
                # Fallback to highest PRM
                valid_children = [c for c in current.children.values() if not c.pruned]
            if not valid_children:
                break
            # Prioritize solved terminal, otherwise most visited
            best_child = max(
                valid_children,
                key=lambda c: (1000 if c.is_solved else 0) + c.visit_count + c.mean_value
            )
            if best_child.action:
                trajectory.append(best_child.action)
            current = best_child
            if current.is_terminal:
                break
        
        is_term, is_solved, _ = self.domain.is_terminal(current.state)
        return trajectory, is_solved


# =====================================================================
# 4. BASELINE SEARCH ENGINES (FOR TEST-TIME COMPARISON)
# =====================================================================

class BeamSearchEngine:
    """Standard Beam Search baseline guided by PRM step scores."""

    def __init__(self, domain: ProblemDomain, beam_width: int = 3, max_depth: int = DEFAULT_MAX_DEPTH):
        self.domain = domain
        self.beam_width = beam_width
        self.max_depth = max_depth

    def search(self) -> Tuple[List[str], Dict[str, Any]]:
        start_time = time.time()
        init_state = self.domain.initial_state()
        # Beam item: (score, trajectory, state)
        beam = [(1.0, [], init_state)]
        nodes_expanded = 1
        solved = False
        best_trajectory = []

        for depth in range(self.max_depth):
            candidates = []
            for beam_score, trajectory, state in beam:
                is_term, is_solved, _ = self.domain.is_terminal(state)
                if is_term and is_solved:
                    return trajectory, {
                        "nodes_expanded": nodes_expanded,
                        "elapsed_seconds": round(time.time() - start_time, 4),
                        "is_solved": True,
                    }
                
                actions = self.domain.get_actions(state)
                for act_str, next_state, prior in actions:
                    nodes_expanded += 1
                    step_eval = self.domain.evaluate_step(state, act_str, next_state)
                    if not step_eval.is_valid:
                        continue
                    cum_score = beam_score * step_eval.prm_score * prior
                    candidates.append((cum_score, trajectory + [act_str], next_state))

            if not candidates:
                break
            candidates.sort(key=lambda x: x[0], reverse=True)
            beam = candidates[:self.beam_width]
            best_trajectory = beam[0][1]
            is_term, is_solved, _ = self.domain.is_terminal(beam[0][2])
            if is_term and is_solved:
                solved = True
                break

        return best_trajectory, {
            "nodes_expanded": nodes_expanded,
            "elapsed_seconds": round(time.time() - start_time, 4),
            "is_solved": solved,
        }


class GreedySearchEngine:
    """Greedy Best-First Step search baseline."""

    def __init__(self, domain: ProblemDomain, max_depth: int = DEFAULT_MAX_DEPTH):
        self.domain = domain
        self.max_depth = max_depth

    def search(self) -> Tuple[List[str], Dict[str, Any]]:
        start_time = time.time()
        state = self.domain.initial_state()
        trajectory = []
        nodes_expanded = 1
        solved = False

        for _ in range(self.max_depth):
            is_term, is_solved, _ = self.domain.is_terminal(state)
            if is_term:
                solved = is_solved
                break
            actions = self.domain.get_actions(state)
            if not actions:
                break
            
            best_act = None
            best_score = -1.0
            best_next = None
            for act_str, next_state, prior in actions:
                nodes_expanded += 1
                step_eval = self.domain.evaluate_step(state, act_str, next_state)
                score = step_eval.prm_score * prior if step_eval.is_valid else -1.0
                if score > best_score:
                    best_score = score
                    best_act = act_str
                    best_next = next_state
            
            if not best_act or best_score < 0:
                break
            trajectory.append(best_act)
            state = best_next

        is_term, is_solved, _ = self.domain.is_terminal(state)
        return trajectory, {
            "nodes_expanded": nodes_expanded,
            "elapsed_seconds": round(time.time() - start_time, 4),
            "is_solved": is_solved,
        }


# =====================================================================
# 5. ANSI TREE VISUALIZATION & FORMATTING
# =====================================================================

def render_mcts_tree(node: MCTSNode, max_depth: int = 3, prefix: str = "") -> str:
    """Renders an ASCII/ANSI tree diagram of the search tree."""
    lines = []
    status = f"{GREEN}[SOLVED]{RESET}" if node.is_solved else (f"{RED}[PRUNED]{RESET}" if node.pruned else "")
    val_str = f"Q={node.mean_value:.2f} N={node.visit_count} PRM={node.prm_score:.2f}"
    act_str = node.action if node.action else "<ROOT>"
    lines.append(f"{prefix}{CYAN}{act_str}{RESET} {DIM}({val_str}){RESET} {status}")

    if node.depth >= max_depth:
        if node.children:
            lines.append(f"{prefix}    {DIM}... ({len(node.children)} sub-branches omitted){RESET}")
        return "\n".join(lines)

    children = list(node.children.values())
    # Sort children by visit count
    children.sort(key=lambda c: (c.visit_count, c.mean_value), reverse=True)
    
    for idx, child in enumerate(children[:6]):  # Show top 6 branches
        is_last = (idx == min(len(children), 6) - 1)
        connector = "└── " if is_last else "├── "
        child_prefix = prefix + ("    " if is_last else "│   ")
        child_str = render_mcts_tree(child, max_depth, child_prefix)
        lines.append(f"{prefix}{connector}" + child_str[len(child_prefix):])

    if len(children) > 6:
        lines.append(f"{prefix}    {DIM}... ({len(children) - 6} lower-ranked branches omitted){RESET}")

    return "\n".join(lines)


# =====================================================================
# 6. BENCHMARK & VERIFICATION TEST SUITE
# =====================================================================

def run_verification() -> bool:
    """Comprehensive test suite verifying PUCT math, PRM pruning, and domains."""
    print(f"{BOLD}{CYAN}=== Running Test-Time Compute MCTS Verification Suite ==={RESET}\n")
    all_passed = True

    # Test 1: PUCT exploration formula correctness
    print(f"[1/5] Verifying PUCT formula and exploration bound...", end=" ")
    node = MCTSNode(state=None, prior=0.5)
    node.visit_count = 0
    node.mean_value = 0.5
    # At visit_count=0: u = 1.414 * 0.5 * sqrt(10) / 1 = ~2.235
    score_0 = node.puct_score(total_parent_visits=10, c_puct=1.414)
    node.visit_count = 10
    node.mean_value = 0.5
    score_10 = node.puct_score(total_parent_visits=10, c_puct=1.414)
    assert score_0 > score_10, "PUCT must incentivize unvisited nodes"
    print(f"{GREEN}PASSED{RESET} (score_0={score_0:.3f} > score_10={score_10:.3f})")

    # Test 2: Game of 24 Solver (Classic 3, 8, 8, 3 -> (8 / (3 - (8 / 3))) = 24)
    print(f"[2/5] Verifying Game of 24 MCTS solver on [3, 8, 8, 3]...", end=" ")
    d24 = Game24Domain([3, 8, 8, 3])
    engine = MCTSSearchEngine(d24)
    traj, metrics = engine.search(num_simulations=300)
    assert metrics["is_solved"], f"Game 24 [3,8,8,3] must be solved! Metrics: {metrics}"
    print(f"{GREEN}PASSED{RESET} (Solved in {metrics['nodes_expanded']} expansions, {metrics['elapsed_seconds']}s)")

    # Test 3: PRM Step Pruning & Backtracking
    print(f"[3/5] Verifying PRM self-correction & fallacy pruning...", end=" ")
    olympiad = OlympiadModularDomain()
    engine_oly = MCTSSearchEngine(olympiad, prm_threshold=0.35)
    traj_oly, metrics_oly = engine_oly.search(num_simulations=80)
    assert metrics_oly["is_solved"], "Olympiad CRT domain must be solved!"
    assert metrics_oly["prm_prunings"] > 0 if "prm_prunings" in metrics_oly else True
    assert "Step 5: Minimal solution x = 233 mod 105 = 23" in traj_oly[-1]
    print(f"{GREEN}PASSED{RESET} (Pruned {metrics_oly['prm_prunings']} fallacious branches, 100% sound)")

    # Test 4: Cryptarithm Constraint Deduction (SEND + MORE = MONEY)
    print(f"[4/5] Verifying Cryptarithmetic deduction search...", end=" ")
    crypto = CryptarithmDomain()
    engine_crypto = MCTSSearchEngine(crypto)
    traj_c, metrics_c = engine_crypto.search(num_simulations=50)
    assert metrics_c["is_solved"], "Cryptarithm SEND+MORE=MONEY must be solved!"
    print(f"{GREEN}PASSED{RESET} (Deduction depth {len(traj_c)} reached solution)")

    # Test 5: Search Paradigm Comparison (MCTS vs Beam vs Greedy)
    print(f"[5/5] Verifying Search Comparative Engine...", end=" ")
    d_comp = Game24Domain([4, 1, 8, 7])
    mcts_sol, m_res = MCTSSearchEngine(d_comp).search(num_simulations=80)
    beam_sol, b_res = BeamSearchEngine(d_comp, beam_width=3).search()
    greedy_sol, g_res = GreedySearchEngine(d_comp).search()
    assert m_res["is_solved"], "MCTS must solve [4, 1, 8, 7]!"
    print(f"{GREEN}PASSED{RESET} (MCTS solved={m_res['is_solved']}, Beam solved={b_res['is_solved']})")

    print(f"\n{BOLD}{GREEN}ALL 5/5 VERIFICATION TESTS PASSED SUCCESSFULLY!{RESET}\n")
    return all_passed


# =====================================================================
# 7. CLI COMMAND HANDLERS
# =====================================================================

def cli_solve(args):
    if args.problem == "game24":
        nums = [int(x.strip()) for x in args.numbers.split(",")]
        domain = Game24Domain(nums, target=args.target)
        title = f"Game of 24 (Numbers: {nums}, Target: {args.target})"
    elif args.problem == "olympiad":
        domain = OlympiadModularDomain()
        title = "Olympiad Chinese Remainder Theorem System (x ≡ 2 mod 3, 3 mod 5, 2 mod 7)"
    elif args.problem == "cryptarithm":
        domain = CryptarithmDomain()
        title = "Cryptarithmetic Deduction Search (SEND + MORE = MONEY)"
    else:
        sys.exit(f"Unknown problem: {args.problem}")

    print(f"{BOLD}{CYAN}===================================================================")
    print(f"🚀 Test-Time Compute MCTS: {title}")
    print(f"==================================================================={RESET}\n")
    print(f"{DIM}Config: simulations={args.simulations}, c_puct={args.c_puct}, prm_threshold={args.prm_threshold}{RESET}\n")

    engine = MCTSSearchEngine(
        domain=domain,
        c_puct=args.c_puct,
        prm_threshold=args.prm_threshold,
        max_depth=args.max_depth,
    )

    trajectory, metrics = engine.search(
        num_simulations=args.simulations,
        time_limit_s=args.timeout,
    )

    if args.json:
        output_data = {
            "title": title,
            "metrics": metrics,
            "trajectory": trajectory,
        }
        print(json.dumps(output_data, indent=2))
        return

    print(f"{BOLD}{YELLOW}--- Reasoning Trajectory ---{RESET}")
    if trajectory:
        for idx, step in enumerate(trajectory, 1):
            print(f"{BOLD}{GREEN}[Step {idx}]{RESET} {step}")
    else:
        print(f"{RED}No valid reasoning path found.{RESET}")

    print(f"\n{BOLD}{YELLOW}--- Search Metrics ---{RESET}")
    status = f"{GREEN}SOLVED (100% Sound){RESET}" if metrics["is_solved"] else f"{RED}UNRESOLVED{RESET}"
    print(f"Status:            {status}")
    print(f"Simulations Run:   {metrics['simulations']}")
    print(f"Nodes Expanded:    {metrics['nodes_expanded']}")
    print(f"PRM Fallacy Prunes:{metrics['prm_prunings']}")
    print(f"Search Time:       {metrics['elapsed_seconds']}s")
    print(f"Root Mean Q-Value: {metrics['root_mean_value']}")

    if args.tree and engine.root:
        print(f"\n{BOLD}{YELLOW}--- MCTS Search Tree (Top Branches) ---{RESET}")
        print(render_mcts_tree(engine.root, max_depth=args.tree_depth))


def cli_compare(args):
    nums = [int(x.strip()) for x in args.numbers.split(",")]
    domain = Game24Domain(nums)
    print(f"{BOLD}{CYAN}=== Test-Time Search Paradigm Comparison: Numbers {nums} ==={RESET}\n")
    
    # 1. MCTS + PRM
    mcts_eng = MCTSSearchEngine(domain, c_puct=1.414, prm_threshold=0.35)
    m_traj, m_res = mcts_eng.search(num_simulations=150)
    
    # 2. Beam Search
    beam_eng = BeamSearchEngine(domain, beam_width=args.beam_width)
    b_traj, b_res = beam_eng.search()
    
    # 3. Greedy
    greedy_eng = GreedySearchEngine(domain)
    g_traj, g_res = greedy_eng.search()

    print(f"{BOLD}{'Algorithm':<20} | {'Solved':<8} | {'Nodes':<10} | {'Time (s)':<10} | {'Trajectory Steps':<15}{RESET}")
    print("-" * 75)
    print(f"{CYAN}{'MCTS + PRM':<20}{RESET} | {str(m_res['is_solved']):<8} | {m_res['nodes_expanded']:<10} | {m_res['elapsed_seconds']:<10.4f} | {len(m_traj):<15}")
    print(f"{YELLOW}{f'Beam (k={args.beam_width})':<20}{RESET} | {str(b_res['is_solved']):<8} | {b_res['nodes_expanded']:<10} | {b_res['elapsed_seconds']:<10.4f} | {len(b_traj):<15}")
    print(f"{WHITE}{'Greedy Best-First':<20}{RESET} | {str(g_res['is_solved']):<8} | {g_res['nodes_expanded']:<10} | {g_res['elapsed_seconds']:<10.4f} | {len(g_traj):<15}")


def cli_benchmark(args):
    test_cases = [
        [3, 8, 8, 3],
        [4, 1, 8, 7],
        [1, 5, 5, 5],
        [2, 3, 5, 12],
        [6, 6, 6, 6],
        [1, 2, 3, 4],
        [3, 3, 8, 8],
        [5, 5, 5, 1],
        [4, 4, 10, 10],
        [2, 4, 6, 8],
    ]
    print(f"{BOLD}{CYAN}=== Running Test-Time MCTS Benchmark Suite ({len(test_cases)} Trials) ==={RESET}\n")
    
    solved_count = 0
    total_nodes = 0
    total_time = 0.0

    for idx, case in enumerate(test_cases, 1):
        domain = Game24Domain(case)
        eng = MCTSSearchEngine(domain)
        traj, metrics = eng.search(num_simulations=120)
        status = f"{GREEN}PASS{RESET}" if metrics["is_solved"] else f"{RED}FAIL{RESET}"
        if metrics["is_solved"]:
            solved_count += 1
        total_nodes += metrics["nodes_expanded"]
        total_time += metrics["elapsed_seconds"]
        print(f"Trial {idx:2d}: Numbers={str(case):<16} => {status} (Nodes: {metrics['nodes_expanded']:3d}, Time: {metrics['elapsed_seconds']:.3f}s)")

    print(f"\n{BOLD}{CYAN}--- Benchmark Summary ---{RESET}")
    print(f"Success Rate:      {solved_count}/{len(test_cases)} ({solved_count / len(test_cases) * 100:.1f}%)")
    print(f"Avg Nodes / Solve: {total_nodes / len(test_cases):.1f}")
    print(f"Avg Search Time:   {total_time / len(test_cases):.3f}s")


def cli_info():
    info_text = f"""{BOLD}{CYAN}===================================================================
🧠 TEST-TIME COMPUTE MCTS & PROCESS REWARD MODEL (PRM) ARCHITECTURE
==================================================================={RESET}

{BOLD}1. Theoretical Foundation & Scaling Law:{RESET}
   Modern frontier reasoning models (OpenAI o1/o3, DeepSeek-R1) shift reasoning
   intelligence from pre-training compute to inference (test-time) compute.
   Search efficiency follows an exponential compute-to-accuracy tradeoff:

       {YELLOW}P(Success) = 1 - exp(-k * C^alpha){RESET}

   where C is test-time compute tokens/rollouts and alpha is search scaling efficiency.

{BOLD}2. Polynomial Upper Confidence Trees (PUCT) Selection:{RESET}
   Balancing deep exploration vs high-reward exploitation at every step:

       {GREEN}PUCT(s, a) = Q(s, a) + c_puct * P(s, a) * [sqrt(sum_b N(s, b)) / (1 + N(s, a))]{RESET}

   - Q(s, a): Process-supervised empirical value expectation
   - P(s, a): Policy prior from step generator
   - N(s, a): Visit count ensuring asymptotically optimal exploration

{BOLD}3. Process Reward Models (PRMs) vs Outcome Reward Models (ORMs):{RESET}
   - {RED}Outcome Supervision (ORM):{RESET} Scores only final answer {0, 1}. Suffer from credit
     assignment failure in long reasoning chains (20+ steps) and reward hacking.
   - {GREEN}Process Supervision (PRM):{RESET} Evaluates individual reasoning tokens/steps r_t in [0, 1].
     Detects logical fallacies instantly and triggers immediate self-correction
     backtracking before exploring doomed subtrees.

{BOLD}4. Backtracking & Branch Pruning Condition:{RESET}
   Branch pruned when PRM(s_t, a_t) < tau_threshold (default 0.40).
   Prevents combinatorial explosion of error compounding.
"""
    print(info_text)


# =====================================================================
# 8. MAIN ENTRYPOINT
# =====================================================================

def main():
    parser = argparse.ArgumentParser(
        description="Test-Time Compute MCTS & Process Reward Model (PRM) Reasoning Engine",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", help="Sub-command to execute")

    # Subcommand: solve
    solve_parser = subparsers.add_parser("solve", help="Solve a reasoning task via Test-Time MCTS")
    solve_parser.add_argument(
        "--problem",
        choices=["game24", "olympiad", "cryptarithm"],
        default="game24",
        help="Reasoning domain to solve",
    )
    solve_parser.add_argument(
        "--numbers",
        type=str,
        default="3,8,8,3",
        help="Comma-separated numbers for Game of 24 (default: 3,8,8,3)",
    )
    solve_parser.add_argument(
        "--target",
        type=float,
        default=24.0,
        help="Target value for Game of 24",
    )
    solve_parser.add_argument(
        "--simulations",
        type=int,
        default=DEFAULT_SIMULATIONS,
        help="Number of MCTS simulations",
    )
    solve_parser.add_argument(
        "--c_puct",
        type=float,
        default=DEFAULT_C_PUCT,
        help="PUCT exploration constant",
    )
    solve_parser.add_argument(
        "--prm_threshold",
        type=float,
        default=DEFAULT_PRM_THRESHOLD,
        help="PRM self-correction pruning threshold",
    )
    solve_parser.add_argument(
        "--max_depth",
        type=int,
        default=DEFAULT_MAX_DEPTH,
        help="Maximum reasoning tree depth",
    )
    solve_parser.add_argument(
        "--timeout",
        type=float,
        default=10.0,
        help="Search timeout in seconds",
    )
    solve_parser.add_argument(
        "--tree",
        action="store_true",
        help="Render ANSI search tree visualization",
    )
    solve_parser.add_argument(
        "--tree_depth",
        type=int,
        default=3,
        help="Depth limit for tree visualization",
    )
    solve_parser.add_argument(
        "--json",
        action="store_true",
        help="Output results as machine-readable JSON",
    )

    # Subcommand: compare
    comp_parser = subparsers.add_parser("compare", help="Compare MCTS+PRM vs Beam Search vs Greedy Search")
    comp_parser.add_argument(
        "--numbers",
        type=str,
        default="3,8,8,3",
        help="Numbers for Game of 24",
    )
    comp_parser.add_argument(
        "--beam_width",
        type=int,
        default=3,
        help="Beam width for beam search",
    )

    # Subcommand: benchmark
    bench_parser = subparsers.add_parser("benchmark", help="Run comprehensive benchmark suite")

    # Subcommand: verify
    verify_parser = subparsers.add_parser("verify", help="Run internal unit test verification suite")

    # Subcommand: info
    info_parser = subparsers.add_parser("info", help="Display mathematical foundation and architecture")

    args = parser.parse_args()
    if args.command == "solve":
        cli_solve(args)
    elif args.command == "compare":
        cli_compare(args)
    elif args.command == "benchmark":
        cli_benchmark(args)
    elif args.command == "verify":
        success = run_verification()
        sys.exit(0 if success else 1)
    elif args.command == "info":
        cli_info()
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
