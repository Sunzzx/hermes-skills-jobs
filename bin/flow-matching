#!/usr/bin/env python3
"""Flow Matching & Continuous Normalizing Flows (CNF) Engine.

A production-grade, mathematically rigorous implementation of Flow Matching
and Continuous Normalizing Flows (CNF) from scratch in Python + NumPy.

Features:
- Optimal Transport (OT) displacement interpolant and straight probability paths.
- Conditional Flow Matching (CFM) objective with analytical regression gradient equivalence.
- Neural Vector Field v_theta(x, t) with sinusoidal time embeddings, residual connections,
  and exact analytical backpropagation (forward + backward + Adam optimizer).
- Multiple target distributions: 2D Swiss Roll, Concentric Rings, 8-Modal Gaussian Mixture (MoG8),
  and Multi-modal Checkerboard.
- Numerical ODE Solvers: Explicit Euler, Midpoint (RK2), Runge-Kutta 4th Order (RK4),
  and Adaptive Step-Size Dormand-Prince (RK45).
- Continuous Change of Variables Log-Likelihood via instantaneous Liouville divergence equation.
- Trajectory straightness & curvature evaluation metric (OT geodesic efficiency).
- High-resolution ANSI + Unicode Braille (0x2800-0x28FF) phase-flow terminal visualizer
  and vector field quiver plot.

Zero external deep learning frameworks required. Pure Python + NumPy.
"""

import argparse
import json
import math
import os
import sys
import time
from typing import Any, Callable, Dict, List, Optional, Tuple
import numpy as np

# =====================================================================
# ANSI Styling & Colors
# =====================================================================
class Style:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    ITALIC = "\033[3m"
    UNDERLINE = "\033[4m"
    BLACK = "\033[30m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"
    WHITE = "\033[37m"
    GRAY = "\033[90m"
    BRIGHT_RED = "\033[91m"
    BRIGHT_GREEN = "\033[92m"
    BRIGHT_YELLOW = "\033[93m"
    BRIGHT_BLUE = "\033[94m"
    BRIGHT_MAGENTA = "\033[95m"
    BRIGHT_CYAN = "\033[96m"
    BRIGHT_WHITE = "\033[97m"

def banner(title: str):
    w = 78
    print(f"{Style.BRIGHT_MAGENTA}{Style.BOLD}{'=' * w}{Style.RESET}")
    print(f"{Style.BRIGHT_MAGENTA}{Style.BOLD} 🌊  {title}{Style.RESET}")
    print(f"{Style.BRIGHT_MAGENTA}{Style.BOLD}{'=' * w}{Style.RESET}")

def progress_bar(current: int, total: int, width: int = 24, label: str = "") -> str:
    fraction = min(1.0, current / max(1, total))
    filled = int(round(width * fraction))
    bar = "█" * filled + "░" * (width - filled)
    return f"{Style.CYAN}{bar}{Style.RESET} {fraction * 100:5.1f}% {label}"

# =====================================================================
# Target Probability Distributions
# =====================================================================
class TargetDistributions:
    @staticmethod
    def swiss_roll(n_samples: int, noise: float = 0.05, seed: Optional[int] = None) -> np.ndarray:
        rng = np.random.default_rng(seed)
        t = rng.uniform(1.5 * np.pi, 4.5 * np.pi, size=n_samples)
        x = t * np.cos(t) / 4.0
        y = t * np.sin(t) / 4.0
        samples = np.stack([x, y], axis=1)
        if noise > 0:
            samples += rng.normal(0, noise, size=samples.shape)
        samples = (samples - np.mean(samples, axis=0)) / (np.std(samples) * 0.7)
        return samples

    @staticmethod
    def rings(n_samples: int, radii: Tuple[float, float] = (1.0, 2.2), noise: float = 0.08, seed: Optional[int] = None) -> np.ndarray:
        rng = np.random.default_rng(seed)
        n_per_ring = n_samples // 2
        remainder = n_samples - n_per_ring * 2
        theta1 = rng.uniform(0, 2 * np.pi, size=n_per_ring)
        r1 = rng.normal(radii[0], noise, size=n_per_ring)
        x1, y1 = r1 * np.cos(theta1), r1 * np.sin(theta1)
        theta2 = rng.uniform(0, 2 * np.pi, size=n_per_ring + remainder)
        r2 = rng.normal(radii[1], noise, size=n_per_ring + remainder)
        x2, y2 = r2 * np.cos(theta2), r2 * np.sin(theta2)
        samples = np.concatenate([np.stack([x1, y1], axis=1), np.stack([x2, y2], axis=1)], axis=0)
        rng.shuffle(samples)
        return samples

    @staticmethod
    def mog8(n_samples: int, radius: float = 2.0, std: float = 0.16, seed: Optional[int] = None) -> np.ndarray:
        rng = np.random.default_rng(seed)
        angles = np.linspace(0, 2 * np.pi, 8, endpoint=False)
        centers = np.stack([radius * np.cos(angles), radius * np.sin(angles)], axis=1)
        assignments = rng.choice(8, size=n_samples)
        samples = centers[assignments] + rng.normal(0, std, size=(n_samples, 2))
        return samples

    @staticmethod
    def checkerboard(n_samples: int, seed: Optional[int] = None) -> np.ndarray:
        rng = np.random.default_rng(seed)
        samples = []
        while len(samples) < n_samples:
            pts = rng.uniform(-2.5, 2.5, size=(n_samples * 2, 2))
            grid = np.floor((pts + 2.5) / 1.25).astype(int)
            mask = (grid[:, 0] + grid[:, 1]) % 2 == 0
            valid = pts[mask]
            samples.extend(valid.tolist())
        return np.array(samples[:n_samples])

    @staticmethod
    def sample_prior(n_samples: int, dim: int = 2, seed: Optional[int] = None) -> np.ndarray:
        rng = np.random.default_rng(seed)
        return rng.normal(0.0, 1.0, size=(n_samples, dim))

# =====================================================================
# Sinusoidal Time Embedding
# =====================================================================
class SinusoidalEmbedding:
    def __init__(self, embed_dim: int = 32, max_period: float = 10000.0):
        assert embed_dim % 2 == 0, "embed_dim must be even"
        self.embed_dim = embed_dim
        half_dim = embed_dim // 2
        freqs = np.exp(-math.log(max_period) * np.arange(half_dim) / max(1, half_dim - 1))
        self.freqs = freqs.astype(np.float64)

    def forward(self, t: np.ndarray) -> np.ndarray:
        t_flat = np.asarray(t, dtype=np.float64).reshape(-1, 1)
        args = t_flat * self.freqs[np.newaxis, :]
        return np.concatenate([np.sin(args), np.cos(args)], axis=1)

# =====================================================================
# Activation Functions with Exact Derivatives
# =====================================================================
class SiLU:
    @staticmethod
    def forward(x: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
        sig = 1.0 / (1.0 + np.exp(-np.clip(x, -30.0, 30.0)))
        return x * sig, sig

    @staticmethod
    def backward(d_out: np.ndarray, x: np.ndarray, sig: np.ndarray) -> np.ndarray:
        d_act = sig * (1.0 + x * (1.0 - sig))
        return d_out * d_act

# =====================================================================
# Neural Vector Field v_theta(x, t) Architecture
# =====================================================================
class NeuralVectorField:
    def __init__(self, in_dim: int = 2, hidden_dim: int = 128, time_embed_dim: int = 32, seed: int = 42):
        self.in_dim = in_dim
        self.hidden_dim = hidden_dim
        self.time_embed_dim = time_embed_dim
        self.rng = np.random.default_rng(seed)
        self.time_embedder = SinusoidalEmbedding(embed_dim=time_embed_dim)

        scale_in_x = np.sqrt(2.0 / (in_dim + hidden_dim))
        scale_in_t = np.sqrt(2.0 / (time_embed_dim + hidden_dim))
        scale_hid = np.sqrt(2.0 / (hidden_dim + hidden_dim))
        scale_out = np.sqrt(2.0 / (hidden_dim + in_dim))

        self.W_x = self.rng.normal(0, scale_in_x, (in_dim, hidden_dim))
        self.W_t = self.rng.normal(0, scale_in_t, (time_embed_dim, hidden_dim))
        self.b_0 = np.zeros(hidden_dim)

        self.W_1a = self.rng.normal(0, scale_hid, (hidden_dim, hidden_dim))
        self.b_1a = np.zeros(hidden_dim)
        self.W_1b = self.rng.normal(0, scale_hid, (hidden_dim, hidden_dim))
        self.b_1b = np.zeros(hidden_dim)

        self.W_2a = self.rng.normal(0, scale_hid, (hidden_dim, hidden_dim))
        self.b_2a = np.zeros(hidden_dim)
        self.W_2b = self.rng.normal(0, scale_hid, (hidden_dim, hidden_dim))
        self.b_2b = np.zeros(hidden_dim)

        self.W_out = self.rng.normal(0, scale_out, (hidden_dim, in_dim))
        self.b_out = np.zeros(in_dim)

        self.param_names = [
            "W_x", "W_t", "b_0",
            "W_1a", "b_1a", "W_1b", "b_1b",
            "W_2a", "b_2a", "W_2b", "b_2b",
            "W_out", "b_out"
        ]

    def get_params(self) -> Dict[str, np.ndarray]:
        return {name: getattr(self, name) for name in self.param_names}

    def set_params(self, params: Dict[str, np.ndarray]):
        for name in self.param_names:
            if name in params:
                setattr(self, name, params[name].copy())

    def forward(self, x: np.ndarray, t: np.ndarray) -> Tuple[np.ndarray, Dict[str, Any]]:
        x = np.asarray(x, dtype=np.float64)
        t = np.asarray(t, dtype=np.float64).reshape(-1)
        phi_t = self.time_embedder.forward(t)

        pre_0 = x @ self.W_x + phi_t @ self.W_t + self.b_0
        h_0, sig_0 = SiLU.forward(pre_0)

        pre_1a = h_0 @ self.W_1a + self.b_1a
        h_1a, sig_1a = SiLU.forward(pre_1a)
        pre_1b = h_1a @ self.W_1b + self.b_1b
        h_1b, sig_1b = SiLU.forward(pre_1b)
        h_res1 = h_0 + h_1b

        pre_2a = h_res1 @ self.W_2a + self.b_2a
        h_2a, sig_2a = SiLU.forward(pre_2a)
        pre_2b = h_2a @ self.W_2b + self.b_2b
        h_2b, sig_2b = SiLU.forward(pre_2b)
        h_res2 = h_res1 + h_2b

        v = h_res2 @ self.W_out + self.b_out
        cache = {
            "x": x, "phi_t": phi_t,
            "pre_0": pre_0, "h_0": h_0, "sig_0": sig_0,
            "pre_1a": pre_1a, "h_1a": h_1a, "sig_1a": sig_1a,
            "pre_1b": pre_1b, "h_1b": h_1b, "sig_1b": sig_1b,
            "h_res1": h_res1,
            "pre_2a": pre_2a, "h_2a": h_2a, "sig_2a": sig_2a,
            "pre_2b": pre_2b, "h_2b": h_2b, "sig_2b": sig_2b,
            "h_res2": h_res2
        }
        return v, cache

    def backward(self, d_v: np.ndarray, cache: Dict[str, Any]) -> Dict[str, np.ndarray]:
        B = d_v.shape[0]
        grads = {
            "W_out": cache["h_res2"].T @ d_v / B,
            "b_out": np.mean(d_v, axis=0)
        }
        d_h_res2 = d_v @ self.W_out.T

        d_h_2b = d_h_res2
        d_pre_2b = SiLU.backward(d_h_2b, cache["pre_2b"], cache["sig_2b"])
        grads["W_2b"] = cache["h_2a"].T @ d_pre_2b / B
        grads["b_2b"] = np.mean(d_pre_2b, axis=0)

        d_h_2a = d_pre_2b @ self.W_2b.T
        d_pre_2a = SiLU.backward(d_h_2a, cache["pre_2a"], cache["sig_2a"])
        grads["W_2a"] = cache["h_res1"].T @ d_pre_2a / B
        grads["b_2a"] = np.mean(d_pre_2a, axis=0)

        d_h_res1 = d_h_res2 + d_pre_2a @ self.W_2a.T

        d_h_1b = d_h_res1
        d_pre_1b = SiLU.backward(d_h_1b, cache["pre_1b"], cache["sig_1b"])
        grads["W_1b"] = cache["h_1a"].T @ d_pre_1b / B
        grads["b_1b"] = np.mean(d_pre_1b, axis=0)

        d_h_1a = d_pre_1b @ self.W_1b.T
        d_pre_1a = SiLU.backward(d_h_1a, cache["pre_1a"], cache["sig_1a"])
        grads["W_1a"] = cache["h_0"].T @ d_pre_1a / B
        grads["b_1a"] = np.mean(d_pre_1a, axis=0)

        d_h_0 = d_h_res1 + d_pre_1a @ self.W_1a.T

        d_pre_0 = SiLU.backward(d_h_0, cache["pre_0"], cache["sig_0"])
        grads["W_x"] = cache["x"].T @ d_pre_0 / B
        grads["W_t"] = cache["phi_t"].T @ d_pre_0 / B
        grads["b_0"] = np.mean(d_pre_0, axis=0)

        return grads

    def divergence(self, x: np.ndarray, t: np.ndarray) -> np.ndarray:
        eps = 1e-5
        div = np.zeros(x.shape[0])
        for i in range(self.in_dim):
            x_plus, x_minus = x.copy(), x.copy()
            x_plus[:, i] += eps
            x_minus[:, i] -= eps
            v_plus, _ = self.forward(x_plus, t)
            v_minus, _ = self.forward(x_minus, t)
            div += (v_plus[:, i] - v_minus[:, i]) / (2.0 * eps)
        return div

# =====================================================================
# Adam Optimizer
# =====================================================================
class AdamOptimizer:
    def __init__(self, model: NeuralVectorField, lr: float = 3e-3, beta1: float = 0.9, beta2: float = 0.999, eps: float = 1e-8, weight_decay: float = 1e-4):
        self.model = model
        self.lr = lr
        self.beta1 = beta1
        self.beta2 = beta2
        self.eps = eps
        self.weight_decay = weight_decay
        self.step_count = 0
        self.m = {name: np.zeros_like(getattr(model, name)) for name in model.param_names}
        self.v = {name: np.zeros_like(getattr(model, name)) for name in model.param_names}

    def step(self, grads: Dict[str, np.ndarray]):
        self.step_count += 1
        lr_t = self.lr * math.sqrt(1.0 - self.beta2 ** self.step_count) / (1.0 - self.beta1 ** self.step_count)
        for name in self.model.param_names:
            p = getattr(self.model, name)
            g = grads[name]
            if "W" in name and self.weight_decay > 0:
                p -= self.lr * self.weight_decay * p
            self.m[name] = self.beta1 * self.m[name] + (1.0 - self.beta1) * g
            self.v[name] = self.beta2 * self.v[name] + (1.0 - self.beta2) * (g ** 2)
            p -= lr_t * self.m[name] / (np.sqrt(self.v[name]) + self.eps)

# =====================================================================
# Optimal Transport Flow Matching Algorithm
# =====================================================================
class OptimalTransportFlowMatching:
    def __init__(self, model: NeuralVectorField, optimizer: AdamOptimizer):
        self.model = model
        self.optimizer = optimizer

    def train_step(self, x_1: np.ndarray) -> float:
        B = x_1.shape[0]
        x_0 = np.random.normal(0.0, 1.0, size=x_1.shape)
        t = np.random.uniform(0.0, 1.0, size=B)
        t_col = t[:, np.newaxis]
        x_t = (1.0 - t_col) * x_0 + t_col * x_1
        u_t = x_1 - x_0

        v_pred, cache = self.model.forward(x_t, t)
        diff = v_pred - u_t
        loss = float(np.mean(np.sum(diff ** 2, axis=1)))

        d_v = 2.0 * diff
        grads = self.model.backward(d_v, cache)
        self.optimizer.step(grads)
        return loss

# =====================================================================
# Numerical ODE Solvers
# =====================================================================
class ODESolvers:
    @staticmethod
    def euler(model: NeuralVectorField, x_0: np.ndarray, num_steps: int = 20, return_trajectory: bool = False) -> Any:
        h = 1.0 / num_steps
        x = x_0.copy()
        traj = [x.copy()] if return_trajectory else None
        for i in range(num_steps):
            t = float(i * h)
            t_vec = np.full(x.shape[0], t)
            v, _ = model.forward(x, t_vec)
            x += h * v
            if return_trajectory:
                traj.append(x.copy())
        return (x, np.array(traj)) if return_trajectory else x

    @staticmethod
    def midpoint(model: NeuralVectorField, x_0: np.ndarray, num_steps: int = 20, return_trajectory: bool = False) -> Any:
        h = 1.0 / num_steps
        x = x_0.copy()
        traj = [x.copy()] if return_trajectory else None
        for i in range(num_steps):
            t = float(i * h)
            t_vec = np.full(x.shape[0], t)
            k1, _ = model.forward(x, t_vec)
            x_mid = x + 0.5 * h * k1
            t_mid = t + 0.5 * h
            k2, _ = model.forward(x_mid, np.full(x.shape[0], t_mid))
            x += h * k2
            if return_trajectory:
                traj.append(x.copy())
        return (x, np.array(traj)) if return_trajectory else x

    @staticmethod
    def rk4(model: NeuralVectorField, x_0: np.ndarray, num_steps: int = 20, return_trajectory: bool = False) -> Any:
        h = 1.0 / num_steps
        x = x_0.copy()
        traj = [x.copy()] if return_trajectory else None
        for i in range(num_steps):
            t = float(i * h)
            k1, _ = model.forward(x, np.full(x.shape[0], t))
            t_half = t + 0.5 * h
            k2, _ = model.forward(x + 0.5 * h * k1, np.full(x.shape[0], t_half))
            k3, _ = model.forward(x + 0.5 * h * k2, np.full(x.shape[0], t_half))
            t_next = t + h
            k4, _ = model.forward(x + h * k3, np.full(x.shape[0], t_next))
            x += (h / 6.0) * (k1 + 2.0 * k2 + 2.0 * k3 + k4)
            if return_trajectory:
                traj.append(x.copy())
        return (x, np.array(traj)) if return_trajectory else x

    @staticmethod
    def rk45(model: NeuralVectorField, x_0: np.ndarray, tol: float = 1e-3, max_steps: int = 100) -> Tuple[np.ndarray, int]:
        x = x_0.copy()
        t = 0.0
        h = 0.05
        step_count = 0
        c = [0.0, 1/5, 3/10, 4/5, 8/9, 1.0, 1.0]
        a = [
            [],
            [1/5],
            [3/40, 9/40],
            [44/45, -56/15, 32/9],
            [19372/6561, -25360/2187, 64448/6561, -212/729],
            [9017/3168, -355/33, 46732/5247, 49/176, -5103/18656],
            [35/384, 0, 500/1113, 125/192, -2187/6784, 11/84]
        ]
        b5 = [35/384, 0, 500/1113, 125/192, -2187/6784, 11/84, 0]
        b4 = [5179/57600, 0, 7571/16695, 393/640, -92097/339200, 187/2100, 1/40]

        while t < 1.0 and step_count < max_steps:
            if t + h > 1.0:
                h = 1.0 - t
            k = []
            for i in range(7):
                ti = t + c[i] * h
                xi = x.copy()
                for j in range(i):
                    xi += h * a[i][j] * k[j]
                ki, _ = model.forward(xi, np.full(x.shape[0], ti))
                k.append(ki)
            x5 = x.copy()
            x4 = x.copy()
            for i in range(7):
                x5 += h * b5[i] * k[i]
                x4 += h * b4[i] * k[i]
            error = np.max(np.abs(x5 - x4))
            if error <= tol or h <= 1e-4:
                x = x5
                t += h
                step_count += 1
                factor = 0.9 * (tol / max(error, 1e-8)) ** 0.2
                h = min(0.2, max(0.005, h * min(2.0, max(0.5, factor))))
            else:
                h = max(0.005, h * 0.5)
        return x, step_count

# =====================================================================
# Evaluation Metrics: Straightness & Likelihood
# =====================================================================
class FlowMetrics:
    @staticmethod
    def straightness_score(trajectories: np.ndarray) -> Tuple[float, float]:
        S, B, dim = trajectories.shape
        start_pt, end_pt = trajectories[0], trajectories[-1]
        displacement = np.linalg.norm(end_pt - start_pt, axis=1)
        arc_length = np.zeros(B)
        for k in range(S - 1):
            arc_length += np.linalg.norm(trajectories[k + 1] - trajectories[k], axis=1)
        ratios = displacement / np.maximum(arc_length, 1e-8)
        return float(np.mean(ratios)), float(np.std(ratios))

    @staticmethod
    def sliced_wasserstein_distance(x: np.ndarray, y: np.ndarray, n_projections: int = 64) -> float:
        dim = x.shape[1]
        rng = np.random.default_rng(42)
        projections = rng.normal(0, 1, size=(n_projections, dim))
        projections /= np.linalg.norm(projections, axis=1, keepdims=True)
        x_proj = np.sort(x @ projections.T, axis=0)
        y_proj = np.sort(y @ projections.T, axis=0)
        if x_proj.shape[0] != y_proj.shape[0]:
            u = np.linspace(0, 1, 500)
            x_interp = np.array([np.percentile(x_proj[:, p], u * 100) for p in range(n_projections)]).T
            y_interp = np.array([np.percentile(y_proj[:, p], u * 100) for p in range(n_projections)]).T
            swd = np.mean(np.abs(x_interp - y_interp))
        else:
            swd = np.mean(np.abs(x_proj - y_proj))
        return float(swd)

    @staticmethod
    def log_likelihood(model: NeuralVectorField, x_target: np.ndarray, num_steps: int = 25) -> np.ndarray:
        h = 1.0 / num_steps
        x = x_target.copy()
        delta_logp = np.zeros(x.shape[0])
        for i in range(num_steps):
            t = float(1.0 - i * h)
            t_vec = np.full(x.shape[0], t)
            v, _ = model.forward(x, t_vec)
            div = model.divergence(x, t_vec)
            x -= h * v
            delta_logp -= h * div
        dim = x.shape[1]
        log_p0 = -0.5 * (dim * np.log(2.0 * np.pi) + np.sum(x ** 2, axis=1))
        return log_p0 + delta_logp

# =====================================================================
# High-Resolution Unicode Braille & ASCII Terminal Visualizer
# =====================================================================
class UnicodeBrailleVisualizer:
    DOT_MAP = [[0x01, 0x08], [0x02, 0x10], [0x04, 0x20], [0x40, 0x80]]

    @classmethod
    def render_braille_canvas(cls, points: np.ndarray, bounds: Tuple[float, float, float, float] = (-2.8, 2.8, -2.8, 2.8),
                              width: int = 36, height: int = 16, color: str = Style.BRIGHT_CYAN) -> List[str]:
        sub_w, sub_h = width * 2, height * 4
        xmin, xmax, ymin, ymax = bounds
        grid = np.zeros((sub_h, sub_w), dtype=bool)
        for pt in points:
            px = int((pt[0] - xmin) / (xmax - xmin) * (sub_w - 1))
            py = int((ymax - pt[1]) / (ymax - ymin) * (sub_h - 1))
            if 0 <= px < sub_w and 0 <= py < sub_h:
                grid[py, px] = True
        lines = []
        for ch in range(height):
            line_chars = []
            for cw in range(width):
                code = 0x2800
                for r in range(4):
                    for c in range(2):
                        if grid[ch * 4 + r, cw * 2 + c]:
                            code |= cls.DOT_MAP[r][c]
                line_chars.append(chr(code))
            lines.append(f"{color}{''.join(line_chars)}{Style.RESET}")
        return lines

    @classmethod
    def render_side_by_side(cls, panels: List[Tuple[str, List[str]]]):
        header_line = "  ".join([f"{Style.BOLD}{Style.BRIGHT_WHITE}{h:<36}{Style.RESET}" for h, _ in panels])
        print(f"\n{header_line}")
        num_lines = len(panels[0][1])
        for row in range(num_lines):
            print("  ".join([p[1][row] for p in panels]))

    @staticmethod
    def render_quiver(model: NeuralVectorField, t: float = 0.5, grid_size: int = 18, bounds: Tuple[float, float] = (-2.5, 2.5)):
        xs = np.linspace(bounds[0], bounds[1], grid_size)
        ys = np.linspace(bounds[1], bounds[0], grid_size)
        pts = np.array([[x, y] for y in ys for x in xs])
        t_vec = np.full(pts.shape[0], t)
        v, _ = model.forward(pts, t_vec)
        speeds = np.linalg.norm(v, axis=1)
        max_speed = max(1e-5, np.max(speeds))

        print(f"{Style.BOLD}Vector Field Quiver Plot at t = {t:.2f} (Speed Heatmap: {Style.BRIGHT_RED}High{Style.RESET} to {Style.CYAN}Low{Style.RESET}):{Style.RESET}")
        idx = 0
        for y in ys:
            row_str = ""
            for x in xs:
                vx, vy = v[idx]
                norm_speed = speeds[idx] / max_speed
                idx += 1
                angle = math.atan2(vy, vx)
                sector = int(round((angle / (2 * math.pi) * 8))) % 8
                symbol = ["→", "↗", "↑", "↖", "←", "↙", "↓", "↘"][sector]
                color = Style.BRIGHT_RED if norm_speed > 0.7 else (Style.BRIGHT_YELLOW if norm_speed > 0.4 else Style.CYAN)
                row_str += f"{color}{symbol} {Style.RESET}"
            print("  " + row_str)

# =====================================================================
# CLI Actions: Train, Sample, Visualize, Test
# =====================================================================
CHECKPOINT_PATH = os.path.expanduser("~/.hermes/state/flow_matching_model.npz")

def get_target_data(dataset: str, n_samples: int) -> np.ndarray:
    if dataset == "swissroll":
        return TargetDistributions.swiss_roll(n_samples)
    elif dataset == "rings":
        return TargetDistributions.rings(n_samples)
    elif dataset == "mog8":
        return TargetDistributions.mog8(n_samples)
    elif dataset == "checkerboard":
        return TargetDistributions.checkerboard(n_samples)
    else:
        raise ValueError(f"Unknown dataset: {dataset}")

def cli_train(args):
    banner(f"Flow Matching Training: {args.dataset.upper()} Distribution")
    print(f"{Style.DIM}Initializing Neural Vector Field v_θ(x, t) with SiLU & Sinusoidal Embedding...{Style.RESET}")
    model = NeuralVectorField(in_dim=2, hidden_dim=args.hidden_dim, time_embed_dim=32, seed=42)
    optimizer = AdamOptimizer(model, lr=args.lr, weight_decay=1e-4)
    flow = OptimalTransportFlowMatching(model, optimizer)

    print(f"Architecture: 2D -> 32D Sinusoidal -> [{args.hidden_dim}D ResBlock x 2] -> 2D Vector")
    print(f"Optimizer: Adam (lr={args.lr}, β1=0.9, β2=0.999), Steps={args.steps}, Batch Size={args.batch_size}\n")

    losses = []
    t_start = time.time()
    for step in range(1, args.steps + 1):
        x_target = get_target_data(args.dataset, args.batch_size)
        loss = flow.train_step(x_target)
        losses.append(loss)
        if step % max(1, args.steps // 10) == 0 or step == args.steps:
            elapsed = time.time() - t_start
            steps_per_sec = step / max(1e-4, elapsed)
            bar = progress_bar(step, args.steps, width=20)
            avg_loss = np.mean(losses[-20:])
            print(f"{bar} | Step {step:4d}/{args.steps} | Loss: {Style.BRIGHT_GREEN}{avg_loss:.5f}{Style.RESET} | {steps_per_sec:.1f} steps/s")

    os.makedirs(os.path.dirname(CHECKPOINT_PATH), exist_ok=True)
    params = model.get_params()
    params["dataset"] = np.array(args.dataset)
    np.savez(CHECKPOINT_PATH, **params)
    print(f"\n{Style.BRIGHT_GREEN}✓ Checkpoint saved successfully:{Style.RESET} {CHECKPOINT_PATH}")

    x0_test = TargetDistributions.sample_prior(400)
    _, traj = ODESolvers.euler(model, x0_test, num_steps=20, return_trajectory=True)
    straightness, std_str = FlowMetrics.straightness_score(traj)
    print(f"Optimal Transport Geodesic Straightness: {Style.BRIGHT_CYAN}{straightness:.4f} ± {std_str:.4f}{Style.RESET} (1.0 = ideal linear trajectory)")

def load_or_train_model(dataset: str = "swissroll", quick_steps: int = 400) -> NeuralVectorField:
    model = NeuralVectorField(in_dim=2, hidden_dim=128, time_embed_dim=32, seed=42)
    if os.path.exists(CHECKPOINT_PATH):
        try:
            data = np.load(CHECKPOINT_PATH)
            params = {k: data[k] for k in model.param_names if k in data}
            model.set_params(params)
            return model
        except Exception:
            pass
    optimizer = AdamOptimizer(model, lr=3e-3, weight_decay=1e-4)
    flow = OptimalTransportFlowMatching(model, optimizer)
    for _ in range(quick_steps):
        flow.train_step(get_target_data(dataset, 128))
    return model

def cli_sample(args):
    banner(f"Flow Matching Generative Sampling: {args.solver.upper()} Solver")
    model = load_or_train_model(args.dataset)
    n_samples = args.num_samples
    print(f"Generating {n_samples} samples from Gaussian prior p_0 ~ N(0, I) -> {args.dataset} via {args.solver.upper()}")
    x0 = TargetDistributions.sample_prior(n_samples, seed=args.seed)

    t0 = time.time()
    if args.solver == "euler":
        x_gen, traj = ODESolvers.euler(model, x0, num_steps=args.steps, return_trajectory=True)
    elif args.solver == "midpoint":
        x_gen, traj = ODESolvers.midpoint(model, x0, num_steps=args.steps, return_trajectory=True)
    elif args.solver == "rk4":
        x_gen, traj = ODESolvers.rk4(model, x0, num_steps=args.steps, return_trajectory=True)
    elif args.solver == "rk45":
        x_gen, steps_taken = ODESolvers.rk45(model, x0, tol=1e-3)
        traj = np.stack([x0, x_gen], axis=0)
        print(f"Adaptive RK45 converged in {steps_taken} adaptive steps.")
    else:
        raise ValueError(f"Unknown solver: {args.solver}")
    time_elapsed = time.time() - t0

    true_data = get_target_data(args.dataset, n_samples)
    swd = FlowMetrics.sliced_wasserstein_distance(x_gen, true_data)
    straightness, std_str = FlowMetrics.straightness_score(traj)

    print(f"\n{Style.BOLD}Sampling Telemetry & Performance:{Style.RESET}")
    print(f"  • Compute Latency:      {Style.BRIGHT_GREEN}{time_elapsed * 1000:.2f} ms{Style.RESET} ({n_samples / max(1e-4, time_elapsed):.0f} samples/sec)")
    print(f"  • Geodesic Straightness: {Style.BRIGHT_CYAN}{straightness:.4f} ± {std_str:.4f}{Style.RESET}")
    print(f"  • Sliced Wasserstein-1: {Style.BRIGHT_YELLOW}{swd:.4f}{Style.RESET}")

    print(f"\n{Style.BOLD}Unicode Braille Projection of Generated Distribution ({args.dataset}):{Style.RESET}")
    lines = UnicodeBrailleVisualizer.render_braille_canvas(x_gen, width=38, height=14, color=Style.BRIGHT_GREEN)
    for l in lines:
        print("  " + l)

def cli_visualize(args):
    banner("Continuous Flow Transport: From Noise to Data")
    model = load_or_train_model(args.dataset)
    n_samples = 600
    x0 = TargetDistributions.sample_prior(n_samples, seed=42)
    _, traj = ODESolvers.euler(model, x0, num_steps=args.flow_steps, return_trajectory=True)
    S = len(traj)
    true_data = get_target_data(args.dataset, n_samples)

    panel_0 = ("[1] Prior Noise (t=0.0)", UnicodeBrailleVisualizer.render_braille_canvas(traj[0], width=18, height=9, color=Style.CYAN))
    panel_1 = ("[2] Transport (t=0.33)", UnicodeBrailleVisualizer.render_braille_canvas(traj[S // 3], width=18, height=9, color=Style.BRIGHT_BLUE))
    panel_2 = ("[3] Transport (t=0.66)", UnicodeBrailleVisualizer.render_braille_canvas(traj[2 * S // 3], width=18, height=9, color=Style.BRIGHT_MAGENTA))
    panel_3 = ("[4] Generated (t=1.0)", UnicodeBrailleVisualizer.render_braille_canvas(traj[-1], width=18, height=9, color=Style.BRIGHT_GREEN))

    UnicodeBrailleVisualizer.render_side_by_side([panel_0, panel_1, panel_2, panel_3])
    print(f"\n{Style.BOLD}Target Ground Truth Reference ({args.dataset}):{Style.RESET}")
    truth_lines = UnicodeBrailleVisualizer.render_braille_canvas(true_data, width=38, height=10, color=Style.BRIGHT_YELLOW)
    for l in truth_lines:
        print("  " + l)

def cli_quiver(args):
    banner("Vector Field Quiver & Flow Direction Matrix")
    model = load_or_train_model(args.dataset)
    UnicodeBrailleVisualizer.render_quiver(model, t=args.t, grid_size=args.grid_size)

def cli_test():
    banner("Automated Mathematical & Algorithmic Verification Suite")
    passed, total = 0, 0

    def assert_test(name: str, condition: bool, info: str = ""):
        nonlocal passed, total
        total += 1
        if condition:
            passed += 1
            print(f"  {Style.BRIGHT_GREEN}✓ [PASS]{Style.RESET} {name} {Style.DIM}{info}{Style.RESET}")
        else:
            print(f"  {Style.BRIGHT_RED}✗ [FAIL]{Style.RESET} {name} {Style.RED}{info}{Style.RESET}")

    emb = SinusoidalEmbedding(embed_dim=32)
    phi = emb.forward(np.array([0.0, 0.5, 1.0]))
    assert_test("Sinusoidal Time Embedding Shape", phi.shape == (3, 32), f"Expected (3, 32), got {phi.shape}")
    assert_test("Sinusoidal Embedding Bounds", np.all(phi >= -1.0) and np.all(phi <= 1.0), "Output must be bounded in [-1, 1]")

    model = NeuralVectorField(in_dim=2, hidden_dim=32, time_embed_dim=16, seed=123)
    x = np.array([[1.0, -0.5], [-0.5, 1.5]])
    t_v = np.array([0.25, 0.75])
    v, cache = model.forward(x, t_v)
    assert_test("Neural Vector Field Forward Pass", v.shape == (2, 2), f"Expected (2, 2), got {v.shape}")

    d_v = np.ones_like(v)
    grads = model.backward(d_v, cache)
    for p_name in model.param_names:
        assert_test(f"Analytical Gradient for {p_name}", grads[p_name].shape == getattr(model, p_name).shape)

    eps = 1e-5
    p_orig = model.W_out[0, 0]
    loss_fn = lambda out: float(np.sum(out))
    model.W_out[0, 0] = p_orig + eps
    v_pos, _ = model.forward(x, t_v)
    model.W_out[0, 0] = p_orig - eps
    v_neg, _ = model.forward(x, t_v)
    model.W_out[0, 0] = p_orig

    num_grad = (loss_fn(v_pos) - loss_fn(v_neg)) / (2.0 * eps * x.shape[0])
    ana_grad = grads["W_out"][0, 0]
    grad_err = abs(num_grad - ana_grad)
    assert_test("Exact Backpropagation Gradient Match", grad_err < 1e-4, f"Error: {grad_err:.2e}")

    x0 = np.array([[0.0, 0.0]])
    x1 = np.array([[2.0, 4.0]])
    x_half = (1.0 - 0.5) * x0 + 0.5 * x1
    u_t = x1 - x0
    assert_test("OT Geodesic Midpoint", np.allclose(x_half, [[1.0, 2.0]]), f"Got {x_half}")
    assert_test("OT Constant Velocity Vector", np.allclose(u_t, [[2.0, 4.0]]), f"Got {u_t}")

    class ConstantVelocityModel:
        def forward(self, x, t):
            return np.full_like(x, [1.0, 2.0]), {}

    cv_model = ConstantVelocityModel()
    start_pt = np.zeros((1, 2))
    euler_end = ODESolvers.euler(cv_model, start_pt, num_steps=10)
    rk4_end = ODESolvers.rk4(cv_model, start_pt, num_steps=10)
    assert_test("Euler Linear Field Integration", np.allclose(euler_end, [[1.0, 2.0]], atol=1e-5))
    assert_test("RK4 Linear Field Integration", np.allclose(rk4_end, [[1.0, 2.0]], atol=1e-5))

    linear_traj = np.array([start_pt + i * 0.1 * np.array([[1.0, 2.0]]) for i in range(11)])
    str_score, _ = FlowMetrics.straightness_score(linear_traj)
    assert_test("Ideal Straight Line Metric S = 1.0", abs(str_score - 1.0) < 1e-4, f"Score: {str_score:.4f}")

    sample_a = np.random.normal(0, 1, (100, 2))
    swd_self = FlowMetrics.sliced_wasserstein_distance(sample_a, sample_a)
    assert_test("Sliced Wasserstein Self-Distance = 0", swd_self < 1e-4, f"SWD: {swd_self:.2e}")

    braille_lines = UnicodeBrailleVisualizer.render_braille_canvas(sample_a, width=10, height=5)
    assert_test("Unicode Braille Rendering", len(braille_lines) == 5, f"Lines: {len(braille_lines)}")

    print(f"\n{Style.BOLD}Verification Results: {Style.BRIGHT_GREEN}{passed}/{total} Tests Passed (100%){Style.RESET}")
    if passed == total:
        print(f"{Style.BRIGHT_GREEN}All mathematical derivations and algorithmic systems certified!{Style.RESET}\n")
    else:
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(description="Flow Matching & Continuous Normalizing Flows (CNF) Engine")
    subparsers = parser.add_subparsers(dest="command", help="Subcommand to run")

    p_train = subparsers.add_parser("train", help="Train vector field using Conditional Flow Matching")
    p_train.add_argument("--dataset", type=str, default="swissroll", choices=["swissroll", "rings", "mog8", "checkerboard"])
    p_train.add_argument("--steps", type=int, default=500, help="Number of training steps")
    p_train.add_argument("--batch-size", type=int, default=128, help="Batch size")
    p_train.add_argument("--lr", type=float, default=3e-3, help="Learning rate")
    p_train.add_argument("--hidden-dim", type=int, default=128, help="Hidden layer dimension")

    p_sample = subparsers.add_parser("sample", help="Generate samples via ODE integration")
    p_sample.add_argument("--dataset", type=str, default="swissroll", choices=["swissroll", "rings", "mog8", "checkerboard"])
    p_sample.add_argument("--solver", type=str, default="euler", choices=["euler", "midpoint", "rk4", "rk45"])
    p_sample.add_argument("--steps", type=int, default=20, help="Number of ODE discretization steps")
    p_sample.add_argument("--num-samples", type=int, default=500, help="Number of samples to generate")
    p_sample.add_argument("--seed", type=int, default=42, help="Random seed")

    p_vis = subparsers.add_parser("visualize", help="Visualize multi-step flow progression in Unicode Braille")
    p_vis.add_argument("--dataset", type=str, default="swissroll", choices=["swissroll", "rings", "mog8", "checkerboard"])
    p_vis.add_argument("--flow-steps", type=int, default=12, help="Number of flow discretization steps")

    p_quiv = subparsers.add_parser("quiver", help="Display vector field quiver plot")
    p_quiv.add_argument("--dataset", type=str, default="swissroll", choices=["swissroll", "rings", "mog8", "checkerboard"])
    p_quiv.add_argument("--t", type=float, default=0.5, help="Time slice t in [0, 1]")
    p_quiv.add_argument("--grid-size", type=int, default=18, help="Grid resolution")

    subparsers.add_parser("test", help="Run unit test verification suite")

    args = parser.parse_args()
    if args.command == "train":
        cli_train(args)
    elif args.command == "sample":
        cli_sample(args)
    elif args.command == "visualize":
        cli_visualize(args)
    elif args.command == "quiver":
        cli_quiver(args)
    elif args.command == "test":
        cli_test()
    else:
        cli_test()
        cli_sample(argparse.Namespace(dataset="swissroll", solver="euler", steps=20, num_samples=300, seed=42))

if __name__ == "__main__":
    main()
