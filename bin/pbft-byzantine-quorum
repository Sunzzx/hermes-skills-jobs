#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""pbft-byzantine-quorum: Practical Byzantine Fault Tolerance (Castro & Liskov).

Production-grade PBFT reference (OSDI 1999 / TOCS 2002) for n = 3f+1 replicas:

  • Client request authentication via MAC-style digests (pure-Python SHA-256)
  • Primary rotation: primary = view mod n
  • Three-phase agreement: PRE-PREPARE → PREPARE → COMMIT
  • Quorums: prepare/commit certificates need 2f+1 matching digests
  • View-change + NEW-VIEW with prepared-certificate recovery
  • Periodic checkpoints (stable watermark) every k sequence numbers
  • Linearizable replicated KV (SET/GET/INCR/CAS/DEL/APPEND)
  • Discrete-event network: drop, delay, partition
  • Byzantine models: crash-stop, mute, equivocate
  • Invariants: agreement, validity, quorum intersection
  • CLI: selftest | simulate | chaos | bench | theory | status | explain

Pure Python 3 stdlib only.

References:
  - Castro & Liskov, Practical Byzantine Fault Tolerance, OSDI 1999
  - Castro & Liskov, TOCS 2002
  - Castro, PhD thesis, MIT 2001
"""

from __future__ import annotations

import argparse
import hashlib
import json
import random
import sys
import time
from collections import defaultdict, deque
from dataclasses import dataclass, field
from enum import Enum
from typing import Any, Deque, Dict, List, Optional, Set, Tuple


def digest(*parts: Any) -> str:
    h = hashlib.sha256()
    for p in parts:
        if isinstance(p, (bytes, bytearray)):
            h.update(p)
        else:
            h.update(json.dumps(p, sort_keys=True, separators=(",", ":"), default=str).encode())
        h.update(b"|")
    return h.hexdigest()[:16]


def max_faults(n: int) -> int:
    return (n - 1) // 3


def pbft_quorum(n: int) -> int:
    f = max_faults(n)
    return 2 * f + 1


class MsgType(str, Enum):
    REQUEST = "REQUEST"
    PRE_PREPARE = "PRE_PREPARE"
    PREPARE = "PREPARE"
    COMMIT = "COMMIT"
    REPLY = "REPLY"
    VIEW_CHANGE = "VIEW_CHANGE"
    NEW_VIEW = "NEW_VIEW"
    CHECKPOINT = "CHECKPOINT"


@dataclass
class Message:
    mtype: MsgType
    sender: int
    view: int = 0
    seq: int = 0
    digest: str = ""
    payload: Dict[str, Any] = field(default_factory=dict)
    client_id: int = -1
    timestamp: int = 0


class FaultMode(str, Enum):
    HONEST = "honest"
    CRASH = "crash"
    MUTE = "mute"
    EQUIVOCATE = "equivocate"


@dataclass
class ReplicaConfig:
    n: int = 4
    f: int = 1
    checkpoint_interval: int = 5
    seed: int = 42


class KVStateMachine:
    def __init__(self) -> None:
        self.store: Dict[str, Any] = {}
        self.applied: List[Tuple[int, Dict[str, Any], Any]] = []

    def apply(self, seq: int, command: Dict[str, Any]) -> Any:
        op = str(command.get("op", "")).upper()
        key = str(command.get("key", ""))
        val = command.get("val")
        res: Any = None
        if op == "SET":
            self.store[key] = val
            res = val
        elif op == "GET":
            res = self.store.get(key)
        elif op == "INCR":
            cur = self.store.get(key, 0)
            if not isinstance(cur, (int, float)):
                cur = 0
            step = val if isinstance(val, (int, float)) else 1
            cur = cur + step
            self.store[key] = cur
            res = cur
        elif op == "CAS":
            expected = command.get("expected")
            cur = self.store.get(key)
            if cur == expected:
                self.store[key] = val
                res = True
            else:
                res = False
        elif op == "DEL":
            res = self.store.pop(key, None)
        elif op == "APPEND":
            cur = self.store.get(key, "")
            self.store[key] = str(cur) + str(val if val is not None else "")
            res = self.store[key]
        elif op == "NOP":
            res = None
        else:
            res = {"error": f"unknown_op:{op}"}
        self.applied.append((seq, dict(command), res))
        return res

    def snapshot(self) -> Dict[str, Any]:
        return dict(self.store)

    def state_digest(self) -> str:
        return digest(self.store)


class Replica:
    def __init__(self, rid: int, cfg: ReplicaConfig, fault: FaultMode = FaultMode.HONEST) -> None:
        self.id = rid
        self.cfg = cfg
        self.n = cfg.n
        self.f = cfg.f
        self.fault = fault
        self.crashed = False
        self.view = 0
        self.seq_high = 0
        self.last_stable_checkpoint = 0
        self.sm = KVStateMachine()
        self.log_request: Dict[int, Dict[str, Any]] = {}
        self.pre_prepare: Dict[Tuple[int, int], Message] = {}
        self.prepares: Dict[Tuple[int, int, str], Set[int]] = defaultdict(set)
        self.commits: Dict[Tuple[int, int, str], Set[int]] = defaultdict(set)
        self.prepared: Set[Tuple[int, int, str]] = set()
        self.committed_local: Set[Tuple[int, int, str]] = set()
        self.executed_seq = 0
        self.replies: Dict[Tuple[int, int], Any] = {}
        self.client_last_ts: Dict[int, int] = {}
        self.checkpoints: Dict[int, Dict[int, str]] = defaultdict(dict)
        self.stable_checkpoint_digest: Dict[int, str] = {}
        self.view_change_msgs: Dict[int, Dict[int, Message]] = defaultdict(dict)
        self.pending_outbox: List[Message] = []
        self.metrics: Dict[str, int] = defaultdict(int)

    def primary_of(self, view: Optional[int] = None) -> int:
        v = self.view if view is None else view
        return v % self.n

    def is_primary(self) -> bool:
        return self.primary_of() == self.id and not self.crashed

    def _emit(self, msg: Message) -> None:
        if self.crashed or self.fault == FaultMode.MUTE:
            return
        self.pending_outbox.append(msg)
        self.metrics["sent"] += 1

    def arm_crash(self) -> None:
        self.crashed = True
        self.fault = FaultMode.CRASH

    def receive(self, msg: Message) -> List[Message]:
        self.pending_outbox = []
        if self.crashed:
            return []
        self.metrics["recv"] += 1
        handlers = {
            MsgType.REQUEST: self._on_request,
            MsgType.PRE_PREPARE: self._on_pre_prepare,
            MsgType.PREPARE: self._on_prepare,
            MsgType.COMMIT: self._on_commit,
            MsgType.VIEW_CHANGE: self._on_view_change,
            MsgType.NEW_VIEW: self._on_new_view,
            MsgType.CHECKPOINT: self._on_checkpoint,
            MsgType.REPLY: lambda _m: None,
        }
        h = handlers.get(msg.mtype)
        if h:
            h(msg)
        self._try_execute()
        out = list(self.pending_outbox)
        self.pending_outbox = []
        return out

    def _on_request(self, msg: Message) -> None:
        if not self.is_primary():
            return
        client = msg.client_id
        ts = msg.timestamp
        last = self.client_last_ts.get(client, -1)
        if ts <= last and (client, ts) in self.replies:
            cached = self.replies[(client, ts)]
            self._emit(Message(
                mtype=MsgType.REPLY, sender=self.id, view=self.view,
                seq=0, digest=digest(cached), payload={"result": cached},
                client_id=client, timestamp=ts,
            ))
            return
        self.client_last_ts[client] = max(last, ts)
        self.seq_high = max(self.seq_high, self.executed_seq) + 1
        seq = self.seq_high
        cmd = dict(msg.payload.get("command", {}))
        d = digest(self.view, seq, cmd)
        self.log_request[seq] = cmd
        pp = Message(
            mtype=MsgType.PRE_PREPARE, sender=self.id, view=self.view, seq=seq,
            digest=d, payload={"command": cmd}, client_id=client, timestamp=ts,
        )
        self.pre_prepare[(self.view, seq)] = pp
        self.prepares[(self.view, seq, d)].add(self.id)
        self._emit(pp)
        self._emit(Message(
            mtype=MsgType.PREPARE, sender=self.id, view=self.view, seq=seq,
            digest=d, payload={}, client_id=client, timestamp=ts,
        ))
        self._maybe_prepared(self.view, seq, d)

    def _on_pre_prepare(self, msg: Message) -> None:
        if msg.view != self.view:
            return
        if msg.sender != self.primary_of(msg.view):
            return
        if msg.seq <= self.last_stable_checkpoint:
            return
        cmd = dict(msg.payload.get("command", {}))
        d = digest(msg.view, msg.seq, cmd)
        if d != msg.digest:
            self.metrics["bad_digest"] += 1
            return
        existing = self.pre_prepare.get((msg.view, msg.seq))
        if existing is not None and existing.digest != msg.digest:
            self.metrics["equivocation_detected"] += 1
            return
        self.pre_prepare[(msg.view, msg.seq)] = msg
        self.log_request[msg.seq] = cmd
        if self.fault == FaultMode.EQUIVOCATE:
            bad = digest(msg.view, msg.seq, {"op": "NOP", "evil": True})
            self._emit(Message(
                mtype=MsgType.PREPARE, sender=self.id, view=msg.view, seq=msg.seq,
                digest=msg.digest, payload={},
            ))
            self._emit(Message(
                mtype=MsgType.PREPARE, sender=self.id, view=msg.view, seq=msg.seq,
                digest=bad, payload={"evil": True},
            ))
            self.prepares[(msg.view, msg.seq, msg.digest)].add(self.id)
            self.prepares[(msg.view, msg.seq, bad)].add(self.id)
        else:
            self.prepares[(msg.view, msg.seq, msg.digest)].add(self.id)
            self._emit(Message(
                mtype=MsgType.PREPARE, sender=self.id, view=msg.view, seq=msg.seq,
                digest=msg.digest, payload={},
            ))
        self._maybe_prepared(msg.view, msg.seq, msg.digest)

    def _on_prepare(self, msg: Message) -> None:
        if msg.view != self.view:
            return
        if msg.seq <= self.last_stable_checkpoint:
            return
        self.prepares[(msg.view, msg.seq, msg.digest)].add(msg.sender)
        self._maybe_prepared(msg.view, msg.seq, msg.digest)

    def _maybe_prepared(self, view: int, seq: int, d: str) -> None:
        if (view, seq) not in self.pre_prepare:
            return
        if self.pre_prepare[(view, seq)].digest != d:
            return
        senders = self.prepares[(view, seq, d)]
        q = pbft_quorum(self.n)
        if len(senders) >= q and (view, seq, d) not in self.prepared:
            self.prepared.add((view, seq, d))
            self.metrics["prepared"] += 1
            self.commits[(view, seq, d)].add(self.id)
            self._emit(Message(
                mtype=MsgType.COMMIT, sender=self.id, view=view, seq=seq, digest=d, payload={},
            ))
            self._maybe_committed(view, seq, d)

    def _on_commit(self, msg: Message) -> None:
        if msg.view != self.view:
            return
        self.commits[(msg.view, msg.seq, msg.digest)].add(msg.sender)
        self._maybe_committed(msg.view, msg.seq, msg.digest)

    def _maybe_committed(self, view: int, seq: int, d: str) -> None:
        q = pbft_quorum(self.n)
        if len(self.commits[(view, seq, d)]) >= q and (view, seq, d) not in self.committed_local:
            if (view, seq) in self.pre_prepare and self.pre_prepare[(view, seq)].digest != d:
                return
            self.committed_local.add((view, seq, d))
            self.metrics["committed"] += 1
            self._try_execute()

    def _try_execute(self) -> None:
        progressed = True
        while progressed:
            progressed = False
            next_seq = self.executed_seq + 1
            found = None
            for (v, s, d) in list(self.committed_local):
                if s == next_seq:
                    found = (v, s, d)
                    break
            if found is None:
                for (v, s), pp in self.pre_prepare.items():
                    if s != next_seq:
                        continue
                    d = pp.digest
                    if len(self.commits[(v, s, d)]) >= pbft_quorum(self.n):
                        found = (v, s, d)
                        self.committed_local.add(found)
                        break
            if found is None:
                return
            v, s, d = found
            cmd = self.log_request.get(s)
            if cmd is None and (v, s) in self.pre_prepare:
                cmd = dict(self.pre_prepare[(v, s)].payload.get("command", {}))
                self.log_request[s] = cmd
            if cmd is None:
                return
            result = self.sm.apply(s, cmd)
            self.executed_seq = s
            progressed = True
            self.metrics["executed"] += 1
            pp = self.pre_prepare.get((v, s))
            if pp is not None:
                self.replies[(pp.client_id, pp.timestamp)] = result
                self._emit(Message(
                    mtype=MsgType.REPLY, sender=self.id, view=self.view, seq=s,
                    digest=digest(result), payload={"result": result},
                    client_id=pp.client_id, timestamp=pp.timestamp,
                ))
            if s % self.cfg.checkpoint_interval == 0:
                sd = self.sm.state_digest()
                self.checkpoints[s][self.id] = sd
                self._emit(Message(
                    mtype=MsgType.CHECKPOINT, sender=self.id, view=self.view, seq=s,
                    digest=sd, payload={"state_digest": sd},
                ))

    def _on_checkpoint(self, msg: Message) -> None:
        self.checkpoints[msg.seq][msg.sender] = msg.digest
        counts: Dict[str, int] = defaultdict(int)
        for d in self.checkpoints[msg.seq].values():
            counts[d] += 1
        for d, c in counts.items():
            if c >= pbft_quorum(self.n) and msg.seq > self.last_stable_checkpoint:
                self.last_stable_checkpoint = msg.seq
                self.stable_checkpoint_digest[msg.seq] = d
                self.metrics["stable_checkpoint"] += 1
                for key in list(self.pre_prepare.keys()):
                    if key[1] <= msg.seq:
                        del self.pre_prepare[key]

    def start_view_change(self, new_view: int) -> List[Message]:
        if new_view <= self.view or self.crashed:
            return []
        self.pending_outbox = []
        P = []
        for (v, s, d) in self.prepared:
            if s > self.last_stable_checkpoint:
                P.append({"view": v, "seq": s, "digest": d})
        msg = Message(
            mtype=MsgType.VIEW_CHANGE, sender=self.id, view=new_view, seq=self.last_stable_checkpoint,
            digest=digest(P), payload={
                "prepared": P,
                "stable_seq": self.last_stable_checkpoint,
                "stable_digest": self.stable_checkpoint_digest.get(self.last_stable_checkpoint, ""),
            },
        )
        self.view_change_msgs[new_view][self.id] = msg
        self._emit(msg)
        out = list(self.pending_outbox)
        self.pending_outbox = []
        return out

    def _on_view_change(self, msg: Message) -> None:
        nv = msg.view
        if nv <= self.view:
            return
        self.view_change_msgs[nv][msg.sender] = msg
        if self.primary_of(nv) != self.id:
            return
        if len(self.view_change_msgs[nv]) < pbft_quorum(self.n):
            return
        best: Dict[int, Tuple[int, str]] = {}
        stable = 0
        for vc in self.view_change_msgs[nv].values():
            stable = max(stable, int(vc.payload.get("stable_seq", 0)))
            for p in vc.payload.get("prepared", []):
                s = int(p["seq"])
                v = int(p["view"])
                d = p["digest"]
                if s not in best or v > best[s][0]:
                    best[s] = (v, d)
        O = []
        max_s = max(best.keys()) if best else stable
        for s in range(stable + 1, max_s + 1):
            if s in best:
                v, d = best[s]
                O.append({"seq": s, "digest": d, "command": self.log_request.get(s, {"op": "NOP"})})
            else:
                O.append({"seq": s, "digest": digest(nv, s, {"op": "NOP"}), "command": {"op": "NOP"}})
        nv_msg = Message(
            mtype=MsgType.NEW_VIEW, sender=self.id, view=nv, seq=stable,
            digest=digest(O), payload={
                "V": {str(k): True for k in self.view_change_msgs[nv].keys()},
                "O": O,
            },
        )
        self._emit(nv_msg)
        self._install_new_view(nv_msg)

    def _on_new_view(self, msg: Message) -> None:
        if msg.view <= self.view:
            return
        if msg.sender != self.primary_of(msg.view):
            return
        V = msg.payload.get("V", {})
        if len(V) < pbft_quorum(self.n):
            return
        self._install_new_view(msg)

    def _install_new_view(self, msg: Message) -> None:
        self.view = msg.view
        self.metrics["view_installs"] += 1
        O = msg.payload.get("O", [])
        for item in O:
            s = int(item["seq"])
            cmd = dict(item.get("command") or {"op": "NOP"})
            d = item.get("digest") or digest(self.view, s, cmd)
            pp = Message(
                mtype=MsgType.PRE_PREPARE, sender=self.primary_of(), view=self.view,
                seq=s, digest=d, payload={"command": cmd},
            )
            self.pre_prepare[(self.view, s)] = pp
            self.log_request[s] = cmd
            self.prepares[(self.view, s, d)].add(self.id)
            if not self.is_primary():
                self._emit(Message(
                    mtype=MsgType.PREPARE, sender=self.id, view=self.view, seq=s, digest=d,
                ))
            else:
                self._emit(pp)
                self._emit(Message(
                    mtype=MsgType.PREPARE, sender=self.id, view=self.view, seq=s, digest=d,
                ))
            self._maybe_prepared(self.view, s, d)
        self.seq_high = max(self.seq_high, max((int(i["seq"]) for i in O), default=self.seq_high))


@dataclass
class NetConfig:
    drop_prob: float = 0.0
    delay_max: int = 0
    partition: Optional[Set[int]] = None
    seed: int = 42


class PBFTCluster:
    def __init__(
        self,
        n: int = 4,
        checkpoint_interval: int = 5,
        faults: Optional[Dict[int, FaultMode]] = None,
        net: Optional[NetConfig] = None,
        seed: int = 42,
    ) -> None:
        if n < 4:
            raise ValueError("PBFT requires n >= 4 (3f+1 with f>=1)")
        f = max_faults(n)
        self.n = n
        self.f = f
        self.cfg = ReplicaConfig(n=n, f=f, checkpoint_interval=checkpoint_interval, seed=seed)
        self.net = net or NetConfig(seed=seed)
        self.rng = random.Random(seed)
        self.replicas: Dict[int, Replica] = {}
        faults = faults or {}
        for i in range(n):
            self.replicas[i] = Replica(i, self.cfg, fault=faults.get(i, FaultMode.HONEST))
        self.tick = 0
        self.inbox: Deque[Tuple[int, int, Message]] = deque()
        self.client_replies: Dict[Tuple[int, int], List[Any]] = defaultdict(list)
        self.client_ts = 0
        self.dropped = 0
        self.delivered = 0

    def primary(self) -> int:
        views = [r.view for r in self.replicas.values() if not r.crashed]
        v = max(views) if views else 0
        return v % self.n

    def _broadcast(self, sender: int, msg: Message) -> None:
        for dest in range(self.n):
            self._unicast(sender, dest, msg)

    def _unicast(self, sender: int, dest: int, msg: Message) -> None:
        if self.net.partition:
            a, b = sender in self.net.partition, dest in self.net.partition
            if a != b:
                self.dropped += 1
                return
        if self.rng.random() < self.net.drop_prob:
            self.dropped += 1
            return
        delay = self.rng.randint(0, self.net.delay_max) if self.net.delay_max > 0 else 0
        self.inbox.append((self.tick + delay, dest, msg))

    def _dispatch_out(self, sender: int, msgs: List[Message]) -> None:
        for msg in msgs:
            if msg.mtype == MsgType.REPLY:
                self.client_replies[(msg.client_id, msg.timestamp)].append(msg.payload.get("result"))
                continue
            self._broadcast(sender, msg)

    def pump(self, max_msgs: int = 10_000) -> int:
        delivered = 0
        guard = 0
        while self.inbox and guard < max_msgs:
            guard += 1
            due = [(t, d, m) for (t, d, m) in self.inbox if t <= self.tick]
            if not due:
                break
            due.sort(key=lambda x: (x[0], x[1], x[2].mtype.value, x[2].sender))
            remaining = [(t, d, m) for (t, d, m) in self.inbox if t > self.tick]
            self.inbox = deque(remaining)
            for _, dest, msg in due:
                out = self.replicas[dest].receive(msg)
                self._dispatch_out(dest, out)
                delivered += 1
                self.delivered += 1
        return delivered

    def step(self, n_ticks: int = 1) -> None:
        for _ in range(n_ticks):
            self.tick += 1
            self.pump()

    def submit(self, command: Dict[str, Any], client_id: int = 0) -> Tuple[int, int]:
        self.client_ts += 1
        ts = self.client_ts
        primary = self.primary()
        msg = Message(
            mtype=MsgType.REQUEST, sender=-1, view=self.replicas[primary].view,
            seq=0, digest=digest(command, client_id, ts),
            payload={"command": command}, client_id=client_id, timestamp=ts,
        )
        out = self.replicas[primary].receive(msg)
        self._dispatch_out(primary, out)
        self.pump()
        return client_id, ts

    def wait_reply(self, client_id: int, ts: int, max_ticks: int = 200) -> Any:
        key = (client_id, ts)
        for _ in range(max_ticks):
            self.step(1)
            reps = self.client_replies.get(key, [])
            counts: Dict[str, List[Any]] = defaultdict(list)
            for r in reps:
                counts[digest(r)].append(r)
            for _, vals in counts.items():
                if len(vals) >= self.f + 1:
                    return vals[0]
        return None

    def request(self, command: Dict[str, Any], client_id: int = 0, max_ticks: int = 200) -> Any:
        cid, ts = self.submit(command, client_id=client_id)
        return self.wait_reply(cid, ts, max_ticks=max_ticks)

    def honest_ids(self) -> List[int]:
        return [i for i, r in self.replicas.items() if r.fault == FaultMode.HONEST and not r.crashed]

    def check_agreement(self) -> Tuple[bool, str]:
        honest = [self.replicas[i] for i in self.honest_ids()]
        if not honest:
            return False, "no honest replicas"
        for a in honest:
            for b in honest:
                n = min(len(a.sm.applied), len(b.sm.applied))
                for i in range(n):
                    sa, ca, _ = a.sm.applied[i]
                    sb, cb, _ = b.sm.applied[i]
                    if sa != sb or ca != cb:
                        return False, f"divergence at i={i} a={ca} b={cb}"
        return True, "ok"

    def check_validity(self, submitted: List[Dict[str, Any]]) -> Tuple[bool, str]:
        sub_digests = {digest(c) for c in submitted}
        for i in self.honest_ids():
            for s, c, _ in self.replicas[i].sm.applied:
                if c.get("op") == "NOP":
                    continue
                if digest(c) not in sub_digests:
                    return False, f"replica {i} executed unsubmitted {c}"
        return True, "ok"

    def status(self) -> Dict[str, Any]:
        return {
            "n": self.n,
            "f": self.f,
            "tick": self.tick,
            "primary": self.primary(),
            "dropped": self.dropped,
            "delivered": self.delivered,
            "replicas": {
                str(i): {
                    "view": r.view,
                    "executed_seq": r.executed_seq,
                    "fault": r.fault.value,
                    "crashed": r.crashed,
                    "prepared": len(r.prepared),
                    "committed": len(r.committed_local),
                    "stable_ckpt": r.last_stable_checkpoint,
                    "store": r.sm.snapshot(),
                    "metrics": dict(r.metrics),
                }
                for i, r in self.replicas.items()
            },
        }


def run_happy_path(n: int = 4, n_ops: int = 12, seed: int = 1) -> Dict[str, Any]:
    c = PBFTCluster(n=n, seed=seed)
    submitted = []
    results = []
    for i in range(n_ops):
        cmd = {"op": "SET", "key": f"k{i % 5}", "val": i}
        submitted.append(cmd)
        results.append(c.request(cmd, client_id=i % 3))
    get_cmd = {"op": "GET", "key": "k0"}
    submitted.append(get_cmd)
    got = c.request(get_cmd, client_id=9)
    ok_agree, msg_a = c.check_agreement()
    ok_val, msg_v = c.check_validity(submitted)
    return {
        "scenario": "happy_path",
        "n": n,
        "f": c.f,
        "ops": n_ops,
        "results_non_null": sum(1 for r in results if r is not None),
        "get_k0": got,
        "agreement": ok_agree,
        "agreement_msg": msg_a,
        "validity": ok_val,
        "validity_msg": msg_v,
        "executed": min(r.executed_seq for r in c.replicas.values()),
        "status": c.status(),
    }


def run_primary_crash(n: int = 4, seed: int = 2) -> Dict[str, Any]:
    c = PBFTCluster(n=n, seed=seed)
    submitted = []
    for i in range(3):
        cmd = {"op": "INCR", "key": "x", "val": 1}
        submitted.append(cmd)
        assert c.request(cmd) is not None
    primary = c.primary()
    c.replicas[primary].arm_crash()
    new_view = 1
    outs = []
    for rid, r in c.replicas.items():
        if r.crashed:
            continue
        outs.extend((rid, m) for m in r.start_view_change(new_view))
    for rid, m in outs:
        c._broadcast(rid, m)
    ok = None
    for _ in range(300):
        c.step(1)
        cmd = {"op": "INCR", "key": "x", "val": 1}
        if any(r.view >= 1 and not r.crashed for r in c.replicas.values()):
            submitted.append(cmd)
            ok = c.request(cmd, client_id=7, max_ticks=50)
            if ok is not None:
                break
    ok_agree, msg_a = c.check_agreement()
    stores = [c.replicas[i].sm.store.get("x") for i in c.honest_ids()]
    return {
        "scenario": "primary_crash_view_change",
        "crashed_primary": primary,
        "post_view_result": ok,
        "honest_x_values": stores,
        "agreement": ok_agree,
        "agreement_msg": msg_a,
        "views": {str(i): r.view for i, r in c.replicas.items()},
        "status": c.status(),
    }


def run_byzantine_equivocation(n: int = 4, seed: int = 3) -> Dict[str, Any]:
    faults = {1: FaultMode.EQUIVOCATE}
    c = PBFTCluster(n=n, seed=seed, faults=faults)
    submitted = []
    results = []
    for i in range(8):
        cmd = {"op": "SET", "key": "safe", "val": f"v{i}"}
        submitted.append(cmd)
        results.append(c.request(cmd, client_id=0))
    ok_agree, msg_a = c.check_agreement()
    ok_val, msg_v = c.check_validity(submitted)
    honest_vals = [c.replicas[i].sm.store.get("safe") for i in c.honest_ids()]
    return {
        "scenario": "byzantine_equivocation",
        "results_ok": sum(1 for r in results if r is not None),
        "honest_final": honest_vals,
        "agreement": ok_agree,
        "agreement_msg": msg_a,
        "validity": ok_val,
        "validity_msg": msg_v,
        "equivocation_detected": sum(r.metrics.get("equivocation_detected", 0) for r in c.replicas.values()),
        "status": c.status(),
    }


def run_lossy_network(n: int = 4, drop: float = 0.15, seed: int = 4) -> Dict[str, Any]:
    # Retries absorb drops; delay_max=1 keeps causal flood recoverable under moderate loss.
    c = PBFTCluster(n=n, seed=seed, net=NetConfig(drop_prob=drop, delay_max=1, seed=seed))
    submitted = []
    ok_n = 0
    for i in range(10):
        cmd = {"op": "APPEND", "key": "log", "val": str(i)}
        submitted.append(cmd)
        r = None
        for attempt in range(5):
            r = c.request(cmd, client_id=1, max_ticks=500)
            if r is not None:
                break
            # client-side retry with fresh timestamp (new request id)
            c.step(5)
        if r is not None:
            ok_n += 1
    ok_agree, msg_a = c.check_agreement()
    return {
        "scenario": "lossy_network",
        "drop_prob": drop,
        "committed_ops": ok_n,
        "dropped_msgs": c.dropped,
        "agreement": ok_agree,
        "agreement_msg": msg_a,
        "final_log_prefix": str(c.replicas[c.honest_ids()[0]].sm.store.get("log", ""))[:40],
        "status": c.status(),
    }


def run_bench(n: int = 7, ops: int = 50, seed: int = 7) -> Dict[str, Any]:
    t0 = time.perf_counter()
    c = PBFTCluster(n=n, seed=seed, checkpoint_interval=10)
    ok = 0
    for i in range(ops):
        r = c.request({"op": "INCR", "key": "c", "val": 1}, client_id=i % 5, max_ticks=300)
        if r is not None:
            ok += 1
    dt = time.perf_counter() - t0
    ok_agree, _ = c.check_agreement()
    final = c.replicas[c.honest_ids()[0]].sm.store.get("c")
    return {
        "scenario": "bench",
        "n": n,
        "f": c.f,
        "ops": ops,
        "ok": ok,
        "final_counter": final,
        "seconds": round(dt, 4),
        "ops_per_sec": round(ok / dt if dt > 0 else 0.0, 2),
        "msgs_delivered": c.delivered,
        "msgs_dropped": c.dropped,
        "agreement": ok_agree,
        "ticks": c.tick,
    }


def theory_ledger(n: int = 4, batch: int = 1) -> Dict[str, Any]:
    f = max_faults(n)
    q = pbft_quorum(n)
    prep_msgs = n * n
    commit_msgs = n * n
    pre_prep = n
    normal_case = pre_prep + prep_msgs + commit_msgs
    view_change = n * n
    return {
        "n": n,
        "f": f,
        "quorum_2f1": q,
        "safety_condition": "n >= 3f+1",
        "normal_case_msgs_per_request": normal_case,
        "view_change_msgs_order": view_change,
        "auth_scheme": "SHA-256 digest MAC-simulator (production: authenticators / TLS)",
        "checkpoint_gc": "stable watermark at 2f+1 matching CHECKPOINT",
        "client_accept": "f+1 matching REPLY",
        "batch": batch,
        "quorum_intersection": f"2q-n = {2*q - n} >= f+1 = {f+1}",
        "notes": [
            "Agreement: two honest replicas never execute different commands at same seq",
            "Quorum intersection: any two 2f+1 sets intersect in >= f+1 => >=1 honest",
            "View change recovers max prepared certificates to preserve safety",
        ],
    }


def selftest(verbose: bool = True) -> int:
    checks = []

    def check(name: str, cond: bool, detail: str = "") -> None:
        checks.append((name, cond, detail))
        if verbose:
            flag = "OK" if cond else "FAIL"
            print(f"  [{flag}] {name}" + (f" — {detail}" if detail else ""))

    check("max_faults(4)==1", max_faults(4) == 1)
    check("max_faults(7)==2", max_faults(7) == 2)
    check("quorum(4)==3", pbft_quorum(4) == 3)
    check("quorum(7)==5", pbft_quorum(7) == 5)
    check("digest_stable", digest({"a": 1}, 2) == digest({"a": 1}, 2))
    check("digest_diff", digest({"a": 1}) != digest({"a": 2}))

    sm = KVStateMachine()
    sm.apply(1, {"op": "SET", "key": "a", "val": 10})
    sm.apply(2, {"op": "INCR", "key": "a", "val": 5})
    check("kv_incr", sm.store["a"] == 15)
    check("kv_cas_ok", sm.apply(3, {"op": "CAS", "key": "a", "expected": 15, "val": 0}) is True)
    check("kv_cas_fail", sm.apply(4, {"op": "CAS", "key": "a", "expected": 15, "val": 1}) is False)

    hp = run_happy_path(n=4, n_ops=10, seed=11)
    check("happy_agreement", hp["agreement"], hp["agreement_msg"])
    check("happy_validity", hp["validity"], hp["validity_msg"])
    check("happy_all_replies", hp["results_non_null"] == 10, str(hp["results_non_null"]))
    check("happy_executed_ge_10", hp["executed"] >= 10, str(hp["executed"]))

    pc = run_primary_crash(n=4, seed=12)
    check("view_change_agreement", pc["agreement"], pc["agreement_msg"])
    check("view_change_progress", pc["post_view_result"] is not None, str(pc["post_view_result"]))
    check(
        "view_change_honest_x_consistent",
        len(set(pc["honest_x_values"])) == 1 and pc["honest_x_values"][0] is not None,
        str(pc["honest_x_values"]),
    )

    be = run_byzantine_equivocation(n=4, seed=13)
    check("equiv_agreement", be["agreement"], be["agreement_msg"])
    check("equiv_validity", be["validity"], be["validity_msg"])
    check("equiv_honest_converged", len(set(be["honest_final"])) == 1, str(be["honest_final"]))
    check("equiv_results", be["results_ok"] >= 6, str(be["results_ok"]))

    ln = run_lossy_network(n=4, drop=0.08, seed=14)
    check("lossy_agreement", ln["agreement"], ln["agreement_msg"])
    check("lossy_some_progress", ln["committed_ops"] >= 5, str(ln["committed_ops"]))

    hp7 = run_happy_path(n=7, n_ops=6, seed=15)
    check("n7_agreement", hp7["agreement"])
    check("n7_replies", hp7["results_non_null"] == 6)

    n, f = 7, 2
    q = 2 * f + 1
    check("quorum_intersection_formula", 2 * q - n == f + 1)

    c = PBFTCluster(n=4, checkpoint_interval=3, seed=16)
    for i in range(6):
        c.request({"op": "SET", "key": "c", "val": i})
    ck = min(r.last_stable_checkpoint for r in c.replicas.values() if not r.crashed)
    check("checkpoint_stable_ge_3", ck >= 3, str(ck))

    passed = sum(1 for _, ok, _ in checks if ok)
    total = len(checks)
    if verbose:
        print(f"\nSelftest: {passed}/{total} passed")
    return 0 if passed == total else 1


def cmd_status(args: argparse.Namespace) -> int:
    t = theory_ledger(n=args.n)
    print(json.dumps({"theory": t, "engine": "pbft-byzantine-quorum", "version": "1.0.0"}, indent=2))
    return 0


def cmd_theory(args: argparse.Namespace) -> int:
    print(json.dumps(theory_ledger(n=args.n, batch=args.batch), indent=2))
    return 0


def cmd_simulate(args: argparse.Namespace) -> int:
    scenarios = {
        "happy": lambda: run_happy_path(n=args.n, n_ops=args.ops, seed=args.seed),
        "primary_crash": lambda: run_primary_crash(n=args.n, seed=args.seed),
        "equivocation": lambda: run_byzantine_equivocation(n=args.n, seed=args.seed),
        "lossy": lambda: run_lossy_network(n=args.n, drop=args.drop, seed=args.seed),
    }
    fn = scenarios.get(args.scenario)
    if not fn:
        print(f"unknown scenario {args.scenario}; choose {list(scenarios)}", file=sys.stderr)
        return 2
    out = fn()
    if not args.verbose and isinstance(out, dict) and "status" in out:
        out = dict(out)
        out["status"] = {
            "primary": out["status"].get("primary"),
            "tick": out["status"].get("tick"),
            "views": {k: v.get("view") for k, v in out["status"].get("replicas", {}).items()},
            "executed": {k: v.get("executed_seq") for k, v in out["status"].get("replicas", {}).items()},
        }
    print(json.dumps(out, indent=2, default=str))
    return 0 if out.get("agreement", True) else 1


def cmd_chaos(args: argparse.Namespace) -> int:
    """Crash primary + one non-primary equivocator + mild loss; require agreement + recovery."""
    n = args.n
    f = max_faults(n)
    # Place equivocator at the highest id so view-1 primary (1) stays honest when primary 0 crashes.
    equiv_id = n - 1
    c = PBFTCluster(
        n=n, seed=args.seed, faults={equiv_id: FaultMode.EQUIVOCATE},
        net=NetConfig(drop_prob=args.drop, delay_max=1, seed=args.seed),
    )
    submitted = []
    for i in range(4):
        cmd = {"op": "INCR", "key": "z", "val": 1}
        submitted.append(cmd)
        c.request(cmd, client_id=0)
    crashed = c.primary()
    c.replicas[crashed].arm_crash()
    nv = max(r.view for r in c.replicas.values()) + 1
    # Multi-round VC flood + pump so NEW-VIEW installs before client traffic resumes.
    for round_i in range(3):
        outs = []
        for rid, r in c.replicas.items():
            if r.crashed:
                continue
            if r.view < nv:
                outs.extend((rid, m) for m in r.start_view_change(nv))
        for rid, m in outs:
            c._broadcast(rid, m)
        c.step(30)
        if any(r.view >= nv and not r.crashed for r in c.replicas.values()):
            break
    recovered = 0
    for _ in range(8):
        cmd = {"op": "INCR", "key": "z", "val": 1}
        submitted.append(cmd)
        got = None
        for _attempt in range(8):
            got = c.request(cmd, client_id=2, max_ticks=200)
            if got is not None:
                break
            c.step(15)
        if got is not None:
            recovered += 1
    # Drain any straggler commits so honest prefix catches up before agreement check.
    c.step(50)
    ok_a, msg_a = c.check_agreement()
    out = {
        "scenario": "chaos_crash_equiv_lossy",
        "n": n,
        "f": f,
        "crashed": crashed,
        "equivocator": equiv_id,
        "recovered_ops": recovered,
        "agreement": ok_a,
        "agreement_msg": msg_a,
        "honest_z": [c.replicas[i].sm.store.get("z") for i in c.honest_ids()],
        "dropped": c.dropped,
        "views": {str(i): r.view for i, r in c.replicas.items()},
    }
    print(json.dumps(out, indent=2))
    return 0 if ok_a and recovered >= 1 else 1


def cmd_bench(args: argparse.Namespace) -> int:
    out = run_bench(n=args.n, ops=args.ops, seed=args.seed)
    print(json.dumps(out, indent=2))
    return 0 if out.get("agreement") and out.get("ok", 0) == args.ops else 1


def cmd_explain(_: argparse.Namespace) -> int:
    text = """
PBFT (Castro & Liskov, OSDI 1999) tolerates f Byzantine replicas among n=3f+1.

Normal-case (view v, primary p = v mod n):
  1. Client sends REQUEST to primary.
  2. Primary assigns sequence n and broadcasts PRE-PREPARE(v,n,d) with digest d=H(m).
  3. Backups accept if authenticated, in-view, and unused (v,n); broadcast PREPARE(v,n,d).
  4. Replica marks prepared(v,n,d) on pre-prepare + 2f matching prepares.
  5. Broadcast COMMIT(v,n,d); on 2f+1 commits -> committed-local; execute in seq order.
  6. Replicas REPLY to client; client waits for f+1 matching replies.

Safety core: any two quorums of size 2f+1 intersect in >= f+1 replicas, hence >= 1 honest.
So two different digests cannot both gather prepare certificates for the same (v,n).

View change: on timeout, replicas broadcast VIEW-CHANGE(v+1) carrying prepared
certificates; new primary collects 2f+1 and issues NEW-VIEW with O set re-proposing
the highest prepared request per sequence (or NOP), preserving agreement across views.

This engine is an educational / invariant-checking simulator — production deployments
need real authenticators (MACs or TLS+signatures), persistent WAL, and liveness timers.
""".strip()
    print(text)
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="pbft-byzantine-quorum",
        description="Practical Byzantine Fault Tolerance (PBFT) quorum consensus engine",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("selftest", help="Run deterministic invariant CI gate")
    s.add_argument("-q", "--quiet", action="store_true")
    s.set_defaults(func=lambda a: selftest(verbose=not a.quiet))

    s = sub.add_parser("simulate", help="Run a named protocol scenario")
    s.add_argument("--scenario", default="happy", choices=["happy", "primary_crash", "equivocation", "lossy"])
    s.add_argument("--n", type=int, default=4)
    s.add_argument("--ops", type=int, default=12)
    s.add_argument("--drop", type=float, default=0.15)
    s.add_argument("--seed", type=int, default=42)
    s.add_argument("--verbose", action="store_true")
    s.set_defaults(func=cmd_simulate)

    s = sub.add_parser("chaos", help="Crash + equivocation + optional loss combined stress")
    s.add_argument("--n", type=int, default=4)
    s.add_argument("--drop", type=float, default=0.0, help="Message drop probability (default 0)")
    s.add_argument("--seed", type=int, default=99)
    s.set_defaults(func=cmd_chaos)

    s = sub.add_parser("bench", help="Throughput microbench on honest cluster")
    s.add_argument("--n", type=int, default=4)
    s.add_argument("--ops", type=int, default=40)
    s.add_argument("--seed", type=int, default=7)
    s.set_defaults(func=cmd_bench)

    s = sub.add_parser("theory", help="Message-complexity and quorum ledger")
    s.add_argument("--n", type=int, default=4)
    s.add_argument("--batch", type=int, default=1)
    s.set_defaults(func=cmd_theory)

    s = sub.add_parser("status", help="Engine metadata + theory snapshot")
    s.add_argument("--n", type=int, default=4)
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("explain", help="Human protocol walkthrough")
    s.set_defaults(func=cmd_explain)
    return p


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv:
        argv = ["selftest"]
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args) or 0)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
