# =====================================================================
# Polyphonic Synthesizer Engine
# =====================================================================
class PolyphonicFMSynth:
    def __init__(self, num_voices: int = MAX_POLYPHONY):
        self.voices = [Voice(i) for i in range(num_voices)]
        self.current_preset = PRESETS["dx7-rhodes"]
        self.lfo_phase = 0.0
        self.dc_x1 = 0.0
        self.dc_y1 = 0.0
        self.load_preset(self.current_preset)

    def load_preset(self, preset: FMPreset):
        self.current_preset = preset
        for i, voice in enumerate(self.voices):
            # Alternate stereo panning across voices for rich stereo spread
            pan = 0.3 + 0.4 * (i / max(1, len(self.voices) - 1))
            voice.setup(preset.algo_id, preset.operators, pan)

    def note_on(self, midi_note: int, velocity: int = 100) -> Voice:
        # 1. Look for free voice
        for v in self.voices:
            if v.state == VoiceState.FREE:
                v.note_on(midi_note, velocity)
                return v
        # 2. Look for earliest released voice
        released = [v for v in self.voices if v.state == VoiceState.RELEASED]
        if released:
            v = min(released, key=lambda x: x.note_on_time)
            v.note_on(midi_note, velocity)
            return v
        # 3. Voice stealing: steal oldest active voice
        v = min(self.voices, key=lambda x: x.note_on_time)
        v.note_on(midi_note, velocity)
        return v

    def note_off(self, midi_note: int):
        for v in self.voices:
            if v.state == VoiceState.ACTIVE and v.midi_note == midi_note:
                v.note_off()

    def all_notes_off(self):
        for v in self.voices:
            v.note_off()

    def render_buffer(self, duration_sec: float) -> Tuple[np.ndarray, np.ndarray]:
        num_samples = int(SAMPLE_RATE * duration_sec)
        left_buf = np.zeros(num_samples, dtype=np.float32)
        right_buf = np.zeros(num_samples, dtype=np.float32)

        lfo_inc = 2.0 * math.pi * self.current_preset.lfo_rate / SAMPLE_RATE
        lfo_depth = self.current_preset.lfo_depth

        for i in range(num_samples):
            self.lfo_phase = (self.lfo_phase + lfo_inc) % (2.0 * math.pi)
            lfo_pitch = math.sin(self.lfo_phase) * lfo_depth

            s_l, s_r = 0.0, 0.0
            for v in self.voices:
                if v.state != VoiceState.FREE:
                    vl, vr = v.tick(lfo_pitch)
                    s_l += vl
                    s_r += vr

            # DC blocking filter: y[n] = x[n] - x[n-1] + 0.995 * y[n-1]
            s_mono = 0.5 * (s_l + s_r)
            dc_out = s_mono - self.dc_x1 + 0.995 * self.dc_y1
            self.dc_x1 = s_mono
            self.dc_y1 = dc_out
            
            dc_diff = dc_out - s_mono
            s_l += dc_diff
            s_r += dc_diff

            # Soft-knee saturation limiter to prevent digital clipping
            left_buf[i] = math.tanh(s_l * 0.8)
            right_buf[i] = math.tanh(s_r * 0.8)

        return left_buf, right_buf


# =====================================================================
# Audio Export (16-bit PCM RIFF WAV)
# =====================================================================
def export_wav(filename: str, left: np.ndarray, right: np.ndarray):
    assert len(left) == len(right)
    num_samples = len(left)
    # Normalize peak to -0.5 dB to prevent inter-sample peaking
    peak = max(np.max(np.abs(left)), np.max(np.abs(right)), 1e-6)
    norm_factor = 0.94 / peak if peak > 0.94 else 1.0

    scaled_l = np.clip(left * norm_factor * 32767.0, -32768, 32767).astype(np.int16)
    scaled_r = np.clip(right * norm_factor * 32767.0, -32768, 32767).astype(np.int16)
    
    # Interleave stereo channels
    interleaved = np.empty((num_samples * 2,), dtype=np.int16)
    interleaved[0::2] = scaled_l
    interleaved[1::2] = scaled_r

    data_bytes = interleaved.tobytes()
    data_size = len(data_bytes)
    riff_size = data_size + 36

    # RIFF WAV Header (44 bytes)
    header = bytearray()
    header.extend(b"RIFF")
    header.extend(struct.pack("<I", riff_size))
    header.extend(b"WAVEfmt ")
    header.extend(struct.pack("<I", 16))           # Subchunk1Size (16 for PCM)
    header.extend(struct.pack("<H", 1))            # AudioFormat (1 = PCM)
    header.extend(struct.pack("<H", 2))            # NumChannels (2 = Stereo)
    header.extend(struct.pack("<I", SAMPLE_RATE))  # SampleRate
    header.extend(struct.pack("<I", SAMPLE_RATE * 2 * 2)) # ByteRate
    header.extend(struct.pack("<H", 4))            # BlockAlign
    header.extend(struct.pack("<H", 16))           # BitsPerSample
    header.extend(b"data")
    header.extend(struct.pack("<I", data_size))

    with open(filename, "wb") as f:
        f.write(header)
        f.write(data_bytes)


# =====================================================================
# Real-Time Visualizers (Braille Oscilloscope & Spectral Power)
# =====================================================================
def render_braille_oscilloscope(samples: np.ndarray, width: int = 68, height: int = 10) -> str:
    """Renders high-resolution 2x4 dot Unicode Braille oscilloscope."""
    if len(samples) == 0:
        return ""
    # Downsample or window first 1200 samples
    window = samples[:min(len(samples), 1600)]
    step = len(window) / (width * 2)
    grid_w = width * 2
    grid_h = height * 4
    grid = np.zeros((grid_h, grid_w), dtype=bool)

    for x in range(grid_w):
        idx = int(x * step)
        val = window[min(len(window) - 1, idx)]
        # Map -1.0..1.0 to 0..grid_h - 1
        norm = (val + 1.0) * 0.5
        y = int(np.clip(norm * (grid_h - 1), 0, grid_h - 1))
        y_inv = grid_h - 1 - y
        grid[y_inv, x] = True

    # Convert 2x4 pixel blocks into Braille characters
    # Braille offset map: 1=0x1, 2=0x2, 3=0x4, 4=0x40, 5=0x8, 6=0x10, 7=0x20, 8=0x80
    lines = []
    for by in range(height):
        line = []
        for bx in range(width):
            val = 0
            base_x = bx * 2
            base_y = by * 4
            if base_y < grid_h and base_x < grid_w and grid[base_y, base_x]: val |= 0x1
            if base_y + 1 < grid_h and base_x < grid_w and grid[base_y + 1, base_x]: val |= 0x2
            if base_y + 2 < grid_h and base_x < grid_w and grid[base_y + 2, base_x]: val |= 0x4
            if base_y + 3 < grid_h and base_x < grid_w and grid[base_y + 3, base_x]: val |= 0x40
            if base_y < grid_h and base_x + 1 < grid_w and grid[base_y, base_x + 1]: val |= 0x8
            if base_y + 1 < grid_h and base_x + 1 < grid_w and grid[base_y + 1, base_x + 1]: val |= 0x10
            if base_y + 2 < grid_h and base_x + 1 < grid_w and grid[base_y + 2, base_x + 1]: val |= 0x20
            if base_y + 3 < grid_h and base_x + 1 < grid_w and grid[base_y + 3, base_x + 1]: val |= 0x80
            line.append(chr(0x2800 + val) if val != 0 else " ")
        lines.append(Style.CYAN + "".join(line) + Style.RESET)
    return "\n".join(lines)


def render_spectral_bars(samples: np.ndarray, num_bands: int = 32) -> str:
    """Renders log-scale DFT frequency spectrum with Unicode block characters."""
    if len(samples) < 256:
        return ""
    window = samples[:2048] * np.hanning(min(len(samples), 2048))
    spectrum = np.abs(np.fft.rfft(window))
    freqs = np.fft.rfftfreq(len(window), d=1.0 / SAMPLE_RATE)

    # Group into log-spaced bands (80 Hz to 12 kHz)
    band_edges = np.logspace(np.log10(80), np.log10(12000), num_bands + 1)
    energy = []
    for b in range(num_bands):
        f_low = band_edges[b]
        f_high = band_edges[b + 1]
        mask = (freqs >= f_low) & (freqs < f_high)
        val = np.mean(spectrum[mask]) if np.any(mask) else 0.0
        energy.append(val)

    energy = np.array(energy)
    max_e = np.max(energy) if np.max(energy) > 0 else 1.0
    norm_e = energy / max_e

    blocks = [" ", " ", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    bar_chars = []
    for e in norm_e:
        idx = min(len(blocks) - 1, int(e * (len(blocks) - 1)))
        bar_chars.append(blocks[idx])
    return Style.MAGENTA + "[Spectrum] " + Style.GREEN + "".join(bar_chars) + Style.RESET


# =====================================================================
# Benchmark & Test Suites
# =====================================================================
def run_benchmark(duration_sec: float = 3.0):
    print(f"{Style.BOLD}{Style.CYAN}⚡ Benchmarking Polyphonic FM DSP Engine...{Style.RESET}")
    synth = PolyphonicFMSynth(16)
    synth.load_preset(PRESETS["dx7-rhodes"])

    # Trigger 8 concurrent chord voices
    chord = ["C3", "G3", "C4", "E4", "G4", "B4", "D5", "F#5"]
    for note in chord:
        synth.note_on(note_to_midi(note), velocity=110)

    total_samples = int(SAMPLE_RATE * duration_sec)
    t0 = time.perf_counter()
    left, right = synth.render_buffer(duration_sec)
    t1 = time.perf_counter()

    elapsed = t1 - t0
    throughput = total_samples / elapsed
    msps = throughput / 1_000_000.0
    realtime_ratio = duration_sec / elapsed

    print(f"  • Rendered Duration:   {duration_sec:.2f} s ({total_samples:,} stereo samples)")
    print(f"  • Active Polyphony:    {len(chord)} voices (48 simultaneous FM operators)")
    print(f"  • Computation Time:    {elapsed * 1000.0:.2f} ms")
    print(f"  • DSP Throughput:       {Style.GREEN}{msps:.3f} Million Samples/sec{Style.RESET}")
    print(f"  • Real-Time Factor:    {Style.GREEN}{realtime_ratio:.1f}x real-time speed{Style.RESET}")
    print(f"{Style.GREEN}✅ Polyphonic FM DSP benchmark completed successfully.{Style.RESET}\n")


def run_dsp_tests():
    print(f"{Style.BOLD}{Style.CYAN}🧪 Running FM Synthesis Mathematical Invariant & DSP Test Suite...{Style.RESET}")
    passed = 0
    total = 0

    def test(name: str, cond: bool, detail: str = ""):
        nonlocal passed, total
        total += 1
        status = f"{Style.GREEN}PASS{Style.RESET}" if cond else f"{Style.RED}FAIL{Style.RESET}"
        print(f"  [{status}] {name}﻿ {Style.DIM}{detail}{Style.RESET}")
        if cond: passed += 1

    # 1. Pitch & Frequency Accuracy
    f_a4 = midi_to_freq(69)
    test("MIDI Pitch Tuning Exactness", abs(f_a4 - 440.0) < 1e-6, f"A4 = {f_a4:.6f} Hz")

    # 2. Envelope 4-Rate 4-Level State Progression
    eg = DX7Envelope(rates=(99, 99, 99, 99), levels=(99, 80, 50, 0))
    eg.key_on()
    levels_seen = []
    for _ in range(500):
        levels_seen.append(eg.tick())
    eg.key_off()
    for _ in range(500):
        levels_seen.append(eg.tick())
    test("DX7 Envelope Dynamic Trajectory", max(levels_seen) > 0.95 and levels_seen[-1] < 0.05,
         f"Peak={max(levels_seen):.3f}, Final={levels_seen[-1]:.3f}")

    # 3. Bessel Sideband Modulation Generation
    synth = PolyphonicFMSynth(1)
    synth.load_preset(PRESETS["dx7-rhodes"])
    synth.note_on(69, 100)
    l, r = synth.render_buffer(0.1)
    fft = np.abs(np.fft.rfft(l[:2048]))
    peak_count = np.sum(fft > (np.max(fft) * 0.1))
    test("Harmonic Sideband Generation", peak_count > 3, f"Active Partials = {peak_count}")

    # 4. Anti-Aliasing Feedback Loop Stability
    op_cfg = OperatorConfig(ratio=1.0, feedback=1.5, output_level=99)
    op = Operator(1, op_cfg)
    op.set_frequency(440.0)
    outs = [op.tick() for _ in range(2000)]
    stable = not any(math.isnan(x) or math.isinf(x) for x in outs) and max(abs(x) for x in outs) < 2.0
    test("Self-Feedback Stability & Boundedness", stable, f"Max Amplitude = {max(abs(x) for x in outs):.3f}")

    # 5. All 32 DX7 Algorithms Structural Consistency
    all_valid = True
    for aid in range(1, 33):
        algo = DX7_ALGORITHMS[aid]
        if not algo["carriers"] or not all(1 <= c <= 6 for c in algo["carriers"]):
            all_valid = False
    test("All 32 DX7 Algorithms Validated", all_valid, "32 DAG topologies verified")

    # 6. Polyphony Voice Allocator Dynamic Scaling
    poly = PolyphonicFMSynth(4)
    voices = [poly.note_on(60 + i) for i in range(4)]
    stolen_voice = poly.note_on(72) # 5th voice triggers stealing
    test("Dynamic Polyphony & Voice Stealing", stolen_voice is not None,
         f"Allocated {len(voices)} voices + 1 stolen")

    # 7. Soft-Knee Tanh Limiter Output Bound
    poly.load_preset(PRESETS["cyberpunk-drone"])
    for i in range(12):
        poly.note_on(36 + i, 127)
    lb, rb = poly.render_buffer(0.05)
    bounded = np.all(np.abs(lb) <= 1.0) and np.all(np.abs(rb) <= 1.0)
    test("Soft-Knee Tanh Limiter Bounds (|y| <= 1.0)", bounded, f"Peak L={np.max(np.abs(lb)):.4f}")

    # 8. RIFF 16-Bit Stereo WAV Header Compliance
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
        tmp_path = tmp.name
    try:
        export_wav(tmp_path, lb, rb)
        with open(tmp_path, "rb") as f:
            hdr = f.read(44)
        riff_ok = hdr[:4] == b"RIFF" and hdr[8:12] == b"WAVE" and hdr[12:16] == b"fmt "
        chans = struct.unpack("<H", hdr[22:24])[0]
        rate = struct.unpack("<I", hdr[24:28])[0]
        bits = struct.unpack("<H", hdr[34:36])[0]
        test("Lossless RIFF 16-bit WAV Header", riff_ok and chans == 2 and rate == SAMPLE_RATE and bits == 16,
             f"RIFF WAV 44.1kHz 16-bit Stereo Verified")
    finally:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)

    print(f"\n{Style.BOLD}Summary: {passed}/{total} tests passed ({passed/total*100:.1f}%).{Style.RESET}\n")
    return passed == total


# =====================================================================
# CLI Interface
# =====================================================================
def print_algo_diagram(algo_id: int):
    algo = DX7_ALGORITHMS.get(algo_id)
    if not algo:
        print(f"Unknown algorithm {algo_id}")
        return
    print(f"{Style.BOLD}{Style.CYAN}═══ Yamaha DX7 Algorithm {algo_id} ═══{Style.RESET}")
    print(f"  {Style.YELLOW}{algo['name']}{Style.RESET}")
    print(f"  Carriers (Output): {sorted(list(algo['carriers']))}")
    print(f"  Feedback Operator: Op {algo['feedback_op']}")
    print("  Modulation Routes:")
    for target, sources in sorted(algo["routes"].items()):
        if sources:
            fb_flag = " [FEEDBACK]" if target == algo["feedback_op"] else ""
            print(f"    • Op {sorted(list(sources))} ──► Op {target}{fb_flag}")
        else:
            print(f"    • Op {target} (Carrier / Independent)")
    print()


def main():
    parser = argparse.ArgumentParser(
        description="Polyphonic 6-Operator Algorithmic FM Synthesizer & Phase Modulation DSP Engine"
    )
    subparsers = parser.add_subparsers(dest="command", help="Sub-command to execute")

    # Subcommand: play
    play_p = subparsers.add_parser("play", help="Synthesize and play an FM note/preset")
    play_p.add_argument("preset", nargs="?", default="dx7-rhodes", choices=list(PRESETS.keys()))
    play_p.add_argument("--note", default="C4", help="Note to play (e.g. C4, A4, F#3)")
    play_p.add_argument("--duration", type=float, default=2.5, help="Duration in seconds")
    play_p.add_argument("--audio", action="store_true", help="Play out loud via macOS afplay")

    # Subcommand: chord
    chord_p = subparsers.add_parser("chord", help="Play a polyphonic chord")
    chord_p.add_argument("preset", nargs="?", default="dx7-rhodes", choices=list(PRESETS.keys()))
    chord_p.add_argument("--notes", default="C4,E4,G4,B4", help="Comma-separated notes (e.g. C4,E4,G4,B4)")
    chord_p.add_argument("--duration", type=float, default=3.0, help="Duration in seconds")
    chord_p.add_argument("--audio", action="store_true", help="Play out loud via macOS afplay")

    # Subcommand: render
    render_p = subparsers.add_parser("render", help="Render preset audio to a 16-bit WAV file")
    render_p.add_argument("preset", choices=list(PRESETS.keys()))
    render_p.add_argument("-o", "--output", default="fm_output.wav", help="Output WAV file path")
    render_p.add_argument("--note", default="C4", help="Note to render")
    render_p.add_argument("--duration", type=float, default=3.0, help="Duration in seconds")

    # Subcommand: algo
    algo_p = subparsers.add_parser("algo", help="Visualize DX7 modulation algorithm diagram")
    algo_p.add_argument("number", type=int, choices=range(1, 33), help="Algorithm number [1..32]")

    # Subcommand: presets
    subparsers.add_parser("presets", help="List all available production presets")

    # Subcommand: bench
    subparsers.add_parser("bench", help="Benchmark FM DSP sample throughput")

    # Subcommand: test
    subparsers.add_parser("test", help="Run formal mathematical invariant & DSP tests")

    # Subcommand: info
    subparsers.add_parser("info", help="Display mathematical formulations and architecture")

    args = parser.parse_args()

    if args.command == "bench":
        run_benchmark()
    elif args.command == "test":
        ok = run_dsp_tests()
        sys.exit(0 if ok else 1)
    elif args.command == "algo":
        print_algo_diagram(args.number)
    elif args.command == "presets":
        print(f"\n{Style.BOLD}{Style.CYAN}🎹 Available Production FM Presets:{Style.RESET}\n")
        for k, p in PRESETS.items():
            print(f"  • {Style.BOLD}{Style.GREEN}{k:<18}{Style.RESET} [Algo {p.algo_id}]  {Style.DIM}{p.description}{Style.RESET}")
        print()
    elif args.command == "render":
        synth = PolyphonicFMSynth(16)
        synth.load_preset(PRESETS[args.preset])
        synth.note_on(note_to_midi(args.note), 100)
        print(f"Rendering preset '{args.preset}' ({args.note}, {args.duration}s) to {args.output}...")
        left, right = synth.render_buffer(args.duration)
        export_wav(args.output, left, right)
        print(f"{Style.GREEN}✅ Saved 44.1kHz Stereo WAV to: {args.output}{Style.RESET}")
    elif args.command == "chord":
        synth = PolyphonicFMSynth(16)
        preset = PRESETS[args.preset]
        synth.load_preset(preset)
        notes = [n.strip() for n in args.notes.split(",")]
        print(f"\n{Style.BOLD}{Style.CYAN}🎶 Playing Polyphonic FM Chord: {args.notes} [{args.preset}]{Style.RESET}")
        for n in notes:
            synth.note_on(note_to_midi(n), 105)
        left, right = synth.render_buffer(args.duration)
        
        # Terminal visualizer
        print(render_braille_oscilloscope(left))
        print(render_spectral_bars(left))
        
        if args.audio:
            with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
                tmp_path = tmp.name
            export_wav(tmp_path, left, right)
            try:
                subprocess.run(["afplay", tmp_path], check=False)
            finally:
                if os.path.exists(tmp_path): os.remove(tmp_path)
    elif args.command == "info":
        info_text = (
            f"\n{Style.BOLD}{Style.CYAN}=== Polyphonic 6-Operator Algorithmic FM Synthesis & Phase Modulation Engine ==={Style.RESET}\n\n"
            f"{Style.BOLD}Mathematical Core:{Style.RESET}\n"
            "  y[n] = A[n] * sin(theta_c[n] + sum(I_k * m_k[n]) + beta_fb * (y[n-1] + y[n-2]) / 2)\n\n"
            f"{Style.BOLD}Jacobi-Anger Expansion:{Style.RESET}\n"
            "  sin(w_c*t + beta*sin(w_m*t)) = sum_{k=-inf}^{+inf} J_k(beta) * sin((w_c + k*w_m)*t)\n\n"
            f"{Style.BOLD}Architecture:{Style.RESET}\n"
            "  - 6 Pure Sine Operators per voice with individual ratio, detune, feedback & envelope\n"
            "  - All 32 Yamaha DX7 Topological Algorithms\n"
            "  - 4-Rate / 4-Level Exponential Envelope Generators\n"
            "  - 16-Voice Dynamic Polyphony with voice priority & stealing\n"
            "  - Soft-knee tanh saturation master limiter\n"
        )
        print(info_text)
    else:
        # Default: play note
        preset_name = getattr(args, "preset", "dx7-rhodes")
        note_name = getattr(args, "note", "C4")
        dur = getattr(args, "duration", 2.0)
        synth = PolyphonicFMSynth(16)
        synth.load_preset(PRESETS[preset_name])
        synth.note_on(note_to_midi(note_name), 100)
        print(f"\n{Style.BOLD}{Style.CYAN}🎹 Synthesizing FM Note: {note_name} [{preset_name}] (Algo {PRESETS[preset_name].algo_id}){Style.RESET}")
        left, right = synth.render_buffer(dur)
        print(render_braille_oscilloscope(left))
        print(render_spectral_bars(left))
        print(f"{Style.GREEN}✅ Rendered {len(left)} samples at 44.1 kHz stereo.{Style.RESET}\n")
        if getattr(args, "audio", False):
            with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tmp:
                tmp_path = tmp.name
            export_wav(tmp_path, left, right)
            try:
                subprocess.run(["afplay", tmp_path], check=False)
            finally:
                if os.path.exists(tmp_path): os.remove(tmp_path)

if __name__ == '__main__':
    main()
