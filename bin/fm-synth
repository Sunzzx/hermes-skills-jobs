def get_topological_eval_order(algo_id: int) -> List[int]:
    """Returns execution order for operators [1..6] so modulators run before targets."""
    algo = DX7_ALGORITHMS.get(algo_id, DX7_ALGORITHMS[1])
    routes = algo["routes"]
    visited = []
    
    def visit(node: int):
        if node in visited:
            return
        for child in sorted(list(routes.get(node, set()))):
            visit(child)
        visited.append(node)
        
    for op in range(1, 7):
        visit(op)
    return visited


# =====================================================================
# Polyphonic Voice & Voice Allocator
# =====================================================================
class VoiceState:
    FREE = 0
    ACTIVE = 1
    RELEASED = 2


class Voice:
    def __init__(self, voice_id: int):
        self.voice_id = voice_id
        self.state = VoiceState.FREE
        self.midi_note = -1
        self.velocity = 0
        self.note_on_time = 0.0
        self.algo_id = 1
        self.eval_order = get_topological_eval_order(1)
        self.operators: Dict[int, Operator] = {}
        self.op_outputs: Dict[int, float] = {i: 0.0 for i in range(1, 7)}
        self.pan = 0.5 # Center

    def setup(self, algo_id: int, configs: Dict[int, OperatorConfig], pan: float = 0.5):
        self.algo_id = algo_id
        self.eval_order = get_topological_eval_order(algo_id)
        self.pan = pan
        self.operators = {
            op_id: Operator(op_id, configs[op_id]) for op_id in range(1, 7)
        }

    def note_on(self, midi_note: int, velocity: int = 100):
        self.midi_note = midi_note
        self.velocity = velocity
        self.state = VoiceState.ACTIVE
        self.note_on_time = time.perf_counter()
        freq = midi_to_freq(midi_note)
        for op in self.operators.values():
            op.set_frequency(freq, velocity)

    def note_off(self):
        if self.state == VoiceState.ACTIVE:
            self.state = VoiceState.RELEASED
            for op in self.operators.values():
                op.key_off()

    def tick(self, lfo_pitch: float = 0.0) -> Tuple[float, float]:
        if self.state == VoiceState.FREE:
            return 0.0, 0.0

        algo = DX7_ALGORITHMS[self.algo_id]
        routes = algo["routes"]
        carriers = algo["carriers"]

        # Process operators in topological order
        for op_id in self.eval_order:
            op = self.operators[op_id]
            # Collect modulation from upstream operators
            mod_in = sum(self.op_outputs[src] for src in routes.get(op_id, set()))
            self.op_outputs[op_id] = op.tick(mod_in, lfo_pitch)

        # Sum carriers
        carrier_sum = sum(self.op_outputs[c] for c in carriers) / max(1.0, math.sqrt(len(carriers)))

        # Check if voice envelopes have finished
        all_finished = all(op.eg.is_finished for op in self.operators.values())
        if all_finished and self.state == VoiceState.RELEASED:
            self.state = VoiceState.FREE

        # Stereo pan
        left = carrier_sum * math.cos(self.pan * math.pi * 0.5)
        right = carrier_sum * math.sin(self.pan * math.pi * 0.5)
        return left, right


