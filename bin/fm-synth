#!/usr/bin/env python3
"""Polyphonic 6-Operator Algorithmic FM Synthesizer & Phase Modulation DSP Engine.

A production-grade, zero-dependency implementation of Yamaha DX7-style 6-operator algorithmic
Frequency Modulation (Phase Modulation) synthesis in pure Python with NumPy.

Theoretical Foundations:
1. Chowning Phase Modulation Formulation:
   y[n] = A[n] * sin(theta_c[n] + I[n] * m[n])
   where instantaneous phase theta_c[n] = (theta_c[n-1] + 2*pi*f_c/f_s) mod 2*pi.
   Phase modulation preserves pitch stability without unwanted carrier center-frequency drift
   under non-zero mean modulation signals.

2. Jacobi-Anger Expansion & Bessel Harmonic Sidebands:
   sin(w_c*t + beta * sin(w_m*t)) = sum_{k=-inf}^{+inf} J_k(beta) * sin((w_c + k*w_m)*t)
   Harmonic sidebands arise at f_c +/- k*f_m weighted by Bessel functions of the first kind J_k(beta).
   Harmonic vs inharmonic spectra are determined by rational vs irrational carrier-to-modulator ratios.

3. Self-Feedback Modulation Loop & Anti-Aliasing Averaging:
   y[n] = sin(theta[n] + beta_fb * (y[n-1] + y[n-2]) / 2.0)
   The two-sample moving average filter acts as a zero at Nyquist, stabilizing feedback and
   preventing chaotic instability for feedback depths beta_fb <= 1.57 (pi/2).

4. Complete 32-Algorithm Modulation Topologies (Yamaha DX7 standard):
   6 operators organized into carrier/modulator trees, stacks, feedback loops, and parallel branches.

5. 4-Rate / 4-Level Exponential Envelope Generators (EG):
   Four-stage rate/level envelopes (Attack, Decay 1, Decay 2, Release) with perceptual
   exponential curves matching physical acoustic decay dynamics.

6. Dynamic 16-Voice Polyphony Allocation & Voice Stealing:
   Dynamic allocation pool with voice priority tracking, release state reuse, and smooth stealing.

7. Real-Time Terminal Visualizers:
   High-resolution Unicode Braille (2x4 dot subpixel) oscilloscope and 32-band log-scale
   spectral magnitude bar meters.
"""

import argparse
import math
import os
import struct
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from typing import Dict, List, Optional, Set, Tuple
import numpy as np

SAMPLE_RATE = 44100
MAX_POLYPHONY = 16

# =====================================================================
# ANSI Terminal Colors
# =====================================================================
class Style:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    CYAN = "\033[36m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    RED = "\033[31m"
    WHITE = "\033[37m"


# =====================================================================
# Musical Pitch Utilities
# =====================================================================
NOTE_NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]

def note_to_midi(note_str: str) -> int:
    note_str = note_str.strip().upper()
    octave = int(note_str[-1]) if note_str[-1].isdigit() else 4
    pitch = note_str[:-1] if note_str[-1].isdigit() else note_str
    if pitch not in NOTE_NAMES:
        # Handle flat notation
        flats = {"DB": "C#", "EB": "D#", "GB": "F#", "AB": "G#", "BB": "A#"}
        pitch = flats.get(pitch, "A")
    idx = NOTE_NAMES.index(pitch)
    return 12 * (octave + 1) + idx

def midi_to_freq(midi_num: int) -> float:
    return 440.0 * (2.0 ** ((midi_num - 69) / 12.0))

def note_name_to_freq(note_str: str) -> float:
    return midi_to_freq(note_to_midi(note_str))


# =====================================================================
# 4-Rate 4-Level Exponential Envelope Generator
# =====================================================================
class EGState:
    IDLE = 0
    ATTACK = 1    # Moving towards Level 1 at Rate 1
    DECAY1 = 2    # Moving towards Level 2 at Rate 2
    DECAY2 = 3    # Moving towards Level 3 at Rate 3
    SUSTAIN = 4   # Holding at Level 3
    RELEASE = 5   # Moving towards Level 4 at Rate 4


class DX7Envelope:
    """Yamaha DX7 4-Rate / 4-Level Exponential Envelope Generator.
    
    Parameters:
      rates:  Tuple[int, int, int, int] (R1, R2, R3, R4) in [0, 99]
      levels: Tuple[int, int, int, int] (L1, L2, L3, L4) in [0, 99]
    """
    def __init__(self, rates: Tuple[int, int, int, int] = (95, 70, 40, 60),
                 levels: Tuple[int, int, int, int] = (99, 80, 50, 0)):
        self.rates = rates
        self.levels = levels
        self.state = EGState.IDLE
        self.current_level = float(levels[3]) / 99.0
        self.target_level = self.current_level
        self.rate_coeff = 0.0
        self.is_finished = True

    def _calc_coeff(self, rate_val: int) -> float:
        # DX7 rates range from ~45 seconds (rate 0) to ~1.5 milliseconds (rate 99)
        rate_val = max(0, min(99, rate_val))
        t_sec = 0.0015 * (45.0 / 0.0015) ** ((99 - rate_val) / 99.0)
        return 1.0 - math.exp(-2.5 / (SAMPLE_RATE * t_sec))

    def key_on(self, velocity: int = 100):
        self.state = EGState.ATTACK
        self.is_finished = False
        self.current_level = float(self.levels[3]) / 99.0
        self.target_level = float(self.levels[0]) / 99.0
        self.rate_coeff = self._calc_coeff(self.rates[0])

    def key_off(self):
        self.state = EGState.RELEASE
        self.target_level = float(self.levels[3]) / 99.0
        self.rate_coeff = self._calc_coeff(self.rates[3])

    def tick(self) -> float:
        if self.state == EGState.IDLE:
            return self.current_level

        if self.state == EGState.SUSTAIN:
            return self.current_level

        diff = self.target_level - self.current_level
        self.current_level += diff * self.rate_coeff

        # State transitions
        if abs(diff) < 0.002:
            self.current_level = self.target_level
            if self.state == EGState.ATTACK:
                self.state = EGState.DECAY1
                self.target_level = float(self.levels[1]) / 99.0
                self.rate_coeff = self._calc_coeff(self.rates[1])
            elif self.state == EGState.DECAY1:
                self.state = EGState.DECAY2
                self.target_level = float(self.levels[2]) / 99.0
                self.rate_coeff = self._calc_coeff(self.rates[2])
            elif self.state == EGState.DECAY2:
                self.state = EGState.SUSTAIN
            elif self.state == EGState.RELEASE:
                self.state = EGState.IDLE
                self.is_finished = True

        return self.current_level


# =====================================================================
# DX7 Operator Configuration & DSP Unit
# =====================================================================
@dataclass
class OperatorConfig:
    ratio: float = 1.0           # Harmonic frequency multiplier (e.g. 1.0, 2.0, 3.14)
    detune: float = 0.0          # Fine pitch detune in Hz
    output_level: int = 99       # Peak volume / modulation index [0, 99]
    rates: Tuple[int, int, int, int] = (95, 60, 40, 50)
    levels: Tuple[int, int, int, int] = (99, 85, 70, 0)
    feedback: float = 0.0        # Self-modulation feedback index
    velocity_sens: float = 0.5   # Velocity sensitivity factor


class Operator:
    def __init__(self, op_id: int, config: OperatorConfig):
        self.op_id = op_id
        self.config = config
        self.phase = 0.0
        self.eg = DX7Envelope(config.rates, config.levels)
        self.fb1 = 0.0
        self.fb2 = 0.0
        self.vel_scale = 1.0
        self.base_freq = 440.0

    def set_frequency(self, freq: float, velocity: int = 100):
        self.base_freq = freq
        self.phase = 0.0
        self.fb1 = 0.0
        self.fb2 = 0.0
        v_norm = max(1, min(127, velocity)) / 127.0
        self.vel_scale = (1.0 - self.config.velocity_sens) + self.config.velocity_sens * (v_norm ** 1.5)
        self.eg.key_on(velocity)

    def key_off(self):
        self.eg.key_off()

    def tick(self, mod_in: float = 0.0, lfo_pitch: float = 0.0) -> float:
        env = self.eg.tick()
        # Modulated frequency
        actual_freq = (self.base_freq * self.config.ratio + self.config.detune) * (1.0 + lfo_pitch)
        phase_inc = 2.0 * math.pi * actual_freq / SAMPLE_RATE
        self.phase = (self.phase + phase_inc) % (2.0 * math.pi)

        # Feedback calculation with 2-sample anti-aliasing average
        fb_mod = 0.0
        if self.config.feedback > 0.0:
            fb_mod = self.config.feedback * (self.fb1 + self.fb2) * 0.5

        # Output amplitude (scaled from 0..99 logarithmic index to linear amplitude)
        amp = (float(self.config.output_level) / 99.0) * env * self.vel_scale
        total_phase = self.phase + mod_in + fb_mod
        out = math.sin(total_phase) * amp

        # Update feedback history
        self.fb2 = self.fb1
        self.fb1 = out
        return out


