#!/usr/bin/env python3
"""Sparse Autoencoders (SAE) & Mechanistic Interpretability Engine.

A mathematically rigorous, production-grade implementation of Top-K and L1-penalized
Sparse Autoencoders for dictionary learning and polysemanticity disentanglement
on neural activations, featuring Adam optimization from scratch, dead latent resampling,
monosemanticity evaluation, causal feature steering, and ANSI terminal visualization.
"""

import sys
import os
import time
import math
import argparse
from typing import Dict, List, Tuple, Optional, Any
import numpy as np

class Style:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    ITALIC = "\033[3m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"

def banner(title: str):
    w = 76
    print(f"{Style.MAGENTA}{Style.BOLD}{'=' * w}{Style.RESET}")
    print(f"{Style.MAGENTA}{Style.BOLD} 🔬  {title}{Style.RESET}")
    print(f"{Style.MAGENTA}{Style.BOLD}{'=' * w}{Style.RESET}")

def progress_bar(current: int, total: int, width: int = 24, label: str = "") -> str:
    fraction = min(1.0, current / max(1, total))
    filled = int(round(width * fraction))
    bar = "█" * filled + "░" * (width - filled)
    return f"{Style.CYAN}{bar}{Style.RESET} {fraction * 100:5.1f}% {label}"

class SuperpositionEnvironment:
    def __init__(self, d_model: int = 64, n_features: int = 256, sparsity_k: int = 5, seed: int = 42):
        self.d_model = d_model
        self.n_features = n_features
        self.sparsity_k = sparsity_k
        self.rng = np.random.default_rng(seed)
        raw_dict = self.rng.standard_normal((d_model, n_features))
        self.true_dictionary = raw_dict / np.linalg.norm(raw_dict, axis=0, keepdims=True)
        ranks = np.arange(1, n_features + 1)
        self.feature_frequencies = 1.0 / (ranks ** 0.6)
        self.feature_frequencies /= self.feature_frequencies.sum()
        self.concept_names = [
            f"Concept-{i:03d}:" + [
                "SyntaxTree", "MedicalDiagnosis", "FormalTone", "CodeIndent",
                "ArithmeticSum", "SpatialRelative", "TemporalPast", "LegalCitation",
                "EmotionPositive", "LogicalDeduction", "PunctuationPeriod", "ColorHue"
            ][i % 12] for i in range(n_features)
        ]

    def sample_batch(self, batch_size: int = 128, noise_std: float = 0.02) -> Tuple[np.ndarray, np.ndarray]:
        true_latents = np.zeros((batch_size, self.n_features), dtype=np.float32)
        for b in range(batch_size):
            active_indices = self.rng.choice(self.n_features, size=self.sparsity_k, replace=False, p=self.feature_frequencies)
            magnitudes = self.rng.exponential(scale=2.5, size=self.sparsity_k) + 0.5
            true_latents[b, active_indices] = magnitudes
        superposition = true_latents @ self.true_dictionary.T
        if noise_std > 0:
            superposition += self.rng.standard_normal(superposition.shape) * noise_std
        return superposition.astype(np.float32), true_latents

class TopKSparseAutoencoder:
    def __init__(self, d_model: int, n_dict: int, k_top: int, lr: float = 3e-3, seed: int = 1337):
        self.d_model = d_model
        self.n_dict = n_dict
        self.k_top = k_top
        self.lr = lr
        self.rng = np.random.default_rng(seed)
        bound_enc = 1.0 / math.sqrt(d_model)
        self.W_enc = self.rng.uniform(-bound_enc, bound_enc, (d_model, n_dict)).astype(np.float32)
        self.b_enc = np.zeros(n_dict, dtype=np.float32)
        self.W_dec = self.W_enc.T.copy()
        self.normalize_decoder()
        self.b_dec = np.zeros(d_model, dtype=np.float32)
        self.beta1, self.beta2, self.eps = 0.9, 0.999, 1e-8
        self.step = 0
        self.m_W_enc, self.v_W_enc = np.zeros_like(self.W_enc), np.zeros_like(self.W_enc)
        self.m_b_enc, self.v_b_enc = np.zeros_like(self.b_enc), np.zeros_like(self.b_enc)
        self.m_W_dec, self.v_W_dec = np.zeros_like(self.W_dec), np.zeros_like(self.W_dec)
        self.m_b_dec, self.v_b_dec = np.zeros_like(self.b_dec), np.zeros_like(self.b_dec)
        self.latent_firing_counts = np.zeros(n_dict, dtype=np.int64)
        self.total_tokens_seen = 0
        self.dead_threshold = 1e-5

    def normalize_decoder(self):
        norms = np.linalg.norm(self.W_dec, axis=1, keepdims=True)
        norms = np.maximum(norms, 1e-12)
        self.W_dec /= norms

    def encode(self, x: np.ndarray) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
        x_centered = x - self.b_dec
        pre_acts = x_centered @ self.W_enc + self.b_enc
        batch_size = x.shape[0]
        k = min(self.k_top, self.n_dict)
        topk_part = np.argpartition(pre_acts, -k, axis=1)[:, -k:]
        rows = np.arange(batch_size)[:, None]
        topk_mask = np.zeros_like(pre_acts, dtype=bool)
        topk_mask[rows, topk_part] = True
        sparse_acts = np.where(topk_mask & (pre_acts > 0), pre_acts, 0.0).astype(np.float32)
        return sparse_acts, pre_acts, topk_mask

    def decode(self, sparse_acts: np.ndarray) -> np.ndarray:
        return (sparse_acts @ self.W_dec + self.b_dec).astype(np.float32)

    def forward(self, x: np.ndarray) -> Tuple[np.ndarray, np.ndarray, Dict[str, float]]:
        sparse_acts, pre_acts, topk_mask = self.encode(x)
        x_recon = self.decode(sparse_acts)
        residual = x - x_recon
        mse_loss = float(np.mean(residual ** 2))
        fvu = float(np.mean(np.sum(residual ** 2, axis=1) / (np.sum((x - np.mean(x, axis=0)) ** 2, axis=1) + 1e-12)))
        l0_norm = float(np.mean(np.count_nonzero(sparse_acts, axis=1)))
        return x_recon, sparse_acts, {"mse": mse_loss, "fvu": fvu, "l0": l0_norm}

    def backward_and_step(self, x: np.ndarray, x_recon: np.ndarray, sparse_acts: np.ndarray, topk_mask: np.ndarray):
        batch_size = x.shape[0]
        self.step += 1
        self.total_tokens_seen += batch_size
        self.latent_firing_counts += np.sum(sparse_acts > 0, axis=0)
        d_x_recon = (2.0 / (batch_size * self.d_model)) * (x_recon - x)
        grad_W_dec = sparse_acts.T @ d_x_recon
        grad_b_dec = np.sum(d_x_recon, axis=0)
        d_sparse_acts = d_x_recon @ self.W_dec.T
        d_pre_acts = np.where(topk_mask & (sparse_acts > 0), d_sparse_acts, 0.0)
        x_centered = x - self.b_dec
        grad_W_enc = x_centered.T @ d_pre_acts
        grad_b_enc = np.sum(d_pre_acts, axis=0)
        grad_b_dec += -np.sum(d_pre_acts @ self.W_enc.T, axis=0)
        for g in [grad_W_enc, grad_b_enc, grad_W_dec, grad_b_dec]:
            np.clip(g, -5.0, 5.0, out=g)
        def adam_step(param, grad, m, v):
            m = self.beta1 * m + (1.0 - self.beta1) * grad
            v = self.beta2 * v + (1.0 - self.beta2) * (grad ** 2)
            m_hat = m / (1.0 - self.beta1 ** self.step)
            v_hat = v / (1.0 - self.beta2 ** self.step)
            param -= self.lr * m_hat / (np.sqrt(v_hat) + self.eps)
            return param, m, v
        self.W_enc, self.m_W_enc, self.v_W_enc = adam_step(self.W_enc, grad_W_enc, self.m_W_enc, self.v_W_enc)
        self.b_enc, self.m_b_enc, self.v_b_enc = adam_step(self.b_enc, grad_b_enc, self.m_b_enc, self.v_b_enc)
        self.W_dec, self.m_W_dec, self.v_W_dec = adam_step(self.W_dec, grad_W_dec, self.m_W_dec, self.v_W_dec)
        self.b_dec, self.m_b_dec, self.v_b_dec = adam_step(self.b_dec, grad_b_dec, self.m_b_dec, self.v_b_dec)
        self.normalize_decoder()

    def resample_dead_latents(self, x: np.ndarray) -> int:
        if self.total_tokens_seen < 1000:
            return 0
        firing_rates = self.latent_firing_counts / max(1, self.total_tokens_seen)
        dead_indices = np.where(firing_rates < self.dead_threshold)[0]
        if len(dead_indices) == 0:
            return 0
        x_recon, _, _ = self.forward(x)
        residuals = x - x_recon
        residual_norms = np.linalg.norm(residuals, axis=1)
        probs = residual_norms / (np.sum(residual_norms) + 1e-12)
        n_resample = min(len(dead_indices), len(x))
        chosen = self.rng.choice(len(x), size=n_resample, replace=False, p=probs)
        for i, dead_idx in enumerate(dead_indices[:n_resample]):
            res_vec = residuals[chosen[i]]
            norm = np.linalg.norm(res_vec)
            if norm > 1e-6:
                unit_vec = res_vec / norm
                self.W_dec[dead_idx] = unit_vec
                self.W_enc[:, dead_idx] = unit_vec * 0.5
                self.b_enc[dead_idx] = 0.0
                self.m_W_enc[:, dead_idx] = 0.0
                self.v_W_enc[:, dead_idx] = 0.0
                self.m_W_dec[dead_idx] = 0.0
                self.v_W_dec[dead_idx] = 0.0
                self.latent_firing_counts[dead_idx] = 1
        self.normalize_decoder()
        return n_resample

class InterpretabilityEvaluator:
    @staticmethod
    def evaluate_concept_recovery(sae: TopKSparseAutoencoder, env: SuperpositionEnvironment) -> Dict[str, float]:
        learned = sae.W_dec
        true_v = env.true_dictionary.T
        sim_matrix = np.abs(learned @ true_v.T)
        max_sim = np.max(sim_matrix, axis=0)
        sorted_sims = np.sort(sim_matrix, axis=1)
        return {
            "mean_concept_recovery": float(np.mean(max_sim)),
            "fraction_recovered_above_90": float(np.mean(max_sim >= 0.90)),
            "fraction_recovered_above_80": float(np.mean(max_sim >= 0.80)),
            "monosemanticity_ratio": float(np.mean(sorted_sims[:, -1] / (sorted_sims[:, -2] + 1e-12)))
        }

    @staticmethod
    def steer_activation(sae: TopKSparseAutoencoder, x: np.ndarray, latent_idx: int, strength: float) -> Tuple[np.ndarray, Dict[str, float]]:
        sparse_acts, _, _ = sae.encode(x)
        orig_val = float(sparse_acts[0, latent_idx])
        steered_acts = sparse_acts.copy()
        steered_acts[:, latent_idx] += strength
        x_steered = sae.decode(steered_acts)
        orig_norm = np.linalg.norm(x[0]) + 1e-12
        steered_norm = np.linalg.norm(x_steered[0]) + 1e-12
        cos_sim = float(np.dot(x[0], x_steered[0]) / (orig_norm * steered_norm))
        displacement = float(np.linalg.norm(x_steered[0] - x[0]))
        return x_steered, {
            "original_activation": orig_val,
            "steered_activation": float(steered_acts[0, latent_idx]),
            "cosine_similarity_to_orig": cos_sim,
            "activation_displacement_norm": displacement
        }

def cmd_train(args):
    banner("Training Top-K Sparse Autoencoder on Polysemantic Superposition")
    env = SuperpositionEnvironment(d_model=args.d_model, n_features=args.n_features, sparsity_k=args.sparsity_k, seed=args.seed)
    sae = TopKSparseAutoencoder(d_model=args.d_model, n_dict=args.n_dict, k_top=args.k_top, lr=args.lr, seed=args.seed + 1)
    t0 = time.time()
    for step in range(1, args.steps + 1):
        xb, _ = env.sample_batch(args.batch_size)
        s, p, m = sae.encode(xb)
        r = sae.decode(s)
        sae.backward_and_step(xb, r, s, m)
        if step % 250 == 0: sae.resample_dead_latents(xb)
        if step % (args.steps // 10 or 1) == 0 or step == args.steps:
            res = xb - r
            mse = float(np.mean(res ** 2))
            fvu = mse / (float(np.var(xb)) + 1e-12)
            dead_cnt = int(np.sum(sae.latent_firing_counts == 0))
            pbar = progress_bar(step, args.steps, width=20)
            elapsed = time.time() - t0
            print(f"{pbar} | Step {step:5d} | MSE: {mse:7.5f} | FVU: {fvu*100:5.2f}% | Dead: {dead_cnt/sae.n_dict*100:4.1f}% | {elapsed:4.1f}s")
    eval_m = InterpretabilityEvaluator.evaluate_concept_recovery(sae, env)
    print(f"{Style.GREEN}{Style.BOLD}✅ Training Complete!{Style.RESET}")
    print(f"  • Mean Concept Recovery:       {eval_m['mean_concept_recovery']:.4f}")
    print(f"  • Fraction Recovered (>0.90):  {eval_m['fraction_recovered_above_90']*100:.1f}%")
    print(f"  • Monosemanticity Ratio:       {eval_m['monosemanticity_ratio']:.2f}x")

def cmd_inspect(args):
    banner("Mechanistic Latent Inspector & Monosemantic Feature Cards")
    env = SuperpositionEnvironment(d_model=48, n_features=144, sparsity_k=4, seed=args.seed)
    sae = TopKSparseAutoencoder(d_model=48, n_dict=144, k_top=4, lr=4e-3, seed=args.seed + 1)
    for _ in range(400):
        xb, _ = env.sample_batch(128)
        s, _, m = sae.encode(xb)
        r = sae.decode(s)
        sae.backward_and_step(xb, r, s, m)
    sim_matrix = np.abs(sae.W_dec @ env.true_dictionary.T)
    top_latents = np.argsort(np.max(sim_matrix, axis=1))[::-1][:args.limit]
    print(f"\n{Style.BOLD}{'ID':<6} {'Feature':<22} {'Matched Concept':<28} {'Cosine Sim':<12} {'Firing Rate'}{Style.RESET}")
    print("-" * 78)
    for l_id in top_latents:
        best_gt = int(np.argmax(sim_matrix[l_id]))
        cosine = float(sim_matrix[l_id, best_gt])
        rate = sae.latent_firing_counts[l_id] / max(1, sae.total_tokens_seen)
        name = env.concept_names[best_gt]
        color = Style.GREEN if cosine >= 0.85 else (Style.YELLOW if cosine >= 0.70 else Style.RED)
        print(f"{l_id:4d}   Latent-{l_id:03d}         {name:<28} {color}{cosine:8.4f}{Style.RESET}     {rate*100:6.2f}%")

def cmd_steer():
    banner("Causal Activation Steering Demonstration")
    env = SuperpositionEnvironment(d_model=48, n_features=128, sparsity_k=4, seed=42)
    sae = TopKSparseAutoencoder(d_model=48, n_dict=128, k_top=4, lr=4e-3, seed=43)
    for _ in range(350):
        xb, _ = env.sample_batch(128)
        s, _, m = sae.encode(xb)
        r = sae.decode(s)
        sae.backward_and_step(xb, r, s, m)
    x_test, _ = env.sample_batch(1)
    target_latent = int(np.argmax(sae.W_dec @ env.true_dictionary[:, 5]))
    concept_name = env.concept_names[5]
    print(f"Target Concept: {Style.CYAN}{concept_name}{Style.RESET} (SAE Latent Index {target_latent})")
    print("-" * 76)
    print(f"{'Alpha (α)':<16} {'Pre-Activation':<16} {'Post-Activation':<16} {'Cosine Sim':<14} {'Displacement'}")
    print("-" * 76)
    for alpha in [-4.0, -2.0, 0.0, 2.0, 5.0, 10.0]:
        _, stats = InterpretabilityEvaluator.steer_activation(sae, x_test, target_latent, alpha)
        highlight = Style.BOLD + Style.GREEN if alpha > 0 else (Style.YELLOW if alpha == 0 else Style.CYAN)
        print(f"{highlight}{alpha:+.1f}{Style.RESET:<14} {stats['original_activation']:12.3f}     {stats['steered_activation']:12.3f}     {stats['cosine_similarity_to_orig']:10.4f}     {stats['activation_displacement_norm']:10.4f}")

def cmd_benchmark():
    banner("SAE High-Velocity Encoder/Decoder Throughput Benchmark")
    d_model, n_dict, k_top = 128, 512, 16
    sae = TopKSparseAutoencoder(d_model=d_model, n_dict=n_dict, k_top=k_top)
    batch_sizes = [64, 256, 1024]
    print(f"Config: d_model={d_model}, n_dict={n_dict} (4x overcomplete), k_top={k_top}\n")
    print(f"{'Batch Size':<12} {'Forward Latency':<18} {'Throughput (Tokens/s)':<24} {'Backward Latency'}")
    print("-" * 72)
    for bs in batch_sizes:
        x = np.random.randn(bs, d_model).astype(np.float32)
        for _ in range(5):
            s, _, m = sae.encode(x)
            r = sae.decode(s)
        t0 = time.time()
        for _ in range(40):
            s, p, m = sae.encode(x)
            r = sae.decode(s)
        fwd_time = (time.time() - t0) / 40
        t0 = time.time()
        for _ in range(40):
            sae.backward_and_step(x, r, s, m)
        bwd_time = (time.time() - t0) / 40
        print(f"{bs:<12} {fwd_time*1000:10.2f} ms        {bs/fwd_time:16,.0f}            {bwd_time*1000:10.2f} ms")

def cmd_verify():
    banner("Sparse Autoencoders & Interpretability Verification Test Suite")
    suites = []
    sae = TopKSparseAutoencoder(d_model=32, n_dict=128, k_top=6)
    x = np.random.randn(50, 32).astype(np.float32)
    s, _, _ = sae.encode(x)
    l0 = np.count_nonzero(s, axis=1)
    t1_pass = bool(np.all(l0 <= 6) and np.all(s >= 0.0))
    suites.append(("Top-K Sparsity & Non-Negativity Invariant (k=6)", t1_pass, f"Max L0: {np.max(l0)}, Min: {np.min(s)}"))
    norms = np.linalg.norm(sae.W_dec, axis=1)
    t2_pass = bool(np.allclose(norms, 1.0, atol=1e-5))
    suites.append(("Decoder Column Unit Hypersphere Projection ||W_dec||=1.0", t2_pass, f"Mean norm: {np.mean(norms):.6f}"))
    env = SuperpositionEnvironment(d_model=32, n_features=64, sparsity_k=3, seed=42)
    sae_conv = TopKSparseAutoencoder(d_model=32, n_dict=64, k_top=3, lr=5e-3)
    x_init, _ = env.sample_batch(128)
    _, _, init_m = sae_conv.forward(x_init)
    for _ in range(300):
        xb, _ = env.sample_batch(128)
        s, _, m = sae_conv.encode(xb)
        r = sae_conv.decode(s)
        sae_conv.backward_and_step(xb, r, s, m)
    x_post, _ = env.sample_batch(128)
    _, _, post_m = sae_conv.forward(x_post)
    t3_pass = bool(post_m['fvu'] < init_m['fvu'] * 0.45)
    suites.append(("Adam Optimizer Loss & FVU Reduction Convergence", t3_pass, f"Initial FVU: {init_m['fvu']*100:.1f}% -> Final: {post_m['fvu']*100:.1f}%"))
    sae_conv.latent_firing_counts[:10] = 0
    sae_conv.total_tokens_seen = 20000
    resampled = sae_conv.resample_dead_latents(x_post)
    t4_pass = resampled > 0
    suites.append(("Dead Feature Identification & Residual Resampling", t4_pass, f"Revived {resampled} dead latents"))
    metrics = InterpretabilityEvaluator.evaluate_concept_recovery(sae_conv, env)
    t5_pass = metrics['mean_concept_recovery'] > 0.70
    suites.append(("Concept Recovery Alignment Against Ground Truth (>0.70)", t5_pass, f"Mean Cosine: {metrics['mean_concept_recovery']:.4f}"))
    all_passed = all(p for _, p, _ in suites)
    for idx, (name, passed, detail) in enumerate(suites, 1):
        status = f"{Style.GREEN}[PASS]{Style.RESET}" if passed else f"{Style.RED}[FAIL]{Style.RESET}"
        print(f"  [{idx}/{len(suites)}] {name}: {status}")
        print(f"        {Style.DIM}{detail}{Style.RESET}")
    print("=" * 76)
    if all_passed:
        print(f"{Style.GREEN}{Style.BOLD}All {len(suites)} SAE Verification Test Suites Passed!{Style.RESET}")
    else:
        print(f"{Style.RED}{Style.BOLD}Verification failed.{Style.RESET}")
        sys.exit(1)

def cmd_info():
    banner("Mathematical Foundations: Superposition & Sparse Autoencoders")
    print("""
  1. The Linear Representation Hypothesis & Polysemanticity:
     • Neural networks represent high-dimensional world concepts as linear directions in activation space.
     • Because models encounter M >> d concepts, they exploit almost-orthogonal high-dimensional geometry
       to pack concepts in SUPERPOSITION: x = ∑ f_i(x) · v_i + ε
     • Consequently, individual neurons fire for multiple unrelated concepts (polysemanticity).

  2. Top-K Sparse Dictionary Learning (Gao et al. 2024):
     • An overcomplete dictionary matrix W_dec ∈ ℝ^{M × d} (with expansion factor M / d ∈ [4, 32])
       resolves superposition into monosemantic axes.
     • Top-K activation directly selects the top-k highest activating dictionary features:
         f(x) = TopK(ReLU(W_enc (x - b_dec) + b_enc), k)
         x̂ = f(x) W_dec + b_dec
     • Eliminates shrinkage bias inherent to L1 penalties (||f(x)||_1), maintaining Pareto optimality.

  3. Unit-Norm Hypersphere Constraint:
     • To prevent the scale-invariance degeneracy where decoder norms shrink and activations blow up,
       decoder columns are projected to the unit sphere: ||W_dec[i, :]||₂ = 1.0.

  4. Residual Resampling:
     • Features that fire rarely (rate < 10⁻⁵) lose gradient flow and die.
     • Resampling identifies high-residual errors e = x - x̂ and reinitializes dead decoder directions
       along e / ||e||₂, reviving dormant capacity.
    """)

def main():
    parser = argparse.ArgumentParser(prog="sae-lens", description="Sparse Autoencoders & Interpretability Engine")
    subparsers = parser.add_subparsers(dest="command")
    train_p = subparsers.add_parser("train")
    train_p.add_argument("--d-model", type=int, default=64)
    train_p.add_argument("--n-dict", type=int, default=256)
    train_p.add_argument("--k-top", type=int, default=6)
    train_p.add_argument("--n-features", type=int, default=256)
    train_p.add_argument("--sparsity-k", type=int, default=5)
    train_p.add_argument("--steps", type=int, default=1000)
    train_p.add_argument("--batch-size", type=int, default=128)
    train_p.add_argument("--lr", type=float, default=3e-3)
    train_p.add_argument("--seed", type=int, default=42)
    inspect_p = subparsers.add_parser("inspect")
    inspect_p.add_argument("--limit", type=int, default=10)
    inspect_p.add_argument("--seed", type=int, default=42)
    subparsers.add_parser("steer")
    subparsers.add_parser("benchmark")
    subparsers.add_parser("verify")
    subparsers.add_parser("info")
    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)
    if args.command == "train": cmd_train(args)
    elif args.command == "inspect": cmd_inspect(args)
    elif args.command == "steer": cmd_steer()
    elif args.command == "benchmark": cmd_benchmark()
    elif args.command == "verify": cmd_verify()
    elif args.command == "info": cmd_info()

if __name__ == '__main__':
    main()
