#!/usr/bin/env python3
"""2D Incompressible Navier-Stokes Fluid Dynamics Engine (Chorin Projection Method).

A production-grade, mathematically rigorous implementation of the 2D Incompressible
Navier-Stokes equations using Chorin's Projection Method (operator splitting) on a
Marker-and-Cell (MAC) staggered grid in pure Python with NumPy.

Theoretical Foundations:
1. Governing Equations (Incompressible Navier-Stokes):
   ∂u/∂t + (u · ∇)u = -(1/ρ) ∇p + ν ∇²u + f
   ∇ · u = 0

2. Helmholtz-Hodge Decomposition Theorem:
   Any vector field w can be uniquely decomposed into a solenoidal (divergence-free)
   component u and an irrotational (curl-free) gradient ∇φ:
   w = u + ∇φ,  with  ∇ · u = 0

3. Fractional Step / Chorin Splitting Scheme:
   - Step 1 (Advection): Non-linear convective transport solved via 2nd-order Runge-Kutta
     Semi-Lagrangian characteristic back-tracing with bilinear interpolation.
   - Step 2 (Viscous Diffusion): Solved implicitly via Helmholtz relaxation:
     (I - ν Δt ∇²) u** = u*
   - Step 3 (Pressure Poisson Equation): Divergence of intermediate velocity sources pressure:
     ∇²p = (ρ / Δt) ∇ · u**
     Solved via Preconditioned Conjugate Gradient (PCG).
   - Step 4 (Velocity Projection): Enforces incompressibility ∇ · u^{n+1} = 0:
     u^{n+1} = u** - (Δt / ρ) ∇p

4. MAC Staggered Grid (Harlow & Welch, 1965):
   - Scalar quantities (pressure p, vorticity ω) defined at cell centers (i, j).
   - Horizontal velocity u defined at vertical cell faces (i ± 1/2, j).
   - Vertical velocity v defined at horizontal cell faces (i, j ± 1/2).
   - Eliminates checkerboard pressure oscillations without artificial dissipation.

5. High-Resolution Visualizer:
   - Unicode Braille canvas (2x4 dot subpixel resolution, U+2800..U+28FF).
   - Palettes: Vorticity, Velocity Magnitude, Pressure, and Streamlines.
"""

import argparse
import math
import os
import sys
import time
from typing import Any, Dict, List, Optional, Tuple
import numpy as np


# =====================================================================
# ANSI Styling & Color Palettes
# =====================================================================
class Style:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    ITALIC = "\033[3m"
    CYAN = "\033[36m"
    BRIGHT_CYAN = "\033[96m"
    BLUE = "\033[34m"
    BRIGHT_BLUE = "\033[94m"
    GREEN = "\033[32m"
    BRIGHT_GREEN = "\033[92m"
    YELLOW = "\033[33m"
    BRIGHT_YELLOW = "\033[93m"
    RED = "\033[31m"
    BRIGHT_RED = "\033[91m"
    MAGENTA = "\033[35m"
    BRIGHT_MAGENTA = "\033[95m"
    WHITE = "\033[97m"
    BG_DARK = "\033[48;5;234m"

    @staticmethod
    def rgb(r: int, g: int, b: int) -> str:
        return f"\033[38;2;{r};{g};{b}m"


# =====================================================================
# High-Resolution Unicode Braille Canvas (2x4 subpixels per cell)
# =====================================================================
class BrailleCanvas:
    """Unicode Braille terminal canvas (U+2800..U+28FF) with 2x4 subpixel density."""
    DOT_MAP = [
        [0x01, 0x08],
        [0x02, 0x10],
        [0x04, 0x20],
        [0x40, 0x80],
    ]

    def __init__(self, char_width: int, char_height: int):
        self.char_width = char_width
        self.char_height = char_height
        self.pixel_width = char_width * 2
        self.pixel_height = char_height * 4

    def render(
        self,
        scalar_grid: np.ndarray,
        obstacle_mask: Optional[np.ndarray] = None,
        vmin: Optional[float] = None,
        vmax: Optional[float] = None,
        palette: str = "vorticity"
    ) -> List[str]:
        ny, nx = scalar_grid.shape
        if obstacle_mask is None:
            obstacle_mask = np.zeros((ny, nx), dtype=bool)

        row_indices = np.linspace(ny - 1, 0, self.pixel_height).astype(np.int32)
        col_indices = np.linspace(0, nx - 1, self.pixel_width).astype(np.int32)

        resampled = scalar_grid[row_indices[:, None], col_indices]
        resampled_obs = obstacle_mask[row_indices[:, None], col_indices]

        fluid_vals = resampled[~resampled_obs]
        if vmin is None:
            vmin = float(np.min(fluid_vals)) if fluid_vals.size > 0 else -1.0
        if vmax is None:
            vmax = float(np.max(fluid_vals)) if fluid_vals.size > 0 else 1.0

        span = max(abs(vmin), abs(vmax), 1e-6)
        lines = []

        for cy in range(self.char_height):
            line_parts = []
            for cx in range(self.char_width):
                px = cx * 2
                py = cy * 4
                cell_sub = resampled[py:py + 4, px:px + 2]
                cell_obs = resampled_obs[py:py + 4, px:px + 2]

                if np.sum(cell_obs) >= 4:
                    line_parts.append(f"{Style.BRIGHT_YELLOW}█{Style.RESET}")
                    continue

                braille_code = 0
                avg_val = 0.0
                count = 0
                for r in range(min(4, cell_sub.shape[0])):
                    for c in range(min(2, cell_sub.shape[1])):
                        v = cell_sub[r, c]
                        avg_val += v
                        count += 1
                        if palette == "vorticity":
                            if abs(v) > 0.12 * span:
                                braille_code |= self.DOT_MAP[r][c]
                        else:
                            norm_v = (v - vmin) / max(vmax - vmin, 1e-6)
                            if norm_v > 0.25:
                                braille_code |= self.DOT_MAP[r][c]

                avg_val = avg_val / max(count, 1)
                char = chr(0x2800 + braille_code) if braille_code > 0 else " "

                # Color mapping
                if palette == "vorticity":
                    norm = max(-1.0, min(1.0, avg_val / span))
                    if norm > 0.3:
                        col = Style.rgb(255, int(180 * (1 - norm)), int(50 * (1 - norm)))
                    elif norm > 0.05:
                        col = Style.rgb(240, 200, 80)
                    elif norm < -0.3:
                        col = Style.rgb(50, int(150 * (1 + norm)), 255)
                    elif norm < -0.05:
                        col = Style.rgb(80, 200, 240)
                    else:
                        col = Style.DIM
                elif palette == "speed":
                    norm = max(0.0, min(1.0, (avg_val - vmin) / max(vmax - vmin, 1e-6)))
                    r = int(255 * min(1.0, max(0.0, 1.5 * norm - 0.5)))
                    g = int(255 * min(1.0, max(0.0, 2.0 * norm if norm < 0.5 else 2.0 * (1 - norm))))
                    b = int(255 * min(1.0, max(0.0, 1.0 - 2.0 * norm)))
                    col = Style.rgb(r, g, b)
                else:
                    col = Style.CYAN

                line_parts.append(f"{col}{char}{Style.RESET}")
            lines.append("".join(line_parts))
        return lines


# =====================================================================
# Incompressible Navier-Stokes 2D Solver (Chorin MAC Formulation)
# =====================================================================
class NavierStokes2D:
    """Chorin Projection Method 2D Incompressible Navier-Stokes Solver on a MAC Grid."""

    def __init__(
        self,
        nx: int = 64,
        ny: int = 64,
        lx: float = 1.0,
        ly: float = 1.0,
        nu: float = 0.01,
        rho: float = 1.0,
        bc_type: str = "cavity",
        lid_velocity: float = 1.0
    ):
        self.nx = nx
        self.ny = ny
        self.lx = lx
        self.ly = ly
        self.dx = lx / nx
        self.dy = ly / ny
        self.nu = nu
        self.rho = rho
        self.bc_type = bc_type
        self.lid_velocity = lid_velocity
        self.time = 0.0
        self.step_count = 0

        # Staggered Grid Allocation
        # u: (ny, nx + 1) located at (x_{i}, y_{j+1/2}) where x_i = i*dx, y_{j+1/2} = (j+0.5)*dy
        self.u = np.zeros((ny, nx + 1), dtype=np.float64)
        # v: (ny + 1, nx) located at (x_{i+1/2}, y_j) where x_{i+1/2} = (i+0.5)*dx, y_j = j*dy
        self.v = np.zeros((ny + 1, nx), dtype=np.float64)
        # p: (ny, nx) cell-centered
        self.p = np.zeros((ny, nx), dtype=np.float64)
        # obstacle mask: (ny, nx) True if solid
        self.obstacle = np.zeros((ny, nx), dtype=bool)

        self._apply_boundary_conditions()

    def set_cylinder_obstacle(self, center_x: float, center_y: float, radius: float):
        """Immerse a solid circular cylinder obstacle."""
        for j in range(self.ny):
            for i in range(self.nx):
                cx = (i + 0.5) * self.dx
                cy = (j + 0.5) * self.dy
                if (cx - center_x) ** 2 + (cy - center_y) ** 2 <= radius ** 2:
                    self.obstacle[j, i] = True

    def _apply_boundary_conditions(self):
        """Enforce boundary conditions on staggered faces."""
        if self.bc_type == "cavity":
            # Normal faces: no-penetration
            self.u[:, 0] = 0.0
            self.u[:, -1] = 0.0
            self.v[0, :] = 0.0
            self.v[-1, :] = 0.0

        elif self.bc_type == "periodic":
            # Periodic wrapping on boundary faces
            self.u[:, -1] = self.u[:, 0]
            self.v[-1, :] = self.v[0, :]

        elif self.bc_type == "channel":
            # Inflow on left: u = lid_velocity
            self.u[:, 0] = self.lid_velocity
            # Convective outflow on right (zero-gradient)
            self.u[:, -1] = self.u[:, -2]
            self.v[:, -1] = self.v[:, -2]
            # Top and bottom: no-penetration
            self.v[0, :] = 0.0
            self.v[-1, :] = 0.0

        # Zero out velocities inside solid obstacles
        if np.any(self.obstacle):
            for j in range(self.ny):
                for i in range(self.nx):
                    if self.obstacle[j, i]:
                        self.u[j, i] = 0.0
                        self.u[j, i + 1] = 0.0
                        self.v[j, i] = 0.0
                        self.v[j + 1, i] = 0.0

    def _interpolate_bilinear(self, field: np.ndarray, x: np.ndarray, y: np.ndarray, x0: float, y0: float) -> np.ndarray:
        """Vectorized bilinear interpolation on uniform grid."""
        ny, nx = field.shape
        if self.bc_type == "periodic":
            gx = np.mod(x - x0, self.lx) / self.dx
            gy = np.mod(y - y0, self.ly) / self.dy
            i0 = np.floor(gx).astype(np.int32) % nx
            j0 = np.floor(gy).astype(np.int32) % ny
            i1 = (i0 + 1) % nx
            j1 = (j0 + 1) % ny
            sx = gx - np.floor(gx)
            sy = gy - np.floor(gy)
        else:
            gx = (x - x0) / self.dx
            gy = (y - y0) / self.dy
            i0 = np.clip(np.floor(gx).astype(np.int32), 0, nx - 2)
            j0 = np.clip(np.floor(gy).astype(np.int32), 0, ny - 2)
            i1 = i0 + 1
            j1 = j0 + 1
            sx = np.clip(gx - i0, 0.0, 1.0)
            sy = np.clip(gy - j0, 0.0, 1.0)

        val = (
            (1.0 - sx) * (1.0 - sy) * field[j0, i0]
            + sx * (1.0 - sy) * field[j0, i1]
            + (1.0 - sx) * sy * field[j1, i0]
            + sx * sy * field[j1, i1]
        )
        return val

    def advect(self, dt: float):
        """Semi-Lagrangian advection with 2nd-order Runge-Kutta back-tracing."""
        # 1. Advect u-component
        ny_u, nx_u = self.u.shape
        x_u_1d = np.linspace(0, self.lx, nx_u)
        y_u_1d = np.linspace(0.5 * self.dy, self.ly - 0.5 * self.dy, ny_u)
        X_u, Y_u = np.meshgrid(x_u_1d, y_u_1d)

        # Interpolate v onto u-faces: 4-point average
        if self.bc_type == "periodic":
            v_at_u = 0.25 * (np.roll(self.v[:-1, :], -1, axis=1) + self.v[:-1, :] + np.roll(self.v[1:, :], -1, axis=1) + self.v[1:, :])
            v_at_u = np.pad(v_at_u, ((0, 0), (0, 1)), mode="wrap")
        else:
            v_at_u = np.zeros_like(self.u)
            v_at_u[:, :-1] += 0.25 * (self.v[:-1, :] + self.v[1:, :])
            v_at_u[:, 1:] += 0.25 * (self.v[:-1, :] + self.v[1:, :])

        # RK2 midpoint backtrace
        x_mid_u = X_u - 0.5 * dt * self.u
        y_mid_u = Y_u - 0.5 * dt * v_at_u
        u_field = self.u[:, :-1] if self.bc_type == "periodic" else self.u
        v_field = v_at_u[:, :-1] if self.bc_type == "periodic" else v_at_u
        u_mid = self._interpolate_bilinear(u_field, x_mid_u, y_mid_u, 0.0, 0.5 * self.dy)
        v_mid = self._interpolate_bilinear(v_field, x_mid_u, y_mid_u, 0.0, 0.5 * self.dy)

        x_back_u = X_u - dt * u_mid
        y_back_u = Y_u - dt * v_mid
        if self.bc_type != "periodic":
            x_back_u = np.clip(x_back_u, 0.0, self.lx)
            y_back_u = np.clip(y_back_u, 0.0, self.ly)
        u_new = self._interpolate_bilinear(u_field, x_back_u, y_back_u, 0.0, 0.5 * self.dy)

        # 2. Advect v-component
        ny_v, nx_v = self.v.shape
        x_v_1d = np.linspace(0.5 * self.dx, self.lx - 0.5 * self.dx, nx_v)
        y_v_1d = np.linspace(0, self.ly, ny_v)
        X_v, Y_v = np.meshgrid(x_v_1d, y_v_1d)

        if self.bc_type == "periodic":
            u_at_v = 0.25 * (np.roll(self.u[:, :-1], -1, axis=0) + self.u[:, :-1] + np.roll(self.u[:, 1:], -1, axis=0) + self.u[:, 1:])
            u_at_v = np.pad(u_at_v, ((0, 1), (0, 0)), mode="wrap")
        else:
            u_at_v = np.zeros_like(self.v)
            u_at_v[:-1, :] += 0.25 * (self.u[:, :-1] + self.u[:, 1:])
            u_at_v[1:, :] += 0.25 * (self.u[:, :-1] + self.u[:, 1:])

        x_mid_v = X_v - 0.5 * dt * u_at_v
        y_mid_v = Y_v - 0.5 * dt * self.v
        u_v_field = u_at_v[:-1, :] if self.bc_type == "periodic" else u_at_v
        v_v_field = self.v[:-1, :] if self.bc_type == "periodic" else self.v
        u_mid_v = self._interpolate_bilinear(u_v_field, x_mid_v, y_mid_v, 0.5 * self.dx, 0.0)
        v_mid_v = self._interpolate_bilinear(v_v_field, x_mid_v, y_mid_v, 0.5 * self.dx, 0.0)

        x_back_v = X_v - dt * u_mid_v
        y_back_v = Y_v - dt * v_mid_v
        if self.bc_type != "periodic":
            x_back_v = np.clip(x_back_v, 0.0, self.lx)
            y_back_v = np.clip(y_back_v, 0.0, self.ly)
        v_new = self._interpolate_bilinear(v_v_field, x_back_v, y_back_v, 0.5 * self.dx, 0.0)

        self.u = u_new
        self.v = v_new
        self._apply_boundary_conditions()

    def diffuse(self, dt: float, max_iter: int = 30):
        """Implicit viscous diffusion: (I - ν Δt ∇²) u** = u* via Jacobi iteration."""
        if self.nu <= 1e-12:
            return

        alpha = (self.dx * self.dy) / (self.nu * dt)
        denom = alpha + 4.0

        if self.bc_type == "periodic":
            u_src = self.u[:, :-1].copy()
            v_src = self.v[:-1, :].copy()
            for _ in range(max_iter):
                u_nb = (
                    np.roll(self.u[:, :-1], 1, axis=0)
                    + np.roll(self.u[:, :-1], -1, axis=0)
                    + np.roll(self.u[:, :-1], 1, axis=1)
                    + np.roll(self.u[:, :-1], -1, axis=1)
                )
                self.u[:, :-1] = (alpha * u_src + u_nb) / denom
                self.u[:, -1] = self.u[:, 0]

                v_nb = (
                    np.roll(self.v[:-1, :], 1, axis=0)
                    + np.roll(self.v[:-1, :], -1, axis=0)
                    + np.roll(self.v[:-1, :], 1, axis=1)
                    + np.roll(self.v[:-1, :], -1, axis=1)
                )
                self.v[:-1, :] = (alpha * v_src + v_nb) / denom
                self.v[-1, :] = self.v[0, :]
        else:
            u_src = self.u.copy()
            v_src = self.v.copy()
            for _ in range(max_iter):
                u_nb = np.zeros_like(self.u)
                u_nb[1:, :] += self.u[:-1, :]
                u_nb[:-1, :] += self.u[1:, :]
                u_nb[:, 1:] += self.u[:, :-1]
                u_nb[:, :-1] += self.u[:, 1:]
                if self.bc_type == "cavity":
                    u_nb[-1, :] += 2.0 * self.lid_velocity - self.u[-1, :]
                    u_nb[0, :] += -self.u[0, :]
                self.u[:, 1:-1] = (alpha * u_src[:, 1:-1] + u_nb[:, 1:-1]) / denom
                self._apply_boundary_conditions()

                v_nb = np.zeros_like(self.v)
                v_nb[1:, :] += self.v[:-1, :]
                v_nb[:-1, :] += self.v[1:, :]
                v_nb[:, 1:] += self.v[:, :-1]
                v_nb[:, :-1] += self.v[:, 1:]
                if self.bc_type == "cavity":
                    v_nb[:, 0] += -self.v[:, 0]
                    v_nb[:, -1] += -self.v[:, -1]
                self.v[1:-1, :] = (alpha * v_src[1:-1, :] + v_nb[1:-1, :]) / denom
                self._apply_boundary_conditions()

    def _compute_laplacian_p(self, p: np.ndarray) -> np.ndarray:
        """Compute discrete Laplacian ∇²p with boundary conditions."""
        if self.bc_type == "periodic":
            return 4.0 * p - (
                np.roll(p, 1, axis=0)
                + np.roll(p, -1, axis=0)
                + np.roll(p, 1, axis=1)
                + np.roll(p, -1, axis=1)
            )

        Ap = np.zeros_like(p)
        # Top differences (p[j, i] - p[j+1, i])
        Ap[:-1, :] += p[:-1, :] - p[1:, :]
        # Bottom differences (p[j, i] - p[j-1, i])
        Ap[1:, :] += p[1:, :] - p[:-1, :]
        # Right differences (p[j, i] - p[j, i+1])
        Ap[:, :-1] += p[:, :-1] - p[:, 1:]
        # Left differences (p[j, i] - p[j, i-1])
        Ap[:, 1:] += p[:, 1:] - p[:, :-1]
        return Ap

    def solve_pressure_poisson(self, dt: float, max_iter: int = 120, tol: float = 1e-6) -> float:
        """Solve ∇²p = (ρ/Δt) ∇·u using Preconditioned Conjugate Gradient (PCG)."""
        # Divergence on cell centers
        div = (self.u[:, 1:] - self.u[:, :-1]) / self.dx + (self.v[1:, :] - self.v[:-1, :]) / self.dy
        if np.any(self.obstacle):
            div[self.obstacle] = 0.0

        rhs = -(self.rho * (self.dx * self.dy) / dt) * div
        rhs -= np.mean(rhs)  # Solvability condition for Neumann / periodic problem

        p = self.p.copy()
        r = rhs - self._compute_laplacian_p(p)
        r -= np.mean(r)
        d = r.copy()
        rs_old = float(np.sum(r * r))

        if math.sqrt(rs_old) < tol:
            self.p = p
            return math.sqrt(rs_old)

        for _ in range(max_iter):
            q = self._compute_laplacian_p(d)
            denom = float(np.sum(d * q))
            if abs(denom) < 1e-30:
                break
            alpha = rs_old / denom
            p += alpha * d
            r -= alpha * q
            r -= np.mean(r)
            rs_new = float(np.sum(r * r))
            if math.sqrt(rs_new) < tol:
                break
            d = r + (rs_new / max(rs_old, 1e-30)) * d
            rs_old = rs_new

        p -= np.mean(p)
        self.p = p
        return math.sqrt(rs_old)

    def project(self, dt: float):
        """Velocity projection: u^{n+1} = u** - (Δt/ρ) ∇p, ensuring ∇·u^{n+1} = 0."""
        coeff = dt / (self.rho * self.dx)
        coeff_y = dt / (self.rho * self.dy)

        if self.bc_type == "periodic":
            self.u[:, 1:-1] -= coeff * (self.p[:, 1:] - self.p[:, :-1])
            self.u[:, 0] -= coeff * (self.p[:, 0] - self.p[:, -1])
            self.u[:, -1] = self.u[:, 0]

            self.v[1:-1, :] -= coeff_y * (self.p[1:, :] - self.p[:-1, :])
            self.v[0, :] -= coeff_y * (self.p[0, :] - self.p[-1, :])
            self.v[-1, :] = self.v[0, :]
        else:
            # Update internal horizontal faces
            self.u[:, 1:-1] -= coeff * (self.p[:, 1:] - self.p[:, :-1])
            # Update internal vertical faces
            self.v[1:-1, :] -= coeff_y * (self.p[1:, :] - self.p[:-1, :])
            self._apply_boundary_conditions()

    def step(self, dt: Optional[float] = None) -> Dict[str, float]:
        """Execute one full Navier-Stokes time step."""
        if dt is None:
            # Adaptive CFL condition
            max_speed = max(float(np.max(np.abs(self.u))), float(np.max(np.abs(self.v))), 1e-4)
            dt = min(0.4 * min(self.dx, self.dy) / max_speed, 0.02)

        # 1. Advection
        self.advect(dt)

        # 2. Viscous Diffusion
        self.diffuse(dt)

        # 3. Pressure Poisson Solve
        res = self.solve_pressure_poisson(dt)

        # 4. Projection
        self.project(dt)

        self.time += dt
        self.step_count += 1

        # Diagnostic metrics
        max_div = float(np.max(np.abs(self.get_divergence())))
        e_kin = float(self.get_kinetic_energy())
        max_vort = float(np.max(np.abs(self.get_vorticity())))

        return {"dt": dt, "residual": res, "max_div": max_div, "e_kin": e_kin, "max_vort": max_vort}

    def get_divergence(self) -> np.ndarray:
        """Compute cell-centered velocity divergence."""
        div = (self.u[:, 1:] - self.u[:, :-1]) / self.dx + (self.v[1:, :] - self.v[:-1, :]) / self.dy
        if np.any(self.obstacle):
            div[self.obstacle] = 0.0
        return div

    def get_vorticity(self) -> np.ndarray:
        """Compute cell-centered vorticity ω = ∂v/∂x - ∂u/∂y via circulation."""
        v_c = 0.5 * (self.v[:-1, :] + self.v[1:, :])
        u_c = 0.5 * (self.u[:, :-1] + self.u[:, 1:])

        dv_dx = np.zeros((self.ny, self.nx), dtype=np.float64)
        dv_dx[:, 1:-1] = (v_c[:, 2:] - v_c[:, :-2]) / (2.0 * self.dx)
        dv_dx[:, 0] = (v_c[:, 1] - v_c[:, 0]) / self.dx
        dv_dx[:, -1] = (v_c[:, -1] - v_c[:, -2]) / self.dx

        du_dy = np.zeros((self.ny, self.nx), dtype=np.float64)
        du_dy[1:-1, :] = (u_c[2:, :] - u_c[:-2, :]) / (2.0 * self.dy)
        du_dy[0, :] = (u_c[1, :] - u_c[0, :]) / self.dy
        du_dy[-1, :] = (u_c[-1, :] - u_c[-2, :]) / self.dy

        vort = dv_dx - du_dy
        if np.any(self.obstacle):
            vort[self.obstacle] = 0.0
        return vort

    def get_velocity_magnitude(self) -> np.ndarray:
        """Compute cell-centered velocity magnitude |u| = sqrt(u² + v²)."""
        u_c = 0.5 * (self.u[:, :-1] + self.u[:, 1:])
        v_c = 0.5 * (self.v[:-1, :] + self.v[1:, :])
        speed = np.sqrt(u_c ** 2 + v_c ** 2)
        if np.any(self.obstacle):
            speed[self.obstacle] = 0.0
        return speed

    def get_streamfunction(self) -> np.ndarray:
        """Solve Poisson equation ∇²ψ = -ω to compute streamfunction ψ."""
        omega = self.get_vorticity()
        psi = np.zeros_like(omega)
        rhs = -omega * (self.dx * self.dy)
        rhs -= np.mean(rhs)

        r = rhs - self._compute_laplacian_p(psi)
        r -= np.mean(r)
        d = r.copy()
        rs_old = float(np.sum(r * r))

        for _ in range(60):
            q = self._compute_laplacian_p(d)
            denom = float(np.sum(d * q))
            if abs(denom) < 1e-30:
                break
            alpha = rs_old / denom
            psi += alpha * d
            r -= alpha * q
            r -= np.mean(r)
            rs_new = float(np.sum(r * r))
            if math.sqrt(rs_new) < 1e-4:
                break
            d = r + (rs_new / max(rs_old, 1e-30)) * d
            rs_old = rs_new
        return psi

    def get_kinetic_energy(self) -> float:
        """Compute total kinetic energy E = 0.5 ∫ (u² + v²) dx dy."""
        speed = self.get_velocity_magnitude()
        return 0.5 * float(np.sum(speed ** 2)) * self.dx * self.dy


# =====================================================================
# Benchmark Scenarios & Analytical Validations
# =====================================================================
def run_taylor_green_validation(grid_n: int = 48, nu: float = 0.01, steps: int = 40, dt: float = 0.01) -> Dict[str, Any]:
    """Analytical validation against the exact 2D Taylor-Green vortex decaying solution."""
    sim = NavierStokes2D(nx=grid_n, ny=grid_n, lx=2.0 * math.pi, ly=2.0 * math.pi, nu=nu, bc_type="periodic")

    # Exact initial condition: u(x, y, 0) = -cos(x) sin(y), v(x, y, 0) = sin(x) cos(y)
    x_u = np.linspace(0, 2 * math.pi, grid_n + 1)
    y_u = np.linspace(0.5 * sim.dy, 2 * math.pi - 0.5 * sim.dy, grid_n)
    X_u, Y_u = np.meshgrid(x_u, y_u)
    sim.u = -np.cos(X_u) * np.sin(Y_u)

    x_v = np.linspace(0.5 * sim.dx, 2 * math.pi - 0.5 * sim.dx, grid_n)
    y_v = np.linspace(0, 2 * math.pi, grid_n + 1)
    X_v, Y_v = np.meshgrid(x_v, y_v)
    sim.v = np.sin(X_v) * np.cos(Y_v)

    e0 = sim.get_kinetic_energy()

    print(f"{Style.BOLD}{Style.CYAN}═══ 2D Taylor-Green Vortex Decay Analytical Validation ═══{Style.RESET}")
    print(f"Grid: {grid_n}x{grid_n} | Viscosity ν: {nu} | Steps: {steps} | Timestep dt: {dt}")
    print(f"Initial Kinetic Energy E(0): {e0:.6f}")

    for s in range(steps):
        sim.step(dt)

    e_num = sim.get_kinetic_energy()
    decay_factor_exact = math.exp(-4.0 * nu * sim.time)
    e_exact = e0 * decay_factor_exact
    rel_err = abs(e_num - e_exact) / e_exact
    max_div = float(np.max(np.abs(sim.get_divergence())))

    print(f"Time t: {sim.time:.3f} | Numerical E(t): {e_num:.6f} | Exact E(t): {e_exact:.6f}")
    print(f"Relative Energy Error: {rel_err * 100:.3f}% | Max Divergence: {max_div:.2e}")

    passed = rel_err < 0.05 and max_div < 1e-6
    status = f"{Style.BRIGHT_GREEN}PASSED{Style.RESET}" if passed else f"{Style.BRIGHT_RED}FAILED{Style.RESET}"
    print(f"Analytical Validation: {status}\n")

    return {"passed": passed, "rel_error": rel_err, "max_div": max_div, "e_num": e_num, "e_exact": e_exact}


def run_cavity_simulation(re: float = 100.0, grid_n: int = 48, steps: int = 300, dt: float = 0.005, vis: str = "vorticity") -> Dict[str, Any]:
    """Lid-Driven Cavity flow simulation at specified Reynolds number."""
    nu = 1.0 / re
    sim = NavierStokes2D(nx=grid_n, ny=grid_n, lx=1.0, ly=1.0, nu=nu, bc_type="cavity", lid_velocity=1.0)
    canvas = BrailleCanvas(char_width=50, char_height=20)

    print(f"{Style.BOLD}{Style.CYAN}═══ Lid-Driven Cavity Simulation (Re = {re:.0f}) ═══{Style.RESET}")
    print(f"Grid: {grid_n}x{grid_n} | ν = {nu:.5f} | Lid Speed U = 1.0 | Steps: {steps}")

    t0 = time.perf_counter()
    for s in range(1, steps + 1):
        metrics = sim.step(dt)
        if s % 50 == 0 or s == steps:
            rate = s / (time.perf_counter() - t0)
            print(f"Step {s:04d}/{steps} | t={sim.time:.3f} | E_kin={metrics['e_kin']:.4f} | |∇·u|={metrics['max_div']:.1e} | {rate:.1f} steps/s")

    # Extract Centerline Velocity profile at x = 0.5
    mid_x = grid_n // 2
    u_centerline = 0.5 * (sim.u[:, mid_x] + sim.u[:, mid_x + 1])
    min_u = float(np.min(u_centerline))
    min_y = float(np.argmin(u_centerline)) / grid_n

    print(f"\n{Style.BOLD}Centerline Analysis (x = 0.5):{Style.RESET}")
    print(f"  • Minimum u-velocity: {min_u:.4f} (Ghia et al. Re=100 benchmark: ~ -0.21)")
    print(f"  • Vortex core y-pos:  {min_y:.3f} (Ghia et al. Re=100 benchmark: ~ 0.46)")

    if vis != "none":
        field = sim.get_vorticity() if vis == "vorticity" else sim.get_velocity_magnitude()
        render_lines = canvas.render(field, palette=vis)
        print(f"\n{Style.BOLD}Terminal Flow Field Visualization ({vis.capitalize()}):{Style.RESET}")
        for line in render_lines:
            print("  " + line)

    return {"min_u": min_u, "min_y": min_y, "final_div": float(np.max(np.abs(sim.get_divergence())))}


def run_cylinder_vortex_street(re: float = 150.0, nx: int = 100, ny: int = 40, steps: int = 350, dt: float = 0.005, vis: str = "vorticity") -> Dict[str, Any]:
    """Von Kármán vortex shedding past an immersed circular cylinder."""
    nu = 1.0 / re
    sim = NavierStokes2D(nx=nx, ny=ny, lx=2.5, ly=1.0, nu=nu, bc_type="channel", lid_velocity=1.0)
    sim.set_cylinder_obstacle(center_x=0.5, center_y=0.5, radius=0.1)
    canvas = BrailleCanvas(char_width=50, char_height=18)

    print(f"{Style.BOLD}{Style.CYAN}═══ Von Kármán Vortex Street past Cylinder (Re = {re:.0f}) ═══{Style.RESET}")
    print(f"Channel: {nx}x{ny} | Inflow U = 1.0 | Cylinder: (0.5, 0.5), R=0.10 | Steps: {steps}")

    t0 = time.perf_counter()
    for s in range(1, steps + 1):
        sim.step(dt)
        if s % 70 == 0 or s == steps:
            rate = s / (time.perf_counter() - t0)
            vort = float(np.max(np.abs(sim.get_vorticity())))
            print(f"Step {s:04d}/{steps} | t={sim.time:.3f} | Peak Vorticity={vort:.3f} | {rate:.1f} steps/s")

    if vis != "none":
        field = sim.get_vorticity() if vis == "vorticity" else sim.get_velocity_magnitude()
        render_lines = canvas.render(field, obstacle_mask=sim.obstacle, palette=vis)
        print(f"\n{Style.BOLD}Wake Vorticity Visualization:{Style.RESET}")
        for line in render_lines:
            print("  " + line)

    return {"final_time": sim.time, "peak_vorticity": float(np.max(np.abs(sim.get_vorticity())))}


def run_benchmark(grid_n: int = 64, steps: int = 100, dt: float = 0.005) -> Dict[str, Any]:
    """Throughput benchmark measured in MCUPS (Million Cell Updates Per Second)."""
    sim = NavierStokes2D(nx=grid_n, ny=grid_n, lx=1.0, ly=1.0, nu=0.01, bc_type="cavity")
    print(f"{Style.BOLD}{Style.CYAN}═══ Incompressible Navier-Stokes Benchmark ═══{Style.RESET}")
    print(f"Grid: {grid_n}x{grid_n} ({grid_n * grid_n:,} cells) | Steps: {steps}")

    # Warmup
    sim.step(dt)

    t_start = time.perf_counter()
    for _ in range(steps):
        sim.step(dt)
    t_elapsed = time.perf_counter() - t_start

    total_updates = grid_n * grid_n * steps
    mcups = (total_updates / t_elapsed) / 1e6
    time_per_step = (t_elapsed / steps) * 1000.0

    print(f"Elapsed Time:     {t_elapsed:.3f} s")
    print(f"Step Latency:     {time_per_step:.2f} ms/step")
    print(f"Throughput:       {Style.BRIGHT_GREEN}{mcups:.3f} MCUPS{Style.RESET}")
    return {"mcups": mcups, "step_latency_ms": time_per_step, "elapsed_s": t_elapsed}


# =====================================================================
# Main CLI Router
# =====================================================================
def main():
    parser = argparse.ArgumentParser(
        description="2D Incompressible Navier-Stokes Fluid Dynamics Engine (Chorin MAC Formulation)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  fluid2d info
  fluid2d taylor-green --steps 40 --validate
  fluid2d cavity --re 100 --steps 300 --vis vorticity
  fluid2d vortex --re 150 --nx 100 --ny 40 --steps 300
  fluid2d benchmark --grid 64
  fluid2d demo
"""
    )

    subparsers = parser.add_subparsers(dest="command", help="Sub-command to execute")

    # info
    subparsers.add_parser("info", help="Print mathematical derivations and algorithm details")

    # taylor-green
    tg_parser = subparsers.add_parser("taylor-green", help="Run Taylor-Green vortex analytical validation")
    tg_parser.add_argument("--grid", type=int, default=48, help="Grid resolution (default: 48)")
    tg_parser.add_argument("--nu", type=float, default=0.01, help="Kinematic viscosity (default: 0.01)")
    tg_parser.add_argument("--steps", type=int, default=40, help="Number of steps (default: 40)")
    tg_parser.add_argument("--dt", type=float, default=0.01, help="Time step (default: 0.01)")
    tg_parser.add_argument("--validate", action="store_true", default=True, help="Assert mathematical error bounds")

    # cavity
    cav_parser = subparsers.add_parser("cavity", help="Run Lid-Driven Cavity simulation")
    cav_parser.add_argument("--re", type=float, default=100.0, help="Reynolds number (default: 100)")
    cav_parser.add_argument("--grid", type=int, default=48, help="Grid resolution (default: 48)")
    cav_parser.add_argument("--steps", type=int, default=300, help="Number of steps (default: 300)")
    cav_parser.add_argument("--dt", type=float, default=0.005, help="Time step (default: 0.005)")
    cav_parser.add_argument("--vis", choices=["vorticity", "speed", "none"], default="vorticity", help="Visualizer mode")

    # vortex
    vort_parser = subparsers.add_parser("vortex", help="Run cylinder wake vortex street simulation")
    vort_parser.add_argument("--re", type=float, default=150.0, help="Reynolds number (default: 150)")
    vort_parser.add_argument("--nx", type=int, default=100, help="Grid width (default: 100)")
    vort_parser.add_argument("--ny", type=int, default=40, help="Grid height (default: 40)")
    vort_parser.add_argument("--steps", type=int, default=300, help="Number of steps (default: 300)")
    vort_parser.add_argument("--dt", type=float, default=0.005, help="Time step (default: 0.005)")
    vort_parser.add_argument("--vis", choices=["vorticity", "speed", "none"], default="vorticity", help="Visualizer mode")

    # benchmark
    bench_parser = subparsers.add_parser("benchmark", help="Benchmark solver throughput in MCUPS")
    bench_parser.add_argument("--grid", type=int, default=64, help="Grid resolution (default: 64)")
    bench_parser.add_argument("--steps", type=int, default=100, help="Number of steps (default: 100)")

    # demo
    subparsers.add_parser("demo", help="Run quick visual demonstration")

    args = parser.parse_args()

    if args.command == "info":
        print(f"""{Style.BOLD}{Style.CYAN}2D Incompressible Navier-Stokes Equations & Chorin Projection{Style.RESET}

Governing Momentum & Continuity Equations:
  ∂u/∂t + (u · ∇)u = -(1/ρ) ∇p + ν ∇²u + f
  ∇ · u = 0

Operator Splitting Scheme:
  1. Advection:  u* = Advect(u^n, Δt) via RK2 Semi-Lagrangian characteristic back-tracing
  2. Diffusion:  (I - ν Δt ∇²) u** = u* via implicit Helmholtz Jacobi relaxation
  3. Poisson:    ∇²p = (ρ / Δt) ∇ · u** via Preconditioned Conjugate Gradient (PCG)
  4. Projection: u^{{n+1}} = u** - (Δt / ρ) ∇p, guaranteeing ∇ · u^{{n+1}} = 0

Discretization: Marker-and-Cell (MAC) staggered grid avoids odd-even pressure oscillations.
""")
    elif args.command == "taylor-green":
        res = run_taylor_green_validation(args.grid, args.nu, args.steps, args.dt)
        sys.exit(0 if res["passed"] else 1)
    elif args.command == "cavity":
        run_cavity_simulation(args.re, args.grid, args.steps, args.dt, args.vis)
    elif args.command == "vortex":
        run_cylinder_vortex_street(args.re, args.nx, args.ny, args.steps, args.dt, args.vis)
    elif args.command == "benchmark":
        run_benchmark(args.grid, args.steps)
    elif args.command == "demo" or args.command is None:
        print(f"{Style.BOLD}Running Navier-Stokes 2D Demo...{Style.RESET}\n")
        run_cavity_simulation(re=100.0, grid_n=36, steps=100, dt=0.005, vis="vorticity")


if __name__ == "__main__":
    main()
