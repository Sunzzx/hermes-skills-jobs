#!/usr/bin/env python3
"""Environment Drift, Secret Leak, and Schema Enforcement Engine."""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from pathlib import Path
from urllib.parse import urlparse

__version__ = "1.0.0"

# Common secret patterns that must never appear in example / template files
SECRET_PATTERNS = [
    ("aws-access-key", re.compile(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b")),
    ("github-token", re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})\b")),
    ("private-key", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----")),
    ("jwt-token", re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b")),
    ("openai-api-key", re.compile(r"\bsk-[A-Za-z0-9]{20,}\b")),
    ("anthropic-api-key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}\b")),
    ("stripe-secret-key", re.compile(r"\b[rs]k_live_[A-Za-z0-9]{24,}\b")),
    ("slack-token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b")),
]

SAFE_PLACEHOLDER_REGEX = re.compile(
    r"(?i)^(\s*|<[^>]+>|\[[^\]]+\]|your[_-].*|change[_-]?me|dummy|example|placeholder|todo|xxx+|test|local|localhost|127\.0\.0\.1|false|true|none|null|0|off|on)?$")


def parse_env_content(content: str) -> tuple[dict[str, str], list[dict[str, any]]]:
    """Parse .env content into a key-value dictionary with line tracking and error reporting."""
    env_vars: dict[str, str] = {}
    errors: list[dict[str, any]] = []
    
    lines = content.splitlines()
    idx = 0
    while idx < len(lines):
        line_num = idx + 1
        raw_line = lines[idx]
        idx += 1
        
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            continue
            
        # Strip optional leading 'export '
        if stripped.startswith("export "):
            stripped = stripped[7:].lstrip()
            
        match = re.match(r"^([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$", stripped)
        if not match:
            errors.append({
                "line": line_num,
                "error": f"Syntax error: invalid environment variable definition: '{raw_line.strip()}'"
            })
            continue
            
        key, val = match.group(1), match.group(2).strip()
        
        # Handle quotes and multiline values
        if val.startswith(('"', "'")):
            quote_char = val[0]
            # Check if quote is closed on same line
            # Check for matching closing quote not escaped
            pattern = rf"^{quote_char}(.*?)(?<!\\){quote_char}(.*)$"
            single_match = re.match(pattern, val, flags=re.DOTALL)
            if single_match:
                parsed_val = single_match.group(1)
                # check trailing comments
                rest = single_match.group(2).strip()
                if rest and not rest.startswith("#"):
                    errors.append({
                        "line": line_num,
                        "error": f"Trailing unexpected characters after quoted value on key '{key}': '{rest}'"
                    })
                env_vars[key] = parsed_val.encode('utf-8').decode('unicode_escape') if quote_char == '"' else parsed_val
            else:
                # Multiline quoted string
                val_lines = [val[1:]]
                closed = False
                while idx < len(lines):
                    m_line = lines[idx]
                    idx += 1
                    end_idx = m_line.find(quote_char)
                    if end_idx != -1 and (end_idx == 0 or m_line[end_idx - 1] != chr(92)):
                        val_lines.append(m_line[:end_idx])
                        closed = True
                        break
                    else:
                        val_lines.append(m_line)
                if not closed:
                    errors.append({
                        "line": line_num,
                        "error": f"Unclosed quote for key '{key}' starting at line {line_num}"
                    })
                    continue
                full_val = "\n".join(val_lines)
                env_vars[key] = full_val.encode('utf-8').decode('unicode_escape') if quote_char == '"' else full_val
        else:
            # Unquoted: strip trailing inline comments separated by whitespace
            if " #" in val:
                val = val.split(" #", 1)[0].strip()
            elif val.startswith("#"):
                val = ""
            env_vars[key] = val
            
    return env_vars, errors


def find_secret_leaks(vars_dict: dict[str, str]) -> list[dict[str, str]]:
    """Scan dictionary values for likely leaked secrets or credentials."""
    leaks = []
    for key, val in vars_dict.items():
        if not val or SAFE_PLACEHOLDER_REGEX.match(val):
            continue
        for name, pattern in SECRET_PATTERNS:
            if pattern.search(val):
                leaks.append({
                    "key": key,
                    "type": name,
                    "warning": f"Potentially active secret ({name}) found in key '{key}'"
                })
                break
    return leaks


def validate_type(val: str, expected_type: str) -> bool:
    """Validate string value against expected type constraint."""
    if expected_type in ("int", "integer"):
        try:
            int(val)
            return True
        except ValueError:
            return False
    elif expected_type == "port":
        try:
            port = int(val)
            return 1 <= port <= 65535
        except ValueError:
            return False
    elif expected_type in ("bool", "boolean"):
        return val.lower() in ("true", "false", "1", "0", "yes", "no", "on", "off")
    elif expected_type == "url":
        parsed = urlparse(val)
        return bool(parsed.scheme and parsed.netloc)
    elif expected_type == "email":
        return bool(re.match(r"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$", val))
    elif expected_type == "json":
        try:
            json.loads(val)
            return True
        except Exception:
            return False
    return True


def audit_environment(
    env_path: Path,
    example_path: Path | None = None,
    schema_path: Path | None = None,
    required_keys: list[str] | None = None,
    type_specs: dict[str, str] | None = None,
    strict: bool = False,
    check_secrets: bool = True
) -> dict[str, any]:
    """Comprehensive environment audit returning structured results."""
    report: dict[str, any] = {
        "valid": True,
        "env_file": str(env_path),
        "example_file": str(example_path) if example_path else None,
        "total_keys": 0,
        "missing_in_env": [],
        "extra_in_env": [],
        "empty_values": [],
        "secret_leaks": [],
        "schema_violations": [],
        "parse_errors": []
    }

    if not env_path.exists():
        report["valid"] = False
        report["parse_errors"].append({"error": f"Environment file not found: {env_path}"})
        return report

    try:
        env_content = env_path.read_text(encoding="utf-8")
        env_vars, parse_errors = parse_env_content(env_content)
        report["total_keys"] = len(env_vars)
        if parse_errors:
            report["parse_errors"].extend(parse_errors)
            report["valid"] = False
    except Exception as e:
        report["valid"] = False
        report["parse_errors"].append({"error": f"Failed to read/parse {env_path}: {e}"})
        return report

    # Audit against example / template file
    example_vars = {}
    if example_path:
        if not example_path.exists():
            report["parse_errors"].append({"error": f"Example template file not found: {example_path}"})
            report["valid"] = False
        else:
            try:
                ex_content = example_path.read_text(encoding="utf-8")
                example_vars, ex_parse_errors = parse_env_content(ex_content)
                if ex_parse_errors:
                    report["parse_errors"].extend(ex_parse_errors)
                    report["valid"] = False
                
                # Check for secrets leaked inside the EXAMPLE template!
                if check_secrets:
                    ex_leaks = find_secret_leaks(example_vars)
                    if ex_leaks:
                        report["secret_leaks"].extend(ex_leaks)
                        report["valid"] = False
                        
                # Compute drift
                for ex_key in example_vars:
                    if ex_key not in env_vars:
                        report["missing_in_env"].append(ex_key)
                
                for env_key in env_vars:
                    if env_key not in example_vars:
                        report["extra_in_env"].append(env_key)
                        
                if report["missing_in_env"]:
                    report["valid"] = False
                if strict and report["extra_in_env"]:
                    report["valid"] = False
            except Exception as e:
                report["parse_errors"].append({"error": f"Failed to read example file: {e}"})
                report["valid"] = False

    # Check empty values in env_vars
    for k, v in env_vars.items():
        if v == "":
            report["empty_values"].append(k)

    # Check required keys
    if required_keys:
        for req in required_keys:
            if req not in env_vars or env_vars[req] == "":
                report["schema_violations"].append({
                    "key": req,
                    "error": f"Required environment variable '{req}' is missing or empty"
                })
                report["valid"] = False

    # Check custom schema JSON if provided
    if schema_path:
        if not schema_path.exists():
            report["parse_errors"].append({"error": f"Schema file not found: {schema_path}"})
            report["valid"] = False
        else:
            try:
                schema = json.loads(schema_path.read_text(encoding="utf-8"))
                reqs = schema.get("required", [])
                for r in reqs:
                    if r not in env_vars or env_vars[r] == "":
                        report["schema_violations"].append({
                            "key": r,
                            "error": f"Schema required variable '{r}' is missing or empty"
                        })
                        report["valid"] = False
                properties = schema.get("properties", {})
                for p_key, p_spec in properties.items():
                    if p_key in env_vars and env_vars[p_key] != "":
                        p_type = p_spec.get("type")
                        if p_type and not validate_type(env_vars[p_key], p_type):
                            report["schema_violations"].append({
                                "key": p_key,
                                "error": f"Value '{env_vars[p_key]}' for key '{p_key}' does not match expected type '{p_type}'"
                            })
                            report["valid"] = False
            except Exception as e:
                report["parse_errors"].append({"error": f"Failed to evaluate schema: {e}"})
                report["valid"] = False

    # Check CLI type specifications
    if type_specs:
        for key, exp_type in type_specs.items():
            if key in env_vars and env_vars[key] != "":
                if not validate_type(env_vars[key], exp_type):
                    report["schema_violations"].append({
                        "key": key,
                        "error": f"Value for key '{key}' does not match type '{exp_type}'"
                    })
                    report["valid"] = False

    return report


def sync_example(env_path: Path, example_path: Path) -> tuple[int, int]:
    """Safely scaffold or synchronize missing keys from .env into .env.example without leaking secrets."""
    if not env_path.exists():
        raise FileNotFoundError(f"Source env file {env_path} not found")

    env_vars, _ = parse_env_content(env_path.read_text(encoding="utf-8"))
    existing_example_vars = {}
    example_content = ""
    if example_path.exists():
        example_content = example_path.read_text(encoding="utf-8")
        existing_example_vars, _ = parse_env_content(example_content)

    missing_keys = [k for k in env_vars if k not in existing_example_vars]
    if not missing_keys:
        return 0, len(existing_example_vars)

    new_lines = []
    if example_content and not example_content.endswith("\n"):
        new_lines.append("\n")
    if not example_content.strip():
        new_lines.append("# Environment Template\n")
    else:
        new_lines.append("\n# Automatically synced variables\n")
        
    for key in missing_keys:
        new_lines.append(f"{key}=your_{key.lower()}_here\n")

    updated_content = example_content + "".join(new_lines)
    example_path.write_text(updated_content, encoding="utf-8")
    return len(missing_keys), len(existing_example_vars) + len(missing_keys)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Environment Drift, Secret Leak, and Schema Enforcement Engine."
    )
    parser.add_argument("target", nargs="?", default=None, help="Path to .env file or directory containing .env")
    parser.add_argument("--env", dest="env_file", help="Explicit path to environment file (default: .env)")
    parser.add_argument("--example", "--template", dest="example_file", help="Path to template/example file")
    parser.add_argument("--schema", dest="schema_file", help="Path to JSON validation schema")
    parser.add_argument("--required", help="Comma-separated list of required variable names")
    parser.add_argument("--types", help="Comma-separated list of key:type assertions (e.g. PORT:int,DEBUG:bool)")
    parser.add_argument("--strict", action="store_true", help="Fail if .env contains variables not present in example")
    parser.add_argument("--sync", action="store_true", help="Sync missing keys from .env to .env.example with safe placeholders")
    parser.add_argument("--format", choices=["text", "json"], default="text", help="Output format (default: text)")
    parser.add_argument("--version", action="version", version=f"env-guard {__version__}")

    args = parser.parse_args(argv)

    # Resolve target directory or file
    base_dir = Path.cwd()
    target_path = Path(args.target) if args.target else None
    
    if target_path and target_path.is_dir():
        env_path = target_path / ".env"
        example_path = target_path / ".env.example"
    elif target_path and target_path.is_file():
        env_path = target_path
        example_path = target_path.parent / f"{target_path.name}.example"
        if not example_path.exists():
            example_path = target_path.parent / ".env.example"
    else:
        env_path = Path(args.env_file) if args.env_file else base_dir / ".env"
        example_path = Path(args.example_file) if args.example_file else None
        
    if args.example_file:
        example_path = Path(args.example_file)
    elif example_path is None or not example_path.exists():
        # Auto-discover example file in same directory if available
        potential_ex = env_path.parent / ".env.example"
        if potential_ex.exists():
            example_path = potential_ex
        else:
            potential_template = env_path.parent / ".env.template"
            if potential_template.exists():
                example_path = potential_template

    # Handle --sync operation
    if args.sync:
        if not example_path:
            example_path = env_path.parent / ".env.example"
        try:
            synced_count, total = sync_example(env_path, example_path)
            if args.format == "json":
                print(json.dumps({"synced_keys": synced_count, "total_example_keys": total, "target": str(example_path)}, indent=2))
            else:
                print(f"✓ Synced {synced_count} missing key(s) into {example_path} (total: {total} keys)")
            return 0
        except Exception as e:
            if args.format == "json":
                print(json.dumps({"error": str(e)}), file=sys.stderr)
            else:
                print(f"Error syncing example file: {e}", file=sys.stderr)
            return 2

    # Parse required and type specs
    req_keys = [k.strip() for k in args.required.split(",")] if args.required else []
    type_specs = {}
    if args.types:
        for item in args.types.split(","):
            if ":" in item:
                k, t = item.split(":", 1)
                type_specs[k.strip()] = t.strip()

    schema_path = Path(args.schema_file) if args.schema_file else None

    report = audit_environment(
        env_path=env_path,
        example_path=example_path,
        schema_path=schema_path,
        required_keys=req_keys,
        type_specs=type_specs,
        strict=args.strict,
        check_secrets=True
    )

    if args.format == "json":
        print(json.dumps(report, indent=2))
    else:
        status_icon = "✓" if report["valid"] else "✗"
        print(f"=== env-guard Audit: {status_icon} (Keys: {report['total_keys']}) ===")
        print(f"Env File:     {report['env_file']}")
        if report["example_file"]:
            print(f"Example File: {report['example_file']}")
            
        if report["parse_errors"]:
            print("\n[Parse / IO Errors]:")
            for err in report["parse_errors"]:
                line_info = f"Line {err['line']}: " if "line" in err else ""
                print(f"  • {line_info}{err['error']}")
                
        if report["secret_leaks"]:
            print("\n[CRITICAL: Leaked Secrets in Example Template]:")
            for leak in report["secret_leaks"]:
                print(f"  • [{leak['type']}] Key '{leak['key']}': {leak['warning']}")
                
        if report["missing_in_env"]:
            print("\n[Drift: Missing in .env]:")
            for m in report["missing_in_env"]:
                print(f"  • {m}")
                
        if report["extra_in_env"] and args.strict:
            print("\n[Strict Mode: Undocumented Keys in .env]:")
            for ext in report["extra_in_env"]:
                print(f"  • {ext}")
                
        if report["schema_violations"]:
            print("\n[Schema / Type Violations]:")
            for viol in report["schema_violations"]:
                print(f"  • {viol['key']}: {viol['error']}")
                
        if report["valid"]:
            print("\n✓ All environment checks and policy constraints passed!")
        else:
            print("\n✗ Audit failed: policy violations detected.")

    if report.get("parse_errors") and any("not found" in err.get("error", "") for err in report["parse_errors"]):
        return 2
    return 0 if report["valid"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
