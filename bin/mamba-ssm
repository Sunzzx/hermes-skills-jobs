#!/usr/bin/env python3
"""Mamba-SSM: Selective State Space Model from Scratch with Blelloch Associative Parallel Scan.

A frontier AI research implementation featuring:
- Continuous-time State Space Equations & Zero-Order Hold (ZOH) Discretization
- Input-dependent Selective Mechanism (A, B, C, Delta parametrization)
- High-Order Polynomial Projection Operators (HiPPO) state initialization
- Numerically exact Blelloch Parallel Associative Prefix Scan (O(log L) depth)
- Constant-memory O(1) recurrent step-by-step inference engine
- Verification, benchmarking, and sequence inspection CLI
"""

import sys
import time
import argparse
import numpy as np


def softplus(x):
    """Numerically stable softplus activation: log(1 + exp(x))."""
    return np.log1p(np.exp(-np.abs(x))) + np.maximum(x, 0)


def hippo_legs_matrix(N):
    """HiPPO-LegS (High-Order Polynomial Projection Operator - Shifted Legendre) continuous transition matrix.
    
    A_{nk} = -sqrt(2n+1) * sqrt(2k+1) if n > k
    A_{nk} = -(n + 1)                 if n == k
    A_{nk} = 0                        if n < k
    """
    A = np.zeros((N, N), dtype=np.float64)
    for n in range(N):
        for k in range(N):
            if n > k:
                A[n, k] = -np.sqrt((2 * n + 1) * (2 * k + 1))
            elif n == k:
                A[n, k] = -(n + 1)
    return A


class MambaSSMBlock:
    """Selective State Space Model (Mamba) Block with continuous ZOH discretization
    and dual execution paths: Sequential Recurrence vs Blelloch Associative Scan.
    """
    def __init__(self, d_model=32, d_state=16, dt_rank=8, seed=42):
        self.d_model = d_model
        self.d_state = d_state
        self.dt_rank = dt_rank
        rng = np.random.RandomState(seed)

        # HiPPO-inspired continuous A initialization (diagonalized log representation)
        # Real parts strictly negative: A = -exp(A_log)
        A_init = np.repeat(np.arange(1, d_state + 1)[None, :], d_model, axis=0).astype(np.float64)
        self.A_log = np.log(A_init)

        # Projection weights for input-dependent selective mechanism
        # x -> [Delta_proj (dt_rank), B (d_state), C (d_state)]
        self.W_x = rng.randn(d_model, dt_rank + 2 * d_state) * (1.0 / np.sqrt(d_model))
        self.W_dt = rng.randn(dt_rank, d_model) * (1.0 / np.sqrt(dt_rank))
        self.dt_bias = np.ones(d_model) * np.log(np.exp(0.01) - 1.0)  # initialize dt near 0.01

        # Skip connection D parameter and Output projection
        self.D = np.ones(d_model, dtype=np.float64)
        self.W_out = rng.randn(d_model, d_model) * (1.0 / np.sqrt(d_model))

    @property
    def A(self):
        """Continuous state matrix A: strictly negative diagonal elements."""
        return -np.exp(self.A_log)  # Shape: (d_model, d_state)

    def discretize_zoh(self, delta, B):
        """Zero-Order Hold (ZOH) discretization of continuous (Delta, A, B).
        
        A_bar = exp(Delta * A)
        B_bar = (Delta * A)^{-1} * (exp(Delta * A) - I) * (Delta * B)
              = A^{-1} * (exp(Delta * A) - I) * B
        
        Args:
            delta: (batch_size, seq_len, d_model)
            B:     (batch_size, seq_len, d_state)
        Returns:
            A_bar: (batch_size, seq_len, d_model, d_state)
            B_bar: (batch_size, seq_len, d_model, d_state)
        """
        delta_expanded = delta[:, :, :, None]        # (B, L, D, 1)
        A_expanded = self.A[None, None, :, :]       # (1, 1, D, N)
        delta_A = delta_expanded * A_expanded       # (B, L, D, N)
        A_bar = np.exp(delta_A)                     # (B, L, D, N)

        # Numerically stable B_bar computation
        denom = A_expanded                          # (1, 1, D, N)
        B_expanded = B[:, :, None, :]               # (B, L, 1, N)
        B_bar = ((A_bar - 1.0) / denom) * B_expanded  # (B, L, D, N)
        return A_bar, B_bar

    def compute_selective_parameters(self, x):
        """Compute dynamic input-dependent Delta, B, C parameters."""
        x_proj = x @ self.W_x
        dt_proj = x_proj[:, :, :self.dt_rank]
        B_sel = x_proj[:, :, self.dt_rank:self.dt_rank + self.d_state]
        C_sel = x_proj[:, :, self.dt_rank + self.d_state:]

        delta = softplus(dt_proj @ self.W_dt + self.dt_bias)  # (B, L, D)
        return delta, B_sel, C_sel

    def forward_sequential(self, x):
        """Sequential recurrent scan (O(L) time, standard autoregressive inference loop)."""
        B_sz, L, D = x.shape
        N = self.d_state

        delta, B_sel, C_sel = self.compute_selective_parameters(x)
        A_bar, B_bar = self.discretize_zoh(delta, B_sel)

        Bx = B_bar * x[:, :, :, None]  # (B, L, D, N)
        h = np.zeros((B_sz, D, N), dtype=np.float64)
        h_all = np.zeros((B_sz, L, D, N), dtype=np.float64)
        y = np.zeros((B_sz, L, D), dtype=np.float64)

        for t in range(L):
            h = A_bar[:, t] * h + Bx[:, t]
            h_all[:, t] = h
            # y_t = C_t * h_t + D * x_t
            y[:, t] = np.sum(h * C_sel[:, t, None, :], axis=-1) + self.D * x[:, t]

        y_out = y @ self.W_out
        return y_out, h_all

    def forward_parallel(self, x):
        """Parallel associative scan (Blelloch-style prefix sum, O(log L) depth)."""
        B_sz, L, D = x.shape
        delta, B_sel, C_sel = self.compute_selective_parameters(x)
        A_bar, B_bar = self.discretize_zoh(delta, B_sel)
        Bx = B_bar * x[:, :, :, None]  # (B, L, D, N)

        # Associative scan: (a_j, b_j) * (a_i, b_i) = (a_j * a_i, a_j * b_i + b_j)
        curr_a = np.copy(A_bar)
        curr_b = np.copy(Bx)
        step = 1
        while step < L:
            new_b = curr_a[:, step:] * curr_b[:, :-step] + curr_b[:, step:]
            new_a = curr_a[:, step:] * curr_a[:, :-step]
            curr_b[:, step:] = new_b
            curr_a[:, step:] = new_a
            step *= 2

        h_all = curr_b  # (B, L, D, N)
        y = np.sum(h_all * C_sel[:, :, None, :], axis=-1) + self.D * x
        y_out = y @ self.W_out
        return y_out, h_all

    def step(self, x_t, prev_state):
        """Constant O(1) memory single-token step for autoregressive generation."""
        # x_t: (B, 1, D), prev_state: (B, D, N)
        delta, B_sel, C_sel = self.compute_selective_parameters(x_t)
        A_bar, B_bar = self.discretize_zoh(delta, B_sel)
        Bx = B_bar[:, 0] * x_t[:, 0, :, None]
        next_state = A_bar[:, 0] * prev_state + Bx
        y_t = np.sum(next_state * C_sel[:, 0, None, :], axis=-1) + self.D * x_t[:, 0]
        y_out = y_t @ self.W_out
        return y_out, next_state


def verify_mathematics():
    """Run comprehensive numerical tests validating equivalence, stability, and discretization."""
    print("=" * 72)
    print("⚡ MAMBA-SSM RIGOROUS MATHEMATICAL & NUMERICAL VERIFICATION SUITE")
    print("=" * 72)

    block = MambaSSMBlock(d_model=32, d_state=16, dt_rank=8, seed=42)
    rng = np.random.RandomState(1337)
    all_passed = True

    # 1. Parity between Parallel Scan and Sequential Recurrence
    print("\n[1/4] Blelloch Associative Scan vs. Sequential Recurrent Parity:")
    for L in [8, 16, 64, 128, 256, 512, 1024]:
        x = rng.randn(2, L, 32)
        y_seq, h_seq = block.forward_sequential(x)
        y_par, h_par = block.forward_parallel(x)
        diff_y = np.max(np.abs(y_seq - y_par))
        diff_h = np.max(np.abs(h_seq - h_par))
        passed = (diff_y < 1e-10) and (diff_h < 1e-10)
        all_passed = all_passed and passed
        tag = "PASS" if passed else "FAIL"
        print(f"  • Sequence Length L={L:<5} | max |Δy| = {diff_y:.2e} | max |Δh| = {diff_h:.2e} [{tag}]")

    # 2. Analytical ZOH Discretization Verification
    print("\n[2/4] Zero-Order Hold (ZOH) Continuous Discretization Check:")
    delta = np.array([[[0.05]]])
    b_val = np.array([[[1.5]]])
    single_block = MambaSSMBlock(d_model=1, d_state=1, dt_rank=1)
    single_block.A_log[0, 0] = np.log(3.0)  # A = -3.0
    A_bar, B_bar = single_block.discretize_zoh(delta, b_val)
    expected_A_bar = np.exp(-3.0 * 0.05)
    expected_B_bar = (np.exp(-3.0 * 0.05) - 1.0) / (-3.0) * 1.5
    err_A = np.abs(A_bar[0, 0, 0, 0] - expected_A_bar)
    err_B = np.abs(B_bar[0, 0, 0, 0] - expected_B_bar)
    zoh_passed = (err_A < 1e-12) and (err_B < 1e-12)
    all_passed = all_passed and zoh_passed
    tag_zoh = 'PASS' if zoh_passed else 'FAIL'
    print(f"  • Analytical A_bar error: {err_A:.2e} | B_bar error: {err_B:.2e} [{tag_zoh}]")

    # 3. HiPPO Hurwitz Stability Verification
    print("\n[3/4] HiPPO-LegS Transition Matrix Hurwitz Stability:")
    A_hippo = hippo_legs_matrix(16)
    eigvals = np.linalg.eigvals(A_hippo)
    max_real_eig = np.max(np.real(eigvals))
    hippo_passed = max_real_eig < 0.0
    all_passed = all_passed and hippo_passed
    tag_hippo = 'PASS' if hippo_passed else 'FAIL'
    print(f"  • Maximum Real Eigenvalue: {max_real_eig:.4f} (Strictly Negative Spectrum) [{tag_hippo}]")

    # 4. Step-by-Step O(1) Token Autoregressive Parity
    print("\n[4/4] O(1) Autoregressive Step Inference vs Full Sequence Output:")
    L_test = 16
    x_test = rng.randn(1, L_test, 32)
    y_full, _ = block.forward_parallel(x_test)
    h_step = np.zeros((1, 32, 16))
    y_step_list = []
    for t in range(L_test):
        y_t, h_step = block.step(x_test[:, t:t+1], h_step)
        y_step_list.append(y_t)
    y_stepped = np.stack(y_step_list, axis=1)
    step_diff = np.max(np.abs(y_full - y_stepped))
    step_passed = step_diff < 1e-10
    all_passed = all_passed and step_passed
    tag_step = 'PASS' if step_passed else 'FAIL'
    print(f"  • Max Token Step Parity Error: {step_diff:.2e} [{tag_step}]")

    print("-" * 72)
    if all_passed:
        print("✅ ALL 4 MATHEMATICAL VERIFICATION STAGES PASSED (Zero Discrepancy)")
    else:
        print("❌ MATHEMATICAL VERIFICATION FAILED")
    print("=" * 72)
    return all_passed


def benchmark_ssm():
    """Benchmark Sequential Recurrence vs Blelloch Associative Parallel Scan."""
    print("=" * 72)
    print("🚀 MAMBA-SSM LATENCY & THROUGHPUT BENCHMARK (Batch=4, Dim=64, State=16)")
    print("=" * 72)
    block = MambaSSMBlock(d_model=64, d_state=16, dt_rank=16, seed=123)
    rng = np.random.RandomState(42)

    lengths = [64, 256, 1024, 2048]
    print(f"{'Seq Len':<10} | {'Sequential (ms)':<16} | {'Parallel Scan (ms)':<18} | {'Speedup':<10} | {'Tokens/sec':<12}")
    print("-" * 72)

    for L in lengths:
        x = rng.randn(4, L, 64)
        block.forward_sequential(x[:, :16])
        block.forward_parallel(x[:, :16])

        t0 = time.perf_counter()
        iters_seq = max(1, int(1000 / L))
        for _ in range(iters_seq):
            block.forward_sequential(x)
        t_seq = ((time.perf_counter() - t0) / iters_seq) * 1000.0

        t0 = time.perf_counter()
        iters_par = max(1, int(1000 / L))
        for _ in range(iters_par):
            block.forward_parallel(x)
        t_par = ((time.perf_counter() - t0) / iters_par) * 1000.0

        speedup = t_seq / max(t_par, 1e-5)
        tokens_per_sec = (4 * L) / (t_par / 1000.0)
        print(f"L={L:<8} | {t_seq:14.2f} ms | {t_par:16.2f} ms | {speedup:8.2f}x | {tokens_per_sec:10.0f} t/s")
    print("=" * 72)


def display_info():
    """Display architectural specifications and complexity comparison."""
    print("""
========================================================================
⚡ MAMBA-SSM: SELECTIVE STATE SPACE ARCHITECTURAL SPECIFICATION
========================================================================
Continuous Dynamics:
  h'(t) = A h(t) + B(t) x(t)
  y(t)  = C(t) h(t) + D x(t)

Zero-Order Hold (ZOH) Discretization:
  A_bar = exp(Δ_t · A)
  B_bar = (Δ_t · A)⁻¹ (exp(Δ_t · A) - I) · (Δ_t · B_t)
        = A⁻¹ (exp(Δ_t · A) - I) · B_t

Input-Dependent Selective Parameters:
  Δ_t   = softplus(Linear(x_t) + bias_Δ)  [Dynamic step size / forgetting gate]
  B_t   = Linear(x_t)                     [Dynamic input matrix]
  C_t   = Linear(x_t)                     [Dynamic output observation matrix]

Parallel Associative Prefix Operator:
  (a_j, b_j) • (a_i, b_i) = (a_j · a_i,  a_j · b_i + b_j)

Complexity Matrix:
  Metric               Transformer (Attention)     Mamba (Selective SSM)
  ----------------------------------------------------------------------
  Training Compute     O(L²) quadratic             O(L) linear
  Training Memory      O(L²) attention map         O(L) activations
  Inference Step       O(L) growing KV-cache       O(1) constant state
  State Footprint      O(B · L · D)                O(B · D · N) fixed
========================================================================
""")


def run_demo(seq_len=64, d_model=32, d_state=16):
    """Run forward pass and visualize hidden state activation trajectory."""
    print(f"⚡ Running Mamba-SSM Forward Pass: L={seq_len}, D_model={d_model}, D_state={d_state}")
    block = MambaSSMBlock(d_model=d_model, d_state=d_state, seed=42)
    x = np.random.randn(1, seq_len, d_model)
    y, h_all = block.forward_parallel(x)

    print(f"  • Input tensor shape:        {x.shape}")
    print(f"  • Hidden state trajectory:   {h_all.shape} (Batch, Seq, Model_dim, State_dim)")
    print(f"  • Output tensor shape:       {y.shape}")
    print(f"  • Mean activation norm:      {np.linalg.norm(y):.4f}")
    print("\nState Energy across Timesteps (first 8 state channels):")
    sample_h = np.mean(np.abs(h_all[0, :, 0, :8]), axis=-1)
    max_val = np.max(sample_h) if np.max(sample_h) > 0 else 1.0
    step_skip = max(1, seq_len // 16)
    for t in range(0, seq_len, step_skip):
        bar_len = int((sample_h[t] / max_val) * 30)
        bar = "█" * bar_len + "░" * (30 - bar_len)
        print(f"  t={t:<3} | {bar} | energy = {sample_h[t]:.4f}")
    print("✅ Forward pass completed cleanly.")


def main():
    parser = argparse.ArgumentParser(description="Mamba-SSM: Selective State Space Model Engine")
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("verify", help="Run comprehensive numerical & mathematical test suite")
    subparsers.add_parser("benchmark", help="Benchmark Sequential vs Blelloch Parallel Scan throughput")
    subparsers.add_parser("info", help="Show mathematical specification & architecture matrix")

    run_parser = subparsers.add_parser("run", help="Execute forward pass demo and display state trajectory")
    run_parser.add_argument("--seq-len", type=int, default=64, help="Sequence length (default: 64)")
    run_parser.add_argument("--dim", type=int, default=32, help="Model dimension (default: 32)")
    run_parser.add_argument("--state", type=int, default=16, help="SSM state dimension (default: 16)")

    args = parser.parse_args()
    if args.command == "verify":
        passed = verify_mathematics()
        sys.exit(0 if passed else 1)
    elif args.command == "benchmark":
        benchmark_ssm()
    elif args.command == "info":
        display_info()
    elif args.command == "run":
        run_demo(seq_len=args.seq_len, d_model=args.dim, d_state=args.state)
    else:
        passed = verify_mathematics()
        sys.exit(0 if passed else 1)


if __name__ == "__main__":
    main()
