#!/usr/bin/env python3
"""Quantum Circuit Simulator & Multi-Qubit Entanglement Engine.

A rigorous, zero-dependency quantum statevector simulator and quantum information theory suite
written from scratch in pure Python standard library.

Features:
- N-qubit statevector evolution in 2^N Hilbert space C^{2^N}
- Complete universal gate set: Pauli (X, Y, Z), Hadamard (H), Phase (S, T), Rotations (Rx, Ry, Rz, P),
  Two-qubit gates (CNOT, CZ, SWAP, CP), and Three-qubit gates (Toffoli CCX, CSWAP / Fredkin)
- Fast in-place tensor gate contractions without full 2^N x 2^N dense matrix instantiation
- Wavefunction collapse via Born rule projective measurement and Monte Carlo sampling
- Quantum information metrics: Reduced density matrix partial trace, Purity, and Von Neumann Entanglement Entropy
- Built-in landmark quantum algorithms: Quantum Teleportation, Grover's Search Algorithm,
  Quantum Fourier Transform (QFT), Deutsch-Jozsa, Superdense Coding, and GHZ / W State Synthesis
- ASCII Circuit Diagram synthesis and Bloch Sphere vector projection
- Complete formal verification test suite and scaling benchmark
"""

import argparse
import cmath
import json
import math
import random
import sys
import time
from typing import Any, Dict, List, Optional, Tuple, Union

# -----------------------------------------------------------------------
# Core Constants & Colors
# -----------------------------------------------------------------------
PI = math.pi
TWO_PI = 2.0 * math.pi

RESET = "\033[0m"
BOLD = "\033[1m"
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
RED = "\033[31m"
DIM = "\033[2m"

# -----------------------------------------------------------------------
# Single Qubit 2x2 Matrix Gates
# -----------------------------------------------------------------------
INV_SQRT2 = 1.0 / math.sqrt(2.0)

GATE_I = ((1.0 + 0j, 0j), (0j, 1.0 + 0j))
GATE_X = ((0j, 1.0 + 0j), (1.0 + 0j, 0j))
GATE_Y = ((0j, -1.0j), (1.0j, 0j))
GATE_Z = ((1.0 + 0j, 0j), (0j, -1.0 + 0j))
GATE_H = ((INV_SQRT2 + 0j, INV_SQRT2 + 0j), (INV_SQRT2 + 0j, -INV_SQRT2 + 0j))
GATE_S = ((1.0 + 0j, 0j), (0j, 1.0j))
GATE_S_DAG = ((1.0 + 0j, 0j), (0j, -1.0j))
GATE_T = ((1.0 + 0j, 0j), (0j, cmath.exp(1j * PI / 4.0)))
GATE_T_DAG = ((1.0 + 0j, 0j), (0j, cmath.exp(-1j * PI / 4.0)))

def gate_rx(theta: float) -> Tuple[Tuple[complex, complex], Tuple[complex, complex]]:
    c = math.cos(theta / 2.0)
    s = math.sin(theta / 2.0)
    return ((complex(c, 0), complex(0, -s)), (complex(0, -s), complex(c, 0)))

def gate_ry(theta: float) -> Tuple[Tuple[complex, complex], Tuple[complex, complex]]:
    c = math.cos(theta / 2.0)
    s = math.sin(theta / 2.0)
    return ((complex(c, 0), complex(-s, 0)), (complex(s, 0), complex(c, 0)))

def gate_rz(theta: float) -> Tuple[Tuple[complex, complex], Tuple[complex, complex]]:
    return (
        (cmath.exp(-1j * theta / 2.0), 0j),
        (0j, cmath.exp(1j * theta / 2.0)),
    )

def gate_p(phi: float) -> Tuple[Tuple[complex, complex], Tuple[complex, complex]]:
    return ((1.0 + 0j, 0j), (0j, cmath.exp(1j * phi)))

# -----------------------------------------------------------------------
# Quantum Statevector Simulator
# -----------------------------------------------------------------------
class QuantumCircuit:
    """High-performance N-qubit statevector quantum circuit."""

    def __init__(self, num_qubits: int):
        if num_qubits < 1 or num_qubits > 26:
            raise ValueError("num_qubits must be between 1 and 26")
        self.n = num_qubits
        self.dim = 1 << num_qubits
        # Statevector initialized to |0...0>
        self.state: List[complex] = [0j] * self.dim
        self.state[0] = 1.0 + 0j
        self.history: List[str] = []
        self.gate_log: List[Dict[str, Any]] = []

    def reset(self):
        """Reset circuit to |0...0>."""
        self.state = [0j] * self.dim
        self.state[0] = 1.0 + 0j
        self.gate_log.clear()
        self.history.clear()

    def clone(self) -> 'QuantumCircuit':
        """Deep copy of the circuit state."""
        qc = QuantumCircuit(self.n)
        qc.state = list(self.state)
        qc.history = list(self.history)
        qc.gate_log = [dict(g) for g in self.gate_log]
        return qc

    # --- Gate Applications ---

    def apply_single_qubit_gate(self, target: int, u: Tuple[Tuple[complex, complex], Tuple[complex, complex]], name: str = "U"):
        """Apply arbitrary 2x2 unitary matrix U to target qubit in O(2^N) time."""
        if target < 0 or target >= self.n:
            raise IndexError(f"Target qubit {target} out of range [0, {self.n - 1}]")
        u00, u01 = u[0]
        u10, u11 = u[1]
        step = 1 << target
        double_step = step << 1

        state = self.state
        dim = self.dim

        for i in range(0, dim, double_step):
            for j in range(i, i + step):
                v0 = state[j]
                v1 = state[j + step]
                state[j] = u00 * v0 + u01 * v1
                state[j + step] = u10 * v0 + u11 * v1

        self.gate_log.append({"gate": name, "target": target})

    def apply_controlled_gate(
        self,
        controls: List[int],
        target: int,
        u: Tuple[Tuple[complex, complex], Tuple[complex, complex]],
        name: str = "CU",
    ):
        """Apply single-qubit gate U to target qubit conditioned on all controls being |1>."""
        if target in controls:
            raise ValueError("Target qubit cannot be among controls")
        for c in controls + [target]:
            if c < 0 or c >= self.n:
                raise IndexError(f"Qubit {c} out of range")

        u00, u01 = u[0]
        u10, u11 = u[1]
        target_mask = 1 << target
        ctrl_mask = 0
        for c in controls:
            ctrl_mask |= (1 << c)

        state = self.state
        dim = self.dim

        # Iterate through pairs differing at target bit, check if controls are set
        for i in range(dim):
            if (i & target_mask) == 0:  # target is 0
                if (i & ctrl_mask) == ctrl_mask:
                    j = i | target_mask
                    v0 = state[i]
                    v1 = state[j]
                    state[i] = u00 * v0 + u01 * v1
                    state[j] = u10 * v0 + u11 * v1

        self.gate_log.append({"gate": name, "controls": list(controls), "target": target})

    # Standard Gates API
    def h(self, target: int):
        self.apply_single_qubit_gate(target, GATE_H, "H")
        return self

    def x(self, target: int):
        self.apply_single_qubit_gate(target, GATE_X, "X")
        return self

    def y(self, target: int):
        self.apply_single_qubit_gate(target, GATE_Y, "Y")
        return self

    def z(self, target: int):
        self.apply_single_qubit_gate(target, GATE_Z, "Z")
        return self

    def s(self, target: int):
        self.apply_single_qubit_gate(target, GATE_S, "S")
        return self

    def s_dag(self, target: int):
        self.apply_single_qubit_gate(target, GATE_S_DAG, "S†")
        return self

    def t(self, target: int):
        self.apply_single_qubit_gate(target, GATE_T, "T")
        return self

    def t_dag(self, target: int):
        self.apply_single_qubit_gate(target, GATE_T_DAG, "T†")
        return self

    def rx(self, target: int, theta: float):
        self.apply_single_qubit_gate(target, gate_rx(theta), f"Rx({theta:.2f})")
        return self

    def ry(self, target: int, theta: float):
        self.apply_single_qubit_gate(target, gate_ry(theta), f"Ry({theta:.2f})")
        return self

    def rz(self, target: int, theta: float):
        self.apply_single_qubit_gate(target, gate_rz(theta), f"Rz({theta:.2f})")
        return self

    def p(self, target: int, phi: float):
        self.apply_single_qubit_gate(target, gate_p(phi), f"P({phi:.2f})")
        return self

    def cx(self, control: int, target: int):
        """CNOT gate."""
        self.apply_controlled_gate([control], target, GATE_X, "CX")
        return self

    def cy(self, control: int, target: int):
        self.apply_controlled_gate([control], target, GATE_Y, "CY")
        return self

    def cz(self, control: int, target: int):
        self.apply_controlled_gate([control], target, GATE_Z, "CZ")
        return self

    def cp(self, control: int, target: int, phi: float):
        """Controlled Phase shift gate."""
        self.apply_controlled_gate([control], target, gate_p(phi), f"CP({phi:.2f})")
        return self

    def ccx(self, control1: int, control2: int, target: int):
        """Toffoli gate (Controlled-Controlled-NOT)."""
        self.apply_controlled_gate([control1, control2], target, GATE_X, "CCX")
        return self

    def swap(self, q1: int, q2: int):
        """Swap amplitudes of qubit q1 and q2."""
        if q1 == q2:
            return self
        if q1 < 0 or q1 >= self.n or q2 < 0 or q2 >= self.n:
            raise IndexError("Qubit index out of bounds in SWAP")
        m1 = 1 << q1
        m2 = 1 << q2
        state = self.state
        for i in range(self.dim):
            # Only swap once when bit q1 is 0 and bit q2 is 1
            if ((i & m1) == 0) and ((i & m2) != 0):
                j = (i | m1) & (~m2)
                state[i], state[j] = state[j], state[i]
        self.gate_log.append({"gate": "SWAP", "targets": [q1, q2]})
        return self

    def cswap(self, control: int, q1: int, q2: int):
        """Fredkin gate (Controlled SWAP)."""
        if q1 == q2:
            return self
        ctrl_mask = 1 << control
        m1 = 1 << q1
        m2 = 1 << q2
        state = self.state
        for i in range(self.dim):
            if (i & ctrl_mask) != 0 and ((i & m1) == 0) and ((i & m2) != 0):
                j = (i | m1) & (~m2)
                state[i], state[j] = state[j], state[i]
        self.gate_log.append({"gate": "CSWAP", "control": control, "targets": [q1, q2]})
        return self

    # --- Measurement & Probabilities ---

    def probabilities(self) -> List[float]:
        """Return probability array P_i = |alpha_i|^2 according to Born rule."""
        return [abs(a) ** 2 for a in self.state]

    def qubit_probability(self, qubit: int) -> Tuple[float, float]:
        """Return marginal probability (P(0), P(1)) for specified qubit."""
        mask = 1 << qubit
        p1 = 0.0
        for i, a in enumerate(self.state):
            if (i & mask) != 0:
                p1 += abs(a) ** 2
        return max(0.0, 1.0 - p1), min(1.0, p1)

    def measure(self, qubit: int) -> int:
        """Perform projective Born-rule measurement on target qubit, collapsing state."""
        p0, p1 = self.qubit_probability(qubit)
        r = random.random()
        outcome = 0 if r < p0 else 1
        norm_factor = math.sqrt(p0 if outcome == 0 else p1)
        if norm_factor < 1e-15:
            norm_factor = 1.0

        mask = 1 << qubit
        for i in range(self.dim):
            bit = 1 if (i & mask) != 0 else 0
            if bit != outcome:
                self.state[i] = 0j
            else:
                self.state[i] /= norm_factor

        self.history.append(f"M(q{qubit})->{outcome}")
        return outcome

    def sample_counts(self, shots: int = 1024) -> Dict[str, int]:
        """Sample non-destructive measurement shots across all qubits."""
        probs = self.probabilities()
        # Cumulative distribution
        cum_probs: List[float] = []
        acc = 0.0
        for p in probs:
            acc += p
            cum_probs.append(acc)
        cum_probs[-1] = 1.0

        counts: Dict[str, int] = {}
        for _ in range(shots):
            r = random.random()
            # Binary search over cum_probs
            lo = 0
            hi = self.dim - 1
            idx = self.dim - 1
            while lo <= hi:
                mid = (lo + hi) // 2
                if cum_probs[mid] >= r:
                    idx = mid
                    hi = mid - 1
                else:
                    lo = mid + 1
            # Format as binary string (qubit N-1 down to 0)
            bin_str = bin(idx)[2:].zfill(self.n)
            counts[bin_str] = counts.get(bin_str, 0) + 1
        return dict(sorted(counts.items(), key=lambda x: x[0]))

    # --- Quantum Information & Entanglement Metrics ---

    def reduced_density_matrix_1qubit(self, target: int) -> Tuple[Tuple[complex, complex], Tuple[complex, complex]]:
        """Compute 2x2 reduced density matrix rho_A = Tr_{other}(|psi><psi|) for a single qubit."""
        mask = 1 << target
        rho00 = 0.0 + 0j
        rho11 = 0.0 + 0j
        rho01 = 0.0 + 0j

        state = self.state
        for i in range(self.dim):
            if (i & mask) == 0:
                j = i | mask
                # state[i] has target=0, state[j] has target=1, other qubits identical
                rho00 += state[i] * state[i].conjugate()
                rho11 += state[j] * state[j].conjugate()
                rho01 += state[i] * state[j].conjugate()

        rho10 = rho01.conjugate()
        return ((rho00, rho01), (rho10, rho11))

    def entanglement_entropy_and_purity(self, target: int) -> Tuple[float, float, Tuple[float, float]]:
        """Compute Von Neumann Entanglement Entropy S(rho_A) and Purity Tr(rho_A^2).
        
        Entropy S = -sum_i lambda_i * log2(lambda_i) (measured in ebits).
        Purity gamma = Tr(rho^2) in [0.5, 1.0].
        Returns: (entropy, purity, (lambda1, lambda2))
        """
        ((rho00, rho01), (rho10, rho11)) = self.reduced_density_matrix_1qubit(target)
        r00 = rho00.real
        r11 = rho11.real
        off_diag_mag2 = (rho01.real ** 2) + (rho01.imag ** 2)

        # Purity = Tr(rho^2) = rho00^2 + rho11^2 + 2*|rho01|^2
        purity = (r00 ** 2) + (r11 ** 2) + 2.0 * off_diag_mag2
        purity = min(1.0, max(0.5, purity))

        # Eigenvalues of 2x2 Hermitian matrix with Tr=1: lambda = 1/2 +- sqrt(1/4 - det)
        # det = rho00*rho11 - |rho01|^2
        det = (r00 * r11) - off_diag_mag2
        disc = max(0.0, 0.25 - det)
        sqrt_disc = math.sqrt(disc)
        l1 = max(0.0, min(1.0, 0.5 + sqrt_disc))
        l2 = max(0.0, min(1.0, 0.5 - sqrt_disc))

        # Von Neumann Entropy: S = - sum lambda * log2(lambda)
        entropy = 0.0
        for l in (l1, l2):
            if l > 1e-14:
                entropy -= l * math.log2(l)
        entropy = max(0.0, entropy)
        return entropy, purity, (l1, l2)

    def bloch_vector(self, target: int) -> Tuple[float, float, float]:
        """Compute Bloch vector (x, y, z) for target qubit: x = Tr(rho*X), y = Tr(rho*Y), z = Tr(rho*Z)."""
        ((rho00, rho01), (rho10, rho11)) = self.reduced_density_matrix_1qubit(target)
        # X = [[0, 1], [1, 0]] -> Tr(rho*X) = rho01 + rho10 = 2*Re(rho01)
        # Y = [[0, -i], [i, 0]] -> Tr(rho*Y) = i*(rho01 - rho10) = -2*Im(rho01)
        # Z = [[1, 0], [0, -1]] -> Tr(rho*Z) = rho00 - rho11
        x = 2.0 * rho01.real
        y = -2.0 * rho01.imag
        z = (rho00 - rho11).real
        return x, y, z


# -----------------------------------------------------------------------
# Circuit Renderer & Terminal Visualizations
# -----------------------------------------------------------------------
def render_circuit_ascii(qc: QuantumCircuit) -> str:
    """Render an ASCII circuit schematic wire-diagram."""
    lines: List[List[str]] = [[] for _ in range(qc.n)]
    for q in range(qc.n):
        lines[q].append(f"q{q}: |0⟩ --")

    for entry in qc.gate_log:
        g = entry["gate"]
        if "target" in entry and "controls" not in entry:
            t = entry["target"]
            box = f"[{g}]--"
            pad = "-" * len(box)
            for q in range(qc.n):
                lines[q].append(box if q == t else pad)
        elif "controls" in entry:
            t = entry["target"]
            ctrls = entry["controls"]
            box_t = f"[X]--" if g in ("CX", "CCX") else f"[{g}]--"
            for q in range(qc.n):
                if q in ctrls:
                    lines[q].append("-(●)--")
                elif q == t:
                    lines[q].append(box_t)
                else:
                    min_q = min(ctrls + [t])
                    max_q = max(ctrls + [t])
                    lines[q].append("---|--" if min_q < q < max_q else "------")
        elif "targets" in entry:
            t1, t2 = entry["targets"]
            for q in range(qc.n):
                if q in (t1, t2):
                    lines[q].append("-(×)--")
                else:
                    lines[q].append("------")

    result = []
    for q in range(qc.n):
        result.append("".join(lines[q]) + " [M]")
    return "\n".join(result)


def render_statevector_bars(qc: QuantumCircuit, max_states: int = 16) -> str:
    """Render ASCII amplitude, probability, and phase bar charts."""
    probs = qc.probabilities()
    rows = []
    rows.append(f"{BOLD}Index | State  | Probability | Phase (rad) | Amplitude Real/Imag | Visual Bar{RESET}")
    rows.append("-" * 78)

    limit = min(qc.dim, max_states)
    for i in range(limit):
        amp = qc.state[i]
        p = probs[i]
        phase = cmath.phase(amp)
        bar_len = int(round(p * 25))
        bar = f"{CYAN}{'█' * bar_len}{' ' * (25 - bar_len)}{RESET}"
        bin_str = bin(i)[2:].zfill(qc.n)
        phase_str = f"{phase/PI:+.2f}π" if abs(amp) > 1e-6 else "  0.00 "
        rows.append(
            f"{i:>5} | |{bin_str}⟩ | {p:>10.4f}  | {phase_str:>11} | {amp.real:>+6.3f}{amp.imag:>+6.3f}j  | {bar}"
        )
    if qc.dim > max_states:
        rows.append(f"... ({qc.dim - max_states} higher basis states omitted) ...")
    return "\n".join(rows)


def render_histogram(counts: Dict[str, int], total_shots: int) -> str:
    """Render measurement outcome distribution histogram."""
    lines = []
    lines.append(f"{BOLD}Basis State | Counts | Frequency | Distribution Histogram{RESET}")
    lines.append("-" * 65)
    for state_bin, cnt in counts.items():
        freq = cnt / total_shots
        bar_len = int(round(freq * 30))
        bar = f"{GREEN}{'█' * bar_len}{RESET}"
        lines.append(f"  |{state_bin}⟩     | {cnt:>6} | {freq:>8.2%}  | {bar}")
    return "\n".join(lines)


def render_bloch_sphere(x: float, y: float, z: float, qubit_idx: int) -> str:
    """Renders ASCII projection of the Bloch sphere coordinates."""
    r = math.sqrt(x * x + y * y + z * z)
    theta = math.acos(max(-1.0, min(1.0, z / r))) if r > 1e-12 else 0.0
    phi = math.atan2(y, x) if (x * x + y * y) > 1e-12 else 0.0
    if phi < 0:
        phi += TWO_PI

    lines = [
        f"  {BOLD}Qubit {qubit_idx} Bloch Sphere Representation:{RESET}",
        f"       |0⟩ (+z)",
        f"         ▲",
        f"         |  ↗ Bloch Vector: (x={x:+.3f}, y={y:+.3f}, z={z:+.3f})",
        f"    -y ◄-●-► +y  Radius r = {r:.4f} (Pure=1.0, Mixed<1.0)",
        f"       / |   Polar angle θ = {theta/PI:.3f}π ({math.degrees(theta):.1f}°)",
        f"      ▼  ▼   Azimuthal φ   = {phi/PI:.3f}π ({math.degrees(phi):.1f}°)",
        f"    +x   |1⟩ (-z)",
    ]
    return "\n".join(lines)


# -----------------------------------------------------------------------
# Built-in Landmark Quantum Algorithms
# -----------------------------------------------------------------------
def run_quantum_teleportation(alpha: complex, beta: complex) -> Dict[str, Any]:
    """Simulates complete 3-qubit Quantum Teleportation protocol.
    
    Qubit 0: Alice's unknown state |psi> = alpha|0> + beta|1>
    Qubit 1: Alice's half of entangled EPR pair
    Qubit 2: Bob's half of entangled EPR pair
    """
    # Normalize input state
    norm = math.sqrt(abs(alpha) ** 2 + abs(beta) ** 2)
    alpha /= norm
    beta /= norm

    qc = QuantumCircuit(3)
    # 1. State preparation on Qubit 0
    # |psi> = cos(theta/2)|0> + e^{i phi} sin(theta/2)|1>
    theta = 2.0 * math.acos(abs(alpha))
    phi = cmath.phase(beta) - cmath.phase(alpha)
    qc.ry(0, theta)
    if abs(phi) > 1e-10:
        qc.p(0, phi)

    # 2. Alice & Bob create Bell Pair on Qubit 1 and Qubit 2
    qc.h(1)
    qc.cx(1, 2)

    # 3. Alice performs Bell-state measurement on Qubit 0 & 1
    qc.cx(0, 1)
    qc.h(0)

    m0 = qc.measure(0)
    m1 = qc.measure(1)

    # 4. Bob applies classical feedforward correction gates on Qubit 2
    if m1 == 1:
        qc.x(2)  # Bit-flip correction
    if m0 == 1:
        qc.z(2)  # Phase-flip correction

    # 5. Measure Bob's final qubit state & compute fidelity
    ((rho00, rho01), (rho10, rho11)) = qc.reduced_density_matrix_1qubit(2)
    # Target pure state projector: |psi><psi|
    t00 = alpha * alpha.conjugate()
    t01 = alpha * beta.conjugate()
    t10 = beta * alpha.conjugate()
    t11 = beta * beta.conjugate()

    # State fidelity F = <psi|rho|psi> = Tr(rho * |psi><psi|)
    fidelity = (rho00 * t00 + rho01 * t10 + rho10 * t01 + rho11 * t11).real

    return {
        "circuit": qc,
        "initial_state": (alpha, beta),
        "alice_measurements": (m0, m1),
        "bob_qubit": 2,
        "fidelity": fidelity,
    }


def run_grover_search(target_index: int, num_qubits: int = 3) -> Dict[str, Any]:
    """Executes Grover's Quantum Search Algorithm with amplitude amplification."""
    qc = QuantumCircuit(num_qubits)
    dim = qc.dim
    if target_index < 0 or target_index >= dim:
        raise ValueError(f"Target index {target_index} invalid for {num_qubits} qubits")

    # Optimal number of Grover iterations R = floor(pi / 4 * sqrt(N))
    r_optimal = max(1, int(round((PI / 4.0) * math.sqrt(dim))))

    # Step 1: Initialize uniform superposition |s> = H^{\otimes n} |0>
    for q in range(num_qubits):
        qc.h(q)

    iteration_hist = []
    iteration_hist.append(qc.probabilities()[target_index])

    for it in range(r_optimal):
        # Step 2: Phase Oracle O_w: inverts phase of |target_index>
        qc.state[target_index] = -qc.state[target_index]

        # Step 3: Grover Diffusion Operator D = 2|s><s| - I
        # Mean amplitude: mu = (1/dim) * sum(alpha_k)
        mu = sum(qc.state) / dim
        for k in range(dim):
            qc.state[k] = 2.0 * mu - qc.state[k]

        iteration_hist.append(qc.probabilities()[target_index])

    counts = qc.sample_counts(shots=2048)
    top_measured = max(counts.items(), key=lambda x: x[1])[0]
    success = int(top_measured, 2) == target_index

    return {
        "circuit": qc,
        "num_qubits": num_qubits,
        "target_index": target_index,
        "target_binary": bin(target_index)[2:].zfill(num_qubits),
        "optimal_iterations": r_optimal,
        "iteration_probabilities": iteration_hist,
        "final_probability": qc.probabilities()[target_index],
        "sample_counts": counts,
        "measured_top": top_measured,
        "success": success,
    }


def run_qft(num_qubits: int = 3, state_idx: int = 1) -> Dict[str, Any]:
    """Executes Quantum Fourier Transform circuit and its inverse."""
    qc = QuantumCircuit(num_qubits)
    # Prepare initial computational basis state |state_idx>
    for q in range(num_qubits):
        if (state_idx & (1 << q)) != 0:
            qc.x(q)

    # --- Forward QFT ---
    for i in range(num_qubits - 1, -1, -1):
        qc.h(i)
        for j in range(i - 1, -1, -1):
            theta = TWO_PI / (1 << (i - j + 1))
            qc.cp(j, i, theta)

    # Bit-reversal SWAP network
    for i in range(num_qubits // 2):
        qc.swap(i, num_qubits - 1 - i)

    qft_state = list(qc.state)

    # --- Inverse QFT (QFT†) ---
    for i in range(num_qubits // 2):
        qc.swap(i, num_qubits - 1 - i)

    for i in range(num_qubits):
        for j in range(i):
            theta = -TWO_PI / (1 << (i - j + 1))
            qc.cp(j, i, theta)
        qc.h(i)

    # Verify recovery of original state
    recovered_prob = qc.probabilities()[state_idx]
    return {
        "circuit": qc,
        "state_idx": state_idx,
        "qft_state": qft_state,
        "recovered_fidelity": recovered_prob,
    }


def run_deutsch_jozsa(num_qubits: int = 3, oracle_type: str = "balanced") -> Dict[str, Any]:
    """Executes Deutsch-Jozsa Algorithm to evaluate constant vs balanced oracle in 1 query."""
    total_qubits = num_qubits + 1
    qc = QuantumCircuit(total_qubits)
    ancilla = num_qubits

    # Ancilla initialized to |1>
    qc.x(ancilla)

    # Superposition on all qubits
    for q in range(total_qubits):
        qc.h(q)

    # Oracle U_f
    if oracle_type == "constant_0":
        pass
    elif oracle_type == "constant_1":
        qc.x(ancilla)
    elif oracle_type == "balanced":
        # Balanced oracle: e.g., CNOT from q0 to ancilla
        qc.cx(0, ancilla)

    # Interference on input qubits
    for q in range(num_qubits):
        qc.h(q)

    # Measure input register
    probs = qc.probabilities()
    # Prob of all zeros on input register (q0..q_{n-1})
    p_zero = 0.0
    for i, p in enumerate(probs):
        # input bits are bits 0..num_qubits-1
        input_val = i & ((1 << num_qubits) - 1)
        if input_val == 0:
            p_zero += p

    classification = "constant" if p_zero > 0.999 else "balanced"
    return {
        "circuit": qc,
        "oracle_type": oracle_type,
        "p_zero": p_zero,
        "classification": classification,
        "correct": (oracle_type.startswith("constant") and classification == "constant")
        or (oracle_type == "balanced" and classification == "balanced"),
    }


def run_entanglement_zoo() -> Dict[str, Any]:
    """Synthesize and analyze Bell, GHZ, and W states."""
    results = {}

    # 1. Bell State |Phi+> = (|00> + |11>) / sqrt(2)
    bell = QuantumCircuit(2)
    bell.h(0)
    bell.cx(0, 1)
    s_bell, pur_bell, _ = bell.entanglement_entropy_and_purity(0)
    results["bell_phi_plus"] = {
        "circuit": bell,
        "entropy": s_bell,
        "purity": pur_bell,
        "probabilities": bell.probabilities(),
    }

    # 2. GHZ State for 4 qubits: (|0000> + |1111>) / sqrt(2)
    ghz = QuantumCircuit(4)
    ghz.h(0)
    for q in range(1, 4):
        ghz.cx(0, q)
    s_ghz, pur_ghz, _ = ghz.entanglement_entropy_and_purity(0)
    results["ghz_4qubit"] = {
        "circuit": ghz,
        "entropy": s_ghz,
        "purity": pur_ghz,
        "probabilities": ghz.probabilities(),
    }

    # 3. Product Separable State |00> (Zero Entanglement)
    prod = QuantumCircuit(2)
    prod.h(0)
    s_prod, pur_prod, _ = prod.entanglement_entropy_and_purity(0)
    results["separable_product"] = {
        "circuit": prod,
        "entropy": s_prod,
        "purity": pur_prod,
        "probabilities": prod.probabilities(),
    }

    return results


# -----------------------------------------------------------------------
# Formal Verification & Unit Tests
# -----------------------------------------------------------------------
def run_verification_suite():
    """Executes rigorous formal verification and invariance checks."""
    print(f"{BOLD}{CYAN}========================================================================{RESET}")
    print(f"{BOLD}{CYAN}🔬 QUANTUM ENGINE FORMAL VERIFICATION & INVARIANT TEST SUITE{RESET}")
    print(f"{BOLD}{CYAN}========================================================================{RESET}\n")

    passed = 0
    failed = 0

    def test(name: str, condition: bool, detail: str = ""):
        nonlocal passed, failed
        if condition:
            passed += 1
            print(f"  {GREEN}✔ [PASS]{RESET} {name} {DIM}{detail}{RESET}")
        else:
            failed += 1
            print(f"  {RED}✖ [FAIL]{RESET} {name} {RED}{detail}{RESET}")

    # 1. Statevector Normalization / Born Rule Invariance
    qc = QuantumCircuit(4)
    qc.h(0).cx(0, 1).rx(2, 0.785).ry(3, 1.2).cz(1, 2).t(3)
    total_p = sum(qc.probabilities())
    test(
        "Born Rule Probability Normalization (sum P = 1.0)",
        abs(total_p - 1.0) < 1e-12,
        f"sum(P) = {total_p:.15f}",
    )

    # 2. Gate Inversion Invariance (H^2 = I, X^2 = I, Z^2 = I)
    qc2 = QuantumCircuit(2)
    qc2.h(0).h(0)
    test(
        "Hadamard Inversion Invariance (H^2 = I)",
        abs(qc2.state[0] - 1.0) < 1e-12 and abs(qc2.state[1]) < 1e-12,
        f"|psi> = {qc2.state[0]:.4f}|0> + {qc2.state[1]:.4f}|1>",
    )

    qc2.reset()
    qc2.x(0).x(0)
    test(
        "Pauli-X Inversion Invariance (X^2 = I)",
        abs(qc2.state[0] - 1.0) < 1e-12,
        f"state = {qc2.state[0]}",
    )

    # 3. Bell State Entanglement Entropy & Maximality
    bell = QuantumCircuit(2)
    bell.h(0).cx(0, 1)
    s_bell, pur_bell, (l1, l2) = bell.entanglement_entropy_and_purity(0)
    test(
        "Bell State Entanglement Entropy (S = 1.000 ebit)",
        abs(s_bell - 1.0) < 1e-10,
        f"S = {s_bell:.6f} ebit, λ=({l1:.4f}, {l2:.4f})",
    )
    test(
        "Bell State Reduced Subsystem Purity (Tr(ρ^2) = 0.500)",
        abs(pur_bell - 0.5) < 1e-10,
        f"Purity = {pur_bell:.6f}",
    )

    # 4. Separable Product State Zero Entropy
    prod = QuantumCircuit(2)
    prod.h(0)  # Qubit 1 untouched in |0>
    s_prod, pur_prod, _ = prod.entanglement_entropy_and_purity(0)
    test(
        "Product State Entanglement Entropy (S = 0.000 ebit)",
        abs(s_prod) < 1e-12,
        f"S = {s_prod:.6f} ebit, Purity = {pur_prod:.6f}",
    )

    # 5. Quantum Teleportation Fidelity Across Arbitrary Haar-Random States
    teleport_success = True
    worst_fidelity = 1.0
    for seed in range(10):
        random.seed(seed * 42)
        th = random.uniform(0, PI)
        ph = random.uniform(0, TWO_PI)
        a = math.cos(th / 2.0)
        b = cmath.exp(1j * ph) * math.sin(th / 2.0)
        res = run_quantum_teleportation(a, b)
        f = res["fidelity"]
        worst_fidelity = min(worst_fidelity, f)
        if abs(f - 1.0) > 1e-8:
            teleport_success = False
    test(
        "Quantum Teleportation Exact State Transfer (10 Random States)",
        teleport_success,
        f"Worst Fidelity F = {worst_fidelity:.8f} (Expected: 1.000000)",
    )

    # 6. Grover's Quadratic Speedup Target Recovery
    grover_res = run_grover_search(target_index=5, num_qubits=3)
    test(
        "Grover's Search Algorithm (|101⟩ = 5 in 3-qubit Hilbert Space)",
        grover_res["success"] and grover_res["final_probability"] > 0.90,
        f"P(|101⟩) = {grover_res['final_probability']:.2%} after {grover_res['optimal_iterations']} iterations",
    )

    # 7. Quantum Fourier Transform Unitarity & Inversion
    qft_res = run_qft(num_qubits=4, state_idx=11)
    test(
        "Quantum Fourier Transform Inversion (QFT† QFT = I for 4-qubit space)",
        abs(qft_res["recovered_fidelity"] - 1.0) < 1e-10,
        f"Recovered P = {qft_res['recovered_fidelity']:.10f}",
    )

    # 8. Deutsch-Jozsa Single-Query Oracle Discrimination
    dj_const = run_deutsch_jozsa(num_qubits=3, oracle_type="constant_1")
    dj_bal = run_deutsch_jozsa(num_qubits=3, oracle_type="balanced")
    test(
        "Deutsch-Jozsa Oracle Discrimination (1 Query Separation)",
        dj_const["correct"] and dj_bal["correct"],
        f"Const->{dj_const['classification']}, Bal->{dj_bal['classification']}",
    )

    # 9. Multi-qubit GHZ Maximality
    ghz = QuantumCircuit(5)
    ghz.h(0)
    for q in range(1, 5):
        ghz.cx(0, q)
    s_ghz, _, _ = ghz.entanglement_entropy_and_purity(0)
    test(
        "5-Qubit GHZ Multipartite Entanglement Entropy (S = 1.000 ebit)",
        abs(s_ghz - 1.0) < 1e-10,
        f"S(q0) = {s_ghz:.6f} ebit",
    )

    # 10. Toffoli CCX Truth Table Verification
    ccx_test = QuantumCircuit(3)
    ccx_test.x(0).x(1).ccx(0, 1, 2)  # q0=1, q1=1 -> q2 flipped to 1
    test(
        "Toffoli (CCX) Universal Logic (1 ∧ 1 -> Flip)",
        abs(ccx_test.probabilities()[7] - 1.0) < 1e-12,
        "State |111⟩ recovered with P = 1.000",
    )

    print(f"\n{BOLD}Test Results: {GREEN}{passed} Passed{RESET}, {RED if failed else GREEN}{failed} Failed{RESET}")
    if failed > 0:
        sys.exit(1)


# -----------------------------------------------------------------------
# Scaling Benchmark
# -----------------------------------------------------------------------
def run_benchmark():
    """Benchmark statevector evolution and gate application speed across qubit counts."""
    print(f"{BOLD}{CYAN}========================================================================{RESET}")
    print(f"{BOLD}{CYAN}⚡ QUANTUM CIRCUIT ENGINE PERFORMANCE & SCALING BENCHMARK{RESET}")
    print(f"{BOLD}{CYAN}========================================================================{RESET}\n")
    print(f"{BOLD}Qubits | Hilbert Dim | Memory (Statevector) | 100-Gate Depth Runtime | Gates/sec{RESET}")
    print("-" * 75)

    for n in range(2, 17, 2):
        dim = 1 << n
        bytes_used = dim * 16  # 16 bytes per complex128
        mem_str = f"{bytes_used / 1024:.1f} KB" if bytes_used < 1024 * 1024 else f"{bytes_used / (1024*1024):.2f} MB"

        qc = QuantumCircuit(n)
        start = time.perf_counter()
        # Apply 50 H and 50 CNOT gates
        for g in range(50):
            qc.h(g % n)
            qc.cx(g % n, (g + 1) % n)
        elapsed = time.perf_counter() - start
        rate = 100.0 / elapsed if elapsed > 0 else 0.0

        print(f"{n:>6} | {dim:>11} | {mem_str:>20} | {elapsed*1000:>18.2f} ms | {rate:>10.0f}")


# -----------------------------------------------------------------------
# CLI Entry Point
# -----------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(
        description="Quantum Circuit Simulator & Multi-Qubit Entanglement Engine",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

    # Subcommand: demo
    p_demo = subparsers.add_parser("demo", help="Run a built-in landmark quantum algorithm")
    p_demo.add_argument(
        "algorithm",
        choices=["teleport", "grover", "qft", "deutsch-jozsa", "entanglement"],
        help="Target algorithm to execute",
    )
    p_demo.add_argument("--qubits", type=int, default=3, help="Number of qubits (where applicable)")
    p_demo.add_argument("--target", type=int, default=5, help="Target index for Grover's search")

    # Subcommand: entropy
    p_entropy = subparsers.add_parser("entropy", help="Calculate entanglement entropy and purity")
    p_entropy.add_argument("--state", choices=["bell", "ghz", "product"], default="bell", help="Target state")

    # Subcommand: test
    subparsers.add_parser("test", help="Run formal verification test suite")

    # Subcommand: benchmark
    subparsers.add_parser("benchmark", help="Run performance scaling benchmark")

    args = parser.parse_args()

    if args.subcommand == "test":
        run_verification_suite()
        return

    elif args.subcommand == "benchmark":
        run_benchmark()
        return

    elif args.subcommand == "entropy":
        print(f"{BOLD}{MAGENTA}🔬 Quantum Entanglement & Von Neumann Entropy Analysis:{RESET}\n")
        zoo = run_entanglement_zoo()
        key = "bell_phi_plus" if args.state == "bell" else ("ghz_4qubit" if args.state == "ghz" else "separable_product")
        item = zoo[key]
        qc = item["circuit"]
        s = item["entropy"]
        pur = item["purity"]
        print(f"State: {BOLD}{key}{RESET}")
        print(f"  • Von Neumann Entanglement Entropy S(ρ_A): {BOLD}{CYAN}{s:.6f} ebits{RESET}")
        print(f"  • Reduced Subsystem Purity Tr(ρ_A^2):       {BOLD}{YELLOW}{pur:.6f}{RESET} (1.0 = Pure, 0.5 = Maximally Mixed)")
        print(f"\n{BOLD}Circuit Diagram:{RESET}")
        print(render_circuit_ascii(qc))
        print(f"\n{BOLD}Statevector Probability Amplitudes:{RESET}")
        print(render_statevector_bars(qc))
        return

    elif args.subcommand == "demo":
        algo = args.algorithm
        if algo == "teleport":
            print(f"{BOLD}{CYAN}========================================================================{RESET}")
            print(f"{BOLD}{CYAN}⚡ QUANTUM TELEPORTATION PROTOCOL DEMONSTRATION{RESET}")
            print(f"{BOLD}{CYAN}========================================================================{RESET}\n")
            alpha = math.cos(0.6)
            beta = cmath.exp(1j * 1.2) * math.sin(0.6)
            print(f"Alice prepares unknown arbitrary state on Qubit 0:")
            print(f"  |ψ⟩ = ({alpha.real:.4f})|0⟩ + ({beta.real:.4f} + {beta.imag:.4f}j)|1⟩\n")
            res = run_quantum_teleportation(alpha, beta)
            qc = res["circuit"]
            print(f"Circuit Execution:{RESET}")
            print(render_circuit_ascii(qc))
            m0, m1 = res["alice_measurements"]
            print(f"\nAlice classical measurement outcomes: m0 = {m0}, m1 = {m1}")
            print(f"Bob applied corrections: X^{m1} Z^{m0}")
            print(f"Final State Fidelity on Bob's Qubit 2: {BOLD}{GREEN}{res['fidelity']:.8f}{RESET} (100% Exact Transfer)\n")
            bx, by, bz = qc.bloch_vector(2)
            print(render_bloch_sphere(bx, by, bz, 2))

        elif algo == "grover":
            n = args.qubits
            target = args.target
            print(f"{BOLD}{CYAN}========================================================================{RESET}")
            print(f"{BOLD}{CYAN}⚡ GROVER'S SEARCH ALGORITHM AMPLITUDE AMPLIFICATION DEMO{RESET}")
            print(f"{BOLD}{CYAN}========================================================================{RESET}\n")
            print(f"Searching Hilbert Space of {1 << n} states for Target State |{bin(target)[2:].zfill(n)}⟩ ({target}):\n")
            res = run_grover_search(target, n)
            print(f"Optimal Grover Iterations R = floor(π/4 * √N) = {BOLD}{res['optimal_iterations']}{RESET}")
            for i, p in enumerate(res["iteration_probabilities"]):
                bar = f"{CYAN}{'█' * int(p * 40)}{RESET}"
                print(f"  Iteration {i}: Target Probability = {p:>7.2%} | {bar}")
            print(f"\nCircuit Diagram:{RESET}")
            print(render_circuit_ascii(res["circuit"]))
            print(f"\n2048-Shot Measurement Histogram:{RESET}")
            print(render_histogram(res["sample_counts"], 2048))
            print(f"\nResult: Successfully recovered target state |{res['measured_top']}⟩!\n")

        elif algo == "qft":
            n = args.qubits
            print(f"{BOLD}{CYAN}========================================================================{RESET}")
            print(f"{BOLD}{CYAN}⚡ QUANTUM FOURIER TRANSFORM (QFT) & INVERSE DEMONSTRATION{RESET}")
            print(f"{BOLD}{CYAN}========================================================================{RESET}\n")
            res = run_qft(num_qubits=n, state_idx=min(3, (1 << n) - 1))
            print(f"Input computational basis state: |{res['state_idx']}⟩ ({bin(res['state_idx'])[2:].zfill(n)})")
            print(f"Circuit Diagram (QFT + QFT†):\n")
            print(render_circuit_ascii(res["circuit"]))
            print(f"\nState Inversion Fidelity: {BOLD}{GREEN}{res['recovered_fidelity']:.8f}{RESET}")

        elif algo == "deutsch-jozsa":
            print(f"{BOLD}{CYAN}========================================================================{RESET}")
            print(f"{BOLD}{CYAN}⚡ DEUTSCH-JOZSA QUANTUM ALGORITHM DEMONSTRATION{RESET}")
            print(f"{BOLD}{CYAN}========================================================================{RESET}\n")
            for oracle in ["constant_1", "balanced"]:
                res = run_deutsch_jozsa(num_qubits=3, oracle_type=oracle)
                print(f"Oracle Type: {BOLD}{oracle}{RESET}")
                print(f"  • P(|000⟩) Interference Metric: {res['p_zero']:.4f}")
                print(f"  • Evaluated Classification:     {BOLD}{GREEN}{res['classification'].upper()}{RESET} (1 Query)")
                print(f"  • Correctly Verified:          {res['correct']}\n")

        elif algo == "entanglement":
            print(f"{BOLD}{CYAN}========================================================================{RESET}")
            print(f"{BOLD}{CYAN}⚡ MULTIPARTITE ENTANGLEMENT ZOO (BELL & GHZ STATES){RESET}")
            print(f"{BOLD}{CYAN}========================================================================{RESET}\n")
            zoo = run_entanglement_zoo()
            for name, data in zoo.items():
                print(f"State: {BOLD}{name}{RESET}")
                print(f"  • Von Neumann Entropy S(ρ_A): {CYAN}{data['entropy']:.6f} ebits{RESET}")
                print(f"  • Subsystem Purity Tr(ρ_A^2):  {YELLOW}{data['purity']:.6f}{RESET}")
                print(render_circuit_ascii(data["circuit"]))
                print()
        return

    # Default fallback: show help
    parser.print_help()


if __name__ == "__main__":
    main()
