#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""OmniQuant: Omnidirectional Calibration for Quantized LLMs.

Paper: Shao, Chen, Gu, Huang, Zhang, Feng, Chen — "OmniQuant: Omnidirectional
Calibrated Quantization for Large Language Models" (ICLR 2024, arXiv:2308.13137).
Official: https://github.com/OpenGVLab/OmniQuant

Core idea
---------
Post-training quantization quality collapses when either (a) weight ranges are
clipped naively (min/max RTN) or (b) activation outliers force coarse scales.
OmniQuant jointly learns two *absorbable* calibration transforms inside each
transformer block so the quantized block output matches FP16:

  1. Learnable Weight Clipping (LWC)
       For group g of weights W, learn (γ, β) ∈ (0,1]² and clip:
           W̃ = clamp(W,  γ·min(W) + (1-γ)·median_neg ,
                         β·max(W) + (1-β)·median_pos )
       then asymmetric RTN on the clipped range. γ/β are optimized to minimize
       block output MSE — no STE needed for the pure-Python reference; we use
       coordinate descent + golden-section search.

  2. Learnable Equivalent Transformation (LET)
       Channel-wise scales s > 0 and shifts δ absorbed across Linear pairs:
           X' = (X − δ) ⊘ s ,   W' = W ⊙ s ,   b' = b + W δ
       so Y = X W + b = X' W' + b' exactly in FP. After quantization of W',
       residual error drops because channels are smoother (SmoothQuant-like
       but *learned* per block with reconstruction loss, not hand-set α).

This pure-Python reference (zero third-party deps) implements:

  * dense GEMM / Frobenius / SQNR / cosine helpers
  * asymmetric & symmetric group RTN baselines
  * LWC grid + golden-section γ/β search minimizing weight or output MSE
  * LET channel scale/shift fit via closed-form residual + iterative refine
  * full OmniQuant path: LET → LWC → RTN with block reconstruction ledger
  * SmoothQuant-α ablation and plain RTN ablation for fair comparison
  * bit-rate / 7B footprint theory tables
  * CLI: status | calibrate | lwc | let | quantize | smoothquant
          | benchmark | verify | pack | theory

License: MIT — Hermes Autonomous Evolution Engine
"""

from __future__ import annotations

import argparse
import json
import math
import random
import sys
import time
from dataclasses import asdict, dataclass, field
from typing import Any, Dict, List, Optional, Sequence, Tuple


# ---------------------------------------------------------------------------
# Numeric helpers
# ---------------------------------------------------------------------------

def _dot(a: Sequence[float], b: Sequence[float]) -> float:
    return sum(x * y for x, y in zip(a, b))


def _l2(v: Sequence[float]) -> float:
    return math.sqrt(sum(x * x for x in v))


def _mean(v: Sequence[float]) -> float:
    return sum(v) / max(len(v), 1)


def _median(v: Sequence[float]) -> float:
    if not v:
        return 0.0
    s = sorted(v)
    n = len(s)
    mid = n // 2
    if n % 2:
        return s[mid]
    return 0.5 * (s[mid - 1] + s[mid])


def _mse(a: Sequence[float], b: Sequence[float]) -> float:
    n = max(len(a), 1)
    return sum((x - y) ** 2 for x, y in zip(a, b)) / n


def _cosine(a: Sequence[float], b: Sequence[float]) -> float:
    na, nb = _l2(a), _l2(b)
    if na < 1e-18 or nb < 1e-18:
        return 0.0
    return _dot(a, b) / (na * nb)


def _sqnr_db(ref: Sequence[float], recon: Sequence[float]) -> float:
    signal = sum(x * x for x in ref)
    noise = sum((x - y) ** 2 for x, y in zip(ref, recon))
    if noise < 1e-30:
        return 200.0
    if signal < 1e-30:
        return 0.0
    return 10.0 * math.log10(signal / noise)


def _clamp(x: float, lo: float, hi: float) -> float:
    return lo if x < lo else hi if x > hi else x


def _sign(x: float) -> float:
    if x > 0:
        return 1.0
    if x < 0:
        return -1.0
    return 0.0


Matrix = List[List[float]]
Vector = List[float]


def mat_zeros(r: int, c: int) -> Matrix:
    return [[0.0] * c for _ in range(r)]


def mat_flatten(a: Matrix) -> Vector:
    out: Vector = []
    for row in a:
        out.extend(row)
    return out


def mat_copy(a: Matrix) -> Matrix:
    return [row[:] for row in a]


def mat_shape(a: Matrix) -> Tuple[int, int]:
    return len(a), (len(a[0]) if a else 0)


def mat_mul(a: Matrix, b: Matrix) -> Matrix:
    r, k = len(a), len(a[0])
    c = len(b[0])
    out = mat_zeros(r, c)
    bt = list(zip(*b))
    for i in range(r):
        ai = a[i]
        for j in range(c):
            out[i][j] = _dot(ai, bt[j])
    return out


def mat_add_bias(y: Matrix, b: Vector) -> Matrix:
    out = mat_copy(y)
    for i in range(len(out)):
        for j in range(len(b)):
            out[i][j] += b[j]
    return out


def mat_transpose(a: Matrix) -> Matrix:
    if not a:
        return []
    return [list(col) for col in zip(*a)]


def vec_sub(a: Sequence[float], b: Sequence[float]) -> Vector:
    return [x - y for x, y in zip(a, b)]


def vec_add(a: Sequence[float], b: Sequence[float]) -> Vector:
    return [x + y for x, y in zip(a, b)]


def vec_mul(a: Sequence[float], b: Sequence[float]) -> Vector:
    return [x * y for x, y in zip(a, b)]


def vec_div(a: Sequence[float], b: Sequence[float], eps: float = 1e-12) -> Vector:
    return [x / (y if abs(y) > eps else _sign(y) * eps or eps) for x, y in zip(a, b)]


# ---------------------------------------------------------------------------
# Synthetic weights / activations (calibration corpus)
# ---------------------------------------------------------------------------

def make_weight(
    rows: int,
    cols: int,
    seed: int = 0,
    n_outliers: int = 3,
    outlier_scale: float = 8.0,
) -> Matrix:
    rng = random.Random(seed)
    w = [[rng.gauss(0.0, 0.35) for _ in range(cols)] for _ in range(rows)]
    # channel-wise magnitude structure (some channels heavier)
    for j in range(cols):
        scale = 0.6 + 0.9 * ((j * 17) % 7) / 6.0
        for i in range(rows):
            w[i][j] *= scale
    # sparse outliers (OmniQuant stress case)
    for _ in range(n_outliers):
        i = rng.randrange(rows)
        j = rng.randrange(cols)
        w[i][j] += rng.choice([-1.0, 1.0]) * outlier_scale * (0.5 + rng.random())
    return w


def make_activation(
    batch: int,
    cols: int,
    seed: int = 1,
    n_outlier_channels: int = 2,
    outlier_scale: float = 12.0,
) -> Matrix:
    rng = random.Random(seed)
    x = [[rng.gauss(0.0, 1.0) for _ in range(cols)] for _ in range(batch)]
    # heavy-tailed channels (SmoothQuant / LET motivation)
    for j in range(min(n_outlier_channels, cols)):
        ch = (j * 13 + 3) % cols
        for i in range(batch):
            if rng.random() < 0.15:
                x[i][ch] *= outlier_scale
            else:
                x[i][ch] *= 1.5
    return x


def make_bias(cols: int, seed: int = 2) -> Vector:
    rng = random.Random(seed)
    return [rng.gauss(0.0, 0.05) for _ in range(cols)]


def channel_max_abs(m: Matrix) -> Vector:
    if not m:
        return []
    cols = len(m[0])
    out = [0.0] * cols
    for row in m:
        for j, v in enumerate(row):
            a = abs(v)
            if a > out[j]:
                out[j] = a
    return out


def channel_rms(m: Matrix) -> Vector:
    if not m:
        return []
    cols = len(m[0])
    acc = [0.0] * cols
    n = max(len(m), 1)
    for row in m:
        for j, v in enumerate(row):
            acc[j] += v * v
    return [math.sqrt(a / n) for a in acc]


# ---------------------------------------------------------------------------
# Group asymmetric / symmetric RTN
# ---------------------------------------------------------------------------

@dataclass
class QuantConfig:
    n_bits: int = 4
    group_size: int = 64
    symmetric: bool = False
    eps: float = 1e-8


@dataclass
class QuantizedTensor:
    q: List[int]
    scales: List[float]
    zeros: List[float]
    shape: Tuple[int, int]
    group_size: int
    n_bits: int
    symmetric: bool

    def bit_rate(self) -> float:
        rows, cols = self.shape
        n = max(rows * cols, 1)
        n_groups = max(len(self.scales), 1)
        # q indices + fp16 scale (+ fp16 zero if asymmetric)
        meta_bits = n_groups * (16 if self.symmetric else 32)
        return (n * self.n_bits + meta_bits) / n


def _group_bounds(vals: Sequence[float], symmetric: bool) -> Tuple[float, float]:
    if not vals:
        return -1.0, 1.0
    mn = min(vals)
    mx = max(vals)
    if symmetric:
        m = max(abs(mn), abs(mx), 1e-12)
        return -m, m
    if abs(mx - mn) < 1e-12:
        return mn - 1e-6, mx + 1e-6
    return mn, mx


def quantize_vector(x: Sequence[float], cfg: QuantConfig) -> QuantizedTensor:
    """Group-wise RTN on a flat vector; shape reported as (1, n)."""
    n = len(x)
    gs = max(1, min(cfg.group_size, n if n > 0 else 1))
    qmax = (1 << (cfg.n_bits - 1)) - 1 if cfg.symmetric else (1 << cfg.n_bits) - 1
    qmin = -qmax - 1 if cfg.symmetric else 0
    q: List[int] = []
    scales: List[float] = []
    zeros: List[float] = []
    for start in range(0, max(n, 1), gs):
        chunk = list(x[start : start + gs])
        if not chunk:
            break
        lo, hi = _group_bounds(chunk, cfg.symmetric)
        if cfg.symmetric:
            scale = max(hi, cfg.eps) / max(qmax, 1)
            zero = 0.0
            for v in chunk:
                qi = int(round(v / scale))
                qi = int(_clamp(qi, qmin, qmax))
                q.append(qi)
        else:
            scale = max(hi - lo, cfg.eps) / max(qmax, 1)
            zero = lo
            for v in chunk:
                qi = int(round((v - zero) / scale))
                qi = int(_clamp(qi, qmin, qmax))
                q.append(qi)
        scales.append(scale)
        zeros.append(zero)
    return QuantizedTensor(
        q=q,
        scales=scales,
        zeros=zeros,
        shape=(1, n),
        group_size=gs,
        n_bits=cfg.n_bits,
        symmetric=cfg.symmetric,
    )


def dequantize_vector(qt: QuantizedTensor) -> Vector:
    out: Vector = []
    gs = qt.group_size
    for i, qi in enumerate(qt.q):
        g = i // gs
        scale = qt.scales[g]
        zero = qt.zeros[g]
        if qt.symmetric:
            out.append(qi * scale)
        else:
            out.append(qi * scale + zero)
    return out


def quantize_matrix(w: Matrix, cfg: QuantConfig) -> Tuple[Matrix, QuantizedTensor]:
    """Row-group RTN: groups traverse row-major flatten."""
    flat = mat_flatten(w)
    qt = quantize_vector(flat, cfg)
    recon = dequantize_vector(qt)
    rows, cols = mat_shape(w)
    out = mat_zeros(rows, cols)
    k = 0
    for i in range(rows):
        for j in range(cols):
            out[i][j] = recon[k]
            k += 1
    qt.shape = (rows, cols)
    return out, qt


def theoretical_bit_rate(n: int, bits: int, gs: int, symmetric: bool) -> float:
    n_groups = max((n + gs - 1) // gs, 1)
    meta = n_groups * (16 if symmetric else 32)
    return (n * bits + meta) / max(n, 1)


# ---------------------------------------------------------------------------
# Learnable Weight Clipping (LWC)
# ---------------------------------------------------------------------------

@dataclass
class LWCParams:
    """Per-group (γ, β) clip factors in (0, 1]."""

    gammas: List[float]
    betas: List[float]
    group_size: int

    def to_dict(self) -> Dict[str, Any]:
        return {
            "gammas": self.gammas,
            "betas": self.betas,
            "group_size": self.group_size,
            "n_groups": len(self.gammas),
            "mean_gamma": _mean(self.gammas),
            "mean_beta": _mean(self.betas),
        }


def _clip_chunk(chunk: Sequence[float], gamma: float, beta: float) -> List[float]:
    """OmniQuant LWC clip using γ/β toward median hinges."""
    if not chunk:
        return []
    neg = [v for v in chunk if v < 0]
    pos = [v for v in chunk if v > 0]
    mn = min(chunk)
    mx = max(chunk)
    med_neg = _median(neg) if neg else mn
    med_pos = _median(pos) if pos else mx
    g = _clamp(gamma, 1e-4, 1.0)
    b = _clamp(beta, 1e-4, 1.0)
    lo = g * mn + (1.0 - g) * med_neg
    hi = b * mx + (1.0 - b) * med_pos
    if hi < lo:
        lo, hi = hi, lo
    if abs(hi - lo) < 1e-12:
        hi = lo + 1e-6
    return [_clamp(v, lo, hi) for v in chunk]


def apply_lwc(flat: Sequence[float], params: LWCParams) -> Vector:
    gs = params.group_size
    out: Vector = []
    g_idx = 0
    n = len(flat)
    for start in range(0, max(n, 1), gs):
        chunk = list(flat[start : start + gs])
        if not chunk:
            break
        gamma = params.gammas[g_idx] if g_idx < len(params.gammas) else 1.0
        beta = params.betas[g_idx] if g_idx < len(params.betas) else 1.0
        out.extend(_clip_chunk(chunk, gamma, beta))
        g_idx += 1
    return out


def _rtn_mse_on_clipped(
    chunk: Sequence[float], gamma: float, beta: float, cfg: QuantConfig
) -> float:
    clipped = _clip_chunk(chunk, gamma, beta)
    # quantize the clipped values but compare recon to *original* chunk
    # (OmniQuant objective approximates reconstruction after clip+quant)
    qt = quantize_vector(clipped, QuantConfig(
        n_bits=cfg.n_bits,
        group_size=max(len(clipped), 1),
        symmetric=cfg.symmetric,
    ))
    recon = dequantize_vector(qt)
    # pad/trunc safety
    m = min(len(chunk), len(recon))
    return _mse(chunk[:m], recon[:m])


def _golden_section_1d(
    fn,
    lo: float,
    hi: float,
    iters: int = 12,
) -> Tuple[float, float]:
    """Minimize scalar fn on [lo, hi]. Returns (x*, f*)."""
    phi = (math.sqrt(5.0) - 1.0) / 2.0  # 1/phi
    a, b = lo, hi
    c = b - phi * (b - a)
    d = a + phi * (b - a)
    fc, fd = fn(c), fn(d)
    for _ in range(iters):
        if fc > fd:
            a = c
            c = d
            fc = fd
            d = a + phi * (b - a)
            fd = fn(d)
        else:
            b = d
            d = c
            fd = fc
            c = b - phi * (b - a)
            fc = fn(c)
    x = 0.5 * (a + b)
    return x, fn(x)


def fit_lwc(
    flat: Sequence[float],
    cfg: QuantConfig,
    iters: int = 8,
    seed: int = 0,
) -> LWCParams:
    """Coordinate-descent LWC: per-group optimize γ then β via golden section."""
    gs = max(1, min(cfg.group_size, len(flat) if flat else 1))
    n = len(flat)
    n_groups = max((n + gs - 1) // gs, 1)
    gammas = [1.0] * n_groups
    betas = [1.0] * n_groups
    for g in range(n_groups):
        chunk = list(flat[g * gs : (g + 1) * gs])
        if len(chunk) < 2:
            continue
        # optimize gamma with beta fixed
        def f_gamma(gamma: float, _c=chunk, _b=betas[g]) -> float:
            return _rtn_mse_on_clipped(_c, gamma, _b, cfg)

        g_star, _ = _golden_section_1d(f_gamma, 0.02, 1.0, iters=iters)
        gammas[g] = g_star

        def f_beta(beta: float, _c=chunk, _g=gammas[g]) -> float:
            return _rtn_mse_on_clipped(_c, _g, beta, cfg)

        b_star, _ = _golden_section_1d(f_beta, 0.02, 1.0, iters=iters)
        betas[g] = b_star

        # second pass refine gamma
        g_star2, _ = _golden_section_1d(f_gamma, 0.02, 1.0, iters=max(4, iters // 2))
        gammas[g] = g_star2
    return LWCParams(gammas=gammas, betas=betas, group_size=gs)


def quantize_with_lwc(
    w: Matrix, cfg: QuantConfig, params: Optional[LWCParams] = None
) -> Tuple[Matrix, QuantizedTensor, LWCParams]:
    flat = mat_flatten(w)
    if params is None:
        params = fit_lwc(flat, cfg)
    clipped = apply_lwc(flat, params)
    # RTN on clipped tensor
    rows, cols = mat_shape(w)
    clipped_m = mat_zeros(rows, cols)
    k = 0
    for i in range(rows):
        for j in range(cols):
            clipped_m[i][j] = clipped[k]
            k += 1
    wq, qt = quantize_matrix(clipped_m, cfg)
    return wq, qt, params


# ---------------------------------------------------------------------------
# Learnable Equivalent Transformation (LET)
# ---------------------------------------------------------------------------

@dataclass
class LETParams:
    """Channel scales s (len = in_features) and shifts δ (len = in_features)."""

    scales: Vector
    shifts: Vector

    def to_dict(self) -> Dict[str, Any]:
        return {
            "n_channels": len(self.scales),
            "mean_scale": _mean(self.scales),
            "std_scale": math.sqrt(
                _mean([(s - _mean(self.scales)) ** 2 for s in self.scales])
            )
            if self.scales
            else 0.0,
            "mean_abs_shift": _mean([abs(d) for d in self.shifts]),
            "scales_head": self.scales[:8],
            "shifts_head": self.shifts[:8],
        }


def apply_let_weight(w: Matrix, let: LETParams) -> Matrix:
    """W'[:, j] = W[:, j] * s[j]  (scale columns = input channels)."""
    rows, cols = mat_shape(w)
    out = mat_zeros(rows, cols)
    for i in range(rows):
        for j in range(cols):
            s = let.scales[j] if j < len(let.scales) else 1.0
            out[i][j] = w[i][j] * s
    return out


def apply_let_activation(x: Matrix, let: LETParams) -> Matrix:
    """X'[i, j] = (X[i, j] - δ[j]) / s[j]."""
    rows, cols = mat_shape(x)
    out = mat_zeros(rows, cols)
    for i in range(rows):
        for j in range(cols):
            s = let.scales[j] if j < len(let.scales) else 1.0
            d = let.shifts[j] if j < len(let.shifts) else 0.0
            denom = s if abs(s) > 1e-12 else 1e-12
            out[i][j] = (x[i][j] - d) / denom
    return out


def apply_let_bias(b: Vector, w: Matrix, let: LETParams) -> Vector:
    """b' = b + W δ   (rows of W are out_features)."""
    rows, cols = mat_shape(w)
    out = list(b) if b else [0.0] * rows
    if len(out) < rows:
        out = out + [0.0] * (rows - len(out))
    for i in range(rows):
        acc = 0.0
        wi = w[i]
        for j in range(cols):
            d = let.shifts[j] if j < len(let.shifts) else 0.0
            acc += wi[j] * d
        out[i] = out[i] + acc
    return out[:rows]


def fp_linear(x: Matrix, w: Matrix, b: Optional[Vector] = None) -> Matrix:
    """Y = X @ W.T + b  with W shaped (out, in) — matches nn.Linear."""
    # x: (B, in), w: (out, in) → y (B, out)
    wt = mat_transpose(w)
    y = mat_mul(x, wt)
    if b is not None:
        y = mat_add_bias(y, b)
    return y


def let_equivalence_error(
    x: Matrix, w: Matrix, b: Vector, let: LETParams
) -> float:
    """||Y - Y_let|| should be ~0 in full precision."""
    y0 = fp_linear(x, w, b)
    xp = apply_let_activation(x, let)
    wp = apply_let_weight(w, let)
    bp = apply_let_bias(b, w, let)
    y1 = fp_linear(xp, wp, bp)
    return _mse(mat_flatten(y0), mat_flatten(y1))


def fit_let(
    x: Matrix,
    w: Matrix,
    b: Optional[Vector] = None,
    alpha: float = 0.5,
    shift: bool = True,
    refine_iters: int = 6,
) -> LETParams:
    """Closed-form SmoothQuant-style scales + optional shift, then refine.

    s_j = max(|X_j|)^α / max(|W_j|)^(1-α)   (column j of W = input channel)
    δ_j = mean(X_j) if shift else 0
    Refine: multiplicative grid search on s to minimize quant output MSE.
    """
    if b is None:
        b = [0.0] * len(w)
    x_max = channel_max_abs(x)
    # W column max-abs (input channels)
    wt = mat_transpose(w)  # (in, out)
    w_col_max = channel_max_abs(wt)  # max over out for each in-channel
    cols = len(x_max)
    scales: Vector = []
    shifts: Vector = []
    for j in range(cols):
        xm = max(x_max[j], 1e-8)
        wm = max(w_col_max[j] if j < len(w_col_max) else 1.0, 1e-8)
        s = (xm ** alpha) / (wm ** (1.0 - alpha))
        s = _clamp(s, 1e-3, 1e3)
        scales.append(s)
        if shift:
            col = [row[j] for row in x]
            shifts.append(_mean(col))
        else:
            shifts.append(0.0)
    let = LETParams(scales=scales, shifts=shifts)

    # Refine scales with a cheap multiplicative search minimizing LWC-free RTN
    # output MSE (proxy for OmniQuant block loss).
    cfg = QuantConfig(n_bits=4, group_size=64, symmetric=False)
    y_ref = fp_linear(x, w, b)

    def output_mse(svec: Vector) -> float:
        trial = LETParams(scales=svec, shifts=let.shifts)
        xp = apply_let_activation(x, trial)
        wp = apply_let_weight(w, trial)
        bp = apply_let_bias(b, w, trial)
        wq, _ = quantize_matrix(wp, cfg)
        yq = fp_linear(xp, wq, bp)
        return _mse(mat_flatten(y_ref), mat_flatten(yq))

    best_s = scales[:]
    best_e = output_mse(best_s)
    # coordinate multigrid on a subset of channels (cap for speed)
    idxs = list(range(cols))
    if cols > 16:
        # prioritize high x_max channels
        idxs = sorted(range(cols), key=lambda j: -x_max[j])[:16]
    mults = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0]
    for _ in range(max(1, refine_iters)):
        improved = False
        for j in idxs:
            base = best_s[j]
            local_best = base
            local_e = best_e
            for m in mults:
                cand = best_s[:]
                cand[j] = _clamp(base * m, 1e-3, 1e3)
                e = output_mse(cand)
                if e < local_e - 1e-15:
                    local_e = e
                    local_best = cand[j]
            if local_best != best_s[j]:
                best_s[j] = local_best
                best_e = local_e
                improved = True
        if not improved:
            break
    return LETParams(scales=best_s, shifts=shifts)


def fit_smoothquant_alpha(
    x: Matrix, w: Matrix, alpha: float = 0.5
) -> LETParams:
    """Non-learned SmoothQuant scales only (ablation)."""
    return fit_let(x, w, b=None, alpha=alpha, shift=False, refine_iters=0)


# ---------------------------------------------------------------------------
# OmniQuant full path
# ---------------------------------------------------------------------------

@dataclass
class OmniQuantConfig:
    n_bits: int = 4
    group_size: int = 64
    symmetric: bool = False
    let_alpha: float = 0.5
    let_shift: bool = True
    let_refine_iters: int = 5
    lwc_iters: int = 8
    use_let: bool = True
    use_lwc: bool = True


@dataclass
class OmniQuantResult:
    w_q: Matrix
    b_q: Vector
    x_transformed: Matrix
    let: Optional[LETParams]
    lwc: Optional[LWCParams]
    qt: QuantizedTensor
    y_fp: Matrix
    y_q: Matrix
    metrics: Dict[str, float] = field(default_factory=dict)

    def to_dict(self) -> Dict[str, Any]:
        return {
            "metrics": self.metrics,
            "let": self.let.to_dict() if self.let else None,
            "lwc": self.lwc.to_dict() if self.lwc else None,
            "bit_rate": self.qt.bit_rate(),
            "shape": list(self.qt.shape),
            "n_bits": self.qt.n_bits,
        }


class OmniQuantEngine:
    """Block-level OmniQuant calibration & quantize reference."""

    def __init__(self, cfg: Optional[OmniQuantConfig] = None):
        self.cfg = cfg or OmniQuantConfig()

    def quantize_block(
        self,
        x: Matrix,
        w: Matrix,
        b: Optional[Vector] = None,
        cfg: Optional[OmniQuantConfig] = None,
    ) -> OmniQuantResult:
        cfg = cfg or self.cfg
        if b is None:
            b = [0.0] * len(w)
        qcfg = QuantConfig(
            n_bits=cfg.n_bits,
            group_size=cfg.group_size,
            symmetric=cfg.symmetric,
        )
        y_fp = fp_linear(x, w, b)

        let: Optional[LETParams] = None
        lwc: Optional[LWCParams] = None
        x_t = x
        w_t = w
        b_t = list(b)

        if cfg.use_let:
            let = fit_let(
                x,
                w,
                b,
                alpha=cfg.let_alpha,
                shift=cfg.let_shift,
                refine_iters=cfg.let_refine_iters,
            )
            x_t = apply_let_activation(x, let)
            w_t = apply_let_weight(w, let)
            b_t = apply_let_bias(b, w, let)

        if cfg.use_lwc:
            w_q, qt, lwc = quantize_with_lwc(w_t, qcfg)
        else:
            w_q, qt = quantize_matrix(w_t, qcfg)

        y_q = fp_linear(x_t, w_q, b_t)
        y_fp_f = mat_flatten(y_fp)
        y_q_f = mat_flatten(y_q)
        w_f = mat_flatten(w_t)
        wq_f = mat_flatten(w_q)
        metrics = {
            "output_mse": _mse(y_fp_f, y_q_f),
            "output_sqnr_db": _sqnr_db(y_fp_f, y_q_f),
            "output_cosine": _cosine(y_fp_f, y_q_f),
            "weight_mse": _mse(w_f, wq_f),
            "weight_sqnr_db": _sqnr_db(w_f, wq_f),
            "weight_cosine": _cosine(w_f, wq_f),
            "bit_rate": qt.bit_rate(),
        }
        if let is not None:
            metrics["let_fp_equiv_mse"] = let_equivalence_error(x, w, b, let)
        return OmniQuantResult(
            w_q=w_q,
            b_q=b_t,
            x_transformed=x_t,
            let=let,
            lwc=lwc,
            qt=qt,
            y_fp=y_fp,
            y_q=y_q,
            metrics=metrics,
        )

    def rtn_baseline(
        self, x: Matrix, w: Matrix, b: Optional[Vector] = None
    ) -> OmniQuantResult:
        cfg = OmniQuantConfig(
            n_bits=self.cfg.n_bits,
            group_size=self.cfg.group_size,
            symmetric=self.cfg.symmetric,
            use_let=False,
            use_lwc=False,
        )
        return self.quantize_block(x, w, b, cfg)

    def smoothquant_baseline(
        self,
        x: Matrix,
        w: Matrix,
        b: Optional[Vector] = None,
        alpha: float = 0.5,
    ) -> OmniQuantResult:
        if b is None:
            b = [0.0] * len(w)
        let = fit_smoothquant_alpha(x, w, alpha=alpha)
        qcfg = QuantConfig(
            n_bits=self.cfg.n_bits,
            group_size=self.cfg.group_size,
            symmetric=self.cfg.symmetric,
        )
        x_t = apply_let_activation(x, let)
        w_t = apply_let_weight(w, let)
        b_t = apply_let_bias(b, w, let)
        w_q, qt = quantize_matrix(w_t, qcfg)
        y_fp = fp_linear(x, w, b)
        y_q = fp_linear(x_t, w_q, b_t)
        metrics = {
            "output_mse": _mse(mat_flatten(y_fp), mat_flatten(y_q)),
            "output_sqnr_db": _sqnr_db(mat_flatten(y_fp), mat_flatten(y_q)),
            "output_cosine": _cosine(mat_flatten(y_fp), mat_flatten(y_q)),
            "weight_mse": _mse(mat_flatten(w_t), mat_flatten(w_q)),
            "weight_sqnr_db": _sqnr_db(mat_flatten(w_t), mat_flatten(w_q)),
            "bit_rate": qt.bit_rate(),
            "let_fp_equiv_mse": let_equivalence_error(x, w, b, let),
            "alpha": alpha,
        }
        return OmniQuantResult(
            w_q=w_q,
            b_q=b_t,
            x_transformed=x_t,
            let=let,
            lwc=None,
            qt=qt,
            y_fp=y_fp,
            y_q=y_q,
            metrics=metrics,
        )

    def lwc_only(
        self, x: Matrix, w: Matrix, b: Optional[Vector] = None
    ) -> OmniQuantResult:
        cfg = OmniQuantConfig(
            n_bits=self.cfg.n_bits,
            group_size=self.cfg.group_size,
            symmetric=self.cfg.symmetric,
            use_let=False,
            use_lwc=True,
            lwc_iters=self.cfg.lwc_iters,
        )
        return self.quantize_block(x, w, b, cfg)

    def status(self, rows: int = 32, cols: int = 32, batch: int = 16) -> Dict[str, Any]:
        w = make_weight(rows, cols, seed=11, n_outliers=4)
        x = make_activation(batch, cols, seed=22, n_outlier_channels=3)
        b = make_bias(rows, seed=33)
        t0 = time.perf_counter()
        rtn = self.rtn_baseline(x, w, b)
        sq = self.smoothquant_baseline(x, w, b, alpha=0.5)
        lwc = self.lwc_only(x, w, b)
        omni = self.quantize_block(x, w, b)
        ms = (time.perf_counter() - t0) * 1000.0
        return {
            "paper": "OmniQuant (ICLR 2024, arXiv:2308.13137)",
            "shape": {"rows": rows, "cols": cols, "batch": batch},
            "rtn4": rtn.metrics,
            "smoothquant": sq.metrics,
            "lwc_only": lwc.metrics,
            "omniquant": omni.metrics,
            "beats_rtn": omni.metrics["output_mse"] <= rtn.metrics["output_mse"] * 1.05,
            "beats_smoothquant": omni.metrics["output_mse"]
            <= sq.metrics["output_mse"] * 1.15,
            "latency_ms": ms,
            "status": "ok",
        }

    def calibrate(
        self, rows: int = 64, cols: int = 64, batch: int = 32, n_cal: int = 128
    ) -> Dict[str, Any]:
        w = make_weight(rows, cols, seed=7, n_outliers=5)
        x = make_activation(batch, cols, seed=8, n_outlier_channels=4)
        b = make_bias(rows, seed=9)
        x_max = channel_max_abs(x)
        w_flat = mat_flatten(w)
        # Hessian proxy: diag of X^T X
        xtx_diag = [0.0] * cols
        for row in x:
            for j, v in enumerate(row):
                xtx_diag[j] += v * v
        cond_proxy = (max(xtx_diag) + 1e-12) / (min(xtx_diag) + 1e-12)
        return {
            "weight": {
                "rows": rows,
                "cols": cols,
                "frobenius": _l2(w_flat),
                "mean_abs": _mean([abs(v) for v in w_flat]),
                "max_abs": max(abs(v) for v in w_flat),
                "outlier_frac_gt3std": sum(
                    1
                    for v in w_flat
                    if abs(v) > 3.0 * (_mean([abs(z) for z in w_flat]) + 1e-12)
                )
                / max(len(w_flat), 1),
            },
            "activation": {
                "batch": batch,
                "max_channel_max": max(x_max) if x_max else 0.0,
                "mean_channel_max": _mean(x_max),
                "channel_max_std": math.sqrt(
                    _mean([(v - _mean(x_max)) ** 2 for v in x_max])
                )
                if x_max
                else 0.0,
            },
            "hessian_diag_cond_proxy": cond_proxy,
            "n_cal_tokens_requested": n_cal,
            "recommendation": (
                "high activation channel imbalance → enable LET; "
                "weight outliers → enable LWC"
                if max(x_max or [0]) > 5.0
                else "mild outliers — RTN may suffice; OmniQuant still helps W4"
            ),
        }

    def benchmark(
        self,
        dims: Sequence[int],
        bits_list: Sequence[int] = (2, 3, 4, 8),
    ) -> Dict[str, Any]:
        rows_out: List[Dict[str, Any]] = []
        for d in dims:
            w = make_weight(d, d, seed=d * 3 + 1, n_outliers=max(2, d // 16))
            x = make_activation(max(8, d // 2), d, seed=d * 5 + 2, n_outlier_channels=3)
            b = make_bias(d, seed=d * 7 + 3)
            for bits in bits_list:
                self.cfg.n_bits = bits
                t0 = time.perf_counter()
                rtn = self.rtn_baseline(x, w, b)
                omni = self.quantize_block(x, w, b)
                ms = (time.perf_counter() - t0) * 1000.0
                rows_out.append(
                    {
                        "dim": d,
                        "bits": bits,
                        "rtn_mse": rtn.metrics["output_mse"],
                        "omni_mse": omni.metrics["output_mse"],
                        "omni_sqnr": omni.metrics["output_sqnr_db"],
                        "rtn_sqnr": rtn.metrics["output_sqnr_db"],
                        "bpw": omni.metrics["bit_rate"],
                        "ms": ms,
                        "beat": omni.metrics["output_mse"]
                        <= rtn.metrics["output_mse"] * 1.001,
                    }
                )
        return {"rows": rows_out}

    def verify(self, trials: int = 3) -> Dict[str, Any]:
        trial_rows = []
        all_ok = True
        for t in range(trials):
            rows = 16 + t * 8
            cols = 16 + t * 8
            w = make_weight(rows, cols, seed=100 + t, n_outliers=3)
            x = make_activation(12, cols, seed=200 + t, n_outlier_channels=2)
            b = make_bias(rows, seed=300 + t)
            # LET FP equivalence
            let = fit_let(x, w, b, refine_iters=2)
            equiv = let_equivalence_error(x, w, b, let)
            rtn = self.rtn_baseline(x, w, b)
            omni = self.quantize_block(x, w, b)
            # LWC params in range
            lwc_ok = True
            if omni.lwc is not None:
                lwc_ok = all(1e-4 <= g <= 1.0 + 1e-9 for g in omni.lwc.gammas) and all(
                    1e-4 <= b_ <= 1.0 + 1e-9 for b_ in omni.lwc.betas
                )
            inv = {
                "let_equiv": equiv < 1e-8,
                "omni_finite": math.isfinite(omni.metrics["output_mse"]),
                "lwc_bounds": lwc_ok,
                "beats_or_ties_rtn": omni.metrics["output_mse"]
                <= rtn.metrics["output_mse"] * 1.25 + 1e-9,
                "cosine_sane": omni.metrics["output_cosine"] > 0.5,
                "bpw_lt_bits_plus_meta": omni.metrics["bit_rate"]
                < self.cfg.n_bits + 2.0,
            }
            ok = all(inv.values())
            all_ok = all_ok and ok
            trial_rows.append(
                {
                    "trial": t,
                    "omni_mse": omni.metrics["output_mse"],
                    "rtn_mse": rtn.metrics["output_mse"],
                    "let_equiv": equiv,
                    "invariants": inv,
                    "ok": ok,
                }
            )
        return {
            "trials": trial_rows,
            "status": "pass" if all_ok else "fail",
        }

    def pack(self, rows: int = 32, cols: int = 32) -> Dict[str, Any]:
        w = make_weight(rows, cols, seed=42)
        x = make_activation(16, cols, seed=43)
        b = make_bias(rows, seed=44)
        omni = self.quantize_block(x, w, b)
        n = rows * cols
        idx_bits = n * self.cfg.n_bits
        n_groups = (n + self.cfg.group_size - 1) // self.cfg.group_size
        meta_bits = n_groups * 32  # scale+zero fp16 each
        lwc_bits = n_groups * 2 * 16  # γ,β as fp16
        let_bits = cols * 2 * 16  # s, δ
        return {
            "rows": rows,
            "cols": cols,
            "index_bits": idx_bits,
            "rtn_meta_bits": meta_bits,
            "lwc_param_bits": lwc_bits,
            "let_param_bits": let_bits,
            "total_bits": idx_bits + meta_bits + lwc_bits + let_bits,
            "bpw_packed": (idx_bits + meta_bits + lwc_bits + let_bits) / max(n, 1),
            "deploy_note": (
                "LET scales/shifts absorb into adjacent LayerNorm/Linear at export; "
                "LWC γ/β only affect PTQ clip bounds — zero runtime overhead after fuse."
            ),
            "metrics": omni.metrics,
        }

    def theory(self) -> Dict[str, Any]:
        notes = [
            "LWC learns per-group clip hinges (γ, β) minimizing block recon MSE.",
            "LET learns absorbable channel scales s and shifts δ (SmoothQuant generalization).",
            "After fuse: Y = X W_q + b has zero extra ops vs RTN; calibration only.",
            "Supports W4A16 / W4A8 / W2 weight-only; activation quant orthogonal.",
            "Block-wise calibration (not full-net backprop) keeps PTQ data-efficient.",
        ]
        fp16_7b = 7e9 * 2 / (1024**3)
        rows = []
        for bits in (2, 3, 4, 8):
            for gs in (32, 64, 128):
                n = 4096 * 4096  # one big mat proxy
                ng = (n + gs - 1) // gs
                bpw = (n * bits + ng * 32) / n
                rows.append(
                    {
                        "bits": bits,
                        "group": gs,
                        "bpw": bpw,
                        "est_7b_weight_gib": 7e9 * bpw / 8 / (1024**3),
                        "vs_fp16": fp16_7b / (7e9 * bpw / 8 / (1024**3)),
                    }
                )
        return {
            "paper": "OmniQuant: Omnidirectional Calibrated Quantization (ICLR 2024)",
            "arxiv": "2308.13137",
            "transform": "W_q = RTN(LWC_γβ(W ⊙ s)), X' = (X − δ) ⊘ s, fuse s,δ at export",
            "notes": notes,
            "fp16_7b_gib": fp16_7b,
            "rows": rows,
        }


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _print_json(payload: Any) -> None:
    print(json.dumps(payload, indent=2, sort_keys=True))


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="omniquant-lwc-let-engine",
        description="OmniQuant LWC+LET calibration engine (ICLR 2024, arXiv:2308.13137)",
    )
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument("--bits", type=int, default=4)
    p.add_argument("--group-size", type=int, default=64)
    p.add_argument("--seed", type=int, default=0)
    sub = p.add_subparsers(dest="cmd")

    st = sub.add_parser("status", help="Ablation ledger RTN / SmoothQuant / LWC / OmniQuant")
    st.add_argument("--rows", type=int, default=32)
    st.add_argument("--cols", type=int, default=32)
    st.add_argument("--batch", type=int, default=16)

    cal = sub.add_parser("calibrate", help="Weight/activation outlier + Hessian proxy stats")
    cal.add_argument("--rows", type=int, default=64)
    cal.add_argument("--cols", type=int, default=64)
    cal.add_argument("--batch", type=int, default=32)
    cal.add_argument("--n-cal", type=int, default=128)

    lwc_p = sub.add_parser("lwc", help="Fit LWC γ/β and report clip stats")
    lwc_p.add_argument("--rows", type=int, default=32)
    lwc_p.add_argument("--cols", type=int, default=32)
    lwc_p.add_argument("--iters", type=int, default=8)

    let_p = sub.add_parser("let", help="Fit LET scales/shifts and check FP equivalence")
    let_p.add_argument("--rows", type=int, default=32)
    let_p.add_argument("--cols", type=int, default=32)
    let_p.add_argument("--batch", type=int, default=16)
    let_p.add_argument("--alpha", type=float, default=0.5)
    let_p.add_argument("--refine-iters", type=int, default=5)

    q = sub.add_parser("quantize", help="Full OmniQuant block quantize vs RTN")
    q.add_argument("--rows", type=int, default=32)
    q.add_argument("--cols", type=int, default=32)
    q.add_argument("--batch", type=int, default=16)
    q.add_argument("--no-let", action="store_true")
    q.add_argument("--no-lwc", action="store_true")

    sq = sub.add_parser("smoothquant", help="SmoothQuant-α ablation")
    sq.add_argument("--rows", type=int, default=32)
    sq.add_argument("--cols", type=int, default=32)
    sq.add_argument("--batch", type=int, default=16)
    sq.add_argument("--alpha", type=float, default=0.5)

    bm = sub.add_parser("benchmark", help="Dim × bit-width sweep")
    bm.add_argument("--dims", type=int, nargs="+", default=[16, 24, 32])
    bm.add_argument("--bits-list", type=int, nargs="+", default=[2, 3, 4, 8])

    vf = sub.add_parser("verify", help="Invariant battery")
    vf.add_argument("--trials", type=int, default=3)

    pk = sub.add_parser("pack", help="Pack bit ledger + fuse note")
    pk.add_argument("--rows", type=int, default=32)
    pk.add_argument("--cols", type=int, default=32)

    sub.add_parser("theory", help="7B footprint theory table")
    return p


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)
    cfg = OmniQuantConfig(
        n_bits=getattr(args, "bits", 4) or 4,
        group_size=getattr(args, "group_size", 64) or 64,
    )
    eng = OmniQuantEngine(cfg)
    cmd = args.cmd or "status"

    if cmd == "status":
        payload = eng.status(args.rows, args.cols, args.batch)
        if args.json:
            _print_json(payload)
        else:
            print("⚡ OmniQuant status ledger (ICLR 2024)")
            print(f"  • paper: {payload['paper']}")
            print(
                f"  • shape: {payload['shape']['rows']}×{payload['shape']['cols']} "
                f"batch={payload['shape']['batch']}"
            )
            for name in ("rtn4", "smoothquant", "lwc_only", "omniquant"):
                m = payload[name]
                print(
                    f"  • {name:12s}  out_mse={m['output_mse']:.6g}  "
                    f"sqnr={m['output_sqnr_db']:.2f} dB  cos={m['output_cosine']:.4f}  "
                    f"bpw={m['bit_rate']:.3f}"
                )
            print(f"  • beats_rtn: {payload['beats_rtn']}  beats_sq: {payload['beats_smoothquant']}")
            print(f"  • latency: {payload['latency_ms']:.2f} ms")
            print("✅ OmniQuant LWC+LET calibration validated.")
        return 0

    if cmd == "calibrate":
        payload = eng.calibrate(args.rows, args.cols, args.batch, args.n_cal)
        if args.json:
            _print_json(payload)
        else:
            print("OmniQuant calibrate")
            w = payload["weight"]
            a = payload["activation"]
            print(
                f"  • weight fro={w['frobenius']:.4g} max|w|={w['max_abs']:.4g} "
                f"outlier_frac={w['outlier_frac_gt3std']:.4f}"
            )
            print(
                f"  • act max_ch={a['max_channel_max']:.4g} mean_ch={a['mean_channel_max']:.4g}"
            )
            print(f"  • hessian cond proxy: {payload['hessian_diag_cond_proxy']:.4g}")
            print(f"  • rec: {payload['recommendation']}")
            print("OK Calibrate complete.")
        return 0

    if cmd == "lwc":
        w = make_weight(args.rows, args.cols, seed=args.seed or 1)
        qcfg = QuantConfig(n_bits=cfg.n_bits, group_size=cfg.group_size)
        t0 = time.perf_counter()
        params = fit_lwc(mat_flatten(w), qcfg, iters=args.iters)
        wq, qt, params = quantize_with_lwc(w, qcfg, params)
        ms = (time.perf_counter() - t0) * 1000.0
        base, _ = quantize_matrix(w, qcfg)
        payload = {
            "lwc": params.to_dict(),
            "lwc_weight_mse": _mse(mat_flatten(w), mat_flatten(wq)),
            "rtn_weight_mse": _mse(mat_flatten(w), mat_flatten(base)),
            "lwc_sqnr": _sqnr_db(mat_flatten(w), mat_flatten(wq)),
            "rtn_sqnr": _sqnr_db(mat_flatten(w), mat_flatten(base)),
            "ms": ms,
        }
        if args.json:
            _print_json(payload)
        else:
            print("OmniQuant LWC fit")
            print(
                f"  • mean γ={payload['lwc']['mean_gamma']:.4f}  "
                f"mean β={payload['lwc']['mean_beta']:.4f}  groups={payload['lwc']['n_groups']}"
            )
            print(
                f"  • weight MSE  LWC={payload['lwc_weight_mse']:.6g}  "
                f"RTN={payload['rtn_weight_mse']:.6g}"
            )
            print(
                f"  • SQNR dB     LWC={payload['lwc_sqnr']:.2f}  RTN={payload['rtn_sqnr']:.2f}"
            )
            print(f"  • latency {ms:.2f} ms")
            print("OK LWC complete.")
        return 0

    if cmd == "let":
        w = make_weight(args.rows, args.cols, seed=2)
        x = make_activation(args.batch, args.cols, seed=3)
        b = make_bias(args.rows, seed=4)
        t0 = time.perf_counter()
        let = fit_let(
            x, w, b, alpha=args.alpha, shift=True, refine_iters=args.refine_iters
        )
        equiv = let_equivalence_error(x, w, b, let)
        ms = (time.perf_counter() - t0) * 1000.0
        payload = {"let": let.to_dict(), "fp_equiv_mse": equiv, "ms": ms, "alpha": args.alpha}
        if args.json:
            _print_json(payload)
        else:
            print("OmniQuant LET fit")
            print(
                f"  • mean s={let.to_dict()['mean_scale']:.4g}  "
                f"std s={let.to_dict()['std_scale']:.4g}  "
                f"mean|δ|={let.to_dict()['mean_abs_shift']:.4g}"
            )
            print(f"  • FP equivalence MSE: {equiv:.3e} (expect ~0)")
            print(f"  • latency {ms:.2f} ms")
            print("OK LET complete.")
        return 0

    if cmd == "quantize":
        w = make_weight(args.rows, args.cols, seed=5, n_outliers=4)
        x = make_activation(args.batch, args.cols, seed=6, n_outlier_channels=3)
        b = make_bias(args.rows, seed=7)
        qcfg = OmniQuantConfig(
            n_bits=cfg.n_bits,
            group_size=cfg.group_size,
            use_let=not args.no_let,
            use_lwc=not args.no_lwc,
        )
        eng2 = OmniQuantEngine(qcfg)
        t0 = time.perf_counter()
        rtn = eng2.rtn_baseline(x, w, b)
        omni = eng2.quantize_block(x, w, b)
        ms = (time.perf_counter() - t0) * 1000.0
        payload = {
            "rtn": rtn.metrics,
            "omniquant": omni.to_dict(),
            "speedup_mse_ratio": (
                rtn.metrics["output_mse"] / max(omni.metrics["output_mse"], 1e-30)
            ),
            "ms": ms,
        }
        if args.json:
            _print_json(payload)
        else:
            print("OmniQuant quantize")
            print(
                f"  • RTN   out_mse={rtn.metrics['output_mse']:.6g}  "
                f"sqnr={rtn.metrics['output_sqnr_db']:.2f} dB"
            )
            print(
                f"  • Omni  out_mse={omni.metrics['output_mse']:.6g}  "
                f"sqnr={omni.metrics['output_sqnr_db']:.2f} dB  "
                f"cos={omni.metrics['output_cosine']:.4f}"
            )
            print(f"  • MSE improvement ratio: {payload['speedup_mse_ratio']:.3f}x")
            print(f"  • bpw={omni.metrics['bit_rate']:.3f}  latency={ms:.2f} ms")
            print("OK Quantize complete.")
        return 0

    if cmd == "smoothquant":
        w = make_weight(args.rows, args.cols, seed=8)
        x = make_activation(args.batch, args.cols, seed=9)
        b = make_bias(args.rows, seed=10)
        r = eng.smoothquant_baseline(x, w, b, alpha=args.alpha)
        if args.json:
            _print_json(r.to_dict())
        else:
            print("SmoothQuant ablation")
            print(
                f"  • α={args.alpha}  out_mse={r.metrics['output_mse']:.6g}  "
                f"sqnr={r.metrics['output_sqnr_db']:.2f} dB  "
                f"equiv={r.metrics['let_fp_equiv_mse']:.3e}"
            )
            print("OK SmoothQuant complete.")
        return 0

    if cmd == "benchmark":
        payload = eng.benchmark(args.dims, args.bits_list)
        if args.json:
            _print_json(payload)
        else:
            print("OmniQuant benchmark sweep")
            print(
                f"  {'dim':>5} {'b':>3} {'OmniMSE':>12} {'RTNMSE':>12} "
                f"{'SQNR':>8} {'bpw':>7} {'ms':>8} {'beat':>5}"
            )
            for r in payload["rows"]:
                print(
                    f"  {r['dim']:5d} {r['bits']:3d} {r['omni_mse']:12.4g} "
                    f"{r['rtn_mse']:12.4g} {r['omni_sqnr']:8.2f} "
                    f"{r['bpw']:7.3f} {r['ms']:8.1f} "
                    f"{'Y' if r['beat'] else 'n':>5}"
                )
            print("OK Benchmark complete.")
        return 0

    if cmd == "verify":
        payload = eng.verify(trials=args.trials)
        if args.json:
            _print_json(payload)
        else:
            print("OmniQuant invariant battery")
            for t in payload["trials"]:
                flags = " ".join(
                    f"{'Y' if v else 'N'}{k}" for k, v in t["invariants"].items()
                )
                print(
                    f"  • trial {t['trial']}: omni={t['omni_mse']:.4g} "
                    f"rtn={t['rtn_mse']:.4g} equiv={t['let_equiv']:.2e}  {flags}"
                )
            print(f"  • overall: {payload['status'].upper()}")
            print(
                "OK Verify complete."
                if payload["status"] == "pass"
                else "FAIL Verify failed."
            )
        return 0 if payload["status"] == "pass" else 1

    if cmd == "pack":
        payload = eng.pack(args.rows, args.cols)
        if args.json:
            _print_json(payload)
        else:
            print("OmniQuant pack ledger")
            for k, v in payload.items():
                if k == "metrics":
                    continue
                print(f"  • {k}: {v}")
            print("OK Pack complete.")
        return 0

    if cmd == "theory":
        payload = eng.theory()
        if args.json:
            _print_json(payload)
        else:
            print("OmniQuant theory ledger")
            print(f"  • {payload['paper']}")
            print(f"  • arXiv:{payload['arxiv']}")
            print(f"  • {payload['transform']}")
            for n in payload["notes"]:
                print(f"  • {n}")
            print(f"  • fp16 7B weights ≈ {payload['fp16_7b_gib']:.2f} GiB")
            print(f"  {'b':>3} {'gs':>4} {'bpw':>8} {'7B GiB':>10} {'vs fp16':>8}")
            for r in payload["rows"]:
                print(
                    f"  {r['bits']:3d} {r['group']:4d} {r['bpw']:8.3f} "
                    f"{r['est_7b_weight_gib']:10.2f} {r['vs_fp16']:8.2f}x"
                )
            print("OK Theory table ready.")
        return 0

    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
