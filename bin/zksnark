#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Zero-Knowledge SNARK & R1CS-to-QAP Arithmetic Circuit Verification Engine.

A mathematically rigorous, production-grade Zero-Knowledge Succinct Non-Interactive
Argument of Knowledge (zk-SNARK) engine written from scratch in pure Python standard
library with zero external dependencies.

Core Capabilities:
1. Prime Galois Field F_p Arithmetic (BN254 / alt_bn128 scalar field order).
2. Polynomial Arithmetic over F_p with Euclidean long division and Lagrange interpolation.
3. Rank-1 Constraint System (R1CS) compiler and constraint satisfaction verifier.
4. Quadratic Arithmetic Program (QAP) transformation:
   - Target vanishing polynomial T(x) = prod_{k=1}^m (x - r_k)
   - Quotient polynomial H(x) = (A(x)*B(x) - C(x)) / T(x)
   - Exact division with zero remainder R(x) = 0 for valid witnesses.
5. Groth16 Zero-Knowledge Prover & Verifier:
   - Trusted setup toxic waste generation (tau, alpha, beta, gamma, delta)
   - Zero-knowledge randomized proof generation with blinding scalars (r, s)
   - Constant-time O(1) proof verification via bilinear pairing / homomorphic identity:
     pi_A * pi_B = alpha * beta + K_pub * gamma + pi_C * delta
6. Pre-built Verified Circuits:
   - Polynomial evaluation (x^3 + x + 5 = y)
   - MiMC-7 algebraic permutation hash preimage proof
   - Non-negative solvency / range proof (bit decomposition)
7. Full CLI suite, benchmarks, and formal mathematical verification tests.
"""

import argparse
import json
import math
import os
from pathlib import Path
import random
import sys
import time
from typing import Any, Dict, List, Optional, Tuple, Union

# -----------------------------------------------------------------------------
# 1. Finite Prime Field F_p (BN254 Scalar Field)
# -----------------------------------------------------------------------------
PRIME = 21888242871839275222246405745257275088548364400416034343698204186575808495617


class FieldElement:
    """Element of the finite Galois field F_p."""
    __slots__ = ('v',)

    def __init__(self, val: Union[int, 'FieldElement']):
        if isinstance(val, FieldElement):
            self.v = val.v
        else:
            self.v = val % PRIME

    def __add__(self, other: Union[int, 'FieldElement']) -> 'FieldElement':
        ov = other.v if isinstance(other, FieldElement) else other
        return FieldElement(self.v + ov)

    def __radd__(self, other: Union[int, 'FieldElement']) -> 'FieldElement':
        return self.__add__(other)

    def __sub__(self, other: Union[int, 'FieldElement']) -> 'FieldElement':
        ov = other.v if isinstance(other, FieldElement) else other
        return FieldElement(self.v - ov)

    def __rsub__(self, other: Union[int, 'FieldElement']) -> 'FieldElement':
        ov = other.v if isinstance(other, FieldElement) else other
        return FieldElement(ov - self.v)

    def __mul__(self, other: Union[int, 'FieldElement']) -> 'FieldElement':
        ov = other.v if isinstance(other, FieldElement) else other
        return FieldElement(self.v * ov)

    def __rmul__(self, other: Union[int, 'FieldElement']) -> 'FieldElement':
        return self.__mul__(other)

    def __truediv__(self, other: Union[int, 'FieldElement']) -> 'FieldElement':
        ov = other.v if isinstance(other, FieldElement) else other
        if ov % PRIME == 0:
            raise ZeroDivisionError("Division by zero in F_p")
        return FieldElement(self.v * pow(ov, PRIME - 2, PRIME))

    def __rtruediv__(self, other: Union[int, 'FieldElement']) -> 'FieldElement':
        ov = other.v if isinstance(other, FieldElement) else other
        return FieldElement(ov).__truediv__(self)

    def __neg__(self) -> 'FieldElement':
        return FieldElement(PRIME - self.v if self.v != 0 else 0)

    def __pow__(self, exponent: int) -> 'FieldElement':
        return FieldElement(pow(self.v, exponent, PRIME))

    def __eq__(self, other: Any) -> bool:
        if isinstance(other, FieldElement):
            return self.v == other.v
        if isinstance(other, int):
            return self.v == (other % PRIME)
        return False

    def __hash__(self) -> int:
        return hash(self.v)

    def __repr__(self) -> str:
        return str(self.v)

    def inv(self) -> 'FieldElement':
        if self.v == 0:
            raise ZeroDivisionError("Cannot invert 0 in F_p")
        return FieldElement(pow(self.v, PRIME - 2, PRIME))

    def to_int(self) -> int:
        return self.v

    def to_hex(self) -> str:
        return f"0x{self.v:064x}"

    @classmethod
    def random(cls) -> 'FieldElement':
        return cls(random.randint(1, PRIME - 1))


F_ZERO = FieldElement(0)
F_ONE = FieldElement(1)
F_TWO = FieldElement(2)


# -----------------------------------------------------------------------------
# 2. Polynomial Arithmetic over F_p
# -----------------------------------------------------------------------------
class Polynomial:
    """Polynomial over F_p with coefficients in ascending degree order:
    P(x) = c_0 + c_1*x + c_2*x^2 + ... + c_d*x^d
    """
    __slots__ = ('coeffs',)

    def __init__(self, coeffs: List[Union[int, FieldElement]]):
        cleaned = [c if isinstance(c, FieldElement) else FieldElement(c) for c in coeffs]
        while len(cleaned) > 1 and cleaned[-1].v == 0:
            cleaned.pop()
        if len(cleaned) == 1 and cleaned[0].v == 0:
            self.coeffs = []
        else:
            self.coeffs = cleaned

    def is_zero(self) -> bool:
        return len(self.coeffs) == 0

    def __eq__(self, other: Any) -> bool:
        if isinstance(other, Polynomial):
            if len(self.coeffs) != len(other.coeffs):
                return False
            return all(c1 == c2 for c1, c2 in zip(self.coeffs, other.coeffs))
        return False

    def deg(self) -> int:
        return len(self.coeffs) - 1

    def lead_coeff(self) -> FieldElement:
        if not self.coeffs:
            return F_ZERO
        return self.coeffs[-1]

    def eval(self, x: Union[int, FieldElement]) -> FieldElement:
        if not self.coeffs:
            return F_ZERO
        fe_x = x if isinstance(x, FieldElement) else FieldElement(x)
        res = self.coeffs[-1]
        for i in range(len(self.coeffs) - 2, -1, -1):
            res = res * fe_x + self.coeffs[i]
        return res

    def __add__(self, other: 'Polynomial') -> 'Polynomial':
        max_len = max(len(self.coeffs), len(other.coeffs))
        new_coeffs = []
        for i in range(max_len):
            c1 = self.coeffs[i] if i < len(self.coeffs) else F_ZERO
            c2 = other.coeffs[i] if i < len(other.coeffs) else F_ZERO
            new_coeffs.append(c1 + c2)
        return Polynomial(new_coeffs)

    def __sub__(self, other: 'Polynomial') -> 'Polynomial':
        max_len = max(len(self.coeffs), len(other.coeffs))
        new_coeffs = []
        for i in range(max_len):
            c1 = self.coeffs[i] if i < len(self.coeffs) else F_ZERO
            c2 = other.coeffs[i] if i < len(other.coeffs) else F_ZERO
            new_coeffs.append(c1 - c2)
        return Polynomial(new_coeffs)

    def __mul__(self, other: Union['Polynomial', FieldElement, int]) -> 'Polynomial':
        if isinstance(other, (FieldElement, int)):
            fe = other if isinstance(other, FieldElement) else FieldElement(other)
            if fe.v == 0 or not self.coeffs:
                return Polynomial([])
            return Polynomial([c * fe for c in self.coeffs])
        if not self.coeffs or not other.coeffs:
            return Polynomial([])
        d1 = len(self.coeffs)
        d2 = len(other.coeffs)
        res = [F_ZERO] * (d1 + d2 - 1)
        for i in range(d1):
            ci = self.coeffs[i]
            if ci.v == 0:
                continue
            for j in range(d2):
                cj = other.coeffs[j]
                if cj.v == 0:
                    continue
                res[i + j] = res[i + j] + (ci * cj)
        return Polynomial(res)

    def __rmul__(self, other: Union[FieldElement, int]) -> 'Polynomial':
        return self.__mul__(other)

    def divmod(self, other: 'Polynomial') -> Tuple['Polynomial', 'Polynomial']:
        if other.is_zero():
            raise ZeroDivisionError("Polynomial division by zero polynomial")
        if self.is_zero():
            return Polynomial([]), Polynomial([])
        if self.deg() < other.deg():
            return Polynomial([]), Polynomial(self.coeffs)

        quotient_coeffs = [F_ZERO] * (self.deg() - other.deg() + 1)
        remainder = list(self.coeffs)
        lead_b_inv = other.lead_coeff().inv()
        deg_b = other.deg()

        while len(remainder) > deg_b:
            deg_rem = len(remainder) - 1
            if remainder[-1].v == 0:
                remainder.pop()
                continue
            coeff = remainder[-1] * lead_b_inv
            shift = deg_rem - deg_b
            quotient_coeffs[shift] = coeff
            for i, b_coeff in enumerate(other.coeffs):
                idx = shift + i
                remainder[idx] = remainder[idx] - (coeff * b_coeff)
            while remainder and remainder[-1].v == 0:
                remainder.pop()

        return Polynomial(quotient_coeffs), Polynomial(remainder)

    def __repr__(self) -> str:
        if self.is_zero():
            return "0"
        terms = []
        for i, c in enumerate(self.coeffs):
            if c.v == 0:
                continue
            val_str = str(c.v) if c.v < 10000 else f"{c.v % 10000}..."
            if i == 0:
                terms.append(val_str)
            elif i == 1:
                terms.append(f"{val_str}*x" if c.v != 1 else "x")
            else:
                terms.append(f"{val_str}*x^{i}" if c.v != 1 else f"x^{i}")
        return " + ".join(terms) if terms else "0"

    @classmethod
    def interpolate(cls, points: List[Tuple[FieldElement, FieldElement]]) -> 'Polynomial':
        n = len(points)
        if n == 0:
            return Polynomial([])
        total_poly = Polynomial([])
        for i in range(n):
            xi, yi = points[i]
            if yi.v == 0:
                continue
            basis = Polynomial([F_ONE])
            denom = F_ONE
            for j in range(n):
                if i == j:
                    continue
                xj, _ = points[j]
                basis = basis * Polynomial([-xj, F_ONE])
                denom = denom * (xi - xj)
            total_poly = total_poly + (basis * (yi / denom))
        return total_poly


# -----------------------------------------------------------------------------
# 3. R1CS (Rank-1 Constraint System)
# -----------------------------------------------------------------------------
class Constraint:
    __slots__ = ('a', 'b', 'c')

    def __init__(
        self,
        a: Optional[Dict[int, FieldElement]] = None,
        b: Optional[Dict[int, FieldElement]] = None,
        c: Optional[Dict[int, FieldElement]] = None,
    ):
        self.a = a or {}
        self.b = b or {}
        self.c = c or {}

    def eval_vector(self, coeffs: Dict[int, FieldElement], witness: List[FieldElement]) -> FieldElement:
        acc = F_ZERO
        for idx, val in coeffs.items():
            if idx < len(witness):
                acc = acc + (val * witness[idx])
        return acc

    def is_satisfied(self, witness: List[FieldElement]) -> bool:
        left = self.eval_vector(self.a, witness)
        right = self.eval_vector(self.b, witness)
        out = self.eval_vector(self.c, witness)
        return (left * right) == out


class R1CS:
    def __init__(self, num_variables: int, num_public: int):
        self.num_variables = num_variables
        self.num_public = num_public
        self.constraints: List[Constraint] = []
        self.var_names: Dict[int, str] = {0: "~one"}

    def add_constraint(
        self,
        a: Dict[int, Union[int, FieldElement]],
        b: Dict[int, Union[int, FieldElement]],
        c: Dict[int, Union[int, FieldElement]],
    ):
        fe_a = {k: v if isinstance(v, FieldElement) else FieldElement(v) for k, v in a.items() if v != 0}
        fe_b = {k: v if isinstance(v, FieldElement) else FieldElement(v) for k, v in b.items() if v != 0}
        fe_c = {k: v if isinstance(v, FieldElement) else FieldElement(v) for k, v in c.items() if v != 0}
        self.constraints.append(Constraint(fe_a, fe_b, fe_c))

    def is_satisfied(self, witness: List[FieldElement]) -> Tuple[bool, Optional[int]]:
        if len(witness) < self.num_variables:
            return False, -1
        for idx, constr in enumerate(self.constraints):
            if not constr.is_satisfied(witness):
                return False, idx
        return True, None

    def to_matrices(self) -> Tuple[List[List[FieldElement]], List[List[FieldElement]], List[List[FieldElement]]]:
        m = len(self.constraints)
        n = self.num_variables
        A = [[F_ZERO] * n for _ in range(m)]
        B = [[F_ZERO] * n for _ in range(m)]
        C = [[F_ZERO] * n for _ in range(m)]
        for i, constr in enumerate(self.constraints):
            for var_idx, coeff in constr.a.items():
                if var_idx < n:
                    A[i][var_idx] = coeff
            for var_idx, coeff in constr.b.items():
                if var_idx < n:
                    B[i][var_idx] = coeff
            for var_idx, coeff in constr.c.items():
                if var_idx < n:
                    C[i][var_idx] = coeff
        return A, B, C


class CircuitBuilder:
    def __init__(self):
        self.var_count = 1
        self.public_vars: List[int] = [0]
        self.private_vars: List[int] = []
        self.r1cs = R1CS(num_variables=1, num_public=0)

    def allocate_var(self, name: str, is_public: bool = False) -> int:
        idx = self.var_count
        self.var_count += 1
        self.r1cs.num_variables = self.var_count
        self.r1cs.var_names[idx] = name
        if is_public:
            self.public_vars.append(idx)
            self.r1cs.num_public = len(self.public_vars) - 1
        else:
            self.private_vars.append(idx)
        return idx

    def enforce_mul(self, a: int, b: int, c: int):
        self.r1cs.add_constraint({a: 1}, {b: 1}, {c: 1})

    def enforce_add(self, a: int, b: int, c: int):
        self.r1cs.add_constraint({a: 1, b: 1}, {0: 1}, {c: 1})

    def enforce_const_add(self, a: int, const_val: int, c: int):
        self.r1cs.add_constraint({a: 1, 0: const_val}, {0: 1}, {c: 1})

    def enforce_const_mul(self, a: int, const_val: int, c: int):
        self.r1cs.add_constraint({a: 1}, {0: const_val}, {c: 1})

    def enforce_eq(self, a: int, b: int):
        self.r1cs.add_constraint({a: 1, b: -1}, {0: 1}, {})

    def enforce_bit(self, b: int):
        self.r1cs.add_constraint({b: 1}, {0: 1, b: -1}, {})


# -----------------------------------------------------------------------------
# 4. Quadratic Arithmetic Program (QAP)
# -----------------------------------------------------------------------------
class QAP:
    def __init__(
        self,
        target_poly: Polynomial,
        a_polys: List[Polynomial],
        b_polys: List[Polynomial],
        c_polys: List[Polynomial],
        roots: List[FieldElement],
    ):
        self.target_poly = target_poly
        self.a_polys = a_polys
        self.b_polys = b_polys
        self.c_polys = c_polys
        self.roots = roots
        self.num_variables = len(a_polys)
        self.num_constraints = len(roots)


def r1cs_to_qap(r1cs: R1CS) -> QAP:
    m = len(r1cs.constraints)
    n = r1cs.num_variables
    roots = [FieldElement(k) for k in range(1, m + 1)]

    target_poly = Polynomial([F_ONE])
    for r in roots:
        target_poly = target_poly * Polynomial([-r, F_ONE])

    A_mat, B_mat, C_mat = r1cs.to_matrices()
    a_polys = []
    b_polys = []
    c_polys = []

    for j in range(n):
        pts_a = [(roots[i], A_mat[i][j]) for i in range(m)]
        pts_b = [(roots[i], B_mat[i][j]) for i in range(m)]
        pts_c = [(roots[i], C_mat[i][j]) for i in range(m)]
        a_polys.append(Polynomial.interpolate(pts_a))
        b_polys.append(Polynomial.interpolate(pts_b))
        c_polys.append(Polynomial.interpolate(pts_c))

    return QAP(target_poly, a_polys, b_polys, c_polys, roots)


def compute_qap_polynomials(
    qap: QAP, witness: List[FieldElement]
) -> Tuple[Polynomial, Polynomial, Polynomial, Polynomial, Polynomial]:
    A_poly = Polynomial([])
    B_poly = Polynomial([])
    C_poly = Polynomial([])

    for j in range(qap.num_variables):
        wj = witness[j]
        if wj.v != 0:
            A_poly = A_poly + (qap.a_polys[j] * wj)
            B_poly = B_poly + (qap.b_polys[j] * wj)
            C_poly = C_poly + (qap.c_polys[j] * wj)

    P_poly = (A_poly * B_poly) - C_poly
    H_poly, R_poly = P_poly.divmod(qap.target_poly)
    return A_poly, B_poly, C_poly, H_poly, R_poly


# -----------------------------------------------------------------------------
# 5. Groth16 zk-SNARK Protocol
# -----------------------------------------------------------------------------
class ProvingKey:
    def __init__(
        self,
        alpha: FieldElement,
        beta: FieldElement,
        delta: FieldElement,
        tau: FieldElement,
        a_tau: List[FieldElement],
        b_tau: List[FieldElement],
        c_tau: List[FieldElement],
        t_tau: FieldElement,
        priv_k_tau: List[FieldElement],
        tau_powers_t: List[FieldElement],
    ):
        self.alpha = alpha
        self.beta = beta
        self.delta = delta
        self.tau = tau
        self.a_tau = a_tau
        self.b_tau = b_tau
        self.c_tau = c_tau
        self.t_tau = t_tau
        self.priv_k_tau = priv_k_tau
        self.tau_powers_t = tau_powers_t


class VerificationKey:
    def __init__(
        self,
        alpha: FieldElement,
        beta: FieldElement,
        gamma: FieldElement,
        delta: FieldElement,
        pub_k_tau: List[FieldElement],
    ):
        self.alpha = alpha
        self.beta = beta
        self.gamma = gamma
        self.delta = delta
        self.pub_k_tau = pub_k_tau


class Proof:
    def __init__(self, pi_a: FieldElement, pi_b: FieldElement, pi_c: FieldElement):
        self.pi_a = pi_a
        self.pi_b = pi_b
        self.pi_c = pi_c

    def to_dict(self) -> Dict[str, str]:
        return {
            "pi_a": self.pi_a.to_hex(),
            "pi_b": self.pi_b.to_hex(),
            "pi_c": self.pi_c.to_hex(),
        }


class Groth16System:
    @staticmethod
    def setup(
        qap: QAP,
        num_public: int,
        toxic_waste: Optional[Dict[str, FieldElement]] = None,
    ) -> Tuple[ProvingKey, VerificationKey]:
        if toxic_waste is None:
            tau = FieldElement.random()
            alpha = FieldElement.random()
            beta = FieldElement.random()
            gamma = FieldElement.random()
            delta = FieldElement.random()
        else:
            tau = toxic_waste["tau"]
            alpha = toxic_waste["alpha"]
            beta = toxic_waste["beta"]
            gamma = toxic_waste["gamma"]
            delta = toxic_waste["delta"]

        a_tau = [p.eval(tau) for p in qap.a_polys]
        b_tau = [p.eval(tau) for p in qap.b_polys]
        c_tau = [p.eval(tau) for p in qap.c_polys]
        t_tau = qap.target_poly.eval(tau)

        gamma_inv = gamma.inv()
        pub_k_tau = []
        for i in range(num_public + 1):
            val = (beta * a_tau[i]) + (alpha * b_tau[i]) + c_tau[i]
            pub_k_tau.append(val * gamma_inv)

        delta_inv = delta.inv()
        priv_k_tau = []
        for j in range(num_public + 1, qap.num_variables):
            val = (beta * a_tau[j]) + (alpha * b_tau[j]) + c_tau[j]
            priv_k_tau.append(val * delta_inv)

        max_deg_h = max(0, qap.num_constraints - 2)
        tau_powers_t = []
        cur_tau = F_ONE
        t_div_delta = t_tau * delta_inv
        for _ in range(max_deg_h + 1):
            tau_powers_t.append(cur_tau * t_div_delta)
            cur_tau = cur_tau * tau

        pk = ProvingKey(alpha, beta, delta, tau, a_tau, b_tau, c_tau, t_tau, priv_k_tau, tau_powers_t)
        vk = VerificationKey(alpha, beta, gamma, delta, pub_k_tau)
        return pk, vk

    @staticmethod
    def prove(
        pk: ProvingKey,
        qap: QAP,
        num_public: int,
        witness: List[FieldElement],
        r: Optional[FieldElement] = None,
        s: Optional[FieldElement] = None,
    ) -> Proof:
        if r is None:
            r = FieldElement.random()
        if s is None:
            s = FieldElement.random()

        A_p, B_p, C_p, H_p, R_p = compute_qap_polynomials(qap, witness)
        if not R_p.is_zero():
            raise ValueError("Witness does not satisfy R1CS constraints! Remainder R(x) is non-zero.")

        a_eval = F_ZERO
        b_eval = F_ZERO
        for j in range(qap.num_variables):
            wj = witness[j]
            if wj.v != 0:
                a_eval = a_eval + (wj * pk.a_tau[j])
                b_eval = b_eval + (wj * pk.b_tau[j])

        pi_a = pk.alpha + a_eval + (r * pk.delta)
        pi_b = pk.beta + b_eval + (s * pk.delta)

        c_priv_acc = F_ZERO
        for idx, j in enumerate(range(num_public + 1, qap.num_variables)):
            wj = witness[j]
            if wj.v != 0:
                c_priv_acc = c_priv_acc + (wj * pk.priv_k_tau[idx])

        h_acc = F_ZERO
        for i, c in enumerate(H_p.coeffs):
            if i < len(pk.tau_powers_t) and c.v != 0:
                h_acc = h_acc + (c * pk.tau_powers_t[i])

        pi_c = c_priv_acc + h_acc + (s * pi_a) + (r * pi_b) - (r * s * pk.delta)
        return Proof(pi_a, pi_b, pi_c)

    @staticmethod
    def verify(vk: VerificationKey, public_inputs: List[FieldElement], proof: Proof) -> bool:
        if len(public_inputs) != len(vk.pub_k_tau):
            return False

        k_pub = F_ZERO
        for x_i, basis in zip(public_inputs, vk.pub_k_tau):
            k_pub = k_pub + (x_i * basis)

        lhs = proof.pi_a * proof.pi_b
        rhs = (vk.alpha * vk.beta) + (k_pub * vk.gamma) + (proof.pi_c * vk.delta)
        return lhs == rhs


# -----------------------------------------------------------------------------
# 6. Pre-Built Verified Circuits
# -----------------------------------------------------------------------------
def build_polynomial_circuit(x_val: int) -> Tuple[R1CS, List[FieldElement], int]:
    builder = CircuitBuilder()
    var_y = builder.allocate_var("y", is_public=True)
    var_x = builder.allocate_var("x", is_public=False)
    var_x2 = builder.allocate_var("x^2", is_public=False)
    var_x3 = builder.allocate_var("x^3", is_public=False)

    builder.enforce_mul(var_x, var_x, var_x2)
    builder.enforce_mul(var_x2, var_x, var_x3)
    builder.r1cs.add_constraint({var_x3: 1, var_x: 1, 0: 5}, {0: 1}, {var_y: 1})

    fx = FieldElement(x_val)
    fx2 = fx * fx
    fx3 = fx2 * fx
    fy = fx3 + fx + FieldElement(5)

    witness = [F_ONE, fy, fx, fx2, fx3]
    return builder.r1cs, witness, fy.to_int()


def build_range_proof_circuit(val: int, num_bits: int = 16) -> Tuple[R1CS, List[FieldElement]]:
    builder = CircuitBuilder()
    var_val = builder.allocate_var("range_val", is_public=False)
    bit_vars = [builder.allocate_var(f"b_{i}", is_public=False) for i in range(num_bits)]

    for b in bit_vars:
        builder.enforce_bit(b)

    sum_dict: Dict[int, Union[int, FieldElement]] = {}
    for i, b in enumerate(bit_vars):
        sum_dict[b] = 1 << i
    builder.r1cs.add_constraint(sum_dict, {0: 1}, {var_val: 1})

    bits = [(val >> i) & 1 for i in range(num_bits)]
    witness = [F_ONE, FieldElement(val)] + [FieldElement(b) for b in bits]
    return builder.r1cs, witness


def build_mimc_hash_circuit(
    secret: int, rounds: int = 4, key: int = 0
) -> Tuple[R1CS, List[FieldElement], FieldElement]:
    builder = CircuitBuilder()
    var_out = builder.allocate_var("mimc_digest", is_public=True)
    var_secret = builder.allocate_var("secret_preimage", is_public=False)

    round_constants = [FieldElement(k * 1337 + 42) for k in range(rounds)]
    fe_key = FieldElement(key)

    cur_var = var_secret
    cur_val = FieldElement(secret)
    witness = [F_ONE, F_ZERO, cur_val]

    for r in range(rounds):
        cr = round_constants[r]
        t_val = cur_val + fe_key + cr
        t2_val = t_val * t_val
        t4_val = t2_val * t2_val
        t6_val = t4_val * t2_val
        t7_val = t6_val * t_val

        v_t = builder.allocate_var(f"r{r}_t", is_public=False)
        v_t2 = builder.allocate_var(f"r{r}_t2", is_public=False)
        v_t4 = builder.allocate_var(f"r{r}_t4", is_public=False)
        v_t6 = builder.allocate_var(f"r{r}_t6", is_public=False)
        v_t7 = builder.allocate_var(f"r{r}_t7", is_public=False)

        builder.r1cs.add_constraint({cur_var: 1, 0: (fe_key + cr).to_int()}, {0: 1}, {v_t: 1})
        builder.enforce_mul(v_t, v_t, v_t2)
        builder.enforce_mul(v_t2, v_t2, v_t4)
        builder.enforce_mul(v_t4, v_t2, v_t6)
        builder.enforce_mul(v_t6, v_t, v_t7)

        witness.extend([t_val, t2_val, t4_val, t6_val, t7_val])
        cur_var = v_t7
        cur_val = t7_val

    builder.enforce_eq(cur_var, var_out)
    witness[1] = cur_val
    return builder.r1cs, witness, cur_val


# -----------------------------------------------------------------------------
# 7. Terminal ASCII Art & Visualization
# -----------------------------------------------------------------------------
RESET = "\033[0m"
BOLD = "\033[1m"
GREEN = "\033[32m"
CYAN = "\033[36m"
YELLOW = "\033[33m"
MAGENTA = "\033[35m"
BLUE = "\033[34m"
RED = "\033[31m"
DIM = "\033[2m"


def render_matrix_ascii(A: List[List[FieldElement]], max_rows: int = 12, max_cols: int = 16) -> str:
    m = len(A)
    n = len(A[0]) if m > 0 else 0
    rows = min(m, max_rows)
    cols = min(n, max_cols)

    lines = []
    lines.append(f"{DIM}      ┌" + "──" * cols + "┐" + RESET)
    for r in range(rows):
        row_str = []
        for c in range(cols):
            val = A[r][c].v
            if val == 0:
                row_str.append(f"{DIM}· {RESET}")
            elif val == 1:
                row_str.append(f"{CYAN}1 {RESET}")
            elif val == (PRIME - 1):
                row_str.append(f"{RED}-1{RESET}")
            else:
                row_str.append(f"{YELLOW}* {RESET}")
        suffix = " ..." if cols < n else ""
        lines.append(f"{DIM}{r:3d} │ {RESET}" + "".join(row_str) + f"{DIM}│{suffix}{RESET}")
    if rows < m:
        lines.append(f"{DIM}    : └" + "──" * cols + "┘ (truncated to " + f"{rows}x{cols}" + ")" + RESET)
    else:
        lines.append(f"{DIM}      └" + "──" * cols + "┘" + RESET)
    return "\n".join(lines)


# -----------------------------------------------------------------------------
# 8. Formal Verification Test Suite
# -----------------------------------------------------------------------------
def run_internal_tests() -> bool:
    print(f"{BOLD}{CYAN}🔬 Running zk-SNARK Formal Invariant Test Suite...{RESET}\n")
    tests_passed = 0
    total_tests = 0

    def assert_test(name: str, condition: bool, err_msg: str = ""):
        nonlocal tests_passed, total_tests
        total_tests += 1
        if condition:
            tests_passed += 1
            print(f"  {GREEN}✓{RESET} {name}")
        else:
            print(f"  {RED}✗{RESET} {name}: {err_msg}")

    a = FieldElement(42)
    b = FieldElement(1337)
    assert_test("Field Additive Inverse", (a + (-a)) == 0)
    assert_test("Field Multiplicative Inverse", (a * a.inv()) == 1)
    assert_test("Field Distributivity", a * (b + 10) == (a * b) + (a * 10))
    assert_test("Fermat Little Theorem a^(p-1) == 1", pow(a.v, PRIME - 1, PRIME) == 1)

    P = Polynomial([F_ONE, F_ZERO, F_ZERO, F_ONE])
    D = Polynomial([FieldElement(PRIME - 1), F_ONE])
    Q, R = P.divmod(D)
    assert_test("Polynomial Division (x^3+1) = (x-1)*Q + R", (Q * D + R) == P)
    assert_test("Polynomial Remainder Value at Root", R.eval(1) == P.eval(1))

    pts = [(FieldElement(1), FieldElement(3)), (FieldElement(2), FieldElement(7)), (FieldElement(3), FieldElement(13))]
    poly_interp = Polynomial.interpolate(pts)
    assert_test("Lagrange Interpolation Exact Fit", all(poly_interp.eval(x) == y for x, y in pts))

    r1cs_poly, witness_poly, y_val = build_polynomial_circuit(x_val=3)
    sat, err_idx = r1cs_poly.is_satisfied(witness_poly)
    assert_test("Polynomial R1CS Constraint Satisfaction (x=3 -> y=35)", sat and y_val == 35)

    qap_poly = r1cs_to_qap(r1cs_poly)
    A_p, B_p, C_p, H_p, R_p = compute_qap_polynomials(qap_poly, witness_poly)
    assert_test("QAP Vanishing Remainder R(x) == 0", R_p.is_zero())

    pk, vk = Groth16System.setup(qap_poly, num_public=r1cs_poly.num_public)
    proof = Groth16System.prove(pk, qap_poly, r1cs_poly.num_public, witness_poly)
    public_inputs = [witness_poly[i] for i in range(r1cs_poly.num_public + 1)]
    valid = Groth16System.verify(vk, public_inputs, proof)
    assert_test("Groth16 Valid Proof Verification", valid)

    tampered_proof = Proof(proof.pi_a + 1, proof.pi_b, proof.pi_c)
    assert_test("Soundness: Rejection of Tampered Proof element pi_A", not Groth16System.verify(vk, public_inputs, tampered_proof))

    tampered_public = [public_inputs[0], public_inputs[1] + 1]
    assert_test("Soundness: Rejection of Fake Public Output", not Groth16System.verify(vk, tampered_public, proof))

    r1cs_range, witness_range = build_range_proof_circuit(val=1337, num_bits=16)
    qap_range = r1cs_to_qap(r1cs_range)
    _, _, _, _, R_range = compute_qap_polynomials(qap_range, witness_range)
    assert_test("Range Proof (16-bit Solvency) Invariant", R_range.is_zero())

    r1cs_mimc, witness_mimc, digest = build_mimc_hash_circuit(secret=42, rounds=3)
    qap_mimc = r1cs_to_qap(r1cs_mimc)
    pk_mimc, vk_mimc = Groth16System.setup(qap_mimc, num_public=r1cs_mimc.num_public)
    proof_mimc = Groth16System.prove(pk_mimc, qap_mimc, r1cs_mimc.num_public, witness_mimc)
    pub_mimc = [witness_mimc[0], digest]
    assert_test("MiMC Preimage Zero-Knowledge Verification", Groth16System.verify(vk_mimc, pub_mimc, proof_mimc))

    print(f"\n{BOLD}{GREEN if tests_passed == total_tests else RED}Results: {tests_passed}/{total_tests} tests passed.{RESET}")
    return tests_passed == total_tests


# -----------------------------------------------------------------------------
# 9. Scaling Benchmark
# -----------------------------------------------------------------------------
def run_benchmark():
    print(f"{BOLD}{CYAN}⚡ Benchmarking zk-SNARK Engine Performance & Scaling...{RESET}\n")
    print(f"{'Circuit':<18} | {'Constraints':<12} | {'QAP Setup (s)':<14} | {'Prove (s)':<10} | {'Verify (ms)':<12} | {'Proof Size':<10}")
    print("-" * 84)

    test_configs = [
        ("Poly (x^3+x+5)", 3, lambda: build_polynomial_circuit(7)[:2]),
        ("Range 8-bit", 9, lambda: build_range_proof_circuit(200, 8)),
        ("Range 16-bit", 17, lambda: build_range_proof_circuit(45000, 16)),
        ("MiMC-7 (2 rnd)", 11, lambda: build_mimc_hash_circuit(99, rounds=2)[:2]),
        ("MiMC-7 (4 rnd)", 21, lambda: build_mimc_hash_circuit(99, rounds=4)[:2]),
    ]

    for name, expected_m, gen_func in test_configs:
        r1cs, witness = gen_func()
        m = len(r1cs.constraints)

        t0 = time.perf_counter()
        qap = r1cs_to_qap(r1cs)
        pk, vk = Groth16System.setup(qap, num_public=r1cs.num_public)
        setup_time = time.perf_counter() - t0

        t0 = time.perf_counter()
        proof = Groth16System.prove(pk, qap, r1cs.num_public, witness)
        prove_time = time.perf_counter() - t0

        pub_inputs = [witness[i] for i in range(r1cs.num_public + 1)]
        t0 = time.perf_counter()
        valid = Groth16System.verify(vk, pub_inputs, proof)
        verify_ms = (time.perf_counter() - t0) * 1000.0

        if not valid:
            print(f"{RED}Verification failed for {name}!{RESET}")
            return

        print(f"{name:<18} | {m:<12} | {setup_time:<14.4f} | {prove_time:<10.4f} | {verify_ms:<12.2f} | 3 elements (96 B)")

    print(f"\n{GREEN}✓ Benchmark completed successfully. Verification latency is strictly O(1) in sub-millisecond range.{RESET}")


# -----------------------------------------------------------------------------
# 10. CLI Dispatcher
# -----------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(
        prog="zksnark",
        description="Zero-Knowledge SNARK & R1CS-to-QAP Arithmetic Circuit Verification Engine",
    )
    subparsers = parser.add_subparsers(dest="command", help="Subcommands")

    subparsers.add_parser("info", help="Theoretical foundations & protocol overview")
    subparsers.add_parser("test", help="Run formal invariant tests")
    subparsers.add_parser("benchmark", help="Run scaling benchmarks across circuit families")

    p_comp = subparsers.add_parser("compile", help="Compile arithmetic circuit to R1CS matrices")
    p_comp.add_argument("--circuit", choices=["poly", "mimc", "range"], default="poly")
    p_comp.add_argument("--input", type=int, default=3, help="Input value (x for poly, secret for mimc, value for range)")

    p_qap = subparsers.add_parser("qap", help="Execute QAP reduction and quotient polynomial division")
    p_qap.add_argument("--circuit", choices=["poly", "mimc", "range"], default="poly")
    p_qap.add_argument("--input", type=int, default=3)

    p_mimc = subparsers.add_parser("mimc", help="Zero-knowledge proof of knowledge of MiMC hash preimage")
    p_mimc.add_argument("--secret", type=int, default=42, help="Private preimage")
    p_mimc.add_argument("--rounds", type=int, default=4, help="Number of permutation rounds")

    p_range = subparsers.add_parser("range", help="Zero-knowledge range / solvency proof")
    p_range.add_argument("--value", type=int, default=1337, help="Private balance/value")
    p_range.add_argument("--bits", type=int, default=16, help="Range upper bound bit length (2^bits)")

    args = parser.parse_args()

    if args.command == "info":
        print(f"{BOLD}{CYAN}⚡ Zero-Knowledge SNARK & R1CS-to-QAP Engine (Groth16){RESET}\n")
        print("Theoretical Architecture:")
        print("1. Rank-1 Constraint System (R1CS): (A . w) * (B . w) = (C . w)")
        print("2. Quadratic Arithmetic Program (QAP):")
        print("   - Lagrange interpolation over roots of unity r_1, ..., r_m")
        print("   - Target vanishing polynomial: T(x) = prod_{k=1}^m (x - r_k)")
        print("   - Identity: P(x) = A(x)*B(x) - C(x) = H(x)*T(x) + R(x)")
        print("   - Remainder R(x) == 0 strictly proves all constraints are satisfied.")
        print("3. Groth16 Succinct Pairing-Based Verification:")
        print("   - Prover blinding with random scalars (r, s) ensures zero-knowledge.")
        print("   - Proof size: exactly 3 group elements (pi_A, pi_B, pi_C).")
        print("   - Verification equation in F_p / G_T:")
        print("       pi_A * pi_B = alpha * beta + K_pub * gamma + pi_C * delta\n")
        print("Available Circuits: Polynomial (x^3+x+5), MiMC-7 Hash Preimage, Bit-Decomposition Range Proof.")

    elif args.command == "test":
        success = run_internal_tests()
        sys.exit(0 if success else 1)

    elif args.command == "benchmark":
        run_benchmark()

    elif args.command == "compile":
        print(f"{BOLD}{CYAN}📐 Compiling Circuit: {args.circuit.upper()}{RESET}")
        if args.circuit == "poly":
            r1cs, witness, y_val = build_polynomial_circuit(args.input)
            print(f"Formula: x^3 + x + 5 = y (x={args.input} -> y={y_val})")
        elif args.circuit == "mimc":
            r1cs, witness, digest = build_mimc_hash_circuit(secret=args.input, rounds=4)
            print(f"MiMC-7 Permutation (4 rounds): Digest = {digest.to_hex()[:18]}...")
        else:
            r1cs, witness = build_range_proof_circuit(val=args.input, num_bits=16)
            print(f"Range Proof: val={args.input} in [0, 2^16-1]")

        A, B, C = r1cs.to_matrices()
        print(f"Variables: {r1cs.num_variables} (Public: {r1cs.num_public}, Private: {r1cs.num_variables - r1cs.num_public - 1})")
        print(f"Constraints: {len(r1cs.constraints)}")
        print("\nMatrix A Sparsity Pattern:")
        print(render_matrix_ascii(A))

    elif args.command == "qap":
        print(f"{BOLD}{CYAN}🔬 QAP Reduction & Polynomial Division: {args.circuit.upper()}{RESET}")
        if args.circuit == "poly":
            r1cs, witness, y_val = build_polynomial_circuit(args.input)
        elif args.circuit == "mimc":
            r1cs, witness, _ = build_mimc_hash_circuit(secret=args.input, rounds=4)
        else:
            r1cs, witness = build_range_proof_circuit(val=args.input, num_bits=16)

        qap = r1cs_to_qap(r1cs)
        print(f"Roots of Unity Count: {len(qap.roots)}")
        print(f"Target Polynomial deg(T): {qap.target_poly.deg()}")

        A_p, B_p, C_p, H_p, R_p = compute_qap_polynomials(qap, witness)
        print(f"Quotient Polynomial deg(H): {H_p.deg()}")
        print(f"Remainder Polynomial deg(R): {R_p.deg()} (Is Zero: {R_p.is_zero()})")
        if R_p.is_zero():
            print(f"{GREEN}✓ Soundness Verified: T(x) divides A(x)*B(x) - C(x) with ZERO remainder.{RESET}")
        else:
            print(f"{RED}✗ Constraint Violation! Remainder is non-zero.{RESET}")

    elif args.command == "mimc":
        print(f"{BOLD}{CYAN}🔐 Zero-Knowledge MiMC-7 Hash Preimage Proof{RESET}")
        print(f"Prover claims knowledge of secret preimage 's' such that MiMC_7(s) = digest without revealing 's'.")
        r1cs, witness, digest = build_mimc_hash_circuit(secret=args.secret, rounds=args.rounds)
        print(f"Secret Preimage (Private): {args.secret}")
        print(f"Target Digest (Public):   {digest.to_hex()}")

        qap = r1cs_to_qap(r1cs)
        pk, vk = Groth16System.setup(qap, num_public=r1cs.num_public)
        proof = Groth16System.prove(pk, qap, r1cs.num_public, witness)
        print(f"\n{MAGENTA}Generated Succinct Proof (96 bytes):{RESET}")
        print(f"  pi_A: {proof.pi_a.to_hex()[:26]}...")
        print(f"  pi_B: {proof.pi_b.to_hex()[:26]}...")
        print(f"  pi_C: {proof.pi_c.to_hex()[:26]}...")

        public_inputs = [witness[0], digest]
        valid = Groth16System.verify(vk, public_inputs, proof)
        if valid:
            print(f"\n{GREEN}✓ Verifier Verdict: VALID PROOF! Preimage knowledge proven with ZERO information leakage.{RESET}")
        else:
            print(f"\n{RED}✗ Verifier Verdict: INVALID PROOF!{RESET}")

    elif args.command == "range":
        print(f"{BOLD}{CYAN}💰 Zero-Knowledge Range & Solvency Proof{RESET}")
        print(f"Prover claims balance v is in range [0, 2^{args.bits}-1] without revealing v.")
        r1cs, witness = build_range_proof_circuit(val=args.value, num_bits=args.bits)
        print(f"Value (Private): {args.value}")
        print(f"Range Bound:     [0, {(1 << args.bits) - 1}]")

        qap = r1cs_to_qap(r1cs)
        pk, vk = Groth16System.setup(qap, num_public=r1cs.num_public)
        proof = Groth16System.prove(pk, qap, r1cs.num_public, witness)
        public_inputs = [witness[0]]
        valid = Groth16System.verify(vk, public_inputs, proof)
        if valid:
            print(f"\n{GREEN}✓ Verifier Verdict: VALID! Value strictly satisfies non-negative {args.bits}-bit range constraint.{RESET}")
        else:
            print(f"{RED}✗ Verifier Verdict: INVALID!{RESET}")
    else:
        parser.print_help()


if __name__ == '__main__':
    main()
