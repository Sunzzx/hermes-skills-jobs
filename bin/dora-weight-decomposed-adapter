#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""DoRA: Weight-Decomposed Low-Rank Adaptation Engine.

Paper: Liu, Feng, Svoboda, et al. (NVIDIA) —
  "DoRA: Weight-Decomposed Low-Rank Adaptation"
  (ICML 2024, arXiv:2402.09353).
Official: https://github.com/NVlabs/DoRA

Core idea
---------
Standard LoRA reparameterizes ΔW = BA and adds it to a frozen base W0:

    W = W0 + BA

This couples magnitude and direction updates inside the same low-rank
subspace, which empirically underfits full fine-tuning (FT) learning
dynamics. DoRA decomposes every weight matrix into *magnitude* and
*direction* and applies LoRA only to the direction:

    W0 = m ⊙ (V / ||V||_c)          # column-wise unit direction
    V  = W0 + BA                    # LoRA on direction (frozen W0 + BA)
    W' = m ⊙ (V / ||V||_c)          # re-compose with trainable m

where ||·||_c is the per-column Euclidean norm and ⊙ is column-wise
broadcast scale. At init, m ← ||W0||_c and BA ← 0 so W' ≡ W0 (zero
delta). Magnitude m is a D_out-vector (column norms); direction lives
on the unit hypersphere so the adapter only learns angular updates —
matching FT's ability to independently reweight columns while staying
PEFT-cheap (same BA params as LoRA + |m|).

This pure-Python reference (zero third-party deps) implements:

  * dense matrix helpers (matmul, transpose, frobenius, column norms)
  * weight decomposition / recomposition with numerical guards
  * LoRA, DoRA, and full-FT AdamW trainers on a linear regression task
  * gradient magnitude/direction split analysis (paper Fig. 2 intuition)
  * rank ablation, PEFT param ledger, LLaMA-scale theory tables
  * CLI: status | decompose | recompose | step | train | ablate
          | benchmark | verify | pack | theory | analyze

License: MIT — Hermes Autonomous Evolution Engine
"""

from __future__ import annotations

import argparse
import json
import math
import random
import sys
import time
from dataclasses import dataclass
from typing import Any, Dict, List, Optional, Sequence, Tuple

Matrix = List[List[float]]
Vector = List[float]

EPS = 1e-8


# ---------------------------------------------------------------------------
# Numeric helpers
# ---------------------------------------------------------------------------

def _zeros(m: int, n: int) -> Matrix:
    return [[0.0] * n for _ in range(m)]


def _zeros_vec(n: int) -> Vector:
    return [0.0] * n


def _eye(n: int) -> Matrix:
    return [[1.0 if i == j else 0.0 for j in range(n)] for i in range(n)]


def _shape(A: Matrix) -> Tuple[int, int]:
    return len(A), (len(A[0]) if A else 0)


def _deepcopy_mat(A: Matrix) -> Matrix:
    return [row[:] for row in A]


def _transpose(A: Matrix) -> Matrix:
    m, n = _shape(A)
    return [[A[i][j] for i in range(m)] for j in range(n)]


def _matmul(A: Matrix, B: Matrix) -> Matrix:
    m, k = _shape(A)
    k2, n = _shape(B)
    if k != k2:
        raise ValueError(f"matmul shape mismatch: {m}x{k} @ {k2}x{n}")
    out = _zeros(m, n)
    for i in range(m):
        Ai = A[i]
        for t in range(k):
            a = Ai[t]
            if a == 0.0:
                continue
            Bt = B[t]
            oi = out[i]
            for j in range(n):
                oi[j] += a * Bt[j]
    return out


def _add(A: Matrix, B: Matrix, alpha: float = 1.0, beta: float = 1.0) -> Matrix:
    m, n = _shape(A)
    return [[alpha * A[i][j] + beta * B[i][j] for j in range(n)] for i in range(m)]


def _scale(A: Matrix, s: float) -> Matrix:
    return [[s * v for v in row] for row in A]


def _frobenius(A: Matrix) -> float:
    return math.sqrt(sum(v * v for row in A for v in row))


def _mse_mat(A: Matrix, B: Matrix) -> float:
    m, n = _shape(A)
    s = 0.0
    for i in range(m):
        for j in range(n):
            d = A[i][j] - B[i][j]
            s += d * d
    return s / max(1, m * n)


def _cosine_mat(A: Matrix, B: Matrix) -> float:
    dot = na = nb = 0.0
    m, n = _shape(A)
    for i in range(m):
        for j in range(n):
            a = A[i][j]
            b = B[i][j]
            dot += a * b
            na += a * a
            nb += b * b
    denom = math.sqrt(na) * math.sqrt(nb)
    if denom < 1e-18:
        return 0.0
    return dot / denom


def _rand_gauss(m: int, n: int, seed: int = 0, scale: float = 1.0) -> Matrix:
    rng = random.Random(seed)
    return [[rng.gauss(0.0, scale) for _ in range(n)] for _ in range(m)]


def _std(xs: Sequence[float]) -> float:
    if not xs:
        return 0.0
    mu = sum(xs) / len(xs)
    var = sum((x - mu) ** 2 for x in xs) / len(xs)
    return math.sqrt(var)


# ---------------------------------------------------------------------------
# DoRA decomposition primitives
# ---------------------------------------------------------------------------

def column_norms(W: Matrix) -> Vector:
    m, n = _shape(W)
    norms = _zeros_vec(n)
    for j in range(n):
        s = 0.0
        for i in range(m):
            v = W[i][j]
            s += v * v
        norms[j] = math.sqrt(s)
    return norms


def normalize_columns(W: Matrix, eps: float = EPS) -> Tuple[Matrix, Vector]:
    m_rows, n = _shape(W)
    mag = column_norms(W)
    V = _zeros(m_rows, n)
    for j in range(n):
        scale = 1.0 / max(mag[j], eps)
        for i in range(m_rows):
            V[i][j] = W[i][j] * scale
    return V, mag


def recompose(magnitude: Vector, direction: Matrix, eps: float = EPS) -> Matrix:
    m_rows, n = _shape(direction)
    if len(magnitude) != n:
        raise ValueError(f"magnitude length {len(magnitude)} != n_cols {n}")
    col_n = column_norms(direction)
    W = _zeros(m_rows, n)
    for j in range(n):
        inv = 1.0 / max(col_n[j], eps)
        mj = magnitude[j]
        for i in range(m_rows):
            W[i][j] = mj * direction[i][j] * inv
    return W


def decompose_weight(W: Matrix, eps: float = EPS) -> Dict[str, Any]:
    V, mag = normalize_columns(W, eps=eps)
    W_hat = recompose(mag, V, eps=eps)
    return {
        "shape": list(_shape(W)),
        "magnitude": mag,
        "direction": V,
        "recon_mse": _mse_mat(W, W_hat),
        "recon_cosine": _cosine_mat(W, W_hat),
        "frobenius": _frobenius(W),
        "mag_mean": sum(mag) / max(1, len(mag)),
        "mag_std": _std(mag),
        "mag_min": min(mag) if mag else 0.0,
        "mag_max": max(mag) if mag else 0.0,
    }


def lora_delta(B: Matrix, A: Matrix) -> Matrix:
    return _matmul(B, A)


def effective_weight_lora(W0: Matrix, B: Matrix, A: Matrix, alpha: float = 1.0) -> Matrix:
    dW = lora_delta(B, A)
    return _add(W0, dW, alpha=1.0, beta=alpha)


def effective_weight_dora(
    W0: Matrix,
    B: Matrix,
    A: Matrix,
    magnitude: Vector,
    alpha: float = 1.0,
    eps: float = EPS,
) -> Matrix:
    V = effective_weight_lora(W0, B, A, alpha=alpha)
    return recompose(magnitude, V, eps=eps)


def split_grad_mag_dir(W: Matrix, G: Matrix, eps: float = EPS) -> Dict[str, float]:
    m_rows, n = _shape(W)
    V, _mag = normalize_columns(W, eps=eps)
    mag_energy = 0.0
    dir_energy = 0.0
    total = 0.0
    for j in range(n):
        g_dot_u = 0.0
        g_norm2 = 0.0
        for i in range(m_rows):
            g = G[i][j]
            u = V[i][j]
            g_dot_u += g * u
            g_norm2 += g * g
        total += g_norm2
        mag_energy += g_dot_u * g_dot_u
        for i in range(m_rows):
            r = G[i][j] - g_dot_u * V[i][j]
            dir_energy += r * r
    tot = max(total, eps)
    return {
        "grad_frobenius": math.sqrt(total),
        "magnitude_energy": mag_energy,
        "direction_energy": dir_energy,
        "magnitude_frac": mag_energy / tot,
        "direction_frac": dir_energy / tot,
    }


# ---------------------------------------------------------------------------
# AdamW
# ---------------------------------------------------------------------------

@dataclass
class AdamConfig:
    lr: float = 0.05
    beta1: float = 0.9
    beta2: float = 0.999
    eps: float = 1e-8
    weight_decay: float = 0.0


class AdamWMat:
    def __init__(self, rows: int, cols: int, cfg: AdamConfig):
        self.cfg = cfg
        self.m = _zeros(rows, cols)
        self.v = _zeros(rows, cols)
        self.t = 0

    def step(self, W: Matrix, G: Matrix) -> None:
        cfg = self.cfg
        self.t += 1
        b1t = 1.0 - cfg.beta1 ** self.t
        b2t = 1.0 - cfg.beta2 ** self.t
        rows, cols = _shape(W)
        for i in range(rows):
            for j in range(cols):
                g = G[i][j]
                self.m[i][j] = cfg.beta1 * self.m[i][j] + (1.0 - cfg.beta1) * g
                self.v[i][j] = cfg.beta2 * self.v[i][j] + (1.0 - cfg.beta2) * (g * g)
                mhat = self.m[i][j] / b1t
                vhat = self.v[i][j] / b2t
                upd = mhat / (math.sqrt(vhat) + cfg.eps)
                if cfg.weight_decay:
                    W[i][j] *= 1.0 - cfg.lr * cfg.weight_decay
                W[i][j] -= cfg.lr * upd


class AdamWVec:
    def __init__(self, n: int, cfg: AdamConfig):
        self.cfg = cfg
        self.m = _zeros_vec(n)
        self.v = _zeros_vec(n)
        self.t = 0

    def step(self, w: Vector, g: Vector) -> None:
        cfg = self.cfg
        self.t += 1
        b1t = 1.0 - cfg.beta1 ** self.t
        b2t = 1.0 - cfg.beta2 ** self.t
        for i in range(len(w)):
            gi = g[i]
            self.m[i] = cfg.beta1 * self.m[i] + (1.0 - cfg.beta1) * gi
            self.v[i] = cfg.beta2 * self.v[i] + (1.0 - cfg.beta2) * (gi * gi)
            mhat = self.m[i] / b1t
            vhat = self.v[i] / b2t
            upd = mhat / (math.sqrt(vhat) + cfg.eps)
            if cfg.weight_decay:
                w[i] *= 1.0 - cfg.lr * cfg.weight_decay
            w[i] -= cfg.lr * upd


# ---------------------------------------------------------------------------
# Linear regression task
# ---------------------------------------------------------------------------

@dataclass
class LinearRegressionTask:
    X: Matrix
    Y: Matrix
    W_true: Matrix

    @staticmethod
    def create(
        m: int = 16,
        n: int = 20,
        batch: int = 32,
        seed: int = 0,
        noise: float = 0.05,
        rank_true: Optional[int] = None,
    ) -> "LinearRegressionTask":
        rng = random.Random(seed)
        if rank_true and rank_true < min(m, n):
            U = [[rng.gauss(0, 1) for _ in range(rank_true)] for _ in range(m)]
            V = [[rng.gauss(0, 1) for _ in range(n)] for _ in range(rank_true)]
            W_true = _matmul(U, V)
            fr = _frobenius(W_true)
            if fr > 1e-12:
                W_true = _scale(W_true, 1.0 / fr * math.sqrt(m * n) * 0.5)
        else:
            W_true = [[rng.gauss(0, 0.5) for _ in range(n)] for _ in range(m)]
        X = [[rng.gauss(0, 1) for _ in range(batch)] for _ in range(n)]
        Y_clean = _matmul(W_true, X)
        Y = [
            [Y_clean[i][j] + rng.gauss(0, noise) for j in range(batch)]
            for i in range(m)
        ]
        return LinearRegressionTask(X=X, Y=Y, W_true=W_true)

    def loss_grad(self, W: Matrix) -> Tuple[float, Matrix]:
        pred = _matmul(W, self.X)
        m, b = _shape(pred)
        resid = _add(pred, self.Y, alpha=1.0, beta=-1.0)
        loss = 0.5 * sum(v * v for row in resid for v in row) / max(1, m * b)
        XT = _transpose(self.X)
        G = _scale(_matmul(resid, XT), 1.0 / max(1, b))
        return loss, G


# ---------------------------------------------------------------------------
# Trainers
# ---------------------------------------------------------------------------

@dataclass
class DoRAConfig:
    rank: int = 4
    alpha: float = 1.0
    seed: int = 0
    lora_init_scale: float = 0.02
    eps: float = EPS


def _init_lora(m: int, n: int, rank: int, seed: int, scale: float) -> Tuple[Matrix, Matrix]:
    rng = random.Random(seed)
    B = [[0.0 for _ in range(rank)] for _ in range(m)]
    A = [[rng.gauss(0.0, scale) for _ in range(n)] for _ in range(rank)]
    return B, A


class FullFTTrainer:
    def __init__(self, W_init: Matrix, adam: AdamConfig):
        self.W = _deepcopy_mat(W_init)
        self.opt = AdamWMat(_shape(W_init)[0], _shape(W_init)[1], adam)

    def step(self, task: LinearRegressionTask) -> float:
        loss, G = task.loss_grad(self.W)
        self.opt.step(self.W, G)
        return loss

    def weight(self) -> Matrix:
        return self.W

    def n_trainable(self) -> int:
        m, n = _shape(self.W)
        return m * n


class LoRATrainer:
    def __init__(self, W0: Matrix, cfg: DoRAConfig, adam: AdamConfig):
        self.W0 = _deepcopy_mat(W0)
        m, n = _shape(W0)
        self.cfg = cfg
        self.B, self.A = _init_lora(m, n, cfg.rank, cfg.seed, cfg.lora_init_scale)
        self.opt_B = AdamWMat(m, cfg.rank, adam)
        self.opt_A = AdamWMat(cfg.rank, n, adam)

    def weight(self) -> Matrix:
        return effective_weight_lora(self.W0, self.B, self.A, alpha=self.cfg.alpha)

    def step(self, task: LinearRegressionTask) -> float:
        W = self.weight()
        loss, G = task.loss_grad(W)
        alpha = self.cfg.alpha
        gB = _scale(_matmul(G, _transpose(self.A)), alpha)
        gA = _scale(_matmul(_transpose(self.B), G), alpha)
        self.opt_B.step(self.B, gB)
        self.opt_A.step(self.A, gA)
        return loss

    def n_trainable(self) -> int:
        m, r = _shape(self.B)
        r2, n = _shape(self.A)
        return m * r + r2 * n


class DoRATrainer:
    def __init__(self, W0: Matrix, cfg: DoRAConfig, adam: AdamConfig):
        self.W0 = _deepcopy_mat(W0)
        m, n = _shape(W0)
        self.cfg = cfg
        self.B, self.A = _init_lora(m, n, cfg.rank, cfg.seed + 1, cfg.lora_init_scale)
        _, self.magnitude = normalize_columns(W0, eps=cfg.eps)
        self.opt_B = AdamWMat(m, cfg.rank, adam)
        self.opt_A = AdamWMat(cfg.rank, n, adam)
        self.opt_m = AdamWVec(n, adam)

    def weight(self) -> Matrix:
        return effective_weight_dora(
            self.W0, self.B, self.A, self.magnitude,
            alpha=self.cfg.alpha, eps=self.cfg.eps,
        )

    def step(self, task: LinearRegressionTask) -> float:
        cfg = self.cfg
        V_raw = effective_weight_lora(self.W0, self.B, self.A, alpha=cfg.alpha)
        col_n = column_norms(V_raw)
        m_rows, n = _shape(V_raw)
        U = _zeros(m_rows, n)
        for j in range(n):
            inv = 1.0 / max(col_n[j], cfg.eps)
            for i in range(m_rows):
                U[i][j] = V_raw[i][j] * inv
        W = _zeros(m_rows, n)
        for j in range(n):
            mj = self.magnitude[j]
            for i in range(m_rows):
                W[i][j] = mj * U[i][j]

        loss, G = task.loss_grad(W)

        g_m = _zeros_vec(n)
        gV = _zeros(m_rows, n)
        for j in range(n):
            dot = 0.0
            for i in range(m_rows):
                dot += G[i][j] * U[i][j]
            g_m[j] = dot
            mj = self.magnitude[j]
            inv_n = 1.0 / max(col_n[j], cfg.eps)
            for i in range(m_rows):
                tangent = G[i][j] - dot * U[i][j]
                gV[i][j] = mj * inv_n * tangent

        alpha = cfg.alpha
        gB = _scale(_matmul(gV, _transpose(self.A)), alpha)
        gA = _scale(_matmul(_transpose(self.B), gV), alpha)

        self.opt_m.step(self.magnitude, g_m)
        self.opt_B.step(self.B, gB)
        self.opt_A.step(self.A, gA)
        for j in range(n):
            if self.magnitude[j] < cfg.eps:
                self.magnitude[j] = cfg.eps
        return loss

    def n_trainable(self) -> int:
        m, r = _shape(self.B)
        r2, n = _shape(self.A)
        return m * r + r2 * n + n


# ---------------------------------------------------------------------------
# PEFT theory
# ---------------------------------------------------------------------------

def peft_param_ledger(m: int, n: int, rank: int) -> Dict[str, Any]:
    full = m * n
    lora = m * rank + rank * n
    dora = lora + n
    return {
        "rows": m,
        "cols": n,
        "rank": rank,
        "full_ft_params": full,
        "lora_params": lora,
        "dora_params": dora,
        "lora_vs_full_pct": 100.0 * lora / max(1, full),
        "dora_vs_full_pct": 100.0 * dora / max(1, full),
        "dora_overhead_vs_lora_pct": 100.0 * n / max(1, lora),
        "dora_extra_params": n,
    }


def theory_report(rank: int = 16, bytes_per: int = 2) -> Dict[str, Any]:
    layers = [
        ("attn_q", 4096, 4096),
        ("attn_k", 4096, 4096),
        ("attn_v", 4096, 4096),
        ("attn_o", 4096, 4096),
        ("mlp_up", 11008, 4096),
        ("mlp_gate", 11008, 4096),
        ("mlp_down", 4096, 11008),
    ]
    n_layers = 32
    full = lora = dora = 0
    per_layer = []
    for name, m, n in layers:
        led = peft_param_ledger(m, n, rank)
        per_layer.append({"name": name, **led})
        full += led["full_ft_params"]
        lora += led["lora_params"]
        dora += led["dora_params"]
    full *= n_layers
    lora *= n_layers
    dora *= n_layers
    return {
        "model": "LLaMA-7B-shaped (32 layers)",
        "rank": rank,
        "bytes_per_param": bytes_per,
        "full_ft_params": full,
        "lora_params": lora,
        "dora_params": dora,
        "lora_vs_full_pct": 100.0 * lora / max(1, full),
        "dora_vs_full_pct": 100.0 * dora / max(1, full),
        "dora_overhead_vs_lora_pct": 100.0 * (dora - lora) / max(1, lora),
        "lora_adapter_mib": lora * bytes_per / (1024 * 1024),
        "dora_adapter_mib": dora * bytes_per / (1024 * 1024),
        "full_ft_gib": full * bytes_per / (1024 ** 3),
        "per_layer_sample": per_layer[:3],
    }


# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------

class DoRAEngine:
    def status(self, m: int = 32, n: int = 40, rank: int = 4, seed: int = 0) -> Dict[str, Any]:
        task = LinearRegressionTask.create(m=m, n=n, batch=24, seed=seed)
        W0 = _rand_gauss(m, n, seed=seed + 7, scale=0.3)
        dec = decompose_weight(W0)
        led = peft_param_ledger(m, n, rank)
        cfg = DoRAConfig(rank=rank, seed=seed)
        adam = AdamConfig(lr=0.05)
        dora = DoRATrainer(W0, cfg, adam)
        loss0, _ = task.loss_grad(dora.weight())
        return {
            "ok": True,
            "engine": "dora-weight-decomposed-adapter",
            "paper": "ICML 2024 arXiv:2402.09353",
            "shape": [m, n],
            "rank": rank,
            "init_loss": loss0,
            "recon_mse": dec["recon_mse"],
            "recon_cosine": dec["recon_cosine"],
            "mag_mean": dec["mag_mean"],
            "peft": led,
            "trainable_dora": dora.n_trainable(),
            "trainable_lora": LoRATrainer(W0, cfg, adam).n_trainable(),
            "trainable_full": m * n,
        }

    def decompose_once(self, m: int = 24, n: int = 32, seed: int = 0) -> Dict[str, Any]:
        W = _rand_gauss(m, n, seed=seed, scale=0.8)
        dec = decompose_weight(W)
        W2 = recompose(dec["magnitude"], dec["direction"])
        return {
            "shape": [m, n],
            "recon_mse": _mse_mat(W, W2),
            "recon_cosine": _cosine_mat(W, W2),
            "mag_mean": dec["mag_mean"],
            "mag_std": dec["mag_std"],
            "mag_min": dec["mag_min"],
            "mag_max": dec["mag_max"],
            "frobenius": dec["frobenius"],
            "ok": _mse_mat(W, W2) < 1e-12,
        }

    def analyze_grad(self, m: int = 20, n: int = 28, seed: int = 0) -> Dict[str, Any]:
        task = LinearRegressionTask.create(m=m, n=n, batch=16, seed=seed)
        W = _rand_gauss(m, n, seed=seed + 3, scale=0.4)
        _, G = task.loss_grad(W)
        split = split_grad_mag_dir(W, G)
        return {"ok": True, "shape": [m, n], **split}

    def step_once(
        self, m: int = 16, n: int = 20, rank: int = 4, seed: int = 0,
        method: str = "dora", lr: float = 0.05,
    ) -> Dict[str, Any]:
        task = LinearRegressionTask.create(m=m, n=n, batch=16, seed=seed)
        W0 = _rand_gauss(m, n, seed=seed + 1, scale=0.25)
        cfg = DoRAConfig(rank=rank, seed=seed)
        adam = AdamConfig(lr=lr)
        if method == "dora":
            tr: Any = DoRATrainer(W0, cfg, adam)
        elif method == "lora":
            tr = LoRATrainer(W0, cfg, adam)
        elif method == "full":
            tr = FullFTTrainer(W0, adam)
        else:
            raise ValueError(method)
        loss0 = task.loss_grad(tr.weight())[0]
        loss1 = tr.step(task)
        loss2 = task.loss_grad(tr.weight())[0]
        return {
            "method": method,
            "loss_before": loss0,
            "loss_after_step_eval": loss1,
            "loss_after": loss2,
            "decreased": loss2 <= loss0 + 1e-9,
            "n_trainable": tr.n_trainable(),
        }

    def train(
        self, m: int = 16, n: int = 20, rank: int = 4, steps: int = 40,
        seed: int = 0, method: str = "dora", lr: float = 0.05, batch: int = 24,
    ) -> Dict[str, Any]:
        task = LinearRegressionTask.create(m=m, n=n, batch=batch, seed=seed)
        W0 = _rand_gauss(m, n, seed=seed + 11, scale=0.2)
        cfg = DoRAConfig(rank=rank, seed=seed)
        adam = AdamConfig(lr=lr)
        if method == "dora":
            tr: Any = DoRATrainer(W0, cfg, adam)
        elif method == "lora":
            tr = LoRATrainer(W0, cfg, adam)
        elif method == "full":
            tr = FullFTTrainer(W0, adam)
        else:
            raise ValueError(method)
        losses = []
        t0 = time.perf_counter()
        for _ in range(steps):
            losses.append(tr.step(task))
        elapsed = (time.perf_counter() - t0) * 1000.0
        final = task.loss_grad(tr.weight())[0]
        Wf = tr.weight()
        return {
            "method": method,
            "steps": steps,
            "rank": rank,
            "init_loss": losses[0] if losses else None,
            "final_loss": final,
            "best_loss": min(losses) if losses else None,
            "mse_to_true": _mse_mat(Wf, task.W_true),
            "cosine_to_true": _cosine_mat(Wf, task.W_true),
            "n_trainable": tr.n_trainable(),
            "elapsed_ms": elapsed,
            "ok": final < (losses[0] if losses else 1e9),
        }

    def ablate(
        self, m: int = 14, n: int = 18, rank: int = 4, steps: int = 35,
        seed: int = 0, lr: float = 0.05,
    ) -> Dict[str, Any]:
        results = {}
        for method in ("full", "lora", "dora"):
            results[method] = self.train(
                m=m, n=n, rank=rank, steps=steps, seed=seed, method=method, lr=lr,
            )
        ranking = sorted(results.keys(), key=lambda k: results[k]["final_loss"])
        return {
            "ok": True,
            "results": {
                k: {
                    "final_loss": results[k]["final_loss"],
                    "init_loss": results[k]["init_loss"],
                    "cosine_to_true": results[k]["cosine_to_true"],
                    "n_trainable": results[k]["n_trainable"],
                }
                for k in results
            },
            "ranking": ranking,
            "winner": ranking[0],
        }

    def benchmark(
        self, dims: Sequence[int] = (12, 16, 24), ranks: Sequence[int] = (2, 4, 8),
        steps: int = 25, seed: int = 0,
    ) -> Dict[str, Any]:
        rows = []
        for d in dims:
            for r in ranks:
                if r >= d:
                    continue
                out = self.train(
                    m=d, n=d + 4, rank=r, steps=steps, seed=seed + d + r,
                    method="dora", lr=0.06,
                )
                rows.append({
                    "dim": d,
                    "rank": r,
                    "final_loss": out["final_loss"],
                    "init_loss": out["init_loss"],
                    "elapsed_ms": out["elapsed_ms"],
                    "n_trainable": out["n_trainable"],
                    "reduction_pct": 100.0 * (1.0 - out["final_loss"] / max(out["init_loss"], 1e-12)),
                })
        return {"ok": True, "rows": rows, "n": len(rows)}

    def verify(self, trials: int = 3, seed: int = 0) -> Dict[str, Any]:
        checks = []
        for t in range(trials):
            d = self.decompose_once(m=16 + t, n=20 + t, seed=seed + t)
            checks.append(("recon_identity", d["ok"], d["recon_mse"]))

        W0 = _rand_gauss(12, 16, seed=seed + 99, scale=0.5)
        cfg = DoRAConfig(rank=3, seed=seed)
        tr = DoRATrainer(W0, cfg, AdamConfig(lr=0.01))
        mse0 = _mse_mat(tr.weight(), W0)
        checks.append(("dora_init_zero_delta", mse0 < 1e-10, mse0))

        ltr = LoRATrainer(W0, cfg, AdamConfig(lr=0.01))
        mse_l = _mse_mat(ltr.weight(), W0)
        checks.append(("lora_init_zero_delta", mse_l < 1e-18, mse_l))

        for method in ("dora", "lora", "full"):
            out = self.train(
                m=12, n=14, rank=3, steps=30, seed=seed + 3, method=method, lr=0.08,
            )
            ok = out["final_loss"] < out["init_loss"] * 0.95
            checks.append((f"train_decreases_{method}", ok, out["final_loss"]))

        led = peft_param_ledger(64, 64, 8)
        ok_p = led["dora_params"] == led["lora_params"] + 64
        checks.append(("param_overhead_is_n", ok_p, led["dora_params"]))

        sp = self.analyze_grad(m=18, n=22, seed=seed + 5)
        sfrac = sp["magnitude_frac"] + sp["direction_frac"]
        checks.append(("grad_split_unit", abs(sfrac - 1.0) < 1e-6, sfrac))

        th = theory_report(rank=16)
        checks.append(("theory_peft_saving", th["dora_vs_full_pct"] < 5.0, th["dora_vs_full_pct"]))

        st = self.step_once(m=10, n=12, rank=2, seed=seed + 8, method="dora")
        checks.append(("step_finite", math.isfinite(st["loss_after"]), st["loss_after"]))

        n_pass = sum(1 for _, ok, _ in checks if ok)
        return {
            "ok": n_pass == len(checks),
            "n_pass": n_pass,
            "n_total": len(checks),
            "checks": [{"name": n, "pass": ok, "value": v} for n, ok, v in checks],
        }

    def pack(self, m: int = 32, n: int = 48, rank: int = 8, seed: int = 0) -> Dict[str, Any]:
        st = self.status(m=m, n=n, rank=rank, seed=seed)
        th = theory_report(rank=rank)
        ab = self.ablate(m=min(m, 16), n=min(n, 20), rank=min(rank, 4), steps=20, seed=seed)
        return {
            "engine": "dora-weight-decomposed-adapter",
            "paper": "ICML 2024 arXiv:2402.09353",
            "status": st,
            "theory": th,
            "ablate_winner": ab["winner"],
            "ablate": ab["results"],
        }


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _pp(obj: Any) -> None:
    print(json.dumps(obj, indent=2, sort_keys=True))


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="dora-weight-decomposed-adapter",
        description=(
            "DoRA: Weight-Decomposed Low-Rank Adaptation "
            "(ICML 2024, arXiv:2402.09353) — pure-Python reference"
        ),
    )
    sub = p.add_subparsers(dest="cmd")

    def add_common(sp: argparse.ArgumentParser) -> None:
        sp.add_argument("--rows", type=int, default=24)
        sp.add_argument("--cols", type=int, default=32)
        sp.add_argument("--rank", type=int, default=4)
        sp.add_argument("--seed", type=int, default=0)
        sp.add_argument("--lr", type=float, default=0.05)
        sp.add_argument("--steps", type=int, default=40)

    sp = sub.add_parser("status", help="Health check + PEFT ledger")
    add_common(sp)
    sp = sub.add_parser("decompose", help="Magnitude/direction decomposition")
    add_common(sp)
    sp = sub.add_parser("recompose", help="Round-trip decompose→recompose")
    add_common(sp)
    sp = sub.add_parser("analyze", help="Split grad into mag/dir energy")
    add_common(sp)
    sp = sub.add_parser("step", help="Single optimizer step")
    add_common(sp)
    sp.add_argument("--method", choices=["dora", "lora", "full"], default="dora")
    sp = sub.add_parser("train", help="Train linear task")
    add_common(sp)
    sp.add_argument("--method", choices=["dora", "lora", "full"], default="dora")
    sp = sub.add_parser("ablate", help="full vs lora vs dora ranking")
    add_common(sp)
    sp = sub.add_parser("benchmark", help="Dim × rank sweep")
    sp.add_argument("--dims", type=int, nargs="+", default=[12, 16, 24])
    sp.add_argument("--ranks", type=int, nargs="+", default=[2, 4, 8])
    sp.add_argument("--steps", type=int, default=25)
    sp.add_argument("--seed", type=int, default=0)
    sp = sub.add_parser("verify", help="Invariant battery")
    sp.add_argument("--trials", type=int, default=3)
    sp.add_argument("--seed", type=int, default=0)
    sp = sub.add_parser("pack", help="Status + theory + ablate bundle")
    add_common(sp)
    sp = sub.add_parser("theory", help="LLaMA-7B PEFT footprint theory")
    sp.add_argument("--rank", type=int, default=16)
    sp.add_argument("--bytes-per", type=int, default=2)
    return p


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)
    eng = DoRAEngine()
    cmd = args.cmd or "status"

    if cmd == "status":
        _pp(eng.status(m=args.rows, n=args.cols, rank=args.rank, seed=args.seed))
    elif cmd in ("decompose", "recompose"):
        _pp(eng.decompose_once(m=args.rows, n=args.cols, seed=args.seed))
    elif cmd == "analyze":
        _pp(eng.analyze_grad(m=args.rows, n=args.cols, seed=args.seed))
    elif cmd == "step":
        _pp(eng.step_once(
            m=args.rows, n=args.cols, rank=args.rank, seed=args.seed,
            method=args.method, lr=args.lr,
        ))
    elif cmd == "train":
        _pp(eng.train(
            m=args.rows, n=args.cols, rank=args.rank, steps=args.steps,
            seed=args.seed, method=args.method, lr=args.lr,
        ))
    elif cmd == "ablate":
        _pp(eng.ablate(
            m=args.rows, n=args.cols, rank=args.rank, steps=args.steps,
            seed=args.seed, lr=args.lr,
        ))
    elif cmd == "benchmark":
        _pp(eng.benchmark(dims=args.dims, ranks=args.ranks, steps=args.steps, seed=args.seed))
    elif cmd == "verify":
        out = eng.verify(trials=args.trials, seed=args.seed)
        _pp(out)
        return 0 if out["ok"] else 1
    elif cmd == "pack":
        _pp(eng.pack(m=args.rows, n=args.cols, rank=args.rank, seed=args.seed))
    elif cmd == "theory":
        _pp(theory_report(rank=args.rank, bytes_per=args.bytes_per))
    else:
        parser.print_help()
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
