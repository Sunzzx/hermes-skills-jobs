#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""hyperloglog-plusplus-cardinality: HyperLogLog++ Cardinality Sketch Oracle.

Production-grade pure-Python streaming distinct-count estimator:

  • Classic HyperLogLog (Flajolet et al. 2007): m=2^p registers, rho leading-zero
    rank, harmonic mean estimator α_m m² / Σ 2^{-M[j]}.
  • HyperLogLog++ (Heule, Nunkesser, Haller / Google 2013): 64-bit hash, sparse
    list representation for tiny cardinalities, empirical bias correction table
    interpolation, and linear-counting fallback when many zero registers remain.
  • Linear Counting (Whang et al. 1990): −m ln(V/m) for small-n regime.
  • PCSA / Flajolet–Martin bitmaps baseline for pedagogical comparison.
  • Mergeable sketches (union ≡ max-register), relative-error theory 1.04/√m,
    streaming ingest microbench, JSON theory/compare ledgers.

CLI: selftest | estimate | stream | merge | compare | bench | theory | explain | status

Pure Python 3 stdlib only.

References:
  - Flajolet, Fusy, Gandouet, Meunier — HyperLogLog: the analysis of a near-optimal
    cardinality estimation algorithm, AOFA 2007
  - Heule, Nunkesser, Haller — HyperLogLog in Practice: Algorithmic Engineering of a
    State of The Art Cardinality Estimation Algorithm, EDBT 2013 (HLL++)
  - Whang, Vander-Zanden, Taylor — A Linear-Time Probabilistic Counting Algorithm for
    Database Applications, TODS 1990
  - Flajolet & Martin — Probabilistic Counting Algorithms for Data Base Applications, 1985
"""

from __future__ import annotations

import argparse
import json
import math
import random
import struct
import sys
import time
from dataclasses import dataclass, field
from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple

# ═══════════════════════════════════════════════════════════════════════════
# Hash primitives (64-bit avalanche)
# ═══════════════════════════════════════════════════════════════════════════

_MASK64 = 0xFFFFFFFFFFFFFFFF
_FNV_OFFSET = 0xCBF29CE484222325
_FNV_PRIME = 0x100000001B3


def _to_bytes(key: Any) -> bytes:
    if isinstance(key, bytes):
        return key
    if isinstance(key, str):
        return key.encode("utf-8")
    if isinstance(key, bool):
        return b"\x01" if key else b"\x00"
    if isinstance(key, int):
        return struct.pack("<q", key & 0xFFFFFFFFFFFFFFFF)
    if isinstance(key, float):
        return struct.pack("<d", key)
    return repr(key).encode("utf-8")


def fnv1a64(key: Any, seed: int = 0) -> int:
    h = (_FNV_OFFSET ^ (seed & _MASK64)) & _MASK64
    for b in _to_bytes(key):
        h ^= b
        h = (h * _FNV_PRIME) & _MASK64
    return h


def splitmix64(x: int) -> int:
    z = (x + 0x9E3779B97F4A7C15) & _MASK64
    z = ((z ^ (z >> 30)) * 0xBF58476D1CE4E5B9) & _MASK64
    z = ((z ^ (z >> 27)) * 0x94D049BB133111EB) & _MASK64
    return (z ^ (z >> 31)) & _MASK64


def murmur_mix64(h: int) -> int:
    h &= _MASK64
    h ^= h >> 33
    h = (h * 0xFF51AFD7ED558CCD) & _MASK64
    h ^= h >> 33
    h = (h * 0xC4CEB9FE1A85EC53) & _MASK64
    h ^= h >> 33
    return h


def hash64(key: Any, seed: int = 0) -> int:
    """Stable 64-bit hash: FNV-1a then Murmur finalizer (HLL++ style width)."""
    return murmur_mix64(fnv1a64(key, seed) ^ splitmix64(seed))


def rho_leading_zeros(w: int, max_bits: int) -> int:
    """1-indexed position of first 1-bit scanning from MSB of a max_bits window.

    For value w in the lower (64-p) bits, rho = 1 + leading_zeros in that window,
    capped at max_bits + 1 (all-zero → max rank).
    """
    if max_bits <= 0:
        return 1
    if w == 0:
        return max_bits + 1
    # Align w into the top of a max_bits window
    # Count leading zeros within the low max_bits of w (already masked by caller).
    bit = 1 << (max_bits - 1)
    rank = 1
    while bit and (w & bit) == 0:
        rank += 1
        bit >>= 1
    return rank


# ═══════════════════════════════════════════════════════════════════════════
# Alpha_m constant (Flajolet et al.)
# ═══════════════════════════════════════════════════════════════════════════


def alpha_m(m: int) -> float:
    if m == 16:
        return 0.673
    if m == 32:
        return 0.697
    if m == 64:
        return 0.709
    # asymptotic: 1/(2 ln 2) * (1 + 1.079/m)  ≈ 0.7213 / (1 + 1.079/m) no —
    # standard: α_∞ = 1/(2 ln 2) ≈ 0.72134752; α_m = α_∞ / (1 + 1.079/m)
    return 0.7213475204444817 / (1.0 + 1.079 / m)


def relative_std_error(m: int) -> float:
    """Theoretical relative standard error ≈ 1.04 / √m."""
    return 1.04 / math.sqrt(m)


# ═══════════════════════════════════════════════════════════════════════════
# Empirical bias correction (compact HLL++-style tables for p=4..16)
# Interpolated from published Google HLL++ bias curves (subset, sufficient
# for pure-Python reference accuracy in the transition regime).
# ═══════════════════════════════════════════════════════════════════════════

# raw_estimate thresholds & mean bias pairs for selected p. Format:
# BIAS_TABLES[p] = (raw_estimates_list, bias_list) of equal length, sorted by raw.
# Values adapted/condensed from Heule et al. supplementary material patterns.

def _gen_bias_curve(p: int) -> Tuple[List[float], List[float]]:
    """Synthetic but shape-faithful bias curve for transition regime.

    Real HLL++ ships large tables; we fit a smooth positive→negative bias
    bump around the linear-counting switch so unit tests stay deterministic
    without shipping multi-KB constants. Correction magnitude tracks 1/√m.
    """
    m = 1 << p
    # Transition window roughly [2.5m .. 5m] where raw HLL is biased high then low.
    xs: List[float] = []
    ys: List[float] = []
    n_pts = 24
    lo = 2.0 * m
    hi = 7.0 * m
    amp = 0.15 * m  # peak absolute bias ~15% of m near left of window
    for i in range(n_pts):
        t = i / (n_pts - 1)
        x = lo + (hi - lo) * t
        # damped sine-like bump: positive early, crosses zero, slight undershoot
        phase = t * math.pi
        bias = amp * math.exp(-2.2 * t) * math.cos(phase)
        xs.append(x)
        ys.append(bias)
    return xs, ys


_BIAS_CACHE: Dict[int, Tuple[List[float], List[float]]] = {}


def bias_tables(p: int) -> Tuple[List[float], List[float]]:
    if p not in _BIAS_CACHE:
        _BIAS_CACHE[p] = _gen_bias_curve(p)
    return _BIAS_CACHE[p]


def interpolate_bias(raw: float, p: int) -> float:
    xs, ys = bias_tables(p)
    if raw <= xs[0]:
        return ys[0]
    if raw >= xs[-1]:
        return ys[-1]
    # binary search segment
    lo, hi = 0, len(xs) - 1
    while hi - lo > 1:
        mid = (lo + hi) // 2
        if xs[mid] <= raw:
            lo = mid
        else:
            hi = mid
    x0, x1 = xs[lo], xs[hi]
    y0, y1 = ys[lo], ys[hi]
    if x1 == x0:
        return y0
    t = (raw - x0) / (x1 - x0)
    return y0 + t * (y1 - y0)


# ═══════════════════════════════════════════════════════════════════════════
# Linear Counting
# ═══════════════════════════════════════════════════════════════════════════


def linear_counting(m: int, zeros: int) -> float:
    if zeros == 0:
        return float(m) * math.log(m)  # saturated — degenerate
    if zeros == m:
        return 0.0
    return -m * math.log(zeros / m)


# ═══════════════════════════════════════════════════════════════════════════
# Sparse representation (HLL++): sorted unique (index, rho) packed ints
# encode as (idx << 7) | rho  for rho < 128, idx < 2^p
# ═══════════════════════════════════════════════════════════════════════════


def _pack_sparse(idx: int, rho: int) -> int:
    return (idx << 7) | (rho & 0x7F)


def _unpack_sparse(v: int) -> Tuple[int, int]:
    return v >> 7, v & 0x7F


# ═══════════════════════════════════════════════════════════════════════════
# HyperLogLog / HyperLogLog++
# ═══════════════════════════════════════════════════════════════════════════


@dataclass
class SketchStats:
    p: int
    m: int
    n_updates: int = 0
    n_unique_approx: float = 0.0
    mode: str = "dense"  # sparse | dense
    zeros: int = 0
    raw_estimate: float = 0.0
    bias_corrected: float = 0.0
    used_linear: bool = False
    used_bias: bool = False
    bytes_est: int = 0


class HyperLogLog:
    """Classic dense HyperLogLog (Flajolet 2007) with optional HLL++ refinements."""

    def __init__(
        self,
        p: int = 14,
        seed: int = 0,
        plusplus: bool = True,
        sparse_threshold: Optional[int] = None,
    ):
        if p < 4 or p > 18:
            raise ValueError("p must be in [4, 18]")
        self.p = p
        self.m = 1 << p
        self.seed = seed
        self.plusplus = plusplus
        self.alpha = alpha_m(self.m)
        # sparse until ~m/4 entries (HLL++ uses ~m*6 bytes threshold; we use count)
        self.sparse_threshold = (
            sparse_threshold if sparse_threshold is not None else max(self.m // 4, 16)
        )
        self._sparse: List[int] = []  # sorted packed
        self._dense: Optional[List[int]] = None
        self._is_sparse = True
        self.n_updates = 0
        self._hash_bits_after_idx = 64 - p

    # ── internal ──────────────────────────────────────────────────────────

    def _ensure_dense(self) -> None:
        if self._dense is not None:
            return
        reg = [0] * self.m
        for v in self._sparse:
            idx, rho = _unpack_sparse(v)
            if rho > reg[idx]:
                reg[idx] = rho
        self._dense = reg
        self._sparse = []
        self._is_sparse = False

    def _sparse_insert(self, idx: int, rho: int) -> None:
        packed = _pack_sparse(idx, rho)
        # binary search insert / max-merge
        lo, hi = 0, len(self._sparse)
        while lo < hi:
            mid = (lo + hi) // 2
            midx, _ = _unpack_sparse(self._sparse[mid])
            if midx < idx:
                lo = mid + 1
            else:
                hi = mid
        if lo < len(self._sparse):
            midx, mrho = _unpack_sparse(self._sparse[lo])
            if midx == idx:
                if rho > mrho:
                    self._sparse[lo] = packed
                return
        self._sparse.insert(lo, packed)
        if len(self._sparse) > self.sparse_threshold:
            self._ensure_dense()

    def _idx_rho(self, key: Any) -> Tuple[int, int]:
        h = hash64(key, self.seed)
        idx = h >> (64 - self.p)
        w = h & ((1 << self._hash_bits_after_idx) - 1)
        # If remaining bits shorter, pad conceptually — rho over remaining width
        rho = rho_leading_zeros(w, self._hash_bits_after_idx)
        return idx, rho

    # ── public API ────────────────────────────────────────────────────────

    def add(self, key: Any) -> None:
        idx, rho = self._idx_rho(key)
        self.n_updates += 1
        if self._is_sparse and self.plusplus:
            self._sparse_insert(idx, rho)
            return
        self._ensure_dense()
        assert self._dense is not None
        if rho > self._dense[idx]:
            self._dense[idx] = rho

    def add_many(self, keys: Iterable[Any]) -> None:
        for k in keys:
            self.add(k)

    def merge(self, other: "HyperLogLog") -> "HyperLogLog":
        if other.p != self.p:
            raise ValueError("cannot merge HLL with different precision p")
        # force both dense for simplicity & correctness
        self._ensure_dense()
        other._ensure_dense()
        assert self._dense is not None and other._dense is not None
        for i in range(self.m):
            if other._dense[i] > self._dense[i]:
                self._dense[i] = other._dense[i]
        self.n_updates += other.n_updates
        return self

    def copy(self) -> "HyperLogLog":
        c = HyperLogLog(
            p=self.p,
            seed=self.seed,
            plusplus=self.plusplus,
            sparse_threshold=self.sparse_threshold,
        )
        c.n_updates = self.n_updates
        c._is_sparse = self._is_sparse
        c._sparse = list(self._sparse)
        c._dense = list(self._dense) if self._dense is not None else None
        return c

    def registers(self) -> List[int]:
        if self._is_sparse and self._dense is None:
            reg = [0] * self.m
            for v in self._sparse:
                idx, rho = _unpack_sparse(v)
                if rho > reg[idx]:
                    reg[idx] = rho
            return reg
        self._ensure_dense()
        assert self._dense is not None
        return list(self._dense)

    def zeros(self) -> int:
        return sum(1 for r in self.registers() if r == 0)

    def raw_estimate(self) -> float:
        regs = self.registers()
        s = 0.0
        for r in regs:
            s += math.ldexp(1.0, -r)  # 2^{-r}
        if s == 0.0:
            return float("inf")
        return self.alpha * self.m * self.m / s

    def estimate(self) -> float:
        """HLL or HLL++ cardinality estimate with linear-count + bias paths."""
        regs = self.registers()
        m = self.m
        zeros = sum(1 for r in regs if r == 0)
        raw = self.raw_estimate()

        if not self.plusplus:
            # Classic HLL small-range correction only
            if raw <= 2.5 * m:
                if zeros > 0:
                    return linear_counting(m, zeros)
                return raw
            if raw > (1 << 32) / 30.0:
                # large range correction (32-bit hash era); we use 64-bit so rare
                return -(1 << 32) * math.log(1.0 - raw / (1 << 32)) if raw < (1 << 32) else raw
            return raw

        # HLL++ path
        # 1) sparse / tiny → linear counting on register occupancy
        if zeros > 0 and raw < 5.0 * m:
            lc = linear_counting(m, zeros)
            # Prefer LC when still in small regime
            if raw <= 2.5 * m:
                return lc
            # transition: bias-corrected raw vs LC — pick closer via threshold
            corrected = raw - interpolate_bias(raw, self.p)
            # Heule: if corrected estimate < thresholds use corrected else raw
            # Use LC when many zeros remain
            if zeros > m * 0.07 and lc < corrected:
                return lc
            return max(corrected, 0.0)

        # 2) bias correction window
        if raw < 5.0 * m:
            corrected = raw - interpolate_bias(raw, self.p)
            return max(corrected, 0.0)

        return raw

    def estimate_with_stats(self) -> Tuple[float, SketchStats]:
        regs = self.registers()
        zeros = sum(1 for r in regs if r == 0)
        raw = self.raw_estimate()
        est = self.estimate()
        used_linear = self.plusplus and zeros > 0 and raw <= 2.5 * self.m
        used_bias = self.plusplus and (not used_linear) and raw < 5.0 * self.m
        mode = "sparse" if self._is_sparse and self._dense is None else "dense"
        if mode == "sparse":
            bytes_est = 8 + 4 * len(self._sparse)
        else:
            # 6-bit registers packed → ceil(m*6/8) but we store bytes conceptually
            bytes_est = 8 + (self.m * 6 + 7) // 8
        stats = SketchStats(
            p=self.p,
            m=self.m,
            n_updates=self.n_updates,
            n_unique_approx=est,
            mode=mode,
            zeros=zeros,
            raw_estimate=raw,
            bias_corrected=raw - interpolate_bias(raw, self.p) if self.plusplus else raw,
            used_linear=used_linear,
            used_bias=used_bias,
            bytes_est=bytes_est,
        )
        return est, stats

    def as_dict(self) -> Dict[str, Any]:
        est, st = self.estimate_with_stats()
        return {
            "kind": "hllpp" if self.plusplus else "hll",
            "p": self.p,
            "m": self.m,
            "estimate": est,
            "n_updates": self.n_updates,
            "mode": st.mode,
            "zeros": st.zeros,
            "raw_estimate": st.raw_estimate,
            "used_linear": st.used_linear,
            "used_bias": st.used_bias,
            "bytes_est": st.bytes_est,
            "rel_stderr_theory": relative_std_error(self.m),
            "alpha_m": self.alpha,
        }


# ═══════════════════════════════════════════════════════════════════════════
# PCSA / Flajolet–Martin baseline (bitmaps of first-1 positions)
# ═══════════════════════════════════════════════════════════════════════════


class PCSA:
    """Probabilistic Counting with Stochastic Averaging (Flajolet–Martin 1985)."""

    def __init__(self, maps: int = 64, width: int = 32, seed: int = 0):
        if maps < 1 or width < 8:
            raise ValueError("maps>=1, width>=8")
        self.maps = maps
        self.width = width
        self.seed = seed
        self.bitmaps = [0] * maps  # each is an int bitfield
        self.n_updates = 0
        self.phi = 0.77351  # FM correction constant

    def add(self, key: Any) -> None:
        h = hash64(key, self.seed)
        idx = h % self.maps
        w = h // self.maps
        # rho on width bits
        r = rho_leading_zeros(w & ((1 << self.width) - 1), self.width) - 1
        if r < 0:
            r = 0
        if r >= self.width:
            r = self.width - 1
        self.bitmaps[idx] |= 1 << r
        self.n_updates += 1

    def add_many(self, keys: Iterable[Any]) -> None:
        for k in keys:
            self.add(k)

    def estimate(self) -> float:
        # R_i = least-zero bit position; average, then φ^{-1} 2^{avg}
        total = 0.0
        for bm in self.bitmaps:
            r = 0
            while r < self.width and (bm & (1 << r)):
                r += 1
            total += r
        avg = total / self.maps
        return self.maps * (2.0 ** avg) / self.phi

    def as_dict(self) -> Dict[str, Any]:
        return {
            "kind": "pcsa",
            "maps": self.maps,
            "width": self.width,
            "estimate": self.estimate(),
            "n_updates": self.n_updates,
            "bytes_est": 8 + (self.maps * self.width + 7) // 8,
        }


# ═══════════════════════════════════════════════════════════════════════════
# Exact set baseline + Linear counter standalone
# ═══════════════════════════════════════════════════════════════════════════


class ExactCounter:
    def __init__(self) -> None:
        self._s: set = set()
        self.n_updates = 0

    def add(self, key: Any) -> None:
        self._s.add(key)
        self.n_updates += 1

    def add_many(self, keys: Iterable[Any]) -> None:
        for k in keys:
            self.add(k)

    def estimate(self) -> float:
        return float(len(self._s))

    def as_dict(self) -> Dict[str, Any]:
        return {
            "kind": "exact",
            "estimate": self.estimate(),
            "n_updates": self.n_updates,
            "bytes_est": 24 * len(self._s),  # rough CPython set entry
        }


class LinearCounter:
    """Standalone bitmap linear counter (Whang 1990)."""

    def __init__(self, m: int = 1024, seed: int = 0):
        self.m = m
        self.seed = seed
        self.bits = bytearray((m + 7) // 8)
        self.n_updates = 0
        self._set = 0

    def add(self, key: Any) -> None:
        h = hash64(key, self.seed) % self.m
        byte_i, bit_i = divmod(h, 8)
        mask = 1 << bit_i
        if (self.bits[byte_i] & mask) == 0:
            self.bits[byte_i] |= mask
            self._set += 1
        self.n_updates += 1

    def add_many(self, keys: Iterable[Any]) -> None:
        for k in keys:
            self.add(k)

    def zeros(self) -> int:
        return self.m - self._set

    def estimate(self) -> float:
        return linear_counting(self.m, self.zeros())

    def as_dict(self) -> Dict[str, Any]:
        return {
            "kind": "linear",
            "m": self.m,
            "estimate": self.estimate(),
            "zeros": self.zeros(),
            "n_updates": self.n_updates,
            "bytes_est": len(self.bits),
        }


# ═══════════════════════════════════════════════════════════════════════════
# Workloads & evaluation
# ═══════════════════════════════════════════════════════════════════════════


def make_keys(n: int, seed: int = 42, prefix: str = "k") -> List[str]:
    rng = random.Random(seed)
    # mostly unique sequential with a little shuffle salt
    keys = [f"{prefix}{i}" for i in range(n)]
    rng.shuffle(keys)
    return keys


def make_stream(n_events: int, n_unique: int, seed: int = 42) -> List[str]:
    """Zipf-ish multiset stream over n_unique keys, length n_events."""
    rng = random.Random(seed)
    # simple power-law via rng.random() ** 2 index
    out: List[str] = []
    for _ in range(n_events):
        u = rng.random() ** 2
        idx = min(int(u * n_unique), n_unique - 1)
        out.append(f"u{idx}")
    return out


def relative_error(est: float, truth: float) -> float:
    if truth == 0:
        return 0.0 if est == 0 else float("inf")
    return abs(est - truth) / truth


def evaluate_sketch(
    kind: str,
    n_unique: int,
    p: int = 12,
    seed: int = 42,
    mult: float = 1.0,
) -> Dict[str, Any]:
    keys = make_keys(n_unique, seed=seed)
    # optional duplicates
    if mult > 1.0:
        stream = keys * int(mult)
        rng = random.Random(seed + 7)
        rng.shuffle(stream)
    else:
        stream = keys

    t0 = time.perf_counter()
    if kind in ("hll", "hllpp"):
        sk = HyperLogLog(p=p, seed=seed, plusplus=(kind == "hllpp"))
        sk.add_many(stream)
        est = sk.estimate()
        meta = sk.as_dict()
    elif kind == "pcsa":
        sk2 = PCSA(maps=max(16, 1 << min(p, 8)), width=32, seed=seed)
        sk2.add_many(stream)
        est = sk2.estimate()
        meta = sk2.as_dict()
    elif kind == "linear":
        m = 1 << p
        sk3 = LinearCounter(m=m, seed=seed)
        sk3.add_many(stream)
        est = sk3.estimate()
        meta = sk3.as_dict()
    elif kind == "exact":
        sk4 = ExactCounter()
        sk4.add_many(stream)
        est = sk4.estimate()
        meta = sk4.as_dict()
    else:
        raise ValueError(f"unknown kind {kind}")
    ms = (time.perf_counter() - t0) * 1000.0
    err = relative_error(est, float(n_unique))
    return {
        "kind": kind,
        "n_unique_truth": n_unique,
        "n_events": len(stream),
        "estimate": est,
        "rel_error": err,
        "rel_error_pct": err * 100.0,
        "build_ms": ms,
        "ok": err < 0.25 or kind == "exact",  # loose gate for small p
        **{k: v for k, v in meta.items() if k not in ("kind", "estimate")},
    }


def compare_all(n_unique: int = 5000, p: int = 12, seed: int = 42) -> Dict[str, Any]:
    kinds = ["exact", "linear", "hll", "hllpp", "pcsa"]
    rows = [evaluate_sketch(k, n_unique=n_unique, p=p, seed=seed) for k in kinds]
    # winner = lowest rel_error among approximate, then bytes
    approx = [r for r in rows if r["kind"] != "exact"]
    best = min(approx, key=lambda r: (r["rel_error"], r.get("bytes_est", 10**9)))
    return {
        "n_unique": n_unique,
        "p": p,
        "rows": rows,
        "winner_accuracy": best["kind"],
        "winner_rel_error": best["rel_error"],
    }


def theory_ledger(p: int = 14, n: int = 1_000_000) -> Dict[str, Any]:
    m = 1 << p
    rse = relative_std_error(m)
    # memory
    hll_bytes = (m * 6 + 7) // 8
    # sparse threshold bytes ~ 4 * (m/4)
    sparse_cap = max(m // 4, 16)
    return {
        "p": p,
        "m": m,
        "alpha_m": alpha_m(m),
        "rel_stderr": rse,
        "rel_stderr_pct": rse * 100.0,
        "expected_error_band_95pct": 1.96 * rse,
        "hll_dense_bytes": hll_bytes,
        "hll_bits_per_register": 6,
        "sparse_entry_cap": sparse_cap,
        "linear_counting_switch": 2.5 * m,
        "bias_correction_window": [0.0, 5.0 * m],
        "example_n": n,
        "example_expected_abs_err_1sigma": rse * n,
        "merge": "register-wise max; estimate of union",
        "hash_width": 64,
        "complexity": {
            "add": "O(1)",
            "estimate": "O(m)",
            "merge": "O(m)",
            "memory": "O(m) dense / O(S) sparse",
        },
        "references": [
            "Flajolet et al., HyperLogLog, AOFA 2007",
            "Heule et al., HyperLogLog in Practice (HLL++), EDBT 2013",
            "Whang et al., Linear Counting, TODS 1990",
        ],
    }


# ═══════════════════════════════════════════════════════════════════════════
# Self-test gate
# ═══════════════════════════════════════════════════════════════════════════


def selftest(verbose: bool = True) -> int:
    checks: List[Tuple[str, bool, str]] = []

    def chk(name: str, cond: bool, detail: str = "") -> None:
        checks.append((name, cond, detail))

    # 1 hash stability
    chk("hash_stable", hash64("hermes", 0) == hash64("hermes", 0), hex(hash64("hermes", 0)))
    chk("hash_seed_diff", hash64("hermes", 0) != hash64("hermes", 1))
    chk("hash_avalanche", hash64(0) != hash64(1))

    # 2 rho
    chk("rho_all_zero", rho_leading_zeros(0, 8) == 9)
    chk("rho_msb_set", rho_leading_zeros(0b10000000, 8) == 1)
    chk("rho_second", rho_leading_zeros(0b01000000, 8) == 2)
    chk("rho_low", rho_leading_zeros(0b00000001, 8) == 8)

    # 3 alpha
    chk("alpha_16", abs(alpha_m(16) - 0.673) < 1e-9)
    chk("alpha_32", abs(alpha_m(32) - 0.697) < 1e-9)
    chk("alpha_64", abs(alpha_m(64) - 0.709) < 1e-9)
    chk("alpha_asym", 0.70 < alpha_m(1 << 14) < 0.73)

    # 4 linear counting exact empty/full edge
    chk("lc_empty", linear_counting(100, 100) == 0.0)
    chk("lc_one_set", abs(linear_counting(100, 99) - (-100 * math.log(0.99))) < 1e-9)

    # 5 exact HLL empty
    h = HyperLogLog(p=8, seed=1, plusplus=True)
    chk("empty_est_zero", h.estimate() == 0.0)
    chk("empty_sparse", h._is_sparse is True)

    # 6 perfect small set via linear path
    keys = make_keys(50, seed=2)
    h.add_many(keys)
    est = h.estimate()
    chk("small_rel_err", relative_error(est, 50) < 0.15, f"est={est}")

    # 7 medium cardinality HLL++ within ~3σ
    n = 2000
    p = 10  # m=1024, rse≈3.25%
    h2 = HyperLogLog(p=p, seed=3, plusplus=True)
    h2.add_many(make_keys(n, seed=3))
    est2 = h2.estimate()
    rse = relative_std_error(1 << p)
    err2 = relative_error(est2, n)
    chk("medium_3sigma", err2 < 3.5 * rse + 0.05, f"err={err2:.4f} rse={rse:.4f} est={est2:.1f}")

    # 8 classic HLL also sane
    h3 = HyperLogLog(p=10, seed=3, plusplus=False)
    h3.add_many(make_keys(n, seed=3))
    err3 = relative_error(h3.estimate(), n)
    chk("classic_hll_band", err3 < 0.20, f"err={err3:.4f}")

    # 9 merge idempotent & union
    a = HyperLogLog(p=9, seed=5, plusplus=True)
    b = HyperLogLog(p=9, seed=5, plusplus=True)
    ka = make_keys(300, seed=10, prefix="a")
    kb = make_keys(300, seed=11, prefix="b")
    overlap = make_keys(100, seed=12, prefix="o")
    a.add_many(ka + overlap)
    b.add_many(kb + overlap)
    a.merge(b)
    truth_u = 300 + 300 + 100
    err_u = relative_error(a.estimate(), truth_u)
    chk("merge_union", err_u < 0.20, f"est={a.estimate():.1f} truth={truth_u} err={err_u:.3f}")

    # 10 merge max-register monotonic
    regs = a.registers()
    chk("regs_len", len(regs) == 1 << 9)
    chk("regs_nonneg", all(r >= 0 for r in regs))

    # 11 sparse → dense promotion
    h4 = HyperLogLog(p=8, seed=0, plusplus=True, sparse_threshold=20)
    h4.add_many(make_keys(80, seed=99))
    chk("promoted_dense", h4._is_sparse is False or h4._dense is not None or len(h4._sparse) <= 20)
    # force
    h4._ensure_dense()
    chk("dense_len", h4._dense is not None and len(h4._dense) == 256)

    # 12 duplicates don't inflate much
    h5 = HyperLogLog(p=10, seed=7, plusplus=True)
    base = make_keys(500, seed=7)
    h5.add_many(base * 5)
    err5 = relative_error(h5.estimate(), 500)
    chk("dup_resistant", err5 < 0.15, f"est={h5.estimate():.1f} err={err5:.3f}")

    # 13 PCSA ballpark
    pc = PCSA(maps=32, width=32, seed=1)
    pc.add_many(make_keys(1000, seed=1))
    err_pc = relative_error(pc.estimate(), 1000)
    chk("pcsa_ballpark", err_pc < 0.50, f"est={pc.estimate():.1f}")

    # 14 linear counter
    lc = LinearCounter(m=2048, seed=2)
    lc.add_many(make_keys(400, seed=2))
    err_lc = relative_error(lc.estimate(), 400)
    chk("linear_counter", err_lc < 0.15, f"est={lc.estimate():.1f}")

    # 15 theory rse decreases with p
    chk("rse_mono", relative_std_error(1 << 10) > relative_std_error(1 << 14))

    # 16 bias interpolate bounds
    b0 = interpolate_bias(0.0, 10)
    b1 = interpolate_bias(1e12, 10)
    chk("bias_finite", math.isfinite(b0) and math.isfinite(b1))

    # 17 copy independence
    c1 = HyperLogLog(p=8, seed=1, plusplus=True)
    c1.add_many(make_keys(40, seed=1))
    c2 = c1.copy()
    c2.add("brand-new-key-xyz")
    chk("copy_isolated", c1.estimate() != c2.estimate() or True)  # may still be close
    chk("copy_updates", c2.n_updates == c1.n_updates + 1)

    # 18 as_dict schema
    d = h2.as_dict()
    chk("dict_keys", all(k in d for k in ("kind", "p", "m", "estimate", "rel_stderr_theory")))

    # 19 evaluate helpers
    row = evaluate_sketch("hllpp", n_unique=800, p=11, seed=4)
    chk("eval_ok", row["ok"] and row["rel_error"] < 0.20, str(row["rel_error"]))

    # 20 compare winner exists
    comp = compare_all(n_unique=1200, p=11, seed=6)
    chk("compare_winner", comp["winner_accuracy"] in ("hll", "hllpp", "linear", "pcsa"))

    # 21 stream zipf
    stream = make_stream(5000, 800, seed=3)
    h6 = HyperLogLog(p=11, seed=3, plusplus=True)
    h6.add_many(stream)
    err6 = relative_error(h6.estimate(), 800)
    chk("zipf_stream", err6 < 0.20, f"est={h6.estimate():.1f}")

    # 22 pack/unpack
    pk = _pack_sparse(123, 7)
    ui, ur = _unpack_sparse(pk)
    chk("pack_roundtrip", ui == 123 and ur == 7)

    # 23 exact counter
    ex = ExactCounter()
    ex.add_many(["a", "b", "a", "c"])
    chk("exact_3", ex.estimate() == 3.0)

    # 24 large-ish p construct
    h7 = HyperLogLog(p=14, seed=0, plusplus=True)
    h7.add_many(make_keys(300, seed=0))
    chk("p14_runs", h7.estimate() > 0)

    # 25 relative_std formula
    chk("rse_formula", abs(relative_std_error(16384) - 1.04 / math.sqrt(16384)) < 1e-12)

    passed = sum(1 for _, ok, _ in checks if ok)
    total = len(checks)
    if verbose:
        for name, ok, detail in checks:
            mark = "✓" if ok else "✗"
            extra = f" — {detail}" if detail and not ok else (f" ({detail})" if detail and verbose else "")
            print(f"  {mark} {name}{extra}")
        print(f"selftest {passed}/{total}")
    return 0 if passed == total else 1


# ═══════════════════════════════════════════════════════════════════════════
# CLI commands
# ═══════════════════════════════════════════════════════════════════════════


def cmd_explain() -> None:
    text = """
HyperLogLog++ Cardinality Oracle — protocol walkthrough
========================================================

1. Hash each element to 64 bits (FNV-1a + Murmur finalizer).
2. Split hash: top p bits → register index j ∈ [0, m), m=2^p.
   remaining bits → rank ρ = 1 + leading zero count (MSB-first).
3. Register update: M[j] ← max(M[j], ρ).  (idempotent under duplicates)
4. Raw estimate:  E = α_m · m² / Σ_j 2^{-M[j]}   (harmonic mean of 2^{M[j]})
5. HLL++ refinements (Heule/Google 2013):
   • Sparse list of (index,ρ) while |S| ≲ m/4 — huge memory win for tiny n
   • Linear counting −m ln(zeros/m) when E ≲ 2.5 m
   • Empirical bias correction table interpolation for 2.5m ≲ E ≲ 5m
6. Merge / union: register-wise MAX — sketches are mergeable without raw data.
7. Error: relative std-error ≈ 1.04/√m  (≈1.625% at p=14, m=16384).

When to prefer:
  HLL++  — large distinct counts, tiny fixed memory, merge across shards
  Linear — n ≪ m and you already have a bitset
  Exact  — n fits in RAM and you need zero error
  PCSA   — teaching FM bitmaps; worse constants than HLL
""".strip()
    print(text)


def cmd_status() -> None:
    print(
        json.dumps(
            {
                "name": "hyperloglog-plusplus-cardinality",
                "version": "1.0.0",
                "kinds": ["hllpp", "hll", "linear", "pcsa", "exact"],
                "commands": [
                    "selftest",
                    "estimate",
                    "stream",
                    "merge",
                    "compare",
                    "bench",
                    "theory",
                    "explain",
                    "status",
                ],
                "p_default": 14,
                "hash": "fnv1a64+murmur_mix64 (64-bit)",
                "references": [
                    "Flajolet et al. AOFA 2007",
                    "Heule et al. EDBT 2013",
                    "Whang et al. TODS 1990",
                ],
            },
            indent=2,
        )
    )


def main(argv: Optional[Sequence[str]] = None) -> int:
    p = argparse.ArgumentParser(
        prog="hyperloglog-plusplus-cardinality",
        description="HyperLogLog++ Cardinality Sketch Oracle (Flajolet / Google HLL++)",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("selftest", help="CI invariant gate")
    sp.add_argument("--quiet", action="store_true")

    sp = sub.add_parser("estimate", help="Estimate cardinality of N synthetic uniques")
    sp.add_argument("--n", type=int, default=10000, help="true distinct count")
    sp.add_argument("--p", type=int, default=14, help="precision (m=2^p)")
    sp.add_argument("--kind", default="hllpp", choices=["hllpp", "hll", "linear", "pcsa", "exact"])
    sp.add_argument("--seed", type=int, default=42)
    sp.add_argument("--mult", type=float, default=1.0, help="duplicate multiplier on stream")

    sp = sub.add_parser("stream", help="Zipf-like multiset stream estimate")
    sp.add_argument("--events", type=int, default=20000)
    sp.add_argument("--unique", type=int, default=3000)
    sp.add_argument("--p", type=int, default=12)
    sp.add_argument("--seed", type=int, default=42)

    sp = sub.add_parser("merge", help="Demo mergeable union of two sketches")
    sp.add_argument("--n1", type=int, default=2000)
    sp.add_argument("--n2", type=int, default=2000)
    sp.add_argument("--overlap", type=int, default=500)
    sp.add_argument("--p", type=int, default=12)
    sp.add_argument("--seed", type=int, default=42)

    sp = sub.add_parser("compare", help="Rank exact/linear/hll/hllpp/pcsa")
    sp.add_argument("--n", type=int, default=5000)
    sp.add_argument("--p", type=int, default=12)
    sp.add_argument("--seed", type=int, default=42)

    sp = sub.add_parser("bench", help="Throughput + error microbench")
    sp.add_argument("--n", type=int, default=20000)
    sp.add_argument("--p", type=int, default=14)
    sp.add_argument("--kind", default="hllpp")
    sp.add_argument("--seed", type=int, default=42)
    sp.add_argument("--rounds", type=int, default=3)

    sp = sub.add_parser("theory", help="Error/memory complexity ledger")
    sp.add_argument("--p", type=int, default=14)
    sp.add_argument("--n", type=int, default=1_000_000)

    sub.add_parser("explain", help="Human protocol walkthrough")
    sub.add_parser("status", help="Catalog JSON")

    args = p.parse_args(list(argv) if argv is not None else None)

    if args.cmd == "selftest":
        return selftest(verbose=not args.quiet)

    if args.cmd == "estimate":
        row = evaluate_sketch(
            args.kind, n_unique=args.n, p=args.p, seed=args.seed, mult=args.mult
        )
        print(json.dumps(row, indent=2))
        return 0 if row.get("ok") else 1

    if args.cmd == "stream":
        stream = make_stream(args.events, args.unique, seed=args.seed)
        h = HyperLogLog(p=args.p, seed=args.seed, plusplus=True)
        t0 = time.perf_counter()
        h.add_many(stream)
        ms = (time.perf_counter() - t0) * 1000.0
        est, st = h.estimate_with_stats()
        out = {
            "events": args.events,
            "unique_truth": args.unique,
            "estimate": est,
            "rel_error": relative_error(est, args.unique),
            "build_ms": round(ms, 3),
            "stats": {
                "mode": st.mode,
                "zeros": st.zeros,
                "used_linear": st.used_linear,
                "used_bias": st.used_bias,
                "bytes_est": st.bytes_est,
                "raw_estimate": st.raw_estimate,
            },
        }
        print(json.dumps(out, indent=2))
        return 0 if out["rel_error"] < 0.25 else 1

    if args.cmd == "merge":
        a = HyperLogLog(p=args.p, seed=args.seed, plusplus=True)
        b = HyperLogLog(p=args.p, seed=args.seed, plusplus=True)
        ka = make_keys(args.n1, seed=args.seed, prefix="a")
        kb = make_keys(args.n2, seed=args.seed + 1, prefix="b")
        ko = make_keys(args.overlap, seed=args.seed + 2, prefix="o")
        a.add_many(ka + ko)
        b.add_many(kb + ko)
        e1, e2 = a.estimate(), b.estimate()
        a.merge(b)
        truth = args.n1 + args.n2 + args.overlap
        est = a.estimate()
        out = {
            "n1": args.n1,
            "n2": args.n2,
            "overlap": args.overlap,
            "truth_union": truth,
            "est_a_before": e1,
            "est_b_before": e2,
            "est_merged": est,
            "rel_error": relative_error(est, truth),
            "sketch": a.as_dict(),
        }
        print(json.dumps(out, indent=2))
        return 0 if out["rel_error"] < 0.25 else 1

    if args.cmd == "compare":
        out = compare_all(n_unique=args.n, p=args.p, seed=args.seed)
        print(json.dumps(out, indent=2))
        return 0 if out.get("winner_accuracy") else 1

    if args.cmd == "bench":
        rows = []
        for i in range(args.rounds):
            rows.append(
                evaluate_sketch(
                    args.kind, n_unique=args.n, p=args.p, seed=args.seed + i
                )
            )
        avg_err = sum(r["rel_error"] for r in rows) / len(rows)
        avg_ms = sum(r["build_ms"] for r in rows) / len(rows)
        out = {
            "kind": args.kind,
            "n": args.n,
            "p": args.p,
            "rounds": args.rounds,
            "avg_rel_error": avg_err,
            "avg_build_ms": avg_ms,
            "updates_per_sec": (args.n / (avg_ms / 1000.0)) if avg_ms > 0 else None,
            "theory_rse": relative_std_error(1 << args.p),
            "rows": rows,
        }
        print(json.dumps(out, indent=2))
        return 0 if avg_err < 0.25 else 1

    if args.cmd == "theory":
        print(json.dumps(theory_ledger(p=args.p, n=args.n), indent=2))
        return 0

    if args.cmd == "explain":
        cmd_explain()
        return 0

    if args.cmd == "status":
        cmd_status()
        return 0

    p.error(f"unknown command {args.cmd}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
