#!/usr/bin/env python3
"""keydiff-kv-engine: KeyDiff Key-Similarity KV Cache Eviction (NeurIPS 2025).

Training-free KV cache eviction that ranks tokens by geometric distinctiveness of
their key vectors — not by attention scores. This preserves FlashAttention / fused
kernel compatibility while retaining needles, rare entities, and long-range anchors
under a hard memory budget.

Core ideas (Park et al., NeurIPS 2025 — KeyDiff):
1. Geometrically distinctive keys correlate with high attention mass.
2. Greedy farthest-point / diversity selection under a fixed token budget.
3. Optional local window + attention-sink anchors without score accumulation.
4. Oracle attention-mass recovery metric vs StreamingLLM / random / magnitude baselines.
"""

from __future__ import annotations

import argparse
import json
import math
import random
import sys
import time
from dataclasses import asdict, dataclass, field
from typing import Dict, List, Optional, Sequence, Tuple


# ---------------------------------------------------------------------------
# Linear algebra helpers (pure Python, no numpy dependency)
# ---------------------------------------------------------------------------

def _dot(a: Sequence[float], b: Sequence[float]) -> float:
    return sum(x * y for x, y in zip(a, b))


def _norm(a: Sequence[float]) -> float:
    return math.sqrt(max(_dot(a, a), 1e-18))


def _l2(a: Sequence[float], b: Sequence[float]) -> float:
    return math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b)))


def _cosine(a: Sequence[float], b: Sequence[float]) -> float:
    return _dot(a, b) / (_norm(a) * _norm(b))


def _mean_vec(rows: Sequence[Sequence[float]]) -> List[float]:
    if not rows:
        return []
    d = len(rows[0])
    acc = [0.0] * d
    for r in rows:
        for i, v in enumerate(r):
            acc[i] += v
    n = float(len(rows))
    return [v / n for v in acc]


def _scale(v: Sequence[float], s: float) -> List[float]:
    return [x * s for x in v]


def _add(a: Sequence[float], b: Sequence[float]) -> List[float]:
    return [x + y for x, y in zip(a, b)]


# ---------------------------------------------------------------------------
# Synthetic long-context key generator
# ---------------------------------------------------------------------------

@dataclass
class KeyCorpus:
    """Synthetic multi-cluster key sequence with needles and sink tokens."""

    keys: List[List[float]]
    labels: List[str]  # sink | local | cluster_k | needle
    dim: int
    n_clusters: int
    n_needles: int

    @property
    def n(self) -> int:
        return len(self.keys)


def generate_key_corpus(
    seq_len: int = 2048,
    dim: int = 64,
    n_clusters: int = 8,
    n_needles: int = 12,
    sink_len: int = 4,
    local_window: int = 128,
    seed: int = 42,
) -> KeyCorpus:
    """Build a long-context key tensor with:
    - attention-sink prefix tokens (shared direction)
    - mid-context cluster masses (redundant near-duplicates)
    - sparse needles (orthogonal outliers)
    - recent local window (decode tail)
    """
    if seq_len < sink_len + local_window + n_needles + n_clusters:
        raise ValueError("seq_len too small for requested structure")
    rng = random.Random(seed)

    def rand_unit() -> List[float]:
        v = [rng.gauss(0.0, 1.0) for _ in range(dim)]
        n = _norm(v)
        return [x / n for x in v]

    sink_dir = rand_unit()
    cluster_dirs = [rand_unit() for _ in range(n_clusters)]
    needle_dirs = [rand_unit() for _ in range(n_needles)]

    keys: List[List[float]] = []
    labels: List[str] = []

    # sinks
    for _ in range(sink_len):
        noise = [rng.gauss(0.0, 0.05) for _ in range(dim)]
        keys.append(_add(sink_dir, noise))
        labels.append("sink")

    mid = seq_len - sink_len - local_window
    # place needles at quasi-uniform mid positions
    needle_pos = set()
    if n_needles > 0 and mid > 0:
        step = max(mid // (n_needles + 1), 1)
        for i in range(n_needles):
            needle_pos.add(sink_len + min(mid - 1, (i + 1) * step))

    cluster_budget = mid - len(needle_pos)
    # fill mid-context
    for t in range(sink_len, sink_len + mid):
        if t in needle_pos:
            ni = len([L for L in labels if L == "needle"])
            ni = min(ni, n_needles - 1)
            noise = [rng.gauss(0.0, 0.02) for _ in range(dim)]
            keys.append(_add(needle_dirs[ni], noise))
            labels.append("needle")
        else:
            c = rng.randrange(n_clusters)
            # high redundancy inside cluster
            noise = [rng.gauss(0.0, 0.08) for _ in range(dim)]
            keys.append(_add(cluster_dirs[c], noise))
            labels.append(f"cluster_{c}")

    # local window
    for _ in range(local_window):
        c = rng.randrange(n_clusters)
        noise = [rng.gauss(0.0, 0.1) for _ in range(dim)]
        keys.append(_add(cluster_dirs[c], noise))
        labels.append("local")

    assert len(keys) == seq_len
    return KeyCorpus(keys=keys, labels=labels, dim=dim, n_clusters=n_clusters, n_needles=n_needles)


# ---------------------------------------------------------------------------
# Eviction policies
# ---------------------------------------------------------------------------

@dataclass
class EvictionResult:
    keep_idx: List[int]
    policy: str
    budget: int
    elapsed_ms: float
    meta: Dict[str, float] = field(default_factory=dict)

    @property
    def keep_set(self) -> set:
        return set(self.keep_idx)


def _forced_anchors(n: int, sink_len: int, local_window: int) -> List[int]:
    sinks = list(range(min(sink_len, n)))
    local = list(range(max(0, n - local_window), n))
    # unique preserving order
    seen = set()
    out: List[int] = []
    for i in sinks + local:
        if i not in seen:
            seen.add(i)
            out.append(i)
    return out


def evict_streaming_llm(
    n: int,
    budget: int,
    sink_len: int = 4,
    local_window: Optional[int] = None,
) -> EvictionResult:
    t0 = time.perf_counter()
    if local_window is None:
        local_window = max(budget - sink_len, 0)
    local_window = min(local_window, max(budget - sink_len, 0))
    keep = list(range(min(sink_len, budget)))
    need = budget - len(keep)
    start = max(0, n - need)
    for i in range(start, n):
        if i not in keep:
            keep.append(i)
        if len(keep) >= budget:
            break
    keep = sorted(keep)[:budget]
    return EvictionResult(keep, "streaming_llm", budget, (time.perf_counter() - t0) * 1000.0)


def evict_random(n: int, budget: int, seed: int = 0) -> EvictionResult:
    t0 = time.perf_counter()
    rng = random.Random(seed)
    keep = sorted(rng.sample(range(n), min(budget, n)))
    return EvictionResult(keep, "random", budget, (time.perf_counter() - t0) * 1000.0)


def evict_magnitude(keys: Sequence[Sequence[float]], budget: int) -> EvictionResult:
    t0 = time.perf_counter()
    scored = sorted((( _norm(k), i) for i, k in enumerate(keys)), reverse=True)
    keep = sorted(i for _, i in scored[:budget])
    return EvictionResult(keep, "magnitude", budget, (time.perf_counter() - t0) * 1000.0)


def _pairwise_min_dist(keys: Sequence[Sequence[float]], idx: int, chosen: Sequence[int], metric: str) -> float:
    if not chosen:
        return float("inf")
    best = float("inf")
    ki = keys[idx]
    for j in chosen:
        if metric == "cosine":
            # distance = 1 - cosine similarity
            d = 1.0 - _cosine(ki, keys[j])
        else:
            d = _l2(ki, keys[j])
        if d < best:
            best = d
    return best


def evict_keydiff(
    keys: Sequence[Sequence[float]],
    budget: int,
    sink_len: int = 4,
    local_window: int = 128,
    metric: str = "cosine",
    seed: int = 0,
) -> EvictionResult:
    """Greedy farthest-point diversity selection (KeyDiff core).

    1. Pin attention-sink prefix + recent local window (always retained).
    2. Fill remaining budget by repeatedly picking the candidate with the
       largest minimum distance to the already-chosen set (FPS / Gonzalez).
    3. Optional: seed the first free pick as farthest from the mean of anchors.
    """
    t0 = time.perf_counter()
    n = len(keys)
    budget = min(budget, n)
    anchors = _forced_anchors(n, sink_len, min(local_window, budget))
    if len(anchors) > budget:
        # Prefer sinks then most-recent locals
        sinks = [i for i in anchors if i < sink_len]
        locals_ = [i for i in anchors if i >= sink_len]
        keep = sinks[: max(1, budget // 4)]
        remain = budget - len(keep)
        keep += locals_[-remain:] if remain else []
        keep = sorted(set(keep))[:budget]
        return EvictionResult(
            keep,
            "keydiff",
            budget,
            (time.perf_counter() - t0) * 1000.0,
            meta={"anchors": float(len(keep)), "fps_picks": 0.0},
        )

    chosen = list(anchors)
    chosen_set = set(chosen)
    remaining_slots = budget - len(chosen)

    # Seed diversity: if we have room, pick the point farthest from anchor centroid
    if remaining_slots > 0:
        centroid = _mean_vec([keys[i] for i in chosen]) if chosen else _mean_vec(keys)
        best_i, best_d = -1, -1.0
        for i in range(n):
            if i in chosen_set:
                continue
            d = (1.0 - _cosine(keys[i], centroid)) if metric == "cosine" else _l2(keys[i], centroid)
            if d > best_d:
                best_d, best_i = d, i
        if best_i >= 0:
            chosen.append(best_i)
            chosen_set.add(best_i)
            remaining_slots -= 1

    # Gonzalez farthest-point sampling
    fps_picks = 0
    while remaining_slots > 0:
        best_i, best_d = -1, -1.0
        for i in range(n):
            if i in chosen_set:
                continue
            d = _pairwise_min_dist(keys, i, chosen, metric)
            if d > best_d:
                best_d, best_i = d, i
        if best_i < 0:
            break
        chosen.append(best_i)
        chosen_set.add(best_i)
        remaining_slots -= 1
        fps_picks += 1

    keep = sorted(chosen)[:budget]
    elapsed = (time.perf_counter() - t0) * 1000.0
    return EvictionResult(
        keep,
        "keydiff",
        budget,
        elapsed,
        meta={
            "anchors": float(len(anchors)),
            "fps_picks": float(fps_picks),
            "metric": 1.0 if metric == "cosine" else 0.0,
        },
    )


def evict_keydiff_block(
    keys: Sequence[Sequence[float]],
    budget: int,
    block_size: int = 16,
    sink_len: int = 4,
    local_window: int = 128,
    metric: str = "cosine",
) -> EvictionResult:
    """Block-compressed KeyDiff: score blocks by internal diversity then FPS on block reps.

    O((n/B)^2) instead of O(n^2) — practical for long contexts.
    """
    t0 = time.perf_counter()
    n = len(keys)
    budget = min(budget, n)
    anchors = set(_forced_anchors(n, sink_len, min(local_window, budget)))

    # Build blocks
    blocks: List[List[int]] = []
    for start in range(0, n, block_size):
        blocks.append(list(range(start, min(start + block_size, n))))

    # Representative = mean of block keys
    reps = [_mean_vec([keys[i] for i in blk]) for blk in blocks]

    # Score blocks: mean pairwise intra-block variance + distance from global mean
    gmean = _mean_vec(keys)
    block_score: List[Tuple[float, int]] = []
    for bi, (blk, rep) in enumerate(zip(blocks, reps)):
        # diversity proxy: average distance from rep
        if len(blk) <= 1:
            spread = 0.0
        else:
            spread = sum(
                (1.0 - _cosine(keys[i], rep)) if metric == "cosine" else _l2(keys[i], rep)
                for i in blk
            ) / len(blk)
        novelty = (1.0 - _cosine(rep, gmean)) if metric == "cosine" else _l2(rep, gmean)
        # boost blocks that already contain anchors
        anchor_boost = 2.0 if any(i in anchors for i in blk) else 1.0
        block_score.append((anchor_boost * (spread + novelty), bi))

    # Select blocks via FPS on reps, seeded by top scored
    block_score.sort(reverse=True)
    selected_blocks: List[int] = []
    selected_set = set()

    # Always include blocks covering anchors
    for bi, blk in enumerate(blocks):
        if any(i in anchors for i in blk):
            selected_blocks.append(bi)
            selected_set.add(bi)

    # Fill with farthest reps until token budget roughly met
    def block_tokens(sel: Sequence[int]) -> int:
        return sum(len(blocks[b]) for b in sel)

    # seed with highest novelty block if empty
    if not selected_blocks and block_score:
        selected_blocks.append(block_score[0][1])
        selected_set.add(block_score[0][1])

    while block_tokens(selected_blocks) < budget and len(selected_set) < len(blocks):
        best_bi, best_d = -1, -1.0
        for bi in range(len(blocks)):
            if bi in selected_set:
                continue
            d = float("inf")
            for bj in selected_blocks:
                dd = (1.0 - _cosine(reps[bi], reps[bj])) if metric == "cosine" else _l2(reps[bi], reps[bj])
                d = min(d, dd)
            # blend with static score
            static = next(s for s, b in block_score if b == bi)
            d = d + 0.1 * static
            if d > best_d:
                best_d, best_bi = d, bi
        if best_bi < 0:
            break
        selected_blocks.append(best_bi)
        selected_set.add(best_bi)

    # Collect tokens; if over budget, FPS-trim inside selected set
    candidates = []
    for bi in selected_blocks:
        candidates.extend(blocks[bi])
    candidates = sorted(set(candidates) | anchors)

    if len(candidates) <= budget:
        keep = sorted(candidates)
    else:
        # run token-level keydiff on candidates only
        sub_keys = [keys[i] for i in candidates]
        # map local->global
        local_res = evict_keydiff(
            sub_keys,
            budget=budget,
            sink_len=min(sink_len, len(sub_keys)),
            local_window=min(local_window, len(sub_keys)),
            metric=metric,
        )
        keep = sorted(candidates[j] for j in local_res.keep_idx)

    elapsed = (time.perf_counter() - t0) * 1000.0
    return EvictionResult(
        keep[:budget],
        "keydiff_block",
        budget,
        elapsed,
        meta={"blocks": float(len(blocks)), "selected_blocks": float(len(selected_blocks))},
    )


# ---------------------------------------------------------------------------
# Evaluation: oracle attention-mass recovery + needle retention
# ---------------------------------------------------------------------------

def oracle_attention_scores(
    keys: Sequence[Sequence[float]],
    queries: Sequence[Sequence[float]],
    temperature: float = 1.0,
) -> List[float]:
    """Average softmax attention mass each key receives across probe queries."""
    n = len(keys)
    mass = [0.0] * n
    if not queries:
        return mass
    scale = 1.0 / (math.sqrt(len(keys[0])) * max(temperature, 1e-6))
    for q in queries:
        logits = [_dot(q, k) * scale for k in keys]
        m = max(logits)
        exps = [math.exp(l - m) for l in logits]
        s = sum(exps) or 1.0
        for i, e in enumerate(exps):
            mass[i] += e / s
    inv = 1.0 / len(queries)
    return [m * inv for m in mass]


def make_probe_queries(
    corpus: KeyCorpus,
    n_queries: int = 32,
    seed: int = 7,
) -> List[List[float]]:
    """Queries biased toward needles + cluster centroids (retrieval-like)."""
    rng = random.Random(seed)
    needle_idx = [i for i, L in enumerate(corpus.labels) if L == "needle"]
    cluster_idx = [i for i, L in enumerate(corpus.labels) if L.startswith("cluster_")]
    queries: List[List[float]] = []
    for _ in range(n_queries):
        if needle_idx and rng.random() < 0.45:
            base = corpus.keys[rng.choice(needle_idx)]
        elif cluster_idx:
            base = corpus.keys[rng.choice(cluster_idx)]
        else:
            base = corpus.keys[rng.randrange(corpus.n)]
        noise = [rng.gauss(0.0, 0.15) for _ in range(corpus.dim)]
        queries.append(_add(base, noise))
    return queries


@dataclass
class EvalReport:
    policy: str
    budget: int
    seq_len: int
    mass_recovery: float
    needle_recall: float
    sink_recall: float
    local_recall: float
    diversity: float
    elapsed_ms: float
    keep_count: int

    def to_dict(self) -> Dict:
        return asdict(self)


def evaluate_policy(
    corpus: KeyCorpus,
    result: EvictionResult,
    queries: Sequence[Sequence[float]],
) -> EvalReport:
    mass = oracle_attention_scores(corpus.keys, queries)
    total_mass = sum(mass) or 1.0
    kept_mass = sum(mass[i] for i in result.keep_idx)
    mass_recovery = kept_mass / total_mass

    def recall(label_pred) -> float:
        idxs = [i for i, L in enumerate(corpus.labels) if label_pred(L)]
        if not idxs:
            return 1.0
        kept = sum(1 for i in idxs if i in result.keep_set)
        return kept / len(idxs)

    needle_recall = recall(lambda L: L == "needle")
    sink_recall = recall(lambda L: L == "sink")
    local_recall = recall(lambda L: L == "local")

    # mean pairwise cosine distance among kept (diversity)
    keep = result.keep_idx
    if len(keep) < 2:
        diversity = 0.0
    else:
        # sample pairs for speed
        rng = random.Random(0)
        pairs = 0
        acc = 0.0
        limit = min(200, len(keep) * (len(keep) - 1) // 2)
        for _ in range(limit):
            i, j = rng.sample(keep, 2)
            acc += 1.0 - _cosine(corpus.keys[i], corpus.keys[j])
            pairs += 1
        diversity = acc / max(pairs, 1)

    return EvalReport(
        policy=result.policy,
        budget=result.budget,
        seq_len=corpus.n,
        mass_recovery=mass_recovery,
        needle_recall=needle_recall,
        sink_recall=sink_recall,
        local_recall=local_recall,
        diversity=diversity,
        elapsed_ms=result.elapsed_ms,
        keep_count=len(result.keep_idx),
    )


def run_benchmark(
    seq_len: int = 1024,
    dim: int = 48,
    budget_ratio: float = 0.25,
    seed: int = 42,
    block_size: int = 16,
) -> Dict:
    corpus = generate_key_corpus(seq_len=seq_len, dim=dim, seed=seed)
    budget = max(16, int(seq_len * budget_ratio))
    queries = make_probe_queries(corpus, n_queries=24, seed=seed + 1)

    policies = [
        evict_keydiff(corpus.keys, budget, sink_len=4, local_window=min(128, budget // 2)),
        evict_keydiff_block(corpus.keys, budget, block_size=block_size, local_window=min(128, budget // 2)),
        evict_streaming_llm(corpus.n, budget, sink_len=4),
        evict_random(corpus.n, budget, seed=seed),
        evict_magnitude(corpus.keys, budget),
    ]

    reports = [evaluate_policy(corpus, p, queries) for p in policies]
    # rank by mass recovery then needle recall
    ranking = sorted(reports, key=lambda r: (r.mass_recovery, r.needle_recall), reverse=True)
    return {
        "seq_len": seq_len,
        "dim": dim,
        "budget": budget,
        "budget_ratio": budget_ratio,
        "n_needles": corpus.n_needles,
        "reports": [r.to_dict() for r in reports],
        "winner": ranking[0].policy,
        "keydiff_mass_recovery": next(r.mass_recovery for r in reports if r.policy == "keydiff"),
        "streaming_mass_recovery": next(r.mass_recovery for r in reports if r.policy == "streaming_llm"),
        "keydiff_needle_recall": next(r.needle_recall for r in reports if r.policy == "keydiff"),
        "streaming_needle_recall": next(r.needle_recall for r in reports if r.policy == "streaming_llm"),
    }


def run_compare(seq_len: int = 768, budget_ratio: float = 0.2, seed: int = 1) -> Dict:
    bench = run_benchmark(seq_len=seq_len, budget_ratio=budget_ratio, seed=seed)
    kd = bench["keydiff_mass_recovery"]
    sl = bench["streaming_mass_recovery"]
    bench["mass_lift_vs_streaming"] = kd - sl
    bench["needle_lift_vs_streaming"] = (
        bench["keydiff_needle_recall"] - bench["streaming_needle_recall"]
    )
    return bench


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _print_report_table(reports: List[Dict]) -> None:
    hdr = f"{'policy':<16} {'mass%':>8} {'needle%':>9} {'sink%':>8} {'local%':>8} {'div':>7} {'ms':>8}"
    print(hdr)
    print("-" * len(hdr))
    for r in reports:
        print(
            f"{r['policy']:<16} "
            f"{100*r['mass_recovery']:>7.2f}% "
            f"{100*r['needle_recall']:>8.1f}% "
            f"{100*r['sink_recall']:>7.1f}% "
            f"{100*r['local_recall']:>7.1f}% "
            f"{r['diversity']:>7.3f} "
            f"{r['elapsed_ms']:>7.2f}"
        )


def cmd_bench(args: argparse.Namespace) -> int:
    t0 = time.perf_counter()
    out = run_benchmark(
        seq_len=args.seq_len,
        dim=args.dim,
        budget_ratio=args.budget_ratio,
        seed=args.seed,
        block_size=args.block_size,
    )
    wall = (time.perf_counter() - t0) * 1000.0
    print("⚡ KeyDiff KV Eviction Benchmark (NeurIPS 2025)")
    print(f"  • seq_len={out['seq_len']}  dim={out['dim']}  budget={out['budget']} ({out['budget_ratio']*100:.0f}%)")
    print(f"  • needles={out['n_needles']}  wall={wall:.1f} ms")
    print()
    _print_report_table(out["reports"])
    print()
    print(f"  ✓ winner={out['winner']}")
    print(
        f"  ✓ keydiff mass={100*out['keydiff_mass_recovery']:.2f}% "
        f"vs streaming={100*out['streaming_mass_recovery']:.2f}% "
        f"(Δ={100*(out['keydiff_mass_recovery']-out['streaming_mass_recovery']):+.2f} pp)"
    )
    print(
        f"  ✓ keydiff needle recall={100*out['keydiff_needle_recall']:.1f}% "
        f"vs streaming={100*out['streaming_needle_recall']:.1f}%"
    )
    if args.json:
        print(json.dumps(out, indent=2))
    return 0


def cmd_compare(args: argparse.Namespace) -> int:
    out = run_compare(seq_len=args.seq_len, budget_ratio=args.budget_ratio, seed=args.seed)
    print("⚔️  KeyDiff vs baselines")
    _print_report_table(out["reports"])
    print()
    print(f"  mass lift vs StreamingLLM:   {100*out['mass_lift_vs_streaming']:+.2f} pp")
    print(f"  needle lift vs StreamingLLM: {100*out['needle_lift_vs_streaming']:+.1f} pp")
    mass_ok = out["mass_lift_vs_streaming"] >= -0.01  # within 1pp is parity
    needle_ok = out["keydiff_needle_recall"] + 1e-12 >= out["streaming_needle_recall"]
    if mass_ok and needle_ok and out["needle_lift_vs_streaming"] > 0:
        print("  ✅ KeyDiff wins needle retention (FlashAttention-safe) with mass parity")
    elif mass_ok and needle_ok:
        print("  ✅ KeyDiff matches or beats StreamingLLM on mass + needles")
    else:
        print("  ⚠ mixed result — inspect reports")
    if args.json:
        print(json.dumps(out, indent=2))
    return 0


def cmd_evict(args: argparse.Namespace) -> int:
    corpus = generate_key_corpus(seq_len=args.seq_len, dim=args.dim, seed=args.seed)
    budget = args.budget if args.budget else max(16, int(args.seq_len * args.budget_ratio))
    if args.policy == "keydiff":
        res = evict_keydiff(corpus.keys, budget, local_window=args.local_window, metric=args.metric)
    elif args.policy == "keydiff_block":
        res = evict_keydiff_block(corpus.keys, budget, block_size=args.block_size, local_window=args.local_window)
    elif args.policy == "streaming_llm":
        res = evict_streaming_llm(corpus.n, budget)
    elif args.policy == "random":
        res = evict_random(corpus.n, budget, seed=args.seed)
    else:
        res = evict_magnitude(corpus.keys, budget)

    queries = make_probe_queries(corpus)
    report = evaluate_policy(corpus, res, queries)
    payload = {
        "policy": res.policy,
        "budget": res.budget,
        "keep_idx_head": res.keep_idx[:32],
        "keep_count": len(res.keep_idx),
        "elapsed_ms": res.elapsed_ms,
        "meta": res.meta,
        "eval": report.to_dict(),
    }
    print(json.dumps(payload, indent=2 if args.json else None))
    return 0


def cmd_selftest(args: argparse.Namespace) -> int:
    """Deterministic invariants used by CI / hourly evolution gate."""
    failures = []

    # 1. budget exactness
    corpus = generate_key_corpus(seq_len=256, dim=32, n_needles=6, seed=0)
    for pol in (
        lambda: evict_keydiff(corpus.keys, 64),
        lambda: evict_keydiff_block(corpus.keys, 64, block_size=8),
        lambda: evict_streaming_llm(corpus.n, 64),
        lambda: evict_random(corpus.n, 64, seed=0),
        lambda: evict_magnitude(corpus.keys, 64),
    ):
        r = pol()
        if len(r.keep_idx) != 64:
            failures.append(f"{r.policy} keep_count={len(r.keep_idx)} != 64")
        if len(set(r.keep_idx)) != len(r.keep_idx):
            failures.append(f"{r.policy} duplicate indices")
        if any(i < 0 or i >= corpus.n for i in r.keep_idx):
            failures.append(f"{r.policy} OOB index")

    # 2. sinks retained by keydiff
    r = evict_keydiff(corpus.keys, 64, sink_len=4, local_window=16)
    for i in range(4):
        if i not in r.keep_set:
            failures.append(f"sink {i} dropped by keydiff")

    # 3. KeyDiff should beat random on needle recall in structured corpus
    queries = make_probe_queries(corpus, n_queries=16, seed=3)
    kd = evaluate_policy(corpus, evict_keydiff(corpus.keys, 48, local_window=16), queries)
    rnd = evaluate_policy(corpus, evict_random(corpus.n, 48, seed=0), queries)
    if kd.needle_recall + 1e-9 < rnd.needle_recall and kd.mass_recovery < rnd.mass_recovery:
        failures.append(
            f"keydiff underperformed random (needle {kd.needle_recall} vs {rnd.needle_recall})"
        )

    # 4. mass recovery in (0,1]
    if not (0.0 < kd.mass_recovery <= 1.0 + 1e-9):
        failures.append(f"mass_recovery out of range: {kd.mass_recovery}")

    # 5. block variant returns exact budget
    rb = evict_keydiff_block(corpus.keys, 40, block_size=8)
    if len(rb.keep_idx) != 40:
        failures.append(f"block budget {len(rb.keep_idx)}")

    if failures:
        print("❌ selftest FAILED:")
        for f in failures:
            print("  -", f)
        return 1
    print("✅ keydiff-kv-engine selftest passed (5 invariant groups)")
    print(f"  • keydiff mass_recovery={kd.mass_recovery:.4f} needle_recall={kd.needle_recall:.3f}")
    print(f"  • random  mass_recovery={rnd.mass_recovery:.4f} needle_recall={rnd.needle_recall:.3f}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="keydiff-kv-engine",
        description="KeyDiff: key-similarity KV cache eviction (NeurIPS 2025)",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_common(sp):
        sp.add_argument("--seq-len", type=int, default=1024)
        sp.add_argument("--dim", type=int, default=48)
        sp.add_argument("--budget-ratio", type=float, default=0.25)
        sp.add_argument("--budget", type=int, default=0, help="absolute budget (overrides ratio)")
        sp.add_argument("--seed", type=int, default=42)
        sp.add_argument("--block-size", type=int, default=16)
        sp.add_argument("--local-window", type=int, default=128)
        sp.add_argument("--metric", choices=["cosine", "l2"], default="cosine")
        sp.add_argument("--json", action="store_true")

    b = sub.add_parser("bench", help="full multi-policy benchmark")
    add_common(b)
    b.set_defaults(func=cmd_bench)

    c = sub.add_parser("compare", help="KeyDiff vs StreamingLLM lift summary")
    add_common(c)
    c.set_defaults(func=cmd_compare)

    e = sub.add_parser("evict", help="run one policy and dump keep set")
    add_common(e)
    e.add_argument(
        "--policy",
        default="keydiff",
        choices=["keydiff", "keydiff_block", "streaming_llm", "random", "magnitude"],
    )
    e.set_defaults(func=cmd_evict)

    s = sub.add_parser("selftest", help="deterministic invariant gate")
    s.set_defaults(func=cmd_selftest)

    return p


def main(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return int(args.func(args))


if __name__ == "__main__":
    sys.exit(main())
