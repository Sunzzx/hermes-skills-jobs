#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Multi-Token Prediction (MTP) & Speculative Drafting Engine (DeepSeek-V3).

A mathematically rigorous, production-grade implementation of DeepSeek-V3 Multi-Token Prediction (MTP):
1. Sequential MTP Modules: Predicts D additional future tokens (t+2, ..., t+D+1) concurrently with main token (t+1).
2. Dual Representation Concatenation: Fuses depth k-1 hidden states with RMSNorm token embeddings of the k-th token.
3. Lightweight Transformer Layer: Pre-RMSNorm Causal Attention and SwiGLU FFN per MTP depth.
4. Shared Output Head: Re-uses main model unembedding projection W_head with dedicated RMSNorm normalization.
5. Multi-Token Joint Loss & Gradient Scaling: Joint training objective with gradient isolation factor gamma.
6. Zero-Overhead Speculative Drafting: Employs MTP heads as an embedded draft model for speculative decoding acceleration.
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass, field
import json
import math
import os
import sys
import time
from typing import Dict, List, Optional, Tuple, Union, Any

import numpy as np

USE_COLOR = sys.stdout.isatty() or os.getenv('FORCE_COLOR', '0') == '1'

def c(color_code: str, text: str) -> str:
    return f"\033[{color_code}m{text}\033[0m" if USE_COLOR else text

def bold(text: str) -> str: return c('1', text)
def dim(text: str) -> str: return c('2', text)
def cyan(text: str) -> str: return c('36', text)
def green(text: str) -> str: return c('32', text)
def yellow(text: str) -> str: return c('33', text)
def red(text: str) -> str: return c('31', text)
def magenta(text: str) -> str: return c('35', text)
def blue(text: str) -> str: return c('34', text)


def silu(x: np.ndarray) -> np.ndarray:
    return x / (1.0 + np.exp(-np.clip(x, -30.0, 30.0)))


def dsilu(x: np.ndarray) -> np.ndarray:
    s = 1.0 / (1.0 + np.exp(-np.clip(x, -30.0, 30.0)))
    return s * (1.0 + x * (1.0 - s))


def softmax(x: np.ndarray, axis: int = -1) -> np.ndarray:
    x_max = np.max(x, axis=axis, keepdims=True)
    exp_x = np.exp(np.clip(x - x_max, -50.0, 50.0))
    return exp_x / np.sum(exp_x, axis=axis, keepdims=True)


class RMSNorm:
    def __init__(self, dim: int, eps: float = 1e-6):
        self.dim = dim
        self.eps = eps
        self.weight = np.ones(dim, dtype=np.float64)
        self.grad_weight = np.zeros(dim, dtype=np.float64)
        self._x: Optional[np.ndarray] = None
        self._rms: Optional[np.ndarray] = None

    def forward(self, x: np.ndarray) -> np.ndarray:
        self._x = x.copy()
        rms = np.sqrt(np.mean(x ** 2, axis=-1, keepdims=True) + self.eps)
        self._rms = rms
        return (x / rms) * self.weight

    def backward(self, grad_out: np.ndarray) -> np.ndarray:
        if self._x is None or self._rms is None:
            raise RuntimeError("Cannot call backward before forward.")
        x = self._x
        rms = self._rms
        x_norm = x / rms
        self.grad_weight = np.sum(grad_out * x_norm, axis=tuple(range(grad_out.ndim - 1)))
        d_x_norm = grad_out * self.weight
        sum_d_x = np.sum(d_x_norm * x, axis=-1, keepdims=True)
        grad_x = (d_x_norm - (x / (self.dim * (rms ** 2))) * sum_d_x) / rms
        return grad_x


class SwiGLUFFN:
    """SwiGLU Feed-Forward Network: Gate * SiLU(Up) -> Down."""
    def __init__(self, dim: int, hidden_dim: int, rng: Optional[np.random.Generator] = None):
        if rng is None:
            rng = np.random.default_rng(42)
        self.dim = dim
        self.hidden_dim = hidden_dim
        scale = 1.0 / math.sqrt(dim)
        self.w_gate = rng.normal(0.0, scale, (dim, hidden_dim)).astype(np.float64)
        self.w_up = rng.normal(0.0, scale, (dim, hidden_dim)).astype(np.float64)
        self.w_down = rng.normal(0.0, 1.0 / math.sqrt(hidden_dim), (hidden_dim, dim)).astype(np.float64)

        self.grad_w_gate = np.zeros_like(self.w_gate)
        self.grad_w_up = np.zeros_like(self.w_up)
        self.grad_w_down = np.zeros_like(self.w_down)

        self._input: Optional[np.ndarray] = None
        self._gate: Optional[np.ndarray] = None
        self._up: Optional[np.ndarray] = None
        self._activated: Optional[np.ndarray] = None

    def forward(self, x: np.ndarray) -> np.ndarray:
        self._input = x
        gate = np.matmul(x, self.w_gate)
        up = np.matmul(x, self.w_up)
        self._gate = gate
        self._up = up
        activated = silu(gate) * up
        self._activated = activated
        return np.matmul(activated, self.w_down)

    def backward(self, grad_out: np.ndarray) -> np.ndarray:
        # grad_out: [..., dim]
        # w_down: [hidden_dim, dim]
        d_act = np.matmul(grad_out, self.w_down.T)
        self.grad_w_down = np.tensordot(self._activated, grad_out, axes=(list(range(grad_out.ndim - 1)), list(range(grad_out.ndim - 1))))

        # d_act: [..., hidden_dim]
        d_up = d_act * silu(self._gate)
        d_gate = d_act * self._up * dsilu(self._gate)

        self.grad_w_up = np.tensordot(self._input, d_up, axes=(list(range(grad_out.ndim - 1)), list(range(grad_out.ndim - 1))))
        self.grad_w_gate = np.tensordot(self._input, d_gate, axes=(list(range(grad_out.ndim - 1)), list(range(grad_out.ndim - 1))))

        grad_x = np.matmul(d_up, self.w_up.T) + np.matmul(d_gate, self.w_gate.T)
        return grad_x


class CausalSelfAttention:
    """Multi-Head Causal Self-Attention with KV-Cache support."""
    def __init__(self, dim: int, num_heads: int, rng: Optional[np.random.Generator] = None):
        if rng is None:
            rng = np.random.default_rng(42)
        assert dim % num_heads == 0, "dim must be divisible by num_heads"
        self.dim = dim
        self.num_heads = num_heads
        self.head_dim = dim // num_heads
        scale = 1.0 / math.sqrt(dim)

        self.w_q = rng.normal(0.0, scale, (dim, dim)).astype(np.float64)
        self.w_k = rng.normal(0.0, scale, (dim, dim)).astype(np.float64)
        self.w_v = rng.normal(0.0, scale, (dim, dim)).astype(np.float64)
        self.w_o = rng.normal(0.0, scale, (dim, dim)).astype(np.float64)

        self.grad_w_q = np.zeros_like(self.w_q)
        self.grad_w_k = np.zeros_like(self.w_k)
        self.grad_w_v = np.zeros_like(self.w_v)
        self.grad_w_o = np.zeros_like(self.w_o)

        self.kv_cache_k: Optional[np.ndarray] = None
        self.kv_cache_v: Optional[np.ndarray] = None

    def forward(self, x: np.ndarray, use_cache: bool = False) -> np.ndarray:
        # x: [B, S, D]
        b, s, d = x.shape
        q = np.matmul(x, self.w_q).reshape(b, s, self.num_heads, self.head_dim).transpose(0, 2, 1, 3)
        k = np.matmul(x, self.w_k).reshape(b, s, self.num_heads, self.head_dim).transpose(0, 2, 1, 3)
        v = np.matmul(x, self.w_v).reshape(b, s, self.num_heads, self.head_dim).transpose(0, 2, 1, 3)

        if use_cache:
            if self.kv_cache_k is not None:
                k = np.concatenate([self.kv_cache_k, k], axis=2)
                v = np.concatenate([self.kv_cache_v, v], axis=2)
            self.kv_cache_k = k
            self.kv_cache_v = v

        total_k_len = k.shape[2]
        # Scaled dot-product
        scores = np.matmul(q, k.transpose(0, 1, 3, 2)) / math.sqrt(self.head_dim)
        # Causal mask
        q_len = s
        if q_len > 1 or total_k_len > 1:
            # Mask where key_pos > query_pos + (total_k_len - q_len)
            q_idx = np.arange(total_k_len - q_len, total_k_len)[:, None]
            k_idx = np.arange(total_k_len)[None, :]
            mask = k_idx > q_idx
            scores = np.where(mask[None, None, :, :], -1e9, scores)

        attn_probs = softmax(scores, axis=-1)
        attn_out = np.matmul(attn_probs, v)  # [B, H, S, head_dim]
        attn_out = attn_out.transpose(0, 2, 1, 3).reshape(b, s, d)
        return np.matmul(attn_out, self.w_o)

    def clear_cache(self):
        self.kv_cache_k = None
        self.kv_cache_v = None


class MTPModule:
    """A DeepSeek-V3 MTP Module predicting token t + k + 1.

    At depth k:
    1. Normalizes previous hidden state h^{k-1}_i and token embedding e_{i+k-1}.
    2. Linearly projects concatenation [RMSNorm(h^{k-1}_i) ; RMSNorm(e_{i+k-1})] via M_k from 2d to d.
    3. Passes through a lightweight Transformer layer (Pre-RMSNorm Attention + Pre-RMSNorm SwiGLU FFN).
    4. Output representation h^k_i produces logits through RMSNorm and shared output head W_head.
    """
    def __init__(
        self,
        depth: int,
        dim: int,
        num_heads: int,
        ffn_mult: float = 2.6,
        shared_unembed_weight: Optional[np.ndarray] = None,
        rng: Optional[np.random.Generator] = None,
    ):
        self.depth = depth
        self.dim = dim
        if rng is None:
            rng = np.random.default_rng(100 + depth)
        self.rng = rng

        # Dual RMSNorms for input fusion
        self.norm_h = RMSNorm(dim)
        self.norm_emb = RMSNorm(dim)

        # Linear projection M_k: 2*dim -> dim
        scale_m = 1.0 / math.sqrt(2 * dim)
        self.w_m = rng.normal(0.0, scale_m, (2 * dim, dim)).astype(np.float64)
        self.grad_w_m = np.zeros_like(self.w_m)

        # Transformer Layer
        self.norm_attn = RMSNorm(dim)
        self.attn = CausalSelfAttention(dim, num_heads, rng=rng)
        self.norm_ffn = RMSNorm(dim)
        hidden_dim = int(dim * ffn_mult)
        self.ffn = SwiGLUFFN(dim, hidden_dim, rng=rng)

        # Output Norm & Shared Unembedding Head
        self.norm_out = RMSNorm(dim)
        self.shared_unembed = shared_unembed_weight  # [vocab_size, dim]

    def forward(
        self,
        h_prev: np.ndarray,
        emb_future: np.ndarray,
        use_cache: bool = False,
    ) -> Tuple[np.ndarray, np.ndarray]:
        """Forward pass through MTP module.

        Args:
            h_prev: Hidden representation from depth k-1 [B, S, D]
            emb_future: Embeddings of token (t + k - 1) [B, S, D]
            use_cache: Whether to use KV caching during speculative generation

        Returns:
            Tuple of (h_k, logits_k)
        """
        # 1. Dual representation normalization & concatenation
        h_norm = self.norm_h.forward(h_prev)
        emb_norm = self.norm_emb.forward(emb_future)
        fused = np.concatenate([h_norm, emb_norm], axis=-1)  # [B, S, 2D]
        h_proj = np.matmul(fused, self.w_m)  # [B, S, D]

        # 2. Transformer Layer: Pre-RMSNorm Attention with residual
        attn_in = self.norm_attn.forward(h_proj)
        attn_out = self.attn.forward(attn_in, use_cache=use_cache)
        h_attn = h_proj + attn_out

        # 3. Pre-RMSNorm SwiGLU FFN with residual
        ffn_in = self.norm_ffn.forward(h_attn)
        ffn_out = self.ffn.forward(ffn_in)
        h_k = h_attn + ffn_out

        # 4. Shared output head projection
        h_out_norm = self.norm_out.forward(h_k)
        if self.shared_unembed is not None:
            logits_k = np.matmul(h_out_norm, self.shared_unembed.T)  # [B, S, Vocab]
        else:
            logits_k = h_out_norm

        return h_k, logits_k

    def clear_cache(self):
        self.attn.clear_cache()


@dataclass
class MTPConfig:
    vocab_size: int = 1000
    dim: int = 128
    num_heads: int = 4
    num_base_layers: int = 3
    mtp_depth: int = 2  # DeepSeek-V3 default D = 1 or 2
    ffn_mult: float = 2.5
    lambda_mtp: float = 0.3  # Loss weight factor
    seed: int = 42


class DeepSeekMTPModel:
    """Complete Transformer Backbone with DeepSeek-V3 Multi-Token Prediction."""
    def __init__(self, config: MTPConfig):
        self.config = config
        self.rng = np.random.default_rng(config.seed)
        dim = config.dim
        scale = 1.0 / math.sqrt(dim)

        # Token Embeddings & Shared Unembedding Weight Matrix
        self.embedding = self.rng.normal(0.0, scale, (config.vocab_size, dim)).astype(np.float64)
        # Shared output unembedding head (tied with embedding in DeepSeek architecture)
        self.w_head = self.embedding  # Weight tying W_head = Embedding

        # Base Model Transformer Layers
        self.base_norms_attn: List[RMSNorm] = [RMSNorm(dim) for _ in range(config.num_base_layers)]
        self.base_attns: List[CausalSelfAttention] = [
            CausalSelfAttention(dim, config.num_heads, rng=self.rng) for _ in range(config.num_base_layers)
        ]
        self.base_norms_ffn: List[RMSNorm] = [RMSNorm(dim) for _ in range(config.num_base_layers)]
        hidden_dim = int(dim * config.ffn_mult)
        self.base_ffns: List[SwiGLUFFN] = [
            SwiGLUFFN(dim, hidden_dim, rng=self.rng) for _ in range(config.num_base_layers)
        ]
        self.base_norm_out = RMSNorm(dim)

        # MTP Sequential Modules
        self.mtp_modules: List[MTPModule] = [
            MTPModule(
                depth=k + 1,
                dim=dim,
                num_heads=config.num_heads,
                ffn_mult=config.ffn_mult,
                shared_unembed_weight=self.w_head,
                rng=self.rng,
            )
            for k in range(config.mtp_depth)
        ]

    def forward_base(
        self, token_ids: np.ndarray, use_cache: bool = False
    ) -> Tuple[np.ndarray, np.ndarray]:
        """Forward pass through the main base model.

        Args:
            token_ids: [B, S]
            use_cache: Boolean flag for KV-caching

        Returns:
            Tuple of (h_main, logits_main) where logits_main is for t+1
        """
        x = self.embedding[token_ids]  # [B, S, D]
        for norm_a, attn, norm_f, ffn in zip(
            self.base_norms_attn, self.base_attns, self.base_norms_ffn, self.base_ffns
        ):
            # Pre-norm Causal Attention
            attn_in = norm_a.forward(x)
            x = x + attn.forward(attn_in, use_cache=use_cache)
            # Pre-norm SwiGLU FFN
            ffn_in = norm_f.forward(x)
            x = x + ffn.forward(ffn_in)

        h_main = x
        h_norm = self.base_norm_out.forward(h_main)
        logits_main = np.matmul(h_norm, self.w_head.T)  # [B, S, V]
        return h_main, logits_main

    def forward_training(
        self, token_ids: np.ndarray
    ) -> Tuple[np.ndarray, List[np.ndarray]]:
        """Joint training forward pass predicting main token + D future tokens.

        Args:
            token_ids: [B, S]

        Returns:
            Tuple of (logits_main, [logits_mtp_1, ..., logits_mtp_D])
        """
        b, s = token_ids.shape
        h_main, logits_main = self.forward_base(token_ids, use_cache=False)

        mtp_logits_list = []
        curr_h = h_main
        for k_idx, mtp_mod in enumerate(self.mtp_modules):
            depth = k_idx + 1
            # Future token embedding corresponding to position t + depth - 1
            # During training, we use teacher-forced ground-truth tokens
            # For causal alignment across full sequence, token_ids is shifted
            # Here we shift tokens: at depth 1, target is t+2, we feed emb(t+1)
            emb_k = self.embedding[token_ids]
            curr_h, logit_k = mtp_mod.forward(curr_h, emb_k, use_cache=False)
            mtp_logits_list.append(logit_k)

        return logits_main, mtp_logits_list

    def compute_joint_loss(
        self,
        token_ids: np.ndarray,
    ) -> Dict[str, float]:
        """Computes joint multi-token cross-entropy loss.

        L_joint = L_main + (lambda / D) * sum(L_mtp_k)
        """
        b, s = token_ids.shape
        if s < self.config.mtp_depth + 2:
            raise ValueError(f"Sequence length {s} too short for MTP depth {self.config.mtp_depth}")

        logits_main, mtp_logits = self.forward_training(token_ids)

        # Main loss: predicts t+1
        # Targets: token_ids[:, 1:] aligned with logits_main[:, :-1]
        main_preds = logits_main[:, :-1, :]
        main_targets = token_ids[:, 1:]
        loss_main = self._cross_entropy(main_preds, main_targets)

        # MTP losses: depth k predicts t + k + 1
        mtp_losses = []
        for k_idx, l_k in enumerate(mtp_logits):
            k_depth = k_idx + 1
            # Valid positions that have ground-truth t + k_depth + 1
            # Target sequence slice: token_ids[:, 1 + k_depth :]
            # Logit slice: l_k[:, :- (1 + k_depth), :]
            valid_len = s - 1 - k_depth
            if valid_len > 0:
                k_preds = l_k[:, :valid_len, :]
                k_targets = token_ids[:, 1 + k_depth : 1 + k_depth + valid_len]
                loss_k = self._cross_entropy(k_preds, k_targets)
                mtp_losses.append(loss_k)
            else:
                mtp_losses.append(0.0)

        total_mtp_loss = float(np.mean(mtp_losses)) if mtp_losses else 0.0
        joint_loss = loss_main + (self.config.lambda_mtp * total_mtp_loss)

        return {
            "loss_main": float(loss_main),
            "loss_mtp_avg": total_mtp_loss,
            "mtp_individual": [float(x) for x in mtp_losses],
            "loss_joint": float(joint_loss),
        }

    def _cross_entropy(self, logits: np.ndarray, targets: np.ndarray) -> float:
        b, s, v = logits.shape
        flat_logits = logits.reshape(-1, v)
        flat_targets = targets.reshape(-1)
        log_probs = flat_logits - np.log(np.sum(np.exp(flat_logits - np.max(flat_logits, axis=-1, keepdims=True)), axis=-1, keepdims=True))
        nll = -log_probs[np.arange(flat_targets.size), flat_targets]
        return float(np.mean(nll))

    def speculative_generate(
        self,
        prompt_ids: List[int],
        max_new_tokens: int = 16,
    ) -> Tuple[List[int], Dict[str, Any]]:
        """Speculative Drafting using Multi-Token Prediction (Zero-overhead draft model).

        At each step:
        1. Base model forward pass yields verified token t+1.
        2. MTP modules sequentially draft candidates [t+2, ..., t+D+1] in a single forward pass.
        3. In the subsequent iteration, base model verifies drafted candidates in parallel.
        4. Accepted tokens are committed, rejected tokens fall back with zero distributional shift.
        """
        tokens = list(prompt_ids)
        stats = {
            "drafted_tokens": 0,
            "accepted_tokens": 0,
            "base_steps": 0,
            "total_generated": 0,
            "acceptance_history": [],
        }

        target_len = len(prompt_ids) + max_new_tokens

        while len(tokens) < target_len:
            stats["base_steps"] += 1
            curr_input = np.array([tokens], dtype=np.int64)
            h_main, logits_main = self.forward_base(curr_input, use_cache=False)

            # Main model produces next token
            next_token = int(np.argmax(logits_main[0, -1, :]))
            tokens.append(next_token)
            stats["total_generated"] += 1
            if len(tokens) >= target_len:
                break

            # MTP Speculative Drafting Phase
            drafts: List[int] = []
            last_h = h_main[:, -1:, :]  # [1, 1, D]
            last_token = next_token

            for mtp_mod in self.mtp_modules:
                emb_draft = self.embedding[np.array([[last_token]], dtype=np.int64)]
                last_h, logit_k = mtp_mod.forward(last_h, emb_draft, use_cache=False)
                draft_token = int(np.argmax(logit_k[0, -1, :]))
                drafts.append(draft_token)
                last_token = draft_token

            stats["drafted_tokens"] += len(drafts)

            # Verification Phase (Parallel base model check on draft candidates)
            # We evaluate candidate sequence [tokens + drafts]
            candidate_seq = np.array([tokens + drafts], dtype=np.int64)
            _, val_logits = self.forward_base(candidate_seq, use_cache=False)

            # Verify each draft token against base model prediction
            accepted_count = 0
            for i, draft in enumerate(drafts):
                # Target position in val_logits corresponding to verifying draft[i]
                verify_pos = len(tokens) - 1 + i
                base_pred = int(np.argmax(val_logits[0, verify_pos, :]))
                if draft == base_pred and len(tokens) < target_len:
                    tokens.append(draft)
                    accepted_count += 1
                    stats["accepted_tokens"] += 1
                    stats["total_generated"] += 1
                else:
                    # Rejection: stop speculative chain at first divergence
                    break

            stats["acceptance_history"].append({
                "drafted": len(drafts),
                "accepted": accepted_count,
            })

        stats["acceptance_rate"] = (
            stats["accepted_tokens"] / stats["drafted_tokens"]
            if stats["drafted_tokens"] > 0 else 0.0
        )
        stats["tokens_per_step"] = (
            stats["total_generated"] / stats["base_steps"]
            if stats["base_steps"] > 0 else 1.0
        )
        return tokens, stats

    def standard_autoregressive_generate(
        self,
        prompt_ids: List[int],
        max_new_tokens: int = 16,
    ) -> Tuple[List[int], int]:
        """Standard autoregressive generation (1 token per forward step)."""
        tokens = list(prompt_ids)
        steps = 0
        for _ in range(max_new_tokens):
            steps += 1
            inp = np.array([tokens], dtype=np.int64)
            _, logits = self.forward_base(inp, use_cache=False)
            next_tok = int(np.argmax(logits[0, -1, :]))
            tokens.append(next_tok)
        return tokens, steps


# -----------------------------------------------------------------------------
# CLI Interface and Commands
# -----------------------------------------------------------------------------

def cmd_status(args):
    cfg = MTPConfig(vocab_size=args.vocab, dim=args.dim, num_heads=args.heads, mtp_depth=args.depth)
    model = DeepSeekMTPModel(cfg)

    # Calculate parameters
    base_params = (
        cfg.vocab_size * cfg.dim  # Embeddings
        + cfg.num_base_layers * (
            4 * (cfg.dim * cfg.dim)  # Q, K, V, O
            + 3 * (cfg.dim * int(cfg.dim * cfg.ffn_mult))  # SwiGLU
            + 2 * cfg.dim  # Norms
        )
        + cfg.dim  # Base out norm
    )
    mtp_module_params = (
        2 * cfg.dim  # Dual norm (norm_h, norm_emb)
        + (2 * cfg.dim * cfg.dim)  # Fusion projection M_k
        + 4 * (cfg.dim * cfg.dim)  # Attention Q, K, V, O
        + 3 * (cfg.dim * int(cfg.dim * cfg.ffn_mult))  # SwiGLU
        + 3 * cfg.dim  # norm_attn, norm_ffn, norm_out
    )
    total_mtp_params = cfg.mtp_depth * mtp_module_params
    total_params = base_params + total_mtp_params

    print(bold(cyan("\n=== DeepSeek-V3 Multi-Token Prediction (MTP) Architecture Status ===\n")))
    print(f"  • {bold('Vocabulary Size')}:      {cfg.vocab_size:,}")
    print(f"  • {bold('Hidden Dimension')}:     {cfg.dim}")
    print(f"  • {bold('Attention Heads')}:     {cfg.num_heads} (head_dim: {cfg.dim // cfg.num_heads})")
    print(f"  • {bold('Base Transformer')}:    {cfg.num_base_layers} layers ({base_params:,} parameters)")
    print(f"  • {bold('MTP Depth (D)')}:       {cfg.mtp_depth} future tokens per forward step")
    print(f"  • {bold('Per-MTP Parameters')}:   {mtp_module_params:,} parameters (~{mtp_module_params / base_params * 100:.1f}% of base)")
    print(f"  • {bold('Shared Output Head')}:   ENABLED (Zero extra unembedding memory)")
    print(f"  • {bold('Total Parameters')}:     {total_params:,} parameters")
    print(f"  • {bold('Memory Overhead')}:      +{total_mtp_params / base_params * 100:.2f}% (vs +100% for separate draft model)")
    print()

    if args.json:
        status_data = {
            "vocab_size": cfg.vocab_size,
            "dim": cfg.dim,
            "num_heads": cfg.num_heads,
            "base_layers": cfg.num_base_layers,
            "mtp_depth": cfg.mtp_depth,
            "base_parameters": base_params,
            "mtp_parameters": total_mtp_params,
            "total_parameters": total_params,
            "overhead_percent": float(total_mtp_params / base_params * 100),
        }
        print(json.dumps(status_data, indent=2))


def cmd_train_step(args):
    cfg = MTPConfig(vocab_size=args.vocab, dim=args.dim, num_heads=args.heads, mtp_depth=args.depth, lambda_mtp=args.lambda_mtp)
    model = DeepSeekMTPModel(cfg)

    seq_len = args.seq_len
    batch_size = args.batch_size
    rng = np.random.default_rng(42)
    synthetic_tokens = rng.integers(0, cfg.vocab_size, size=(batch_size, seq_len))

    t0 = time.perf_counter()
    loss_dict = model.compute_joint_loss(synthetic_tokens)
    elapsed_ms = (time.perf_counter() - t0) * 1000

    print(bold(green("\n=== MTP Multi-Token Joint Training Step ===\n")))
    print(f"  • Batch shape:           [{batch_size}, {seq_len}]")
    print(f"  • Main Token Loss (t+1): {loss_dict['loss_main']:.4f}")
    for idx, l_k in enumerate(loss_dict['mtp_individual']):
        print(f"  • MTP Head {idx+1} Loss (t+{idx+2}): {l_k:.4f}")
    print(f"  • Average MTP Loss:      {loss_dict['loss_mtp_avg']:.4f}")
    print(f"  • Joint Loss (lambda={cfg.lambda_mtp}): {loss_dict['loss_joint']:.4f}")
    print(f"  • Compute Time:          {elapsed_ms:.2f} ms")
    print()


def cmd_benchmark(args):
    cfg = MTPConfig(vocab_size=args.vocab, dim=args.dim, num_heads=args.heads, mtp_depth=args.depth)
    model = DeepSeekMTPModel(cfg)

    prompt_len = args.prompt_len
    gen_tokens = args.gen_tokens
    rng = np.random.default_rng(123)
    prompt = list(rng.integers(0, cfg.vocab_size, size=prompt_len))

    print(bold(cyan(f"\n=== Benchmarking Speculative MTP Drafting vs Autoregressive Decoding ===\n")))
    print(f"Prompt tokens: {prompt_len} | Target generated: {gen_tokens} tokens | MTP Depth: {cfg.mtp_depth}")
    print("-" * 65)

    # 1. Standard Autoregressive
    t0 = time.perf_counter()
    auto_tokens, auto_steps = model.standard_autoregressive_generate(prompt, max_new_tokens=gen_tokens)
    t_auto = time.perf_counter() - t0
    auto_tok_sec = gen_tokens / t_auto if t_auto > 0 else 0.0

    # 2. Speculative MTP Drafting
    t1 = time.perf_counter()
    spec_tokens, spec_stats = model.speculative_generate(prompt, max_new_tokens=gen_tokens)
    t_spec = time.perf_counter() - t1
    spec_tok_sec = spec_stats["total_generated"] / t_spec if t_spec > 0 else 0.0

    speedup_ratio = auto_steps / spec_stats["base_steps"] if spec_stats["base_steps"] > 0 else 1.0

    print(f"  {bold('Standard Autoregressive')}:")
    print(f"    • Forward Passes:      {auto_steps}")
    print(f"    • Latency:             {t_auto * 1000:.2f} ms ({auto_tok_sec:.1f} tokens/sec)")
    print(f"    • Tokens/Step:         1.00")
    print()
    print(f"  {bold('MTP Speculative Drafting')}:")
    print(f"    • Forward Passes:      {spec_stats['base_steps']} (reduced from {auto_steps})")
    print(f"    • Drafted Tokens:      {spec_stats['drafted_tokens']}")
    print(f"    • Accepted Tokens:     {spec_stats['accepted_tokens']}")
    print(f"    • Acceptance Rate:     {spec_stats['acceptance_rate'] * 100:.1f}%")
    print(f"    • Latency:             {t_spec * 1000:.2f} ms ({spec_tok_sec:.1f} tokens/sec)")
    print(f"    • Effective Speedup:   {speedup_ratio:.2f}x fewer model forward steps")
    print(f"    • Tokens/Step:         {spec_stats['tokens_per_step']:.2f}")
    print()


def cmd_verify(args):
    print(bold(cyan("\n=== Running DeepSeek-V3 MTP Mathematical Verification Suite ===\n")))
    cfg = MTPConfig(vocab_size=256, dim=64, num_heads=2, num_base_layers=2, mtp_depth=2)
    model = DeepSeekMTPModel(cfg)

    passed = True

    # 1. Verification of RMSNorm invariants
    norm = RMSNorm(64)
    test_x = np.random.randn(4, 8, 64)
    norm_out = norm.forward(test_x)
    rms_vals = np.sqrt(np.mean(norm_out ** 2, axis=-1))
    norm_err = float(np.max(np.abs(rms_vals - 1.0)))
    if norm_err < 1e-4:
        print(f"  {green('✔')} RMSNorm unit variance property verified (max err: {norm_err:.2e})")
    else:
        print(f"  {red('✘')} RMSNorm test failed: err={norm_err}")
        passed = False

    # 2. RMSNorm numerical gradient check
    eps = 1e-5
    grad_out = np.random.randn(*test_x.shape)
    analytic_grad = norm.backward(grad_out)
    num_grad = np.zeros_like(test_x)
    for i in range(min(5, test_x.shape[1])):
        for j in range(min(5, test_x.shape[2])):
            x_plus = test_x.copy()
            x_plus[0, i, j] += eps
            x_minus = test_x.copy()
            x_minus[0, i, j] -= eps
            y_p = norm.forward(x_plus)
            y_m = norm.forward(x_minus)
            num_grad[0, i, j] = np.sum((y_p - y_m) / (2 * eps) * grad_out)
    grad_err = float(np.max(np.abs(analytic_grad[0, :5, :5] - num_grad[0, :5, :5])))
    if grad_err < 1e-4:
        print(f"  {green('✔')} RMSNorm analytical gradient checked (max diff: {grad_err:.2e})")
    else:
        print(f"  {red('✘')} RMSNorm gradient check failed: diff={grad_err}")
        passed = False

    # 3. Parameter reuse check (Unembedding weight tying)
    for idx, mtp in enumerate(model.mtp_modules):
        is_shared = mtp.shared_unembed is model.w_head
        if is_shared:
            print(f"  {green('✔')} MTP Head {idx+1} strictly shares W_head with Base Model (Zero memory leak)")
        else:
            print(f"  {red('✘')} MTP Head {idx+1} failed shared unembedding constraint")
            passed = False

    # 4. Causal attention leakage test
    attn = CausalSelfAttention(64, 2)
    x_causal = np.random.randn(1, 10, 64)
    out_orig = attn.forward(x_causal)
    # Mutate future token at index 8 and check if output at index 3 changes
    x_mutated = x_causal.copy()
    x_mutated[0, 8, :] += 5.0
    out_mutated = attn.forward(x_mutated)
    causal_leak = float(np.max(np.abs(out_orig[0, :8, :] - out_mutated[0, :8, :])))
    if causal_leak < 1e-10:
        print(f"  {green('✔')} Causal attention masking strictly verified (leakage = {causal_leak:.2e})")
    else:
        print(f"  {red('✘')} Causal leakage detected: {causal_leak}")
        passed = False

    # 5. Speculative drafting consistency
    prompt = [12, 45, 99, 128]
    tokens_spec, stats = model.speculative_generate(prompt, max_new_tokens=8)
    if len(tokens_spec) == len(prompt) + 8:
        print(f"  {green('✔')} Speculative generation completed exact token target ({len(tokens_spec)} tokens)")
    else:
        print(f"  {red('✘')} Speculative generation length mismatch")
        passed = False

    print()
    if passed:
        print(bold(green("All mathematical and architectural invariants verified successfully.")))
        return 0
    else:
        print(bold(red("Verification failed.")))
        return 1


def main():
    parser = argparse.ArgumentParser(
        description="DeepSeek-V3 Multi-Token Prediction (MTP) & Speculative Drafting Engine"
    )
    subparsers = parser.add_subparsers(dest="command", help="Command to run")

    # status
    p_status = subparsers.add_parser("status", help="Inspect MTP architecture and memory overhead")
    p_status.add_argument("--vocab", type=int, default=1000)
    p_status.add_argument("--dim", type=int, default=128)
    p_status.add_argument("--heads", type=int, default=4)
    p_status.add_argument("--depth", type=int, default=2)
    p_status.add_argument("--json", action="store_true")

    # train-step
    p_train = subparsers.add_parser("train-step", help="Simulate a joint MTP training forward step")
    p_train.add_argument("--vocab", type=int, default=1000)
    p_train.add_argument("--dim", type=int, default=128)
    p_train.add_argument("--heads", type=int, default=4)
    p_train.add_argument("--depth", type=int, default=2)
    p_train.add_argument("--seq-len", type=int, default=32)
    p_train.add_argument("--batch-size", type=int, default=4)
    p_train.add_argument("--lambda-mtp", type=float, default=0.3)

    # benchmark
    p_bench = subparsers.add_parser("benchmark", help="Benchmark MTP speculative drafting vs autoregressive")
    p_bench.add_argument("--vocab", type=int, default=1000)
    p_bench.add_argument("--dim", type=int, default=128)
    p_bench.add_argument("--heads", type=int, default=4)
    p_bench.add_argument("--depth", type=int, default=2)
    p_bench.add_argument("--prompt-len", type=int, default=16)
    p_bench.add_argument("--gen-tokens", type=int, default=24)

    # verify
    subparsers.add_parser("verify", help="Run mathematical and architectural verification tests")

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        return 0

    if args.command == "status":
        cmd_status(args)
    elif args.command == "train-step":
        cmd_train_step(args)
    elif args.command == "benchmark":
        cmd_benchmark(args)
    elif args.command == "verify":
        return cmd_verify(args)
    return 0


if __name__ == "__main__":
    sys.exit(main() or 0)
