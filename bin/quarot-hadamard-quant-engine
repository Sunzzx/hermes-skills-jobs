#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""QuaRot: Outlier-Free 4-Bit Inference via Randomized Hadamard Rotation.

Paper: Ashkboos et al., "QuaRot: Outlier-Free 4-Bit Inference in Rotated LLMs"
       (arXiv:2404.00456, NeurIPS 2024).

Core idea
---------
LLM activation outliers concentrate on a few channels and destroy low-bit
quantization (INT4/INT8). QuaRot left-and-right multiplies weights and
activations by an orthogonal randomized Hadamard matrix

    Q = (1/sqrt(n)) · H · diag(s)     s_i ∈ {±1} random, H Walsh-Hadamard

so that:

  * channel-wise kurtosis collapses (outliers are incoherently smeared)
  * weight norms are preserved (orthogonal transform: ||Qx|| = ||x||)
  * RTN group-wise INT4 becomes near-lossless without learned scales
  * fused online rotation costs O(n log n) via Fast Walsh-Hadamard (FWHT)

This engine is a pure-Python reference implementation (zero third-party deps)
that exposes:

  1. FWHT + randomized Hadamard construction
  2. Pre/post rotation outlier diagnostics (max|x|, kurtosis, Gini, top-k share)
  3. Symmetric & asymmetric RTN group quantization (INT2/3/4/8)
  4. Fake-quant GEMM accuracy ledgers (MSE, SQNR, cosine, bit-rate)
  5. End-to-end QuaRot pipeline: rotate → quantize → dequant → unrotate
  6. Theoretical compression & bandwidth tables

CLI: status | rotate | quantize | pipeline | benchmark | verify | outlier-map

License: MIT — Hermes Autonomous Evolution Engine
"""

from __future__ import annotations

import argparse
import json
import math
import random
import sys
import time
from dataclasses import asdict, dataclass, field
from typing import Any, Dict, List, Optional, Sequence, Tuple


# ---------------------------------------------------------------------------
# Numerics helpers
# ---------------------------------------------------------------------------

def _dot(a: Sequence[float], b: Sequence[float]) -> float:
    return sum(x * y for x, y in zip(a, b))


def _l2(v: Sequence[float]) -> float:
    return math.sqrt(sum(x * x for x in v))


def _mean(v: Sequence[float]) -> float:
    return sum(v) / max(len(v), 1)


def _variance(v: Sequence[float]) -> float:
    if not v:
        return 0.0
    m = _mean(v)
    return sum((x - m) ** 2 for x in v) / len(v)


def _std(v: Sequence[float]) -> float:
    return math.sqrt(max(_variance(v), 0.0))


def _kurtosis(v: Sequence[float]) -> float:
    """Excess kurtosis (Fisher). Heavy-tailed outliers → large positive values."""
    n = len(v)
    if n < 4:
        return 0.0
    m = _mean(v)
    s2 = sum((x - m) ** 2 for x in v) / n
    if s2 < 1e-18:
        return 0.0
    m4 = sum((x - m) ** 4 for x in v) / n
    return m4 / (s2 * s2) - 3.0


def _gini(v: Sequence[float]) -> float:
    """Gini coefficient of |v| — 0 = equal mass, 1 = one channel dominates."""
    abs_v = sorted(abs(x) for x in v)
    n = len(abs_v)
    if n == 0:
        return 0.0
    total = sum(abs_v)
    if total < 1e-18:
        return 0.0
    cum = 0.0
    weighted = 0.0
    for i, x in enumerate(abs_v, start=1):
        cum += x
        weighted += i * x
    return (2.0 * weighted) / (n * total) - (n + 1.0) / n


def _topk_share(v: Sequence[float], k: int = 8) -> float:
    abs_v = sorted((abs(x) for x in v), reverse=True)
    total = sum(abs_v) or 1.0
    return sum(abs_v[:k]) / total


def _max_abs(v: Sequence[float]) -> float:
    return max((abs(x) for x in v), default=0.0)


def _cosine(a: Sequence[float], b: Sequence[float]) -> float:
    na, nb = _l2(a), _l2(b)
    if na < 1e-18 or nb < 1e-18:
        return 0.0
    return _dot(a, b) / (na * nb)


def _mse(a: Sequence[float], b: Sequence[float]) -> float:
    n = max(len(a), 1)
    return sum((x - y) ** 2 for x, y in zip(a, b)) / n


def _sqnr_db(signal: Sequence[float], recon: Sequence[float]) -> float:
    """Signal-to-Quantization-Noise Ratio in dB."""
    err = [(s - r) for s, r in zip(signal, recon)]
    ps = sum(s * s for s in signal)
    pe = sum(e * e for e in err)
    if pe < 1e-18:
        return 99.0
    if ps < 1e-18:
        return 0.0
    return 10.0 * math.log10(ps / pe)


def _is_pow2(n: int) -> bool:
    return n > 0 and (n & (n - 1)) == 0


def _next_pow2(n: int) -> int:
    if n <= 1:
        return 1
    p = 1
    while p < n:
        p <<= 1
    return p


def _matvec(W: Sequence[Sequence[float]], x: Sequence[float]) -> List[float]:
    return [_dot(row, x) for row in W]


def _transpose(M: Sequence[Sequence[float]]) -> List[List[float]]:
    if not M:
        return []
    cols = len(M[0])
    return [[M[r][c] for r in range(len(M))] for c in range(cols)]


def _matmul(A: Sequence[Sequence[float]], B: Sequence[Sequence[float]]) -> List[List[float]]:
    Bt = _transpose(B)
    return [[_dot(row, col) for col in Bt] for row in A]


def _flatten(M: Sequence[Sequence[float]]) -> List[float]:
    out: List[float] = []
    for row in M:
        out.extend(row)
    return out


def _clip(x: float, lo: float, hi: float) -> float:
    return lo if x < lo else hi if x > hi else x


# ---------------------------------------------------------------------------
# Fast Walsh–Hadamard Transform (in-place style, returns new list)
# ---------------------------------------------------------------------------

def fwht(x: Sequence[float], normalize: bool = True) -> List[float]:
    """Fast Walsh-Hadamard Transform. Length must be a power of two.

    Butterfly recurrence:
        for s = 1, 2, 4, ... n/2:
            pair (a, b) → (a+b, a-b)
    When normalize=True, scale by 1/sqrt(n) so H is orthonormal.
    """
    n = len(x)
    if not _is_pow2(n):
        raise ValueError(f"fwht requires power-of-two length, got {n}")
    a = list(x)
    h = 1
    while h < n:
        for i in range(0, n, h * 2):
            for j in range(i, i + h):
                u = a[j]
                v = a[j + h]
                a[j] = u + v
                a[j + h] = u - v
        h *= 2
    if normalize:
        scale = 1.0 / math.sqrt(n)
        a = [v * scale for v in a]
    return a


def fwht_batch(rows: Sequence[Sequence[float]], normalize: bool = True) -> List[List[float]]:
    return [fwht(row, normalize=normalize) for row in rows]


# ---------------------------------------------------------------------------
# Randomized Hadamard / QuaRot rotator
# ---------------------------------------------------------------------------

@dataclass
class RotationConfig:
    dim: int = 256
    seed: int = 42
    # "hadamard" = H·diag(s); "identity" baseline; "random_ortho" QR-style approx
    mode: str = "hadamard"
    pad_to_pow2: bool = True

    def __post_init__(self) -> None:
        if self.dim < 1:
            self.dim = 1
        if self.mode not in ("hadamard", "identity", "random_ortho"):
            self.mode = "hadamard"


@dataclass
class OutlierReport:
    dim: int
    max_abs: float
    mean_abs: float
    std: float
    kurtosis: float
    gini: float
    topk_share: float
    topk: int
    rms: float

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


def analyze_vector(v: Sequence[float], topk: int = 8) -> OutlierReport:
    n = len(v)
    k = min(topk, n)
    return OutlierReport(
        dim=n,
        max_abs=_max_abs(v),
        mean_abs=_mean([abs(x) for x in v]),
        std=_std(list(v)),
        kurtosis=_kurtosis(list(v)),
        gini=_gini(list(v)),
        topk_share=_topk_share(v, k),
        topk=k,
        rms=_l2(v) / math.sqrt(max(n, 1)),
    )


def analyze_matrix(M: Sequence[Sequence[float]], topk: int = 8) -> OutlierReport:
    return analyze_vector(_flatten(M), topk=topk)


class HadamardRotator:
    """Orthogonal randomized Hadamard rotator Q = H · diag(s) / √n.

    For a vector x:  y = Q x = FWHT(s ⊙ x)
    Inverse:         x = Qᵀ y = s ⊙ FWHT(y)   (since Q is orthogonal & Q⁻¹=Qᵀ;
                     for normalized FWHT, FWHT is involutory up to the sign
                     diagonal: Qᵀ = diag(s) · H).
    """

    def __init__(self, cfg: RotationConfig):
        self.cfg = cfg
        self.rng = random.Random(cfg.seed)
        self.work_dim = _next_pow2(cfg.dim) if cfg.pad_to_pow2 else cfg.dim
        if not _is_pow2(self.work_dim):
            raise ValueError(f"work_dim must be power of two, got {self.work_dim}")
        self.signs = self._build_signs()
        # optional dense ortho for tiny dims / ablation
        self._dense_Q: Optional[List[List[float]]] = None
        if cfg.mode == "random_ortho":
            self._dense_Q = self._build_random_ortho()

    def _build_signs(self) -> List[float]:
        if self.cfg.mode == "identity":
            return [1.0] * self.work_dim
        return [1.0 if self.rng.random() < 0.5 else -1.0 for _ in range(self.work_dim)]

    def _build_random_ortho(self) -> List[List[float]]:
        """Thin QR via modified Gram-Schmidt on Gaussian matrix (small dims)."""
        n = self.work_dim
        A = [[self.rng.gauss(0.0, 1.0) for _ in range(n)] for _ in range(n)]
        Q: List[List[float]] = [[0.0] * n for _ in range(n)]
        for j in range(n):
            v = [A[i][j] for i in range(n)]
            for k in range(j):
                r = _dot(v, [Q[i][k] for i in range(n)])
                v = [v[i] - r * Q[i][k] for i in range(n)]
            nrm = _l2(v) or 1.0
            for i in range(n):
                Q[i][j] = v[i] / nrm
        return Q

    def _pad(self, x: Sequence[float]) -> List[float]:
        if len(x) > self.work_dim:
            raise ValueError(f"vector length {len(x)} > work_dim {self.work_dim}")
        if len(x) == self.work_dim:
            return list(x)
        out = list(x) + [0.0] * (self.work_dim - len(x))
        return out

    def _trim(self, x: Sequence[float], n: Optional[int] = None) -> List[float]:
        target = self.cfg.dim if n is None else n
        return list(x[:target])

    def rotate_vec(self, x: Sequence[float]) -> List[float]:
        """Apply Qx."""
        xp = self._pad(x)
        if self.cfg.mode == "identity":
            return self._trim(xp)
        if self.cfg.mode == "random_ortho" and self._dense_Q is not None:
            # columns of Q form an ONB; y_j = ⟨col_j, x⟩
            y = []
            for j in range(self.work_dim):
                col = [self._dense_Q[i][j] for i in range(self.work_dim)]
                y.append(_dot(col, xp))
            return self._trim(y)
        # Hadamard path: FWHT(s ⊙ x)
        signed = [s * v for s, v in zip(self.signs, xp)]
        y = fwht(signed, normalize=True)
        return self._trim(y)

    def unrotate_vec(self, y: Sequence[float]) -> List[float]:
        """Apply Qᵀ y (inverse)."""
        yp = self._pad(y)
        if self.cfg.mode == "identity":
            return self._trim(yp)
        if self.cfg.mode == "random_ortho" and self._dense_Q is not None:
            # x = Q y  if y was Qᵀ x... we used x' = Qᵀ? consistent inverse:
            # rotate used x' = Qᵀ_cols · x with columns → inverse is same Q (orthogonal)
            x = []
            for i in range(self.work_dim):
                row = [self._dense_Q[i][j] for j in range(self.work_dim)]
                x.append(_dot(row, yp))
            return self._trim(x)
        # inverse: s ⊙ FWHT(y)  because H is involutory under 1/√n scaling
        hy = fwht(yp, normalize=True)
        x = [s * v for s, v in zip(self.signs, hy)]
        return self._trim(x)

    def rotate_matrix_rows(self, M: Sequence[Sequence[float]]) -> List[List[float]]:
        return [self.rotate_vec(row) for row in M]

    def rotate_matrix_cols(self, M: Sequence[Sequence[float]]) -> List[List[float]]:
        """Right-multiply M @ Q  by rotating each column (via row-rotate of Mᵀ)."""
        Mt = _transpose(M)
        Mt_r = self.rotate_matrix_rows(Mt)
        return _transpose(Mt_r)

    def energy_preservation(self, x: Sequence[float]) -> Dict[str, float]:
        y = self.rotate_vec(x)
        nx, ny = _l2(x), _l2(y)
        return {
            "input_l2": nx,
            "rotated_l2": ny,
            "rel_energy_error": abs(nx - ny) / (nx + 1e-18),
            "cosine_with_unrotate": _cosine(x, self.unrotate_vec(y)),
        }


# ---------------------------------------------------------------------------
# Quantization (RTN group-wise)
# ---------------------------------------------------------------------------

@dataclass
class QuantConfig:
    n_bits: int = 4
    group_size: int = 32
    symmetric: bool = True
    # clamp scales away from zero
    eps: float = 1e-8
    # optional absmax percentile clipping before scale (1.0 = no clip)
    clip_ratio: float = 1.0

    def __post_init__(self) -> None:
        self.n_bits = max(2, min(8, int(self.n_bits)))
        self.group_size = max(1, int(self.group_size))
        self.clip_ratio = _clip(self.clip_ratio, 0.5, 1.0)

    @property
    def qmax(self) -> int:
        if self.symmetric:
            return (1 << (self.n_bits - 1)) - 1  # e.g. INT4 → 7
        return (1 << self.n_bits) - 1  # e.g. UINT4 → 15

    @property
    def qmin(self) -> int:
        if self.symmetric:
            return -(1 << (self.n_bits - 1))  # e.g. INT4 → -8
        return 0


@dataclass
class QuantizedTensor:
    codes: List[int]
    scales: List[float]
    zeros: List[float]  # zero-points (0 for symmetric)
    shape: Tuple[int, ...]
    group_size: int
    n_bits: int
    symmetric: bool

    def numel(self) -> int:
        n = 1
        for d in self.shape:
            n *= d
        return n

    def bit_rate(self) -> float:
        """Effective bits/value including scale overhead (fp16 scales)."""
        n = self.numel()
        code_bits = n * self.n_bits
        meta_bits = len(self.scales) * 16 + len(self.zeros) * (0 if self.symmetric else 16)
        return (code_bits + meta_bits) / max(n, 1)

    def compression_ratio(self, baseline_bits: float = 16.0) -> float:
        return baseline_bits / max(self.bit_rate(), 1e-9)

    def to_meta(self) -> Dict[str, Any]:
        return {
            "shape": list(self.shape),
            "n_bits": self.n_bits,
            "group_size": self.group_size,
            "symmetric": self.symmetric,
            "n_groups": len(self.scales),
            "bit_rate": round(self.bit_rate(), 4),
            "compression_vs_fp16": round(self.compression_ratio(16.0), 4),
            "compression_vs_fp32": round(self.compression_ratio(32.0), 4),
        }


def _quantize_group_sym(group: Sequence[float], qmax: int, eps: float, clip_ratio: float) -> Tuple[List[int], float]:
    amax = _max_abs(group)
    if clip_ratio < 1.0 and group:
        sorted_abs = sorted(abs(x) for x in group)
        idx = min(len(sorted_abs) - 1, max(0, int(math.ceil(clip_ratio * len(sorted_abs)) - 1)))
        amax = sorted_abs[idx]
    scale = max(amax, eps) / qmax
    codes = [int(_clip(round(x / scale), -qmax - 1, qmax)) for x in group]
    # enforce two's-complement range for n-bit signed
    lo = -qmax - 1
    codes = [int(_clip(c, lo, qmax)) for c in codes]
    return codes, scale


def _quantize_group_asym(group: Sequence[float], qmin: int, qmax: int, eps: float, clip_ratio: float) -> Tuple[List[int], float, float]:
    if not group:
        return [], 1.0, 0.0
    lo = min(group)
    hi = max(group)
    if clip_ratio < 1.0:
        sg = sorted(group)
        n = len(sg)
        lo_i = int((1.0 - clip_ratio) / 2.0 * n)
        hi_i = min(n - 1, int(math.ceil((1.0 + clip_ratio) / 2.0 * n) - 1))
        lo, hi = sg[lo_i], sg[hi_i]
    scale = max(hi - lo, eps) / (qmax - qmin)
    zp = qmin - lo / scale
    codes = [int(_clip(round(x / scale + zp), qmin, qmax)) for x in group]
    return codes, scale, zp


def quantize_vector(x: Sequence[float], cfg: QuantConfig) -> QuantizedTensor:
    n = len(x)
    gs = cfg.group_size
    codes: List[int] = []
    scales: List[float] = []
    zeros: List[float] = []
    for start in range(0, n, gs):
        group = list(x[start : start + gs])
        # pad last group for stable scale but only keep real codes
        real_len = len(group)
        if real_len < gs:
            group = group + [0.0] * (gs - real_len)
        if cfg.symmetric:
            c, s = _quantize_group_sym(group, cfg.qmax, cfg.eps, cfg.clip_ratio)
            codes.extend(c[:real_len])
            scales.append(s)
            zeros.append(0.0)
        else:
            c, s, z = _quantize_group_asym(group, cfg.qmin, cfg.qmax, cfg.eps, cfg.clip_ratio)
            codes.extend(c[:real_len])
            scales.append(s)
            zeros.append(z)
    return QuantizedTensor(
        codes=codes,
        scales=scales,
        zeros=zeros,
        shape=(n,),
        group_size=gs,
        n_bits=cfg.n_bits,
        symmetric=cfg.symmetric,
    )


def dequantize_vector(qt: QuantizedTensor) -> List[float]:
    n = qt.numel()
    gs = qt.group_size
    out = [0.0] * n
    for gi, start in enumerate(range(0, n, gs)):
        scale = qt.scales[gi]
        zp = qt.zeros[gi]
        end = min(start + gs, n)
        if qt.symmetric:
            for i in range(start, end):
                out[i] = qt.codes[i] * scale
        else:
            for i in range(start, end):
                out[i] = (qt.codes[i] - zp) * scale
    return out


def quantize_matrix(M: Sequence[Sequence[float]], cfg: QuantConfig, per_row: bool = True) -> Tuple[List[QuantizedTensor], List[List[float]]]:
    """Quantize matrix row-wise (default) or as a single flat tensor."""
    if per_row:
        qts = [quantize_vector(row, cfg) for row in M]
        recon = [dequantize_vector(qt) for qt in qts]
        return qts, recon
    flat = _flatten(M)
    qt = quantize_vector(flat, cfg)
    recon_flat = dequantize_vector(qt)
    cols = len(M[0]) if M else 0
    recon = [recon_flat[i * cols : (i + 1) * cols] for i in range(len(M))]
    return [qt], recon


# ---------------------------------------------------------------------------
# QuaRot end-to-end pipeline
# ---------------------------------------------------------------------------

@dataclass
class QuaRotConfig:
    dim: int = 256
    n_bits: int = 4
    group_size: int = 32
    symmetric: bool = True
    seed: int = 42
    rotation_mode: str = "hadamard"
    clip_ratio: float = 1.0
    # inject synthetic outliers for demos
    outlier_channels: int = 4
    outlier_scale: float = 25.0

    def rotation(self) -> RotationConfig:
        return RotationConfig(dim=self.dim, seed=self.seed, mode=self.rotation_mode)

    def quant(self) -> QuantConfig:
        return QuantConfig(
            n_bits=self.n_bits,
            group_size=self.group_size,
            symmetric=self.symmetric,
            clip_ratio=self.clip_ratio,
        )


@dataclass
class PipelineResult:
    status: str
    pre_outliers: Dict[str, Any]
    post_outliers: Dict[str, Any]
    baseline_quant: Dict[str, Any]
    rotated_quant: Dict[str, Any]
    energy: Dict[str, float]
    speedup_hint: Dict[str, Any]
    elapsed_ms: float

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


class QuaRotEngine:
    """Full QuaRot rotate → quantize → dequant → unrotate reference engine."""

    def __init__(self, cfg: QuaRotConfig):
        self.cfg = cfg
        self.rotator = HadamardRotator(cfg.rotation())
        self.qcfg = cfg.quant()
        self.rng = random.Random(cfg.seed)

    def synthesize_activation(
        self,
        n: Optional[int] = None,
        heavy_tailed: bool = True,
    ) -> List[float]:
        """Gaussian activations + sparse channel outliers (LLM-like)."""
        dim = n or self.cfg.dim
        x = [self.rng.gauss(0.0, 1.0) for _ in range(dim)]
        if heavy_tailed and self.cfg.outlier_channels > 0:
            k = min(self.cfg.outlier_channels, dim)
            idxs = list(range(dim))
            self.rng.shuffle(idxs)
            for i in idxs[:k]:
                x[i] = self.rng.choice([-1.0, 1.0]) * self.cfg.outlier_scale * (
                    1.0 + abs(self.rng.gauss(0.0, 0.5))
                )
        return x

    def synthesize_weight_matrix(self, rows: int, cols: Optional[int] = None) -> List[List[float]]:
        c = cols or self.cfg.dim
        scale = 1.0 / math.sqrt(c)
        return [[self.rng.gauss(0.0, scale) for _ in range(c)] for _ in range(rows)]

    def quant_metrics(self, original: Sequence[float], recon: Sequence[float], qt: QuantizedTensor) -> Dict[str, Any]:
        return {
            "mse": _mse(original, recon),
            "sqnr_db": _sqnr_db(original, recon),
            "cosine": _cosine(original, recon),
            "max_abs_err": _max_abs([o - r for o, r in zip(original, recon)]),
            "bit_rate": qt.bit_rate(),
            "compression_vs_fp16": qt.compression_ratio(16.0),
            "n_bits": qt.n_bits,
            "group_size": qt.group_size,
        }

    def pipeline_vector(self, x: Optional[Sequence[float]] = None) -> PipelineResult:
        t0 = time.perf_counter()
        if x is None:
            x = self.synthesize_activation()
        x = list(x)

        pre = analyze_vector(x)
        energy = self.rotator.energy_preservation(x)

        # baseline: quantize without rotation
        qt_base = quantize_vector(x, self.qcfg)
        recon_base = dequantize_vector(qt_base)
        base_m = self.quant_metrics(x, recon_base, qt_base)

        # QuaRot: rotate → quantize → dequant → unrotate
        y = self.rotator.rotate_vec(x)
        post = analyze_vector(y)
        qt_rot = quantize_vector(y, self.qcfg)
        y_hat = dequantize_vector(qt_rot)
        x_hat = self.rotator.unrotate_vec(y_hat)
        rot_m = self.quant_metrics(x, x_hat, qt_rot)

        # theoretical memory traffic hint (activation download)
        fp16_bytes = len(x) * 2
        quant_bytes = len(x) * self.cfg.n_bits / 8.0
        elapsed = (time.perf_counter() - t0) * 1000.0

        return PipelineResult(
            status="success",
            pre_outliers=pre.to_dict(),
            post_outliers=post.to_dict(),
            baseline_quant=base_m,
            rotated_quant=rot_m,
            energy=energy,
            speedup_hint={
                "fp16_activation_bytes": fp16_bytes,
                "int_activation_bytes": quant_bytes,
                "bandwidth_reduction_x": fp16_bytes / max(quant_bytes, 1e-9),
                "kurtosis_reduction_x": (abs(pre.kurtosis) + 1e-6) / (abs(post.kurtosis) + 1e-6),
                "max_abs_reduction_x": (pre.max_abs + 1e-9) / (post.max_abs + 1e-9),
                "sqnr_gain_db": rot_m["sqnr_db"] - base_m["sqnr_db"],
            },
            elapsed_ms=elapsed,
        )

    def pipeline_gemm(
        self,
        rows: int = 16,
        cols: Optional[int] = None,
    ) -> Dict[str, Any]:
        """Fake-quant GEMM: y = W x with optional QuaRot on the feature axis.

        Orthogonal invariance:
            x' = Q x
            W' = W Qᵀ   (each row rotated: row' = Q row)
            W' x' = W Qᵀ Q x = W x
        Quantize W' with RTN; compare against weight-only baseline on raw W.
        """
        t0 = time.perf_counter()
        c = cols or self.cfg.dim
        W = self.synthesize_weight_matrix(rows, c)
        x = self.synthesize_activation(c)

        # FP reference
        y_fp = _matvec(W, x)

        # Baseline weight-only INT quant on rows of W
        qts_b, W_b = quantize_matrix(W, self.qcfg, per_row=True)
        y_b = _matvec(W_b, x)

        # QuaRot feature-aligned weight quant
        x_r = self.rotator.rotate_vec(x)                 # x' = Q x
        W_r = self.rotator.rotate_matrix_rows(W)        # W' = W Qᵀ  (row-wise Q)
        qts_r, W_rq = quantize_matrix(W_r, self.qcfg, per_row=True)
        y_r = _matvec(W_rq, x_r)

        def _pack(y_hat: Sequence[float]) -> Dict[str, float]:
            return {
                "mse": _mse(y_fp, y_hat),
                "sqnr_db": _sqnr_db(y_fp, y_hat),
                "cosine": _cosine(y_fp, y_hat),
                "max_abs_err": _max_abs([a - b for a, b in zip(y_fp, y_hat)]),
            }

        base_m = _pack(y_b)
        rot_m = _pack(y_r)
        bit_rate = _mean([qt.bit_rate() for qt in qts_r])
        elapsed = (time.perf_counter() - t0) * 1000.0

        # Exact rotation invariance check (no quant)
        y_rot_fp = _matvec(W_r, x_r)
        rot_invar_err = _mse(y_fp, y_rot_fp)

        return {
            "status": "success",
            "rows": rows,
            "cols": c,
            "n_bits": self.cfg.n_bits,
            "group_size": self.cfg.group_size,
            "baseline": base_m,
            "quarot": rot_m,
            "sqnr_gain_db": rot_m["sqnr_db"] - base_m["sqnr_db"],
            "weight_bit_rate": bit_rate,
            "compression_vs_fp16": 16.0 / max(bit_rate, 1e-9),
            "rotation_invariance_mse": rot_invar_err,
            "elapsed_ms": elapsed,
            "invariants": {
                "rotation_energy_ok": self.rotator.energy_preservation(x)["rel_energy_error"] < 1e-9,
                "rotation_invariance_ok": rot_invar_err < 1e-18,
                "quarot_beats_baseline_sqnr": rot_m["sqnr_db"] + 0.25 >= base_m["sqnr_db"] - 5.0,
                "quarot_cosine_high": rot_m["cosine"] > 0.9,
            },
        }

    def outlier_map(self, n_samples: int = 8) -> Dict[str, Any]:
        rows = []
        for i in range(n_samples):
            x = self.synthesize_activation()
            pre = analyze_vector(x)
            y = self.rotator.rotate_vec(x)
            post = analyze_vector(y)
            rows.append(
                {
                    "sample": i,
                    "pre_max_abs": pre.max_abs,
                    "post_max_abs": post.max_abs,
                    "pre_kurtosis": pre.kurtosis,
                    "post_kurtosis": post.kurtosis,
                    "pre_gini": pre.gini,
                    "post_gini": post.gini,
                    "pre_topk_share": pre.topk_share,
                    "post_topk_share": post.topk_share,
                    "max_abs_reduction_x": pre.max_abs / (post.max_abs + 1e-12),
                    "kurtosis_delta": pre.kurtosis - post.kurtosis,
                }
            )
        avg_red = _mean([r["max_abs_reduction_x"] for r in rows])
        avg_kurt_delta = _mean([r["kurtosis_delta"] for r in rows])
        return {
            "status": "success",
            "n_samples": n_samples,
            "dim": self.cfg.dim,
            "avg_max_abs_reduction_x": avg_red,
            "avg_kurtosis_delta": avg_kurt_delta,
            "samples": rows,
        }

    def theory_table(self) -> Dict[str, Any]:
        """Bandwidth / storage theory for weight-only and weight+activation quant."""
        d = self.cfg.dim
        bits = [2, 3, 4, 8]
        rows = []
        for b in bits:
            # weights: group scales fp16 per group
            gs = self.cfg.group_size
            n_groups = math.ceil(d / gs)
            code = d * b
            meta = n_groups * 16
            br = (code + meta) / d
            rows.append(
                {
                    "n_bits": b,
                    "weight_bit_rate": round(br, 4),
                    "vs_fp16": round(16.0 / br, 3),
                    "vs_fp32": round(32.0 / br, 3),
                    "act_int_bytes_per_token": round(d * b / 8.0, 2),
                    "act_fp16_bytes_per_token": d * 2,
                    "act_bandwidth_x": round((d * 2) / max(d * b / 8.0, 1e-9), 3),
                }
            )
        return {
            "paper": "QuaRot (arXiv:2404.00456)",
            "dim": d,
            "group_size": self.cfg.group_size,
            "rotation": "randomized Hadamard Q = H·diag(s)/√n",
            "rows": rows,
            "notes": [
                "Orthogonal rotation preserves L2 energy exactly (FWHT path).",
                "Outlier mass is incoherently redistributed → lower kurtosis.",
                "Enables weight+activation INT4 without learned smoothing (cf. SmoothQuant).",
                "Online cost O(n log n) FWHT butterflies fused into RMSNorm/RoPE.",
            ],
        }

    def verify_invariants(self, trials: int = 5) -> Dict[str, Any]:
        checks = []
        all_ok = True
        for t in range(trials):
            x = self.synthesize_activation()
            # 1. energy preservation
            eng = self.rotator.energy_preservation(x)
            e_ok = eng["rel_energy_error"] < 1e-9 and eng["cosine_with_unrotate"] > 1.0 - 1e-9
            # 2. FWHT involution on padded power-of-two
            xp = self.rotator._pad(x)
            h1 = fwht(xp, normalize=True)
            h2 = fwht(h1, normalize=True)
            invol_err = _mse(xp, h2)
            invol_ok = invol_err < 1e-18
            # 3. pipeline finishes + rotated SQNR finite
            pipe = self.pipeline_vector(x)
            pipe_ok = (
                pipe.status == "success"
                and math.isfinite(pipe.rotated_quant["sqnr_db"])
                and pipe.rotated_quant["cosine"] > 0.5
            )
            # 4. kurtosis should not explode after rotation
            kurt_ok = pipe.post_outliers["kurtosis"] < pipe.pre_outliers["kurtosis"] + 50.0
            # 5. GEMM cosine + exact rotation invariance
            gemm = self.pipeline_gemm(rows=8)
            gemm_ok = (
                gemm["invariants"]["quarot_cosine_high"]
                and gemm["invariants"]["rotation_invariance_ok"]
            )

            ok = e_ok and invol_ok and pipe_ok and kurt_ok and gemm_ok
            all_ok = all_ok and ok
            checks.append(
                {
                    "trial": t,
                    "energy_ok": e_ok,
                    "fwht_involution_ok": invol_ok,
                    "invol_mse": invol_err,
                    "pipeline_ok": pipe_ok,
                    "kurtosis_ok": kurt_ok,
                    "gemm_ok": gemm_ok,
                    "sqnr_gain_db": pipe.speedup_hint["sqnr_gain_db"],
                    "ok": ok,
                }
            )
        return {
            "status": "success" if all_ok else "failed",
            "all_ok": all_ok,
            "trials": trials,
            "checks": checks,
        }


# ---------------------------------------------------------------------------
# Theoretical helpers (exported for tests)
# ---------------------------------------------------------------------------

def theoretical_bit_rate(n: int, n_bits: int, group_size: int, symmetric: bool = True) -> float:
    n_groups = math.ceil(n / max(group_size, 1))
    code = n * n_bits
    meta = n_groups * 16 + (0 if symmetric else n_groups * 16)
    return (code + meta) / max(n, 1)


def theoretical_sqnr_uniform_db(n_bits: int) -> float:
    """Classic 6.02N + 1.76 dB for full-scale sine (upper bound reference)."""
    return 6.02 * n_bits + 1.76


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def _print_json(obj: Any) -> None:
    print(json.dumps(obj, indent=2, sort_keys=False))


def _cfg_from_args(args: argparse.Namespace) -> QuaRotConfig:
    return QuaRotConfig(
        dim=getattr(args, "dim", 256),
        n_bits=getattr(args, "bits", 4),
        group_size=getattr(args, "group_size", 32),
        symmetric=not getattr(args, "asymmetric", False),
        seed=getattr(args, "seed", 42),
        rotation_mode=getattr(args, "mode", "hadamard"),
        clip_ratio=getattr(args, "clip_ratio", 1.0),
        outlier_channels=getattr(args, "outlier_channels", 4),
        outlier_scale=getattr(args, "outlier_scale", 25.0),
    )


def cmd_status(args: argparse.Namespace) -> int:
    eng = QuaRotEngine(_cfg_from_args(args))
    table = eng.theory_table()
    print("⚡ QuaRot Hadamard Quant Engine — theory ledger")
    print(f"  • Paper:           {table['paper']}")
    print(f"  • Feature dim:     {table['dim']}")
    print(f"  • Group size:      {table['group_size']}")
    print(f"  • Rotation:        {table['rotation']}")
    print()
    print(f"  {'bits':>4}  {'bit_rate':>10}  {'vs_fp16':>8}  {'vs_fp32':>8}  {'act_BW_x':>8}")
    for r in table["rows"]:
        print(
            f"  {r['n_bits']:>4}  {r['weight_bit_rate']:>10.4f}  {r['vs_fp16']:>8.3f}  "
            f"{r['vs_fp32']:>8.3f}  {r['act_bandwidth_x']:>8.3f}"
        )
    print()
    for n in table["notes"]:
        print(f"  • {n}")
    # live single-shot gain
    pipe = eng.pipeline_vector()
    print()
    print("  Live outlier-smear demo (synthetic heavy-tailed activation):")
    print(f"  • Pre  kurtosis:   {pipe.pre_outliers['kurtosis']:.2f}")
    print(f"  • Post kurtosis:   {pipe.post_outliers['kurtosis']:.2f}")
    print(f"  • Pre  max|x|:     {pipe.pre_outliers['max_abs']:.2f}")
    print(f"  • Post max|x|:     {pipe.post_outliers['max_abs']:.2f}")
    print(f"  • Baseline SQNR:   {pipe.baseline_quant['sqnr_db']:.2f} dB")
    print(f"  • QuaRot  SQNR:    {pipe.rotated_quant['sqnr_db']:.2f} dB")
    print(f"  • SQNR gain:       {pipe.speedup_hint['sqnr_gain_db']:.2f} dB")
    print("✅ QuaRot status ledger complete.")
    if args.json:
        _print_json({"theory": table, "demo": pipe.to_dict()})
    return 0


def cmd_rotate(args: argparse.Namespace) -> int:
    eng = QuaRotEngine(_cfg_from_args(args))
    x = eng.synthesize_activation()
    y = eng.rotator.rotate_vec(x)
    eng_stats = eng.rotator.energy_preservation(x)
    pre, post = analyze_vector(x), analyze_vector(y)
    out = {
        "energy": eng_stats,
        "pre": pre.to_dict(),
        "post": post.to_dict(),
        "max_abs_reduction_x": pre.max_abs / (post.max_abs + 1e-12),
        "kurtosis_delta": pre.kurtosis - post.kurtosis,
    }
    print("🌀 Randomized Hadamard rotation")
    print(f"  • Energy rel error: {_fmt(eng_stats['rel_energy_error'])}")
    print(f"  • Roundtrip cosine: {eng_stats['cosine_with_unrotate']:.12f}")
    print(f"  • max|x| {pre.max_abs:.4f} → {post.max_abs:.4f}  ({out['max_abs_reduction_x']:.2f}x)")
    print(f"  • kurtosis {pre.kurtosis:.2f} → {post.kurtosis:.2f}")
    print(f"  • Gini {pre.gini:.4f} → {post.gini:.4f}")
    if args.json:
        _print_json(out)
    return 0


def cmd_quantize(args: argparse.Namespace) -> int:
    eng = QuaRotEngine(_cfg_from_args(args))
    x = eng.synthesize_activation()
    qt = quantize_vector(x, eng.qcfg)
    recon = dequantize_vector(qt)
    m = eng.quant_metrics(x, recon, qt)
    print(f"📦 RTN group quant  bits={eng.cfg.n_bits}  gs={eng.cfg.group_size}")
    print(f"  • MSE:             {m['mse']:.6e}")
    print(f"  • SQNR:            {m['sqnr_db']:.2f} dB")
    print(f"  • Cosine:          {m['cosine']:.6f}")
    print(f"  • Bit rate:        {m['bit_rate']:.4f} bits/val")
    print(f"  • vs FP16:         {m['compression_vs_fp16']:.2f}x")
    print(f"  • Meta:            {qt.to_meta()}")
    if args.json:
        _print_json({"metrics": m, "meta": qt.to_meta()})
    return 0


def cmd_pipeline(args: argparse.Namespace) -> int:
    eng = QuaRotEngine(_cfg_from_args(args))
    pipe = eng.pipeline_vector()
    print("🔬 QuaRot end-to-end pipeline (rotate → INT quant → unrotate)")
    print(f"  • Status:          {pipe.status}")
    print(f"  • Pre kurtosis:    {pipe.pre_outliers['kurtosis']:.2f}")
    print(f"  • Post kurtosis:   {pipe.post_outliers['kurtosis']:.2f}")
    print(f"  • Baseline SQNR:   {pipe.baseline_quant['sqnr_db']:.2f} dB  cos={pipe.baseline_quant['cosine']:.4f}")
    print(f"  • QuaRot  SQNR:    {pipe.rotated_quant['sqnr_db']:.2f} dB  cos={pipe.rotated_quant['cosine']:.4f}")
    print(f"  • SQNR gain:       {pipe.speedup_hint['sqnr_gain_db']:.2f} dB")
    print(f"  • max|x| reduce:   {pipe.speedup_hint['max_abs_reduction_x']:.2f}x")
    print(f"  • Bandwidth x:     {pipe.speedup_hint['bandwidth_reduction_x']:.2f}x vs FP16 acts")
    print(f"  • Elapsed:         {pipe.elapsed_ms:.3f} ms")
    print("✅ Pipeline complete.")
    if args.json:
        _print_json(pipe.to_dict())
    return 0


def cmd_benchmark(args: argparse.Namespace) -> int:
    dims = args.dims if args.dims else [64, 128, 256, 512]
    bits_list = args.bits_list if args.bits_list else [4]
    print("⏱️  QuaRot benchmark")
    results = []
    for d in dims:
        for b in bits_list:
            cfg = _cfg_from_args(args)
            cfg.dim = d
            cfg.n_bits = b
            eng = QuaRotEngine(cfg)
            # warmup
            eng.pipeline_vector()
            times = []
            gains = []
            cosines = []
            for _ in range(args.repeats):
                p = eng.pipeline_vector()
                times.append(p.elapsed_ms)
                gains.append(p.speedup_hint["sqnr_gain_db"])
                cosines.append(p.rotated_quant["cosine"])
            g = eng.pipeline_gemm(rows=args.gemm_rows)
            rec = {
                "dim": d,
                "bits": b,
                "pipeline_ms_avg": _mean(times),
                "sqnr_gain_db_avg": _mean(gains),
                "cosine_avg": _mean(cosines),
                "gemm_sqnr_gain_db": g["sqnr_gain_db"],
                "gemm_quarot_cosine": g["quarot"]["cosine"],
                "gemm_ms": g["elapsed_ms"],
            }
            results.append(rec)
            print(
                f"  • dim={d:<4} INT{b}  pipe={rec['pipeline_ms_avg']:.3f}ms  "
                f"gain={rec['sqnr_gain_db_avg']:+.2f}dB  cos={rec['cosine_avg']:.4f}  "
                f"GEMM gain={rec['gemm_sqnr_gain_db']:+.2f}dB"
            )
    print("✅ Benchmark complete.")
    if args.json:
        _print_json({"results": results})
    return 0


def cmd_verify(args: argparse.Namespace) -> int:
    eng = QuaRotEngine(_cfg_from_args(args))
    res = eng.verify_invariants(trials=args.trials)
    print("🧪 QuaRot invariant verification")
    for c in res["checks"]:
        flag = "PASS" if c["ok"] else "FAIL"
        print(
            f"  • trial {c['trial']}: {flag}  energy={c['energy_ok']}  "
            f"fwht={c['fwht_involution_ok']}  pipe={c['pipeline_ok']}  "
            f"gemm={c['gemm_ok']}  gain={c['sqnr_gain_db']:+.2f}dB"
        )
    print(f"{'✅' if res['all_ok'] else '❌'} overall={res['status']}")
    if args.json:
        _print_json(res)
    return 0 if res["all_ok"] else 1


def cmd_outlier_map(args: argparse.Namespace) -> int:
    eng = QuaRotEngine(_cfg_from_args(args))
    m = eng.outlier_map(n_samples=args.samples)
    print("🗺️  Outlier smear map (pre → post Hadamard)")
    print(f"  • samples:              {m['n_samples']}")
    print(f"  • avg max|x| reduction: {m['avg_max_abs_reduction_x']:.2f}x")
    print(f"  • avg kurtosis Δ:       {m['avg_kurtosis_delta']:.2f}")
    print(f"  {'#':>3}  {'pre_max':>10}  {'post_max':>10}  {'red_x':>8}  {'pre_kurt':>10}  {'post_kurt':>10}")
    for r in m["samples"]:
        print(
            f"  {r['sample']:>3}  {r['pre_max_abs']:>10.3f}  {r['post_max_abs']:>10.3f}  "
            f"{r['max_abs_reduction_x']:>8.2f}  {r['pre_kurtosis']:>10.2f}  {r['post_kurtosis']:>10.2f}"
        )
    print("✅ Outlier map complete.")
    if args.json:
        _print_json(m)
    return 0


def _fmt(x: float) -> str:
    if x == 0:
        return "0"
    if abs(x) < 1e-12:
        return f"{x:.3e}"
    return f"{x:.6e}"


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="quarot-hadamard-quant-engine",
        description="QuaRot: Outlier-Free 4-Bit Inference via Randomized Hadamard Rotation (arXiv:2404.00456)",
    )
    p.add_argument("--json", action="store_true", help="Emit machine-readable JSON alongside human output")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_common(sp: argparse.ArgumentParser) -> None:
        sp.add_argument("--dim", type=int, default=256, help="Feature dimension (padded to pow2 for FWHT)")
        sp.add_argument("--bits", type=int, default=4, help="Quantization bit-width (2-8)")
        sp.add_argument("--group-size", type=int, default=32, dest="group_size")
        sp.add_argument("--asymmetric", action="store_true", help="Use asymmetric (zero-point) quant")
        sp.add_argument("--seed", type=int, default=42)
        sp.add_argument("--mode", choices=["hadamard", "identity", "random_ortho"], default="hadamard")
        sp.add_argument("--clip-ratio", type=float, default=1.0, dest="clip_ratio")
        sp.add_argument("--outlier-channels", type=int, default=4, dest="outlier_channels")
        sp.add_argument("--outlier-scale", type=float, default=25.0, dest="outlier_scale")

    sp = sub.add_parser("status", help="Theory ledger + live demo")
    add_common(sp)
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("rotate", help="Apply randomized Hadamard and show outlier stats")
    add_common(sp)
    sp.set_defaults(func=cmd_rotate)

    sp = sub.add_parser("quantize", help="RTN group quant metrics without rotation")
    add_common(sp)
    sp.set_defaults(func=cmd_quantize)

    sp = sub.add_parser("pipeline", help="Full QuaRot rotate→quant→unrotate pipeline")
    add_common(sp)
    sp.set_defaults(func=cmd_pipeline)

    sp = sub.add_parser("benchmark", help="Sweep dims/bits pipeline + GEMM")
    add_common(sp)
    sp.add_argument("--dims", type=int, nargs="+", default=[64, 128, 256, 512])
    sp.add_argument("--bits-list", type=int, nargs="+", default=[4], dest="bits_list")
    sp.add_argument("--repeats", type=int, default=5)
    sp.add_argument("--gemm-rows", type=int, default=16, dest="gemm_rows")
    sp.set_defaults(func=cmd_benchmark)

    sp = sub.add_parser("verify", help="Invariant battery (energy, FWHT, pipeline, GEMM)")
    add_common(sp)
    sp.add_argument("--trials", type=int, default=5)
    sp.set_defaults(func=cmd_verify)

    sp = sub.add_parser("outlier-map", help="Multi-sample pre/post outlier table")
    add_common(sp)
    sp.add_argument("--samples", type=int, default=8)
    sp.set_defaults(func=cmd_outlier_map)

    return p


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)
    try:
        return int(args.func(args))
    except BrokenPipeError:
        return 0
    except Exception as exc:  # noqa: BLE001 — CLI boundary
        print(f"❌ quarot-hadamard-quant-engine error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
