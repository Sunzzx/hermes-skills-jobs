#!/usr/bin/env python3
"""Redact common credentials and personal identifiers from text logs."""
from __future__ import annotations
import argparse
import re
import sys
from pathlib import Path

REDACTED = "[REDACTED]"
PATTERNS: list[tuple[str, re.Pattern[str]]] = [
    ("private-key", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----[\s\S]*?-----END (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----")),
    ("aws-access-key", re.compile(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b")),
    ("github-token", re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})\b")),
    ("bearer-token", re.compile(r"(?i)(\bBearer\s+)[A-Za-z0-9._~+/=-]{8,}")),
    ("jwt", re.compile(r"\beyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\b")),
    ("assignment-secret", re.compile(r"(?i)(\b(?:api[_-]?key|access[_-]?token|refresh[_-]?token|client[_-]?secret|password|passwd|secret)\b\s*[:=]\s*)(['\"]?)([^\s,;\"']{6,})\2")),
    ("email", re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b")),
    ("phone", re.compile(r"(?<!\w)(?:\+?\d[\d .()-]{8,}\d)(?!\w)")),
]


def scrub(text: str) -> tuple[str, dict[str, int]]:
    counts: dict[str, int] = {}
    for name, pattern in PATTERNS:
        if name in {"bearer-token", "assignment-secret"}:
            text, count = pattern.subn(lambda m: m.group(1) + REDACTED, text)
        else:
            text, count = pattern.subn(REDACTED, text)
        if count:
            counts[name] = count
    return text, counts


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("files", nargs="*", help="UTF-8 text files; omit or use - for stdin")
    parser.add_argument("--check", action="store_true", help="exit 1 if any credential/identifier would be redacted; emit no content")
    args = parser.parse_args(argv)
    names = args.files or ["-"]
    try:
        chunks = []
        for name in names:
            chunks.append(sys.stdin.read() if name == "-" else Path(name).read_text(encoding="utf-8", errors="replace"))
    except OSError as exc:
        print(f"log-scrub: {exc}", file=sys.stderr)
        return 2
    output, counts = scrub("".join(chunks))
    if args.check:
        for name, count in sorted(counts.items()):
            print(f"{name}: {count}", file=sys.stderr)
        return 1 if counts else 0
    sys.stdout.write(output)
    total = sum(counts.values())
    print(f"log-scrub: redacted {total} matches across {len(counts)} categories", file=sys.stderr)
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
